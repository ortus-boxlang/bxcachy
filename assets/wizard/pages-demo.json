{
  "title": "BxCachy",
  "tagline": "Your developer machine, set up in minutes.",
  "version": "0.12.0",
  "pages": [
    {
      "id": "desktop",
      "title": "Desktop",
      "intro": "Hyprland with Noctalia sits beside KDE Plasma. Pick what you want on this machine.",
      "questions": [
        {
          "type": "choice",
          "id": "desktops",
          "label": "Which desktops?",
          "default": "both",
          "help": "You can switch at the login screen at any time.",
          "options": [
            {
              "value": "hyprland",
              "label": "Hyprland + Noctalia",
              "description": "A fast tiling desktop with a polished shell. Keyboard-first, Mac-style Super keys."
            },
            {
              "value": "plasma",
              "label": "KDE Plasma with tiling",
              "description": "Keep Plasma and add HyprKwin tiling on top. Toggle it any time with: bxcachy tiling on|off."
            },
            {
              "value": "both",
              "label": "Both",
              "description": "Install Hyprland and tiling for Plasma. Choose at the login screen."
            }
          ]
        },
        {
          "type": "choice",
          "id": "window_style",
          "label": "How should windows behave?",
          "default": "tiled",
          "options": [
            {
              "value": "tiled",
              "label": "Tiled",
              "description": "Windows split the screen automatically. Great for focus and big monitors."
            },
            {
              "value": "floating",
              "label": "Floating",
              "description": "Windows sit where you drop them, like macOS and Windows."
            }
          ]
        },
        {
          "type": "number",
          "id": "workspaces",
          "label": "Workspaces always shown",
          "min": 1,
          "max": 10,
          "default": 2,
          "help": "Empty workspaces stay visible in the bar."
        }
      ]
    },
    {
      "id": "look",
      "title": "Look",
      "intro": "Dark with the BoxLang greens, or your own taste.",
      "questions": [
        {
          "type": "choice",
          "id": "theme",
          "label": "Theme",
          "default": "dark",
          "options": [
            {
              "value": "dark",
              "label": "Dark",
              "description": "Catppuccin Frappe neutrals with BoxLang green and cyan."
            },
            {
              "value": "light",
              "label": "Light",
              "description": "Catppuccin Latte neutrals with deeper greens."
            },
            {
              "value": "auto",
              "label": "Auto",
              "description": "Follows sunrise and sunset."
            }
          ]
        },
        {
          "type": "choice",
          "id": "wallpaper",
          "label": "Wallpaper",
          "default": "box",
          "options": [
            {
              "value": "box",
              "label": "BxCachy",
              "description": "The BoxLang icon on a soft dark glow."
            },
            {
              "value": "grid",
              "label": "Grid",
              "description": "A perspective grid in the brand gradient."
            },
            {
              "value": "aurora",
              "label": "Aurora",
              "description": "Green and cyan light on dark."
            },
            {
              "value": "minimal",
              "label": "Minimal",
              "description": "Almost nothing. The mono icon."
            }
          ]
        }
      ]
    },
    {
      "id": "input",
      "title": "Input",
      "intro": "Keyboards, languages and the Mac-style keys.",
      "questions": [
        {
          "type": "multi",
          "id": "layouts",
          "label": "Keyboard layouts",
          "default": [
            "us-intl",
            "es"
          ],
          "help": "Switch between them from the bar.",
          "options": [
            {
              "value": "us-intl",
              "label": "English (US, international)",
              "description": "US layout with dead keys for accents.",
              "group": "English"
            },
            {
              "value": "us",
              "label": "English (US)",
              "description": "Plain US layout.",
              "group": "English"
            },
            {
              "value": "es",
              "label": "Spanish",
              "description": "Spanish (Spain) layout.",
              "group": "Spanish"
            },
            {
              "value": "latam",
              "label": "Spanish (Latin America)",
              "description": "Latin American layout.",
              "group": "Spanish"
            },
            {
              "value": "de",
              "label": "German",
              "description": "QWERTZ.",
              "group": "Other"
            },
            {
              "value": "fr",
              "label": "French",
              "description": "AZERTY.",
              "group": "Other"
            }
          ]
        },
        {
          "type": "confirm",
          "id": "natural_scroll",
          "label": "Natural scrolling",
          "default": false,
          "help": "Content follows your fingers, like macOS."
        },
        {
          "type": "confirm",
          "id": "mac_keys",
          "label": "Mac-style Super keys",
          "default": true,
          "help": "Super+C, Super+V, Super+Tab behave like Cmd."
        }
      ]
    },
    {
      "id": "dev",
      "title": "Developer",
      "intro": "Who you are and how you like your shell.",
      "questions": [
        {
          "type": "text",
          "id": "git_name",
          "label": "Git name",
          "placeholder": "Luis Majano"
        },
        {
          "type": "text",
          "id": "git_email",
          "label": "Git email",
          "placeholder": "you@example.com"
        },
        {
          "type": "choice",
          "id": "shell",
          "label": "Shell",
          "default": "fish",
          "options": [
            {
              "value": "fish",
              "label": "fish",
              "description": "Friendly, with autosuggestions out of the box."
            },
            {
              "value": "zsh",
              "label": "zsh",
              "description": "Familiar from macOS, endlessly configurable."
            },
            {
              "value": "bash",
              "label": "bash",
              "description": "The classic. Nothing to learn."
            }
          ]
        },
        {
          "type": "confirm",
          "id": "ssh_key",
          "label": "Create an SSH key",
          "default": true,
          "help": "An ed25519 key for GitHub and servers."
        }
      ]
    },
    {
      "id": "tools",
      "title": "Toolchains",
      "intro": "Languages and build tools. Java 21, BoxLang and Node are always installed.",
      "questions": [
        {
          "type": "multi",
          "id": "toolchains",
          "label": "Add toolchains",
          "default": [
            "java"
          ],
          "options": [
            {
              "value": "java",
              "label": "Java with Gradle and Maven",
              "description": "JDK 21, plus the build tools."
            },
            {
              "value": "php",
              "label": "PHP with Composer and Laravel",
              "description": "PHP, Composer and the Laravel installer."
            },
            {
              "value": "python",
              "label": "Python with uv",
              "description": "Fast Python toolchain and virtual environments."
            },
            {
              "value": "go",
              "label": "Go",
              "description": "The Go toolchain."
            }
          ]
        }
      ]
    },
    {
      "id": "containers",
      "title": "Containers",
      "intro": "Where your databases and services run.",
      "questions": [
        {
          "type": "choice",
          "id": "container_engine",
          "label": "Container engine",
          "default": "podman",
          "options": [
            {
              "value": "podman",
              "label": "Podman",
              "description": "Rootless and daemonless. Safer by default, no background service, Docker-compatible commands."
            },
            {
              "value": "docker",
              "label": "Docker",
              "description": "The most widely documented. Runs a root daemon; best if your team's tooling expects Docker."
            }
          ]
        },
        {
          "type": "multi",
          "id": "databases",
          "label": "Databases to run",
          "default": [
            "postgres"
          ],
          "options": [
            {
              "value": "postgres",
              "label": "PostgreSQL",
              "description": "The default relational database.",
              "group": "Relational"
            },
            {
              "value": "mysql",
              "label": "MySQL / MariaDB",
              "description": "For apps that expect MySQL.",
              "group": "Relational"
            },
            {
              "value": "redis",
              "label": "Redis",
              "description": "Cache and queues.",
              "group": "Other"
            },
            {
              "value": "couchbase",
              "label": "Couchbase",
              "description": "Document database.",
              "group": "Other"
            },
            {
              "value": "pgvector",
              "label": "pgvector",
              "description": "Vectors in PostgreSQL.",
              "group": "Vectors"
            },
            {
              "value": "chroma",
              "label": "Chroma",
              "description": "Vector store for AI apps.",
              "group": "Vectors"
            }
          ]
        }
      ]
    },
    {
      "id": "apps",
      "title": "Apps",
      "intro": "Defaults come from the BxCachy catalog.",
      "questions": [
        {
          "type": "choice",
          "id": "app_mode",
          "label": "How do you want your apps?",
          "default": "defaults",
          "options": [
            {
              "value": "defaults",
              "label": "Use the defaults",
              "description": "The recommended app for each category."
            },
            {
              "value": "custom",
              "label": "Let me choose",
              "description": "Go through each category and pick."
            }
          ]
        },
        {
          "type": "multi",
          "id": "ai_agents",
          "label": "AI agents",
          "default": [
            "claude-code"
          ],
          "options": [
            {
              "value": "claude-code",
              "label": "Claude Code",
              "description": "Anthropic's coding agent."
            },
            {
              "value": "codex",
              "label": "Codex",
              "description": "OpenAI's coding agent."
            },
            {
              "value": "gemini",
              "label": "Gemini CLI",
              "description": "Google's coding agent."
            }
          ]
        }
      ]
    },
    {
      "id": "extras",
      "title": "Extras",
      "intro": "A few more things that make a machine feel like yours.",
      "questions": [
        {
          "type": "choice",
          "id": "vpn",
          "label": "VPN",
          "default": "tailscale",
          "options": [
            {
              "value": "none",
              "label": "None",
              "description": ""
            },
            {
              "value": "tailscale",
              "label": "Tailscale",
              "description": "Zero-config private network between your machines."
            },
            {
              "value": "wireguard",
              "label": "WireGuard",
              "description": "Fast, simple VPN tunnels."
            }
          ]
        },
        {
          "type": "choice",
          "id": "password_manager",
          "label": "Password manager",
          "default": "bitwarden",
          "options": [
            {
              "value": "bitwarden",
              "label": "Bitwarden",
              "description": "Open source, synced."
            },
            {
              "value": "keepassxc",
              "label": "KeePassXC",
              "description": "Local files, no account."
            },
            {
              "value": "1password",
              "label": "1Password",
              "description": "Polished, subscription."
            }
          ]
        },
        {
          "type": "choice",
          "id": "gaming",
          "label": "Gaming",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "No gaming",
              "description": ""
            },
            {
              "value": "steam",
              "label": "Steam only",
              "description": "Just Steam."
            },
            {
              "value": "bundle",
              "label": "Full CachyOS gaming bundle",
              "description": "Steam, Lutris, Heroic, Proton tools, MangoHud and more."
            }
          ]
        }
      ]
    }
  ]
}
