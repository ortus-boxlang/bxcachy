{
  "name": "bxcachy",
  "slug": "bxcachy",
  "version": "0.11.0-dev",
  "shortDescription": "Developer kickstarter for CachyOS with Hyprland and Noctalia",
  "toolchain": {
    "java": {
      "version": "21",
      "package": "jdk21-openjdk"
    },
    "boxlang": {
      "version": "latest",
      "testedWith": "1.19.0"
    },
    "bvm": {
      "version": "latest",
      "testedWith": "1.40.0",
      "installer": "https://install-bvm.boxlang.io"
    },
    "mvm": {
      "version": "latest",
      "testedWith": "2.0.1",
      "installer": "https://raw.githubusercontent.com/ortus-boxlang/matchbox-quick-installer/main/install/install.sh"
    },
    "matchbox": {
      "version": "0.13.0",
      "repo": "https://github.com/ortus-boxlang/matchbox",
      "ref": "bxcachy",
      "downloads": "https://downloads.ortussolutions.com/ortussolutions/bxcachy/matchbox",
      "note": "MatchBox built by CI from the `bxcachy` branch (develop plus the open BxCachy pull requests) and published to S3; switch back to a released version through mvm once those pull requests ship."
