// BxCachy: a kickstarter for developers on CachyOS. Entry point class: `bxcachy <command> ...`
// runs main( args ) (BoxLang class entry, MatchBox PR #152). Application.bx adds the lifecycle.
class {

    property name="version" default="0.11.0-dev";

    function main( rawArgs = [] ) {
        var args = CLIGetArgs();
        var p = args.positionals;
        var cmd = p.len() ? p[1] : "help";
        var appVersion = "0.11.0-dev";
        var asJson = structKeyExists( args.options, "json" );
        var cli = new bxcachy.Cli( appVersion );
        var catalog = new bxcachy.Catalog();
        var config = new bxcachy.ConfigService();
        // One shared flag check for every command: unknown flags are usage errors and nothing runs.
        for ( var flag in args.options ) {
            if ( !arrayFind( [ "yes", "dry-run", "force", "json", "quiet", "group", "category", "tier", "kind", "source", "profile", "optional", "shell", "keys", "undo-keys", "build", "method", "overwrite", "name", "port", "password-file", "ask-password", "keep-data", "show-password", "prompt", "print-answers", "layout", "workspaces", "natural-scroll", "layouts", "theme", "wallpaper", "terminal", "default", "also", "pages", "out", "answers", "demo", "from-file", "show", "strict" ], flag ) && !( cmd == "secrets" && p.len() >= 2 && p[2] == "run" ) ) {
                println( "Unknown option: --" & flag );
                CLIExit( 2 );
            }
        }
        var base = [ "localsend", "mpv", "pacseek" ];

        switch ( cmd ) {
         case "version":
          if ( asJson ) println( cli.envelope( "version", 0, { name: "BxCachy", version: appVersion } ) );
          else println( "BxCachy 0.11.0-dev" );
          break;
         case "doctor":
         case "prerequisites":
          println( "Workstation prerequisites: Java 21, BVM, MVM, BoxLang, MatchBox" );
          println( "Native build prerequisites: Rust and Cargo" );
          break;
         case "desktop-list":
         case "tui-list":
         case "web-list":
         case "optional-list":
         case "profile-list":
          if ( p.len() != 1 ) {
           println( "Usage: bxcachy " & cmd & " [--json]" );
           CLIExit( 2 );
          }
          pk = new bxcachy.Packages( cli, catalog.load() );
          CLIExit( cmd == "profile-list" ? pk.profiles( asJson ) : pk.listApps( cmd, asJson ) );
          break;
         case "apps-doctor":
          println( "Base packages (pacman first):" );
          for ( var pkg in base ) println( pkg );
          break;
         case "plan":
         case "install-plan":
         case "optional-plan":
         case "profile-plan":
         case "profile-install-plan":
          // Selection comes from the arguments and flags; the resolver decides, nothing is installed.
          pk = new bxcachy.Packages( cli, catalog.load() );
          planReq = pk.request( cmd, p, args.options );
          if ( planReq.bad ) {
           println( planReq.usage );
           CLIExit( 2 );
          }
          CLIExit( pk.plan( cmd, planReq.req, asJson ) );
          break;
         case "package-status":
         case "package-source":
          if ( p.len() != 2 || !reFind( "^[a-z0-9][a-z0-9-]*$", p[2] ) ) {
           println( "Usage: bxcachy " & cmd & " ID" );
           CLIExit( 2 );
          }
          pk = new bxcachy.Packages( cli, catalog.load() );
          CLIExit( cmd == "package-status" ? pk.status( p[2], asJson ) : pk.source( p[2], asJson ) );
          break;
         case "dev-plan":
          println( "Java: jdk21-openjdk via pacman" );
          println( "Maven: maven via pacman" );
          println( "Gradle: gradle via pacman" );
          println( "BVM: https://install-bvm.boxlang.io" );
          println( "MVM: https://raw.githubusercontent.com/ortus-boxlang/matchbox-quick-installer/main/install/install.sh" );
          break;
         case "install":
         case "optional-install":
         case "profile-install":
          // Selection as for plan; the installer runs it. Without --yes the plan is printed and nothing changes.
          pk = new bxcachy.Packages( cli, catalog.load() );
          instReq = pk.request( cmd, p, args.options );
          if ( instReq.bad ) {
           println( instReq.usage );
           CLIExit( 2 );
          }
          CLIExit( pk.install( cmd, instReq.req, asJson, structKeyExists( args.options, "yes" ), structKeyExists( args.options, "dry-run" ) ) );
          break;
         case "catalog":
          catVerb = p.len() >= 2 ? p[2] : "";
          catArg = p.len() >= 3 ? p[3] : "";
          catBad = p.len() > 3 || !arrayFind( [ "list", "show", "groups", "check", "version" ], catVerb ) || ( catVerb == "show" && p.len() != 3 ) || ( catVerb != "show" && p.len() > 2 );
          catOpts = [ "json", "group", "category", "tier", "kind", "source" ];
          for ( var o in args.options ) if ( !arrayFind( catOpts, o ) && !arrayFind( [ "yes", "dry-run", "force", "quiet" ], o ) ) catBad = true;
          if ( catBad ) {
           println( "Usage: bxcachy catalog list [--group=G] [--category=C] [--tier=default|optional] [--kind=K] [--source=S] [--json] | show ID | groups | check | version" );
           CLIExit( 2 );
          }
          cat = catalog.load();
          if ( catVerb == "version" ) {
           if ( asJson ) println( cli.envelope( "catalog version", 0, { catalog_version: cat.catalog_version, schema: cat.schema, apps: cat.apps.len() } ) );
           else println( "catalog " & cat.catalog_version & " (schema " & cat.schema & ", " & cat.apps.len() & " apps)" );
           break;
          }
          if ( catVerb == "groups" ) {
           rows = [];
           for ( var g in cat.groups ) {
            cs = cat.categories.filter( function( c ) { return c.group == g.id; } ).map( function( c ) { return c.title; } );
            n = cat.apps.filter( function( a ) { return a.group == g.id; } ).len();
            rows.append( { id: g.id, title: g.title, blurb: g.blurb, order: g.order, apps: n, categories: cs } );
           }
           if ( asJson ) println( cli.envelope( "catalog groups", 0, rows ) );
           else for ( var r in rows ) println( r.id & ": " & r.title & " (" & r.apps & " apps) - " & r.categories.toList( ", " ) );
           break;
          }
          if ( catVerb == "show" ) {
           found = catalog.find( cat, catArg );
           if ( structIsEmpty( found ) ) {
            println( "Unknown catalog id: " & catArg );
            CLIExit( 3 );
           }
           if ( asJson ) {
            println( cli.envelope( "catalog show", 0, found ) );
           } else {
            println( found.name & " (" & found.id & ")" );
            println( found.description );
            println( "group: " & found.group & "/" & found.category & "  tier: " & found.tier & "  kind: " & found.kind );
            println( "source: " & found.source & ( structKeyExists( found, "targets" ) ? "  targets: " & found.targets.toList( " " ) : "" ) & ( structKeyExists( found, "url" ) ? "  url: " & found.url : "" ) );
            if ( structKeyExists( found, "homepage" ) ) println( "homepage: " & found.homepage );
            if ( !isNull( found.macos ) ) println( "macOS: " & found.macos );
            if ( structKeyExists( found, "note" ) ) println( "note: " & found.note );
           }
           break;
          }
          if ( catVerb == "check" ) {
           res = catalog.check( cat );
           code = res.errors.len() ? 1 : 0;
           if ( asJson ) {
            println( cli.envelope( "catalog check", code, res ) );
           } else {
            for ( var e in res.errors ) println( "error: " & e );
            for ( var w in res.warnings ) println( "warning: " & w );
            println( "catalog check: " & res.errors.len() & " errors, " & res.warnings.len() & " warnings, " & cat.apps.len() & " apps" );
           }
           CLIExit( code );
          }
          // list
          sel = cat.apps.filter( function( a ) {
           if ( structKeyExists( args.options, "group" ) && a.group != args.options.group ) return false;
           if ( structKeyExists( args.options, "category" ) && a.category != args.options.category ) return false;
           if ( structKeyExists( args.options, "tier" ) && a.tier != args.options.tier ) return false;
           if ( structKeyExists( args.options, "kind" ) && a.kind != args.options.kind ) return false;
           if ( structKeyExists( args.options, "source" ) && a.source != args.options.source ) return false;
           return true;
          } );
          if ( asJson ) println( cli.envelope( "catalog list", 0, sel ) );
          else for ( var a in sel ) println( catalog.row( a ) );
          break;
         case "config":
          cfgVerb = p.len() >= 2 ? p[2] : "";
          cfgName = p.len() >= 3 ? p[3] : "";
          cfgBad = !len( getSystemSetting( "HOME", "" ) ) || p.len() > 4 || ( p.len() == 4 && cfgVerb != "restore" ) || !arrayFind( [ "list", "diff", "apply", "restore", "history" ], cfgVerb );
          if ( cfgBad ) {
           println( "Usage: bxcachy config list|diff NAME|apply NAME|restore NAME ID|history [NAME] [--yes] [--dry-run] [--force] [--json]" );
           CLIExit( 2 );
          }
          yes = structKeyExists( args.options, "yes" );
          dryRun = structKeyExists( args.options, "dry-run" );
          force = structKeyExists( args.options, "force" );
          nl = chr( 10 );
          var managed = { "bxcachy": { name: "bxcachy", target: config.cfgHome() & "/bxcachy/bxcachy.json", mode: "600", content: '{' & nl & '  "schema_version": 1,' & nl & '  "desktop": "auto"' & nl & '}' & nl } };
          for ( var se in new bxcachy.Shortcuts().entries( config.cfgHome() ) ) managed[se.name] = se;
          for ( var ne in new bxcachy.Starter().entries() ) managed[ne.name] = ne;
          if ( cfgVerb == "list" || cfgVerb == "history" ) {
           rows = [];
           if ( cfgVerb == "list" ) {
            for ( var key in managed ) rows.append( { name: key, target: managed[key].target, state: config.configState( managed[key] ) } );
           } else {
            rows = config.journalEntries( cfgName );
           }
           if ( asJson ) {
            println( jsonSerialize( rows ) );
           } else if ( cfgVerb == "list" ) {
            for ( var r in rows ) println( r.name & ": " & r.state & " (" & r.target & ")" );
           } else {
            for ( var r in rows ) println( r.id & " " & r.action & " " & r.name & " " & r.time );
            if ( !rows.len() ) println( "No history." );
           }
           break;
          }
          if ( !structKeyExists( managed, cfgName ) ) {
           println( "Unknown managed config: " & cfgName );
           CLIExit( 2 );
          }
          entry = managed[cfgName];
          if ( cfgVerb == "diff" ) {
           st = config.configState( entry );
           println( cfgName & ": " & st );
           if ( st == "outdated" || st == "drifted" ) {
            tmpSrc = getTempDirectory() & "/bxcachy-src-" & left( createUUID(), 8 );
            fileWrite( tmpSrc, entry.content );
            d = systemExecute( "diff", [ "-u", entry.target, tmpSrc ], 15, true );
            println( d.output );
            fileDelete( tmpSrc );
           }
           break;
          }
          if ( cfgVerb == "apply" ) {
           CLIExit( config.configApply( entry, yes, dryRun, force ) );
          }
          if ( p.len() != 4 ) {
           println( "Usage: bxcachy config restore NAME ID --yes" );
           CLIExit( 2 );
          }
          CLIExit( config.configRestore( entry, p[4], yes, dryRun ) );
          break;
         case "setup":
          // Targets: plasma (HyprKwin tiling on KDE), hyprland (packages), undo plasma|hyprland, status.
          setupSub = p.len() >= 2 ? p[2] : "";
          setupYes = structKeyExists( args.options, "yes" );
          setupDry = structKeyExists( args.options, "dry-run" );
          st = new bxcachy.Setup( cli );
          if ( setupSub == "plasma" && p.len() == 2 ) {
           CLIExit( st.plasma( { keys: structKeyExists( args.options, "keys" ), undoKeys: structKeyExists( args.options, "undo-keys" ) }, setupYes, setupDry, asJson ) );
          }
          if ( setupSub == "undo" && p.len() == 3 && p[3] == "plasma" ) {
           CLIExit( st.undoPlasma( setupYes, setupDry, asJson ) );
          }
          if ( setupSub == "status" && p.len() == 2 ) {
           CLIExit( st.status( asJson ) );
          }
          if ( setupSub == "hyprland" && p.len() == 2 ) {
           CLIExit( st.hyprland( { terminal: args.options.terminal ?: "", layout: args.options.layout ?: "", workspaces: args.options.workspaces ?: "", naturalScroll: structKeyExists( args.options, "natural-scroll" ), layouts: args.options.layouts ?: "", theme: args.options.theme ?: "", wallpaper: args.options.wallpaper ?: "" }, setupYes, setupDry, asJson ) );
          }
          if ( setupSub == "undo" && p.len() == 3 && p[3] == "hyprland" ) {
           CLIExit( st.undoHyprland( setupYes, setupDry, asJson ) );
          }
          if ( setupSub == "terminal" && p.len() == 2 ) {
           CLIExit( st.terminal( { default: args.options.default ?: "", also: args.options.also ?: "" }, setupYes, setupDry, asJson ) );
          }
          if ( setupSub == "shell" && p.len() == 2 ) {
           CLIExit( st.shell( { shell: args.options.shell ?: "" }, setupYes, setupDry, asJson ) );
          }
          if ( setupSub == "xremap" && p.len() == 2 ) {
           CLIExit( st.xremap( { build: args.options.build ?: "" }, setupYes, setupDry, asJson ) );
          }
          if ( setupSub == "undo" && p.len() == 3 && p[3] == "xremap" ) {
           CLIExit( st.undoXremap( setupYes, setupDry, asJson ) );
          }
          println( "Usage: bxcachy setup plasma [--keys | --undo-keys] | hyprland [--terminal=ghostty|kitty|alacritty|foot|konsole] [--layout=dwindle|master|scrolling|floating] [--workspaces=N] [--natural-scroll] [--layouts=us-intl,es] [--theme=dark|light|auto] [--wallpaper=box|grid|aurora|minimal] | terminal [--default=ghostty] [--also=a,b] | shell [--shell=zsh|fish|bash] | xremap [--build=hypr|kde] | undo plasma|hyprland|xremap | status [--yes] [--dry-run] [--json]" );
          CLIExit( 2 );
          break;
         case "default":
          // Make an installed app your default browser or terminal. See COMMAND-CONTRACT.md 13.12.
          dfltSub = p.len() >= 2 ? p[2] : "";
          dflt = new bxcachy.Defaults( cli );
          dfltYes = structKeyExists( args.options, "yes" );
          dfltDry = structKeyExists( args.options, "dry-run" );
          if ( dfltSub == "show" && p.len() == 2 ) CLIExit( dflt.show( asJson ) );
          if ( dfltSub == "browser" && p.len() == 3 ) CLIExit( dflt.browser( p[3], dfltYes, dfltDry, asJson ) );
          if ( dfltSub == "terminal" && p.len() == 3 ) CLIExit( dflt.terminal( p[3], dfltYes, dfltDry, asJson ) );
          println( "Usage: bxcachy default show | browser ID | terminal ID [--yes] [--dry-run] [--json]" );
          CLIExit( 2 );
          break;
         case "secrets":
          // One way to store and load API keys: keyring first, private files otherwise. See COMMAND-CONTRACT.md 13.13.
          secSub = p.len() >= 2 ? p[2] : "";
          sec = new bxcachy.Secrets( cli );
          if ( secSub == "status" && p.len() == 2 ) CLIExit( sec.status( asJson ) );
          if ( secSub == "list" && p.len() == 2 ) CLIExit( sec.list( asJson ) );
          if ( secSub == "set" && p.len() == 3 ) CLIExit( sec.setValue( p[3], args.options["from-file"] ?: "", asJson ) );
          if ( secSub == "get" && p.len() == 3 ) CLIExit( sec.getValue( p[3], structKeyExists( args.options, "show" ), asJson ) );
          if ( secSub == "unset" && p.len() == 3 ) CLIExit( sec.unset( p[3], structKeyExists( args.options, "yes" ), asJson ) );
          if ( secSub == "apply" && p.len() == 2 ) CLIExit( sec.apply( structKeyExists( args.options, "yes" ), structKeyExists( args.options, "dry-run" ), asJson ) );
          if ( secSub == "global" && p.len() >= 3 ) CLIExit( sec.globalCmd( p[3], p.len() >= 4 ? p[4] : "", structKeyExists( args.options, "yes" ), asJson ) );
          if ( secSub == "unlock" && p.len() == 2 ) CLIExit( sec.unlock( asJson ) );
          if ( secSub == "lock" && p.len() == 2 ) CLIExit( sec.lock( asJson ) );
          if ( secSub == "env" ) CLIExit( sec.env( p.len() > 2 ? p.slice( 3 ) : [] ) );
          if ( secSub == "run" ) {
            // Everything after -- is the program and its arguments, taken from the raw arguments (the flag parser would eat its flags).
            secRaw = rawArgs.len() ? rawArgs : [];
            secDash = arrayFind( secRaw, "--" );
            if ( secDash > 0 ) {
              secNames = secRaw.slice( 3, secDash - 3 );
              secCmd = secRaw.slice( secDash + 1 );
              secStrict = arrayFind( secNames, "--strict" ) > 0;
              CLIExit( sec.run( secNames.filter( function( x ) { return left( x, 2 ) != "--"; } ), secCmd, secStrict ) );
            }
          }
          println( "Usage: bxcachy secrets status | list | set NAME [--from-file=F] | get NAME [--show] | unset NAME --yes | apply [--yes] | global on NAME --yes|off NAME|show | unlock | lock | env [NAMES...] | run [NAMES...] [--strict] -- COMMAND [ARGS...] [--json]" );
          CLIExit( 2 );
          break;
         case "dotfiles":
          // Apply your own dotfiles repository (method detected: chezmoi, yadm, stow or links). See COMMAND-CONTRACT.md 13.11.
          dfSub = p.len() >= 2 ? p[2] : "";
          df = new bxcachy.Dotfiles( cli );
          dfYes = structKeyExists( args.options, "yes" );
          dfDry = structKeyExists( args.options, "dry-run" );
          dfUsage = "Usage: bxcachy dotfiles plan REPO [--method=chezmoi|yadm|stow|links] | apply REPO [--method=M] [--overwrite] [--yes] [--dry-run] | status | undo [--yes] [--dry-run] [--json]";
          if ( dfSub == "plan" && p.len() == 3 ) CLIExit( df.showPlan( p[3], args.options.method ?: "", asJson ) );
          if ( dfSub == "apply" && p.len() == 3 ) CLIExit( df.apply( p[3], args.options.method ?: "", structKeyExists( args.options, "overwrite" ), dfYes, dfDry, asJson ) );
          if ( dfSub == "status" && p.len() == 2 ) CLIExit( df.status( asJson ) );
          if ( dfSub == "undo" && p.len() == 2 ) CLIExit( df.undo( dfYes, dfDry, asJson ) );
          println( dfUsage );
          CLIExit( 2 );
          break;
         case "db":
          // Local database and search services as containers (Podman by default, Docker by choice). See COMMAND-CONTRACT.md 13.10.
          dbSub = p.len() >= 2 ? p[2] : "";
          dbArg = p.len() >= 3 ? p[3] : "";
          db = new bxcachy.Db( cli );
          dbYes = structKeyExists( args.options, "yes" );
          dbDry = structKeyExists( args.options, "dry-run" );
          dbName = args.options.name ?: "default";
          dbUsage = "Usage: bxcachy db engines | list | start ENGINE [--name N] [--port P] [--password-file FILE | --ask-password] [--yes] [--dry-run] | stop|status|logs ENGINE [--name N] | remove ENGINE [--name N] [--keep-data] --yes | info ENGINE [--name N] [--show-password] | engine [podman|docker] | menu [--json]";
          if ( arrayFind( [ "engines", "list" ], dbSub ) && p.len() == 2 ) CLIExit( dbSub == "engines" ? db.listEngines( asJson ) : db.list( asJson ) );
          if ( dbSub == "menu" && p.len() == 2 ) CLIExit( db.menu() );
          if ( dbSub == "engine" && p.len() <= 3 ) CLIExit( db.engine( dbArg, asJson ) );
          if ( p.len() == 3 && dbSub == "start" ) CLIExit( db.start( dbArg, dbName, args.options.port ?: "", dbYes, dbDry, asJson, args.options["password-file"] ?: "", structKeyExists( args.options, "ask-password" ) ) );
          if ( p.len() == 3 && arrayFind( [ "stop", "status", "logs" ], dbSub ) ) CLIExit( db.act( dbSub, dbArg, dbName, asJson ) );
          if ( p.len() == 3 && dbSub == "remove" ) CLIExit( db.remove( dbArg, dbName, structKeyExists( args.options, "keep-data" ), dbYes, dbDry, asJson ) );
          if ( p.len() == 3 && dbSub == "info" ) CLIExit( db.info( dbArg, dbName, structKeyExists( args.options, "show-password" ), asJson ) );
          println( dbUsage );
          CLIExit( 2 );
          break;
         case "runner":
          // Launcher and menu providers. Records the choice (~/.config/bxcachy/runner.json); never changes a keybinding.
          // set and menu-set are user settings that act at once (no --yes), like `tiling`.
          rnSub = p.len() >= 2 ? p[2] : "";
          rn = new bxcachy.Runner( cli );
          rnUsage = "Usage: bxcachy runner list | show | doctor | launch | select JSON_ENTRIES [--prompt=TEXT] | set PROVIDER | menu-set PROVIDER | launcher-command PROVIDER JSON_ARGV | menu-command PROVIDER JSON_ARGV [--json]";
          rnArity = { list: 2, show: 2, doctor: 2, launch: 2, select: 3, set: 3, "menu-set": 3, "launcher-command": 4, "menu-command": 4 };
          if ( !structKeyExists( rnArity, rnSub ) || p.len() != rnArity[ rnSub ] ) {
           println( rnUsage );
           CLIExit( 2 );
          }
          try {
           if ( rnSub == "list" ) {
            rnCfg = rn.load();
            if ( asJson ) println( cli.envelope( "runner list", 0, { launchers: rn.launcherProviders().map( function( x ) { return { id: x, current: x == rnCfg.provider, title: rn.registry().get( x ).title, package: rn.registry().get( x ).package }; } ), menus: rn.menuProviders().map( function( x ) { var m = rn.registry().get( x ).menu; return { id: x, current: x == rnCfg.menu_provider, icons: m.icons, returns: m.returns }; } ) } ) );
            else {
             println( "launcher: " & rn.launcherProviders().map( function( x ) { return ( x == rnCfg.provider ? "*" : "" ) & x; } ).toList( " " ) );
             println( "menu: " & rn.menuProviders().map( function( x ) { return ( x == rnCfg.menu_provider ? "*" : "" ) & x; } ).toList( " " ) );
            }
            CLIExit( 0 );
           }
           if ( rnSub == "show" ) {
            rnCfg = rn.load();
            if ( asJson ) println( cli.envelope( "runner show", 0, rnCfg ) ); else println( jsonSerialize( rnCfg ) );
            CLIExit( 0 );
           }
           if ( rnSub == "doctor" ) {
            rnDoc = rn.doctor();
            if ( asJson ) println( cli.envelope( "runner doctor", 0, rnDoc ) );
            else {
             println( "Desktop: " & rnDoc.desktop );
             println( "Launcher: " & rnDoc.launcher.provider & " | command: " & ( rnDoc.launcher.owned_by_desktop ? "(desktop-owned)" : rnDoc.launcher.command.toList( " " ) ) );
             println( "Menu: " & rnDoc.menu.provider & " | command: " & rnDoc.menu.command.toList( " " ) );
             if ( !rnDoc.launcher.owned_by_desktop ) println( "launcher executable: " & ( rnDoc.launcher.found ? "found" : "NOT FOUND" ) );
             println( "menu executable: " & ( rnDoc.menu.found ? "found" : "NOT FOUND" ) );
             println( "Shortcut ownership: unchanged" );
            }
            CLIExit( 0 );
           }
           if ( rnSub == "launch" ) {
            rnLaunch = rn.launch();
            if ( asJson ) println( cli.envelope( "runner launch", rnLaunch.ok ? 0 : 4, rnLaunch ) );
            else if ( !rnLaunch.ok ) println( "error: " & rnLaunch.error );
            CLIExit( rnLaunch.ok ? 0 : 4 );
           }
           if ( rnSub == "select" ) {
            // The menu abstraction: entries as a JSON array of labels or { label, icon }. Prints the 0-based index of the choice;
            // exit 1 when cancelled, 4 when the menu cannot run or the entries are invalid.
            try { rnEntries = jsonDeserialize( p[3] ); } catch ( any e ) { rnEntries = ""; }
            rnOk = isArray( rnEntries ) && rnEntries.len() > 0;
            if ( rnOk ) for ( rnE in rnEntries ) if ( !( isSimpleValue( rnE ) && len( rnE ) ) && !( isStruct( rnE ) && structKeyExists( rnE, "label" ) && len( rnE.label ) ) ) rnOk = false;
            if ( !rnOk ) {
             println( "error: entries must be a JSON array of labels or { label, icon } objects, for example [""Apps"",""Settings""]" );
             CLIExit( 4 );
            }
            rnPick = rn.select( args.options.prompt ?: "BxCachy", rnEntries );
            if ( rnPick == 0 ) CLIExit( 1 );
            if ( asJson ) println( cli.envelope( "runner select", 0, { index: rnPick - 1 } ) ); else println( rnPick - 1 );
            CLIExit( 0 );
           }
           rnArgv = [];
           if ( rnSub == "launcher-command" || rnSub == "menu-command" ) {
            try { rnArgv = jsonDeserialize( p[4] ); } catch ( any e ) { rnArgv = []; }
            if ( !isArray( rnArgv ) ) rnArgv = [];
           }
           rnErr = rn.set( rnSub == "set" ? "provider" : ( rnSub == "menu-set" ? "menu" : rnSub ), p[3], rnArgv );
           if ( len( rnErr ) ) {
            if ( asJson ) println( cli.envelope( "runner " & rnSub, 4, { error: rnErr } ) ); else println( "error: " & rnErr );
            CLIExit( 4 );
           }
           if ( asJson ) println( cli.envelope( "runner " & rnSub, 0, { provider: p[3] } ) );
           else println( ( rnSub == "set" ? "Runner provider: " : ( rnSub == "menu-set" ? "Menu provider: " : "Configured " ) ) & p[3] );
           CLIExit( 0 );
          } catch ( any e ) {
           if ( e.message contains "CLIExit" ) rethrow;
           println( "error: " & e.message );
           CLIExit( 4 );
          }
          break;
         case "toolchain":
          // Optional language toolchains. `toolchain node` installs nvm (pinned official installer) and Node.js LTS. Bun and Deno are
          // catalog apps: bxcachy install bun deno.
          if ( p.len() != 2 || p[2] != "node" ) {
           println( "Usage: bxcachy toolchain node [--yes] [--dry-run] [--json]   (Bun and Deno: bxcachy install bun deno)" );
           CLIExit( 2 );
          }
          CLIExit( new bxcachy.Setup( cli ).node( structKeyExists( args.options, "yes" ), structKeyExists( args.options, "dry-run" ), asJson ) );
          break;
         case "init":
          // The setup wizard and what it runs. init (needs a terminal) | init --answers=FILE [--yes] [--dry-run] [--json] | init --print-answers.
          if ( p.len() != 1 ) {
           println( "Usage: bxcachy init | init --answers=FILE [--yes] [--dry-run] [--json] | init --print-answers [--json]" );
           CLIExit( 2 );
          }
          initRun = new bxcachy.Init( cli );
          if ( structKeyExists( args.options, "print-answers" ) ) CLIExit( initRun.printAnswers( asJson ) );
          if ( structKeyExists( args.options, "answers" ) ) {
           try {
            initAnswers = jsonDeserialize( fileRead( args.options.answers ) );
           } catch ( any e ) {
            println( "bxcachy init: cannot read the answers file: " & e.message );
            CLIExit( 4 );
           }
           CLIExit( initRun.run( initAnswers, structKeyExists( args.options, "yes" ), structKeyExists( args.options, "dry-run" ), asJson ) );
          }
          CLIExit( initRun.wizard( structKeyExists( args.options, "dry-run" ), asJson ) );
          break;
         case "wizard":
          // The full-screen setup wizard on MatchBox's terminal canvas. It shows pages from a JSON file (--pages) or the
          // built-in ones (--demo), optionally starting from earlier answers (--answers FILE), and writes the answers as
          // JSON to --out FILE. It changes nothing on the machine. Exit: 0 answers written, 130 cancelled, 2 usage, 4 bad file.
          if ( p.len() != 1 || ( !structKeyExists( args.options, "demo" ) && !structKeyExists( args.options, "pages" ) ) ) {
           println( "Usage: bxcachy wizard --demo [--out=FILE] | --pages=FILE [--out=FILE] [--answers=FILE]" );
           CLIExit( 2 );
          }
          try {
           wzSpec = jsonDeserialize( structKeyExists( args.options, "demo" ) ? new bxcachy.WizardData().demoPages() : fileRead( args.options.pages ) );
           wzPreset = structKeyExists( args.options, "answers" ) ? jsonDeserialize( fileRead( args.options.answers ) ) : {};
          } catch ( any e ) {
           println( "bxcachy wizard: cannot read the pages or answers: " & e.message );
           CLIExit( 4 );
          }
          wzResult = new bxcachy.Wizard( wzSpec, wzPreset ).run();
          if ( wzResult.outcome != "done" ) CLIExit( 130 );
          if ( structKeyExists( args.options, "out" ) ) fileWrite( args.options.out, jsonSerialize( wzResult.answers ) & chr( 10 ) );
          CLIExit( 0 );
          break;
         case "keys":
          // The shared shortcut table: keys show | keys render xremap|hyprland|plasma (pure, writes nothing).
          keysSub = p.len() >= 2 ? p[2] : "";
          sc = new bxcachy.Shortcuts();
          if ( keysSub == "show" && p.len() == 2 ) {
           rows = sc.show();
           if ( asJson ) println( cli.envelope( "keys show", 0, { shortcuts: rows } ) );
           else for ( kr in rows ) println( kr.keys & "  " & kr.action & "  (" & kr.how & ")" );
           CLIExit( 0 );
          }
          if ( keysSub == "render" && p.len() == 3 && arrayFind( sc.targets(), p[3] ) ) {
           if ( asJson ) println( cli.envelope( "keys render", 0, { target: p[3], text: sc.render( p[3] ) } ) );
           else print( sc.render( p[3] ) );
           CLIExit( 0 );
          }
          if ( keysSub == "check" && p.len() == 2 ) {
           CLIExit( new bxcachy.KeysService( cli ).check( asJson ) );
          }
          if ( keysSub == "apply" && p.len() == 2 ) {
           CLIExit( new bxcachy.KeysService( cli ).apply( structKeyExists( args.options, "yes" ), structKeyExists( args.options, "dry-run" ), structKeyExists( args.options, "force" ), asJson ) );
          }
          println( "Usage: bxcachy keys show | render xremap|hyprland|plasma | check | apply [--yes] [--dry-run] [--force] [--json]" );
          CLIExit( 2 );
          break;
         case "assets":
          // The embedded brand images: assets list | assets install [--yes] [--dry-run].
          assetsSub = p.len() == 2 ? p[2] : "";
          assetsSvc = new bxcachy.Assets( cli );
          if ( assetsSub == "list" ) CLIExit( assetsSvc.list( asJson ) );
          if ( assetsSub == "install" ) CLIExit( assetsSvc.install( structKeyExists( args.options, "yes" ), structKeyExists( args.options, "dry-run" ), asJson ) );
          println( "Usage: bxcachy assets list | install [--yes] [--dry-run] [--json]" );
          CLIExit( 2 );
          break;
         case "session":
          // Which session the SDDM login screen preselects: session show | session set hyprland|plasma [--yes] [--dry-run].
          sessionSub = p.len() >= 2 ? p[2] : "";
          sessionSvc = new bxcachy.Session( cli );
          if ( sessionSub == "show" && p.len() == 2 ) CLIExit( sessionSvc.show( asJson ) );
          if ( sessionSub == "set" && p.len() == 3 ) CLIExit( sessionSvc.set( p[3], structKeyExists( args.options, "yes" ), structKeyExists( args.options, "dry-run" ), asJson ) );
          println( "Usage: bxcachy session show | set hyprland|plasma [--yes] [--dry-run] [--json]" );
          CLIExit( 2 );
          break;
         case "tiling":
          // HyprKwin on/off inside Plasma; on and off act at once (reversible user setting, see Tiling.bx).
          tilingSub = p.len() == 2 ? p[2] : "";
          if ( !arrayFind( [ "on", "off", "status" ], tilingSub ) ) {
           println( "Usage: bxcachy tiling on|off|status [--json]" );
           CLIExit( 2 );
          }
          tl = new bxcachy.Tiling( cli );
          CLIExit( tilingSub == "status" ? tl.status( asJson ) : tl.set( tilingSub == "on", asJson ) );
          break;
         case "help":
          println( "BxCachy commands: version, doctor, prerequisites, desktop-list, tui-list, web-list, optional-list, optional-plan, profile-list, profile-plan, profile-install-plan, install-plan, package-status, package-source, profile-install, optional-install, install, plan, apps-doctor, dev-plan, config, catalog, setup, tiling, keys, assets, session, help" );
          break;
         default:
          println( "Unsupported command: " & cmd );
          println( "Run bxcachy help" );
        }
    }

}
