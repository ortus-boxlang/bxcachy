// BxCachy: a kickstarter for developers on CachyOS. Entry point class: `bxcachy <command> ...`
// runs main( args ) (BoxLang class entry, MatchBox PR #152). Application.bx adds the lifecycle.
class {

    property name="version" default="0.11.0-dev";

    function main( rawArgs = [] ) {
        var args = CLIGetArgs();
        var p = args.positionals;
        var cmd = p.len() ? p[1] : "help";
        var appVersion = "0.11.0-dev";
        var asJson = structKeyExists( args.options, "json" );
        var cli = new bxcachy.Cli( appVersion );
        var catalog = new bxcachy.Catalog();
        var config = new bxcachy.ConfigService();
        // One shared flag check for every command: unknown flags are usage errors and nothing runs.
        for ( var flag in args.options ) {
            if ( !arrayFind( [ "yes", "dry-run", "force", "json", "quiet", "group", "category", "tier", "kind", "source", "profile", "optional", "shell" ], flag ) ) {
                println( "Unknown option: --" & flag );
                CLIExit( 2 );
            }
        }
        var base = [ "localsend", "mpv", "pacseek" ];

        switch ( cmd ) {
         case "version":
          if ( asJson ) println( cli.envelope( "version", 0, { name: "BxCachy", version: appVersion } ) );
          else println( "BxCachy 0.11.0-dev" );
          break;
         case "doctor":
         case "prerequisites":
          println( "Workstation prerequisites: Java 21, BVM, MVM, BoxLang, MatchBox" );
          println( "Native build prerequisites: Rust and Cargo" );
          break;
         case "desktop-list":
         case "tui-list":
         case "web-list":
         case "optional-list":
         case "profile-list":
          if ( p.len() != 1 ) {
           println( "Usage: bxcachy " & cmd & " [--json]" );
           CLIExit( 2 );
          }
          pk = new bxcachy.Packages( cli, catalog.load() );
          CLIExit( cmd == "profile-list" ? pk.profiles( asJson ) : pk.listApps( cmd, asJson ) );
          break;
         case "apps-doctor":
          println( "Base packages (pacman first):" );
          for ( var pkg in base ) println( pkg );
          break;
         case "plan":
         case "install-plan":
         case "optional-plan":
         case "profile-plan":
         case "profile-install-plan":
          // Selection comes from the arguments and flags; the resolver decides, nothing is installed.
          pk = new bxcachy.Packages( cli, catalog.load() );
          planReq = pk.request( cmd, p, args.options );
          if ( planReq.bad ) {
           println( planReq.usage );
           CLIExit( 2 );
          }
          CLIExit( pk.plan( cmd, planReq.req, asJson ) );
          break;
         case "package-status":
         case "package-source":
          if ( p.len() != 2 || !reFind( "^[a-z0-9][a-z0-9-]*$", p[2] ) ) {
           println( "Usage: bxcachy " & cmd & " ID" );
           CLIExit( 2 );
          }
          pk = new bxcachy.Packages( cli, catalog.load() );
          CLIExit( cmd == "package-status" ? pk.status( p[2], asJson ) : pk.source( p[2], asJson ) );
          break;
         case "dev-plan":
          println( "Java: jdk21-openjdk via pacman" );
          println( "Maven: maven via pacman" );
          println( "Gradle: gradle via pacman" );
          println( "BVM: https://install-bvm.boxlang.io" );
          println( "MVM: https://raw.githubusercontent.com/ortus-boxlang/matchbox-quick-installer/main/install/install.sh" );
          break;
         case "install":
         case "optional-install":
         case "profile-install":
          // Selection as for plan; the installer runs it. Without --yes the plan is printed and nothing changes.
          pk = new bxcachy.Packages( cli, catalog.load() );
          instReq = pk.request( cmd, p, args.options );
          if ( instReq.bad ) {
           println( instReq.usage );
           CLIExit( 2 );
          }
          CLIExit( pk.install( cmd, instReq.req, asJson, structKeyExists( args.options, "yes" ), structKeyExists( args.options, "dry-run" ) ) );
          break;
         case "catalog":
          catVerb = p.len() >= 2 ? p[2] : "";
          catArg = p.len() >= 3 ? p[3] : "";
          catBad = p.len() > 3 || !arrayFind( [ "list", "show", "groups", "check", "version" ], catVerb ) || ( catVerb == "show" && p.len() != 3 ) || ( catVerb != "show" && p.len() > 2 );
          catOpts = [ "json", "group", "category", "tier", "kind", "source" ];
          for ( var o in args.options ) if ( !arrayFind( catOpts, o ) && !arrayFind( [ "yes", "dry-run", "force", "quiet" ], o ) ) catBad = true;
          if ( catBad ) {
           println( "Usage: bxcachy catalog list [--group=G] [--category=C] [--tier=default|optional] [--kind=K] [--source=S] [--json] | show ID | groups | check | version" );
           CLIExit( 2 );
          }
          cat = catalog.load();
          if ( catVerb == "version" ) {
           if ( asJson ) println( cli.envelope( "catalog version", 0, { catalog_version: cat.catalog_version, schema: cat.schema, apps: cat.apps.len() } ) );
           else println( "catalog " & cat.catalog_version & " (schema " & cat.schema & ", " & cat.apps.len() & " apps)" );
           break;
          }
          if ( catVerb == "groups" ) {
           rows = [];
           for ( var g in cat.groups ) {
            cs = cat.categories.filter( function( c ) { return c.group == g.id; } ).map( function( c ) { return c.title; } );
            n = cat.apps.filter( function( a ) { return a.group == g.id; } ).len();
            rows.append( { id: g.id, title: g.title, blurb: g.blurb, order: g.order, apps: n, categories: cs } );
           }
           if ( asJson ) println( cli.envelope( "catalog groups", 0, rows ) );
           else for ( var r in rows ) println( r.id & ": " & r.title & " (" & r.apps & " apps) - " & r.categories.toList( ", " ) );
           break;
          }
          if ( catVerb == "show" ) {
           found = catalog.find( cat, catArg );
           if ( structIsEmpty( found ) ) {
            println( "Unknown catalog id: " & catArg );
            CLIExit( 3 );
           }
           if ( asJson ) {
            println( cli.envelope( "catalog show", 0, found ) );
           } else {
            println( found.name & " (" & found.id & ")" );
            println( found.description );
            println( "group: " & found.group & "/" & found.category & "  tier: " & found.tier & "  kind: " & found.kind );
            println( "source: " & found.source & ( structKeyExists( found, "targets" ) ? "  targets: " & found.targets.toList( " " ) : "" ) & ( structKeyExists( found, "url" ) ? "  url: " & found.url : "" ) );
            if ( structKeyExists( found, "homepage" ) ) println( "homepage: " & found.homepage );
            if ( !isNull( found.macos ) ) println( "macOS: " & found.macos );
            if ( structKeyExists( found, "note" ) ) println( "note: " & found.note );
           }
           break;
          }
          if ( catVerb == "check" ) {
           res = catalog.check( cat );
           code = res.errors.len() ? 1 : 0;
           if ( asJson ) {
            println( cli.envelope( "catalog check", code, res ) );
           } else {
            for ( var e in res.errors ) println( "error: " & e );
            for ( var w in res.warnings ) println( "warning: " & w );
            println( "catalog check: " & res.errors.len() & " errors, " & res.warnings.len() & " warnings, " & cat.apps.len() & " apps" );
           }
           CLIExit( code );
          }
          // list
          sel = cat.apps.filter( function( a ) {
           if ( structKeyExists( args.options, "group" ) && a.group != args.options.group ) return false;
           if ( structKeyExists( args.options, "category" ) && a.category != args.options.category ) return false;
           if ( structKeyExists( args.options, "tier" ) && a.tier != args.options.tier ) return false;
           if ( structKeyExists( args.options, "kind" ) && a.kind != args.options.kind ) return false;
           if ( structKeyExists( args.options, "source" ) && a.source != args.options.source ) return false;
           return true;
          } );
          if ( asJson ) println( cli.envelope( "catalog list", 0, sel ) );
          else for ( var a in sel ) println( catalog.row( a ) );
          break;
         case "config":
          cfgVerb = p.len() >= 2 ? p[2] : "";
          cfgName = p.len() >= 3 ? p[3] : "";
          cfgBad = !len( getSystemSetting( "HOME", "" ) ) || p.len() > 4 || ( p.len() == 4 && cfgVerb != "restore" ) || !arrayFind( [ "list", "diff", "apply", "restore", "history" ], cfgVerb );
          if ( cfgBad ) {
           println( "Usage: bxcachy config list|diff NAME|apply NAME|restore NAME ID|history [NAME] [--yes] [--dry-run] [--force] [--json]" );
           CLIExit( 2 );
          }
          yes = structKeyExists( args.options, "yes" );
          dryRun = structKeyExists( args.options, "dry-run" );
          force = structKeyExists( args.options, "force" );
          nl = chr( 10 );
          var managed = { "bxcachy": { name: "bxcachy", target: config.cfgHome() & "/bxcachy/bxcachy.json", mode: "600", content: '{' & nl & '  "schema_version": 1,' & nl & '  "desktop": "auto"' & nl & '}' & nl } };
          if ( cfgVerb == "list" || cfgVerb == "history" ) {
           rows = [];
           if ( cfgVerb == "list" ) {
            for ( var key in managed ) rows.append( { name: key, target: managed[key].target, state: config.configState( managed[key] ) } );
           } else {
            rows = config.journalEntries( cfgName );
           }
           if ( asJson ) {
            println( jsonSerialize( rows ) );
           } else if ( cfgVerb == "list" ) {
            for ( var r in rows ) println( r.name & ": " & r.state & " (" & r.target & ")" );
           } else {
            for ( var r in rows ) println( r.id & " " & r.action & " " & r.name & " " & r.time );
            if ( !rows.len() ) println( "No history." );
           }
           break;
          }
          if ( !structKeyExists( managed, cfgName ) ) {
           println( "Unknown managed config: " & cfgName );
           CLIExit( 2 );
          }
          entry = managed[cfgName];
          if ( cfgVerb == "diff" ) {
           st = config.configState( entry );
           println( cfgName & ": " & st );
           if ( st == "outdated" || st == "drifted" ) {
            tmpSrc = getTempDirectory() & "/bxcachy-src-" & left( createUUID(), 8 );
            fileWrite( tmpSrc, entry.content );
            d = systemExecute( "diff", [ "-u", entry.target, tmpSrc ], 15, true );
            println( d.output );
            fileDelete( tmpSrc );
           }
           break;
          }
          if ( cfgVerb == "apply" ) {
           CLIExit( config.configApply( entry, yes, dryRun, force ) );
          }
          if ( p.len() != 4 ) {
           println( "Usage: bxcachy config restore NAME ID --yes" );
           CLIExit( 2 );
          }
          CLIExit( config.configRestore( entry, p[4], yes, dryRun ) );
          break;
         case "help":
          println( "BxCachy commands: version, doctor, prerequisites, desktop-list, tui-list, web-list, optional-list, optional-plan, profile-list, profile-plan, profile-install-plan, install-plan, package-status, package-source, profile-install, optional-install, install, plan, apps-doctor, dev-plan, config, catalog, help" );
          break;
         default:
          println( "Unsupported command: " & cmd );
          println( "Run bxcachy help" );
        }
    }

}
