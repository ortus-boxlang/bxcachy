// Application listener for the bxrig CLI (BoxLang Application.bx; MatchBox PR #154).
class {

    this.name = "bxrig";
    this.mappings = { "/bxrig": getDirectoryFromPath( getCurrentTemplatePath() ) & "bxrig" };

    // An unexpected error is an internal error: exit code 9 (docs/architecture/COMMAND-CONTRACT.md section 3).
    function onError( exception, eventName ) {
        println( "bxrig: internal error: " & exception.message );
        CLIExit( 9 );
        return true;
    }

}
