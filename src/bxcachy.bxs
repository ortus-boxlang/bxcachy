// BxCachy native CLI. BoxLang source compiled with MatchBox.
// Read-only commands never modify the workstation.
args = CLIGetArgs();
p = args.positionals;
cmd = p.len() ? p[1] : "help";
appVersion = "0.11.0-dev";
asJson = structKeyExists( args.options, "json" );
// One shared flag check for every command: unknown flags are usage errors and nothing runs.
for ( flag in args.options ) {
 if ( !arrayFind( [ "yes", "dry-run", "force", "json", "quiet", "group", "category", "tier", "kind", "source" ], flag ) ) {
  println( "Unknown option: --" & flag );
  CLIExit( 2 );
 }
}
base = [ "localsend", "mpv", "pacseek" ];
desktop = { localsend: "localsend", mpv: "mpv", obs: "obs-studio", kdenlive: "kdenlive", pinta: "pinta", chromium: "chromium", obsidian: "obsidian", libreoffice: "libreoffice-fresh" };
tui = { lazygit: "lazygit", btop: "btop", neovim: "neovim", pacseek: "pacseek", yazi: "yazi" };
optional = { obs: "obs-studio", kdenlive: "kdenlive", pinta: "pinta", chromium: "chromium", obsidian: "obsidian", libreoffice: "libreoffice-fresh" };
web = { github: "https://github.com", "boxlang-docs": "https://boxlang.ortusbooks.com", youtube: "https://youtube.com" };

// --json: one JSON object on stdout, nothing else (docs/architecture/COMMAND-CONTRACT.md section 4).
function envelope( command, exitCode, data ) {
 return jsonSerialize( { schema: 1, command: command, version: "0.11.0-dev", ok: exitCode == 0, exit: exitCode, dry_run: false, data: data, warnings: [] } );
}
// Prints a key/value listing as lines, or as the JSON envelope with --json.
function emitMap( command, asJson, map, suffix ) {
 if ( asJson ) {
  println( envelope( command, 0, map ) );
  return;
 }
 for ( key in map ) println( key & ": " & map[key] & suffix );
}
