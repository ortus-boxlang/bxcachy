:"monologue","name":"Monologue","description":"A simple, theme-synced webcam recorder for Omarchy","description_source":"pkgbuild","kind":"desktop","group":"media","category":"Media","tier":"optional","source":"pkgbuild","targets":["monologue"],"pkgbuild":{"repo":"omacom/omarchy-pkgs","path":"pkgbuilds/monologue","ref":"master"},"homepage":"https://github.com/omacom/monologue","macos":"Photo Booth","origin":["omarchy-desktop"],"note":"Build from the Omarchy PKGBUILD (omacom/omarchy-pkgs)","verified_on":"2026-11-09"},{"id":"obs","name":"OBS Studio","description":"Free, open source software for live streaming and recording","description_source":"arch","kind":"desktop","group":"media","category":"Media","tier":"optional","source":"pacman","targets":["obs-studio"],"repo":"extra","homepage":"https://obsproject.com","macos":"ScreenFlow / QuickTime","verified_on":"2026-11-09"},{"id":"omacut","name":"Omacut","description":"Dead-simple video length trimmer built with Qt Quick and ffmpeg","description_source":"pkgbuild","kind":"desktop","group":"media","category":"Media","tier":"optional","source":"pkgbuild","targets":["omacut"],"pkgbuild":{"repo":"omacom/omarchy-pkgs","path":"pkgbuilds/omacut","ref":"master"},"homepage":"https://github.com/omacom/omacut","macos":"QuickTime trim","origin":["omarchy-desktop"],"note":"Build from the Omarchy PKGBUILD (omacom/omarchy-pkgs)","verified_on":"2026-11-09"},{"id":"omareel","name":"Omareel","description":"Screen recorder and editor for Omarchy with a synthetic cursor, auto zooms, and a camera bubble","description_source":"pkgbuild","kind":"desktop","group":"media","category":"Media","tier":"optional","source":"pkgbuild","targets":["omareel"],"pkgbuild":{"repo":"omacom/omarchy-pkgs","path":"pkgbuilds/omareel","ref":"master"},"homepage":"https://github.com/omacom/omareel","macos":"ScreenFlow","origin":["omarchy-desktop"],"note":"Build from the Omarchy PKGBUILD (omacom/omarchy-pkgs)","verified_on":"2026-11-09"},{"id":"yt-dlp","name":"yt-dl