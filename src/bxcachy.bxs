// END GENERATED CATALOG
function catalogLoad() {
 return jsonDeserialize( catalogJson() );
}
function catalogFind( cat, id ) {
 for ( a in cat.apps ) if ( a.id == id ) return a;
 return {};
}
// Offline validation: returns { errors: [], warnings: [] }.
function catalogCheck( cat ) {
 errors = []; warnings = []; unpinned = 0;
 if ( cat.schema != 3 ) errors.append( "schema must be 3, found " & cat.schema );
 groupIds = cat.groups.map( function( g ) { return g.id; } );
 pairs = cat.categories.map( function( c ) { return c.group & "/" & c.title; } );
 seen = {};
 for ( a in cat.apps ) {
  who = a.id;
  if ( structKeyExists( seen, a.id ) ) errors.append( who & ": duplicate id" );
  seen[a.id] = true;
  if ( !reFind( "^[a-z0-9][a-z0-9-]*$", a.id ) ) errors.append( who & ": id must be lowercase letters, digits and dashes" );
  if ( !arrayFind( [ "desktop", "tui", "web" ], a.kind ) ) errors.append( who & ": unknown kind " & a.kind );
  if ( !arrayFind( [ "default", "optional" ], a.tier ) ) errors.append( who & ": unknown tier " & a.tier );
  if ( !arrayFind( [ "pacman", "aur", "pkgbuild", "web", "script", "unresolved" ], a.source ) ) errors.append( who & ": unknown source " & a.source );
  if ( !arrayFind( groupIds, a.group ) ) errors.append( who & ": unknown group " & a.group );
  else if ( !arrayFind( pairs, a.group & "/" & a.category ) ) errors.append( who & ": category " & a.category & " is not in group " & a.group );
  if ( !structKeyExists( a, "description" ) || !len( a.description ) ) errors.append( who & ": missing description" );
  if ( arrayFind( [ "pacman", "aur", "pkgbuild", "unresolved" ], a.source ) ) {
   if ( !structKeyExists( a, "targets" ) || !a.targets.len() ) errors.append( who & ": " & a.source & " needs targets" );
   else for ( t in a.targets ) if ( !reFind( "^[a-zA-Z0-9@._+-]+$", t ) ) errors.append( who & ": unsafe package name " & t );
  }
  if ( a.source == "web" ) {
   if ( !structKeyExists( a, "url" ) || !reFind( "^https://[^/@\s]+(/\S*)?$", a.url ) ) errors.append( who & ": web url must be https without credentials" );
  }
  if ( a.source == "pkgbuild" ) {
   if ( !structKeyExists( a, "pkgbuild" ) || !structKeyExists( a.pkgbuild, "repo" ) || !structKeyExists( a.pkgbuild, "path" ) || !structKeyExists( a.pkgbuild, "ref" ) ) errors.append( who & ": pkgbuild needs repo, path and ref" );
   else if ( a.pkgbuild.ref == "master" || a.pkgbuild.ref == "main" ) unpinned++;
  }
  if ( a.source == "unresolved" && a.tier == "default" ) warnings.append( who & ": default entry has no installable package yet" );
 }
 if ( unpinned ) warnings.append( unpinned & " pkgbuild entries use a branch ref; pin them to commits before an installer builds them" );
 return { errors: errors, warnings: warnings };
}
function catalogRow( a ) {
 return a.id & "  [" & a.tier & "]  " & a.group & "/" & a.category & "  " & a.name;
}

// ---- config service (plain BoxLang + a little OS: mkdir lock, stat) ----
function cfgHome() {
 return getSystemSetting( "BXCACHY_CONFIG_HOME", getSystemSetting( "HOME", "" ) & "/.config" );
}
function stateDir() {
 return getSystemSetting( "BXCACHY_STATE_HOME", getSystemSetting( "HOME", "" ) & "/.local/state" ) & "/bxcachy";
}
function pathKind( path ) {
 if ( fileExists( path ) || directoryExists( path ) ) {
  info = getFileInfo( path );
  if ( info.is_symlink ) return "link";
  if ( info.is_file ) return "file";
  return "other";
 }
 try {
  info = getFileInfo( path );
  if ( info.is_symlink ) return "link";
 } catch ( any e ) {
 }
 return "none";
}
function hashOf( text ) {
 return lCase( hash( text, "SHA-256" ) );
}
function fileHashOf( path ) {
 return hashOf( fileRead( path ) );
}
function nowText() {
 return dateTimeFormat( now(), "yyyy-MM-dd'T'HH:mm:ss" );
}
function modeOf( path ) {
 r = systemExecute( "stat", [ "-c", "%a", path ], 10, true );
 return r.exitCode == 0 ? trim( r.output ) : "";
}
function journalEntries( name ) {
 dir = stateDir() & "/journal";
 out = [];
 if ( !directoryExists( dir ) ) return out;
 names = directoryList( dir, false, "name" );
 arraySort( names, "text", "desc" );
 for ( n in names ) {
  if ( !reFind( "\.json$", n ) ) continue;
  e = jsonDeserialize( fileRead( dir & "/" & n ) );
  if ( !len( name ) || e.name == name ) out.append( e );
 }
 return out;
}
function configState( entry ) {
 kind = pathKind( entry.target );
 if ( kind == "none" ) return "missing";
 if ( kind != "file" ) return "blocked";
 current = fileHashOf( entry.target );
 if ( current == hashOf( entry.content ) ) return "clean";
 last = journalEntries( entry.name );
 if ( last.len() && last[1].after == current ) return "outdated";
 return "drifted";
}
function writeAtomic( target, content, mode ) {
 directoryCreate( getDirectoryFromPath( target ), true, true );
 tmp = target & ".bxcachy-" & left( createUUID(), 8 ) & ".tmp";
 fileWriteExclusive( tmp, content, mode );
 fileMove( tmp, target );
}
function lockTake() {
 directoryCreate( stateDir(), true, true );
 try {
  fileWriteExclusive( stateDir() & "/lock", nowText(), "600" );
 } catch ( any e ) {
  return false;
 }
 return true;
}
function lockDrop() {
 if ( fileExists( stateDir() & "/lock" ) ) fileDelete( stateDir() & "/lock" );
}
function recordJournal( entry, action, before, backup, after ) {
 id = dateTimeFormat( now(), "yyyyMMdd'T'HHmmssSSS" ) & "-" & left( createUUID(), 8 );
 directoryCreate( stateDir() & "/journal", true, true );
 rec = { id: id, action: action, name: entry.name, target: entry.target, time: nowText(), before: before, after: after, backup: backup };
 fileWriteExclusive( stateDir() & "/journal/" & id & ".json", jsonSerialize( rec ), "600" );
 return id;
}
function pruneHistory( name ) {
 all = journalEntries( name );
 for ( i = 21; i <= all.len(); i++ ) {
  if ( len( all[i].backup ) && fileExists( all[i].backup ) ) fileDelete( all[i].backup );
  fileDelete( stateDir() & "/journal/" & all[i].id & ".json" );
 }
}
function takeBackup( entry ) {
 if ( pathKind( entry.target ) == "none" ) return "";
 dir = stateDir() & "/backups/" & entry.name;
 directoryCreate( dir, true, true );
 dest = dir & "/" & dateTimeFormat( now(), "yyyyMMdd'T'HHmmssSSS" ) & "-" & left( createUUID(), 8 ) & ".bak";
 fileCopy( entry.target, dest );
 fileSetAccessMode( dest, "600" );
 return dest;
}
// Shared by apply and restore. Returns an exit code, never exits itself.
function configWrite( entry, content, action, yes, dryRun ) {
 kind = pathKind( entry.target );
 if ( kind == "link" || kind == "other" ) {
  println( entry.name & ": refusing to write, target is a symlink or special file: " & entry.target );
  return 8;
 }
 println( action & " " & entry.name & " -> " & entry.target );
 if ( !yes ) {
  println( "Nothing changed. Pass --yes to proceed." );
  return 2;
 }
 if ( dryRun ) {
  println( "Dry run, nothing changed." );
  return 0;
 }
 if ( !lockTake() ) {
  println( "Another BxCachy run holds the lock: " & stateDir() & "/lock (a file; remove it if no run is active)" );
  return 8;
 }
 code = 0;
 try {
  before = kind == "file" ? fileHashOf( entry.target ) : "";
  backup = takeBackup( entry );
  writeAtomic( entry.target, content, entry.mode );
  after = fileHashOf( entry.target );
  if ( after != hashOf( content ) ) {
   println( entry.name & ": verification failed after write" );
   code = 9;
  } else {
   if ( modeOf( entry.target ) != entry.mode ) println( "warning: mode is " & modeOf( entry.target ) & ", expected " & entry.mode );
   id = recordJournal( entry, action, before, backup, after );
   pruneHistory( entry.name );
   println( entry.name & ": " & action & " done (journal " & id & ")" );
  }
 } catch ( any e ) {
  println( entry.name & ": failed: " & e.message );
  code = 9;
 }
 lockDrop();
 return code;
}
function configApply( entry, yes, dryRun, force ) {
 st = configState( entry );
 if ( st == "blocked" ) return configWrite( entry, entry.content, "apply", yes, dryRun );
 if ( st == "clean" ) {
  println( entry.name & ": unchanged" );
  return 0;
 }
 if ( st == "drifted" && !force ) {
  println( entry.name & ": target was changed outside BxCachy. Run 'config diff " & entry.name & "', then --force to overwrite (a backup is kept)." );
  return 8;
 }
 return configWrite( entry, entry.content, "apply", yes, dryRun );
}
function configRestore( entry, id, yes, dryRun ) {
 found = journalEntries( entry.name ).filter( function( e ) { return e.id == id; } );
 if ( !found.len() ) {
  println( "Unknown journal id for " & entry.name & ": " & id );
  return 3;
 }
 rec = found[1];
 if ( !len( rec.backup ) || !fileExists( rec.backup ) ) {
  println( id & ": no backup to restore (the file did not exist before, or the backup was pruned)" );
  return 3;
 }
 old = fileRead( rec.backup );
 if ( hashOf( old ) != rec.before ) {
  println( id & ": backup does not match its recorded hash, refusing" );
  return 8;
 }
 return configWrite( entry, old, "restore", yes, dryRun );
}

switch ( cmd ) {
 case "version":
  if ( asJson ) println( envelope( "version", 0, { name: "BxCachy", version: appVersion } ) );
  else println( "BxCachy 0.11.0-dev" );
  break;
 case "doctor":
 case "prerequisites":
  println( "Workstation prerequisites: Java 21, BVM, MVM, BoxLang, MatchBox" );
  println( "Native build prerequisites: Rust and Cargo" );
  break;
 case "desktop-list":
  emitMap( "desktop-list", asJson, desktop, "" );
  break;
 case "tui-list":
  emitMap( "tui-list", asJson, tui, "" );
  break;
 case "web-list":
  emitMap( "web-list", asJson, web, "" );
  break;
 case "optional-list":
  emitMap( "optional-list", asJson, optional, " (optional)" );
  break;
 case "plan":
 case "apps-doctor":
  println( "Base packages (pacman first):" );
  for ( pkg in base ) println( pkg );
  break;
 case "optional-plan":
  if ( p.len() < 2 ) {
   println( "Usage: bxcachy optional-plan NAME [NAME...]" );
   break;
  }
  println( "Optional packages (pacman-first plan):" );
  for ( i = 2; i <= p.len(); i++ ) {
   name = p[i];
   if ( structKeyExists( optional, name ) ) {
    println( name & ": " & optional[name] );
   } else {
    println( "Unknown optional application: " & name );
   }
  }
  break;
 case "package-status":
  if ( p.len() != 2 || !reFind( "^[a-zA-Z0-9@._+-]+$", p[2] ) ) {
   println( "Usage: bxcachy package-status PACKAGE" );
   CLIExit( 2 );
  }
  result = systemExecute( name = "pacman", arguments = "-Qq " & p[2], timeout = 15, terminateOnTimeout = true );
  if ( result.timeout ) {
   println( p[2] & ": package check timed out" );
   CLIExit( 3 );
  }
  if ( result.exitCode == 0 ) {
   println( p[2] & ": installed" );
  } else {
   println( p[2] & ": missing or pacman unavailable" );
   CLIExit( 1 );
  }
  break;
 case "package-source":
  if ( p.len() != 2 || !reFind( "^[a-zA-Z0-9@._+-]+$", p[2] ) ) {
   println( "Usage: bxcachy package-source PACKAGE" );
   CLIExit( 2 );
  }
  packageName = p[2];
  installedCheck = systemExecute( name = "pacman", arguments = "-Qq " & packageName, timeout = 15, terminateOnTimeout = true );
  if ( installedCheck.timeout ) {
   println( packageName & ": installed-package check timed out" );
   CLIExit( 3 );
  }
  if ( installedCheck.exitCode == 0 ) {
   println( packageName & ": installed" );
   break;
  }
  officialCheck = systemExecute( name = "pacman", arguments = "-Si " & packageName, timeout = 15, terminateOnTimeout = true );
  if ( officialCheck.timeout ) {
   println( packageName & ": official repository check timed out" );
   CLIExit( 3 );
  }
  if ( officialCheck.exitCode == 0 ) {
   println( packageName & ": pacman" );
   break;
  }
  aurCheck = systemExecute( name = "yay", arguments = "-Si " & packageName, timeout = 15, terminateOnTimeout = true );
  if ( aurCheck.timeout ) {
   println( packageName & ": AUR repository check timed out" );
   CLIExit( 3 );
  }
  if ( aurCheck.exitCode == 0 ) {
   println( packageName & ": yay" );
  } else {
   println( packageName & ": unavailable" );
   CLIExit( 1 );
  }
  break;
 case "install-plan":
  println( "Base installation plan (pacman first, yay fallback):" );
  for ( pkg in base ) println( pkg );
  println( "No packages installed. Run the tested package adapter to apply this plan." );
  break;
 case "profile-install-plan":
  if ( p.len() != 2 ) {
   println( "Usage: bxcachy profile-install-plan core|jvm|containers|terminal" );
   break;
  }
  switch ( p[2] ) {
   case "core": println( "git curl jq unzip" ); break;
   case "jvm": println( "jdk21-openjdk maven gradle" ); break;
   case "containers": println( "podman buildah skopeo" ); break;
   case "terminal": println( "btop neovim lazygit yazi" ); break;
   default: println( "Unknown profile: " & p[2] );
  }
  println( "Read-only plan; no packages installed." );
  break;
 case "profile-list":
  profileMap = { core: "git curl jq unzip", jvm: "jdk21-openjdk maven gradle", containers: "podman buildah skopeo", terminal: "btop neovim lazygit yazi" };
  if ( asJson ) {
   println( envelope( "profile-list", 0, profileMap ) );
  } else {
   println( "Available workstation profiles:" );
   emitMap( "profile-list", false, profileMap, "" );
  }
  break;
 case "profile-plan":
  if ( p.len() != 2 ) {
   println( "Usage: bxcachy profile-plan core|jvm|containers|terminal" );
   break;
  }
  profile = p[2];
  switch ( profile ) {
   case "core": println( "git curl jq unzip" ); break;
   case "jvm": println( "jdk21-openjdk maven gradle" ); break;
   case "containers": println( "podman buildah skopeo" ); break;
   case "terminal": println( "btop neovim lazygit yazi" ); break;
   default: println( "Unknown profile: " & profile );
  }
  break;
 case "dev-plan":
  println( "Java: jdk21-openjdk via pacman" );
  println( "Maven: maven via pacman" );
  println( "Gradle: gradle via pacman" );
  println( "BVM: https://install-bvm.boxlang.io" );
  println( "MVM: https://raw.githubusercontent.com/ortus-boxlang/matchbox-quick-installer/main/install/install.sh" );
  break;
 case "install":
 case "optional-install":
 case "profile-install":
  // Resolve all packages before performing any mutation. Package names are
  // drawn exclusively from the internal catalog, never from raw user input.
  installPackages = [];
  valid = true;
  confirmed = structKeyExists( args.options, "yes" );
  if ( cmd == "install" ) {
   installPackages = base;
   if ( p.len() != 1 || !structKeyExists( args.options, "yes" ) ) valid = false;
  } else if ( cmd == "profile-install" ) {
   if ( p.len() != 2 || !structKeyExists( args.options, "yes" ) ) {
    valid = false;
   } else {
    switch ( p[2] ) {
     case "core": installPackages = [ "git", "curl", "jq", "unzip" ]; break;
     case "jvm": installPackages = [ "jdk21-openjdk", "maven", "gradle" ]; break;
     case "containers": installPackages = [ "podman", "buildah", "skopeo" ]; break;
     case "terminal": installPackages = [ "btop", "neovim", "lazygit", "yazi" ]; break;
     default: valid = false;
    }
   }
  } else {
   if ( p.len() < 2 || !structKeyExists( args.options, "yes" ) ) valid = false;
   for ( i = 2; i <= p.len(); i++ ) {
    if ( structKeyExists( optional, p[i] ) ) {
     installPackages.append( optional[p[i]] );
    } else {
     valid = false;
    }
   }
   if ( !confirmed || installPackages.len() == 0 ) valid = false;
  }
  if ( !valid ) {
   println( "Invalid installation request. Specify catalog names and --yes." );
   CLIExit( 2 );
  }
  officialPackages = [];
  aurPackages = [];
  unavailablePackages = [];
  for ( packageName in installPackages ) {
   installed = systemExecute( name = "pacman", arguments = "-Qq " & packageName, timeout = 15, terminateOnTimeout = true );
   if ( installed.timeout ) {
    println( "Package status timed out: " & packageName );
    CLIExit( 3 );
   }
   if ( installed.exitCode == 0 ) continue;
   official = systemExecute( name = "pacman", arguments = "-Si " & packageName, timeout = 15, terminateOnTimeout = true );
   if ( official.timeout ) {
    println( "Official repository lookup timed out: " & packageName );
    CLIExit( 3 );
   }
   if ( official.exitCode == 0 ) {
    officialPackages.append( packageName );
    continue;
   }
   aur = systemExecute( name = "yay", arguments = "-Si " & packageName, timeout = 15, terminateOnTimeout = true );
   if ( aur.timeout ) {
    println( "AUR repository lookup timed out: " & packageName );
    CLIExit( 3 );
   }
   if ( aur.exitCode == 0 ) aurPackages.append( packageName );
   else unavailablePackages.append( packageName );
  }
  if ( unavailablePackages.len() ) {
   println( "Unavailable packages: " & unavailablePackages.toList( ", " ) );
   println( "No packages installed." );
   CLIExit( 3 );
  }
  if ( aurPackages.len() ) {
   uidCheck = systemExecute( name = "id", arguments = "-u", timeout = 10, terminateOnTimeout = true );
   if ( uidCheck.exitCode != 0 || trim( uidCheck.output ) == "0" ) {
    println( "AUR installs require a non-root user. No packages installed." );
    CLIExit( 4 );
   }
  }
  if ( officialPackages.len() ) {
   officialInstall = systemExecute( name = "sudo", arguments = "pacman -S --needed --noconfirm " & officialPackages.toList( " " ), timeout = 1800, terminateOnTimeout = true );
   if ( officialInstall.timeout || officialInstall.exitCode != 0 ) {
    println( "pacman installation failed; AUR installation skipped." );
    CLIExit( 5 );
   }
  }
  if ( aurPackages.len() ) {
   aurInstall = systemExecute( name = "yay", arguments = "-S --needed --noconfirm " & aurPackages.toList( " " ), timeout = 1800, terminateOnTimeout = true );
   if ( aurInstall.timeout || aurInstall.exitCode != 0 ) {
    println( "yay installation failed." );
    CLIExit( 6 );
   }
  }
  println( "Installation completed." );
  break;
 case "catalog":
  catVerb = p.len() >= 2 ? p[2] : "";
  catArg = p.len() >= 3 ? p[3] : "";
  catBad = p.len() > 3 || !arrayFind( [ "list", "show", "groups", "check", "version" ], catVerb ) || ( catVerb == "show" && p.len() != 3 ) || ( catVerb != "show" && p.len() > 2 );
  catOpts = [ "json", "group", "category", "tier", "kind", "source" ];
  for ( o in args.options ) if ( !arrayFind( catOpts, o ) && !arrayFind( [ "yes", "dry-run", "force", "quiet" ], o ) ) catBad = true;
  if ( catBad ) {
   println( "Usage: bxcachy catalog list [--group=G] [--category=C] [--tier=default|optional] [--kind=K] [--source=S] [--json] | show ID | groups | check | version" );
   CLIExit( 2 );
  }
  cat = catalogLoad();
  if ( catVerb == "version" ) {
   if ( asJson ) println( envelope( "catalog version", 0, { catalog_version: cat.catalog_version, schema: cat.schema, apps: cat.apps.len() } ) );
   else println( "catalog " & cat.catalog_version & " (schema " & cat.schema & ", " & cat.apps.len() & " apps)" );
   break;
  }
  if ( catVerb == "groups" ) {
   rows = [];
   for ( g in cat.groups ) {
    cs = cat.categories.filter( function( c ) { return c.group == g.id; } ).map( function( c ) { return c.title; } );
    n = cat.apps.filter( function( a ) { return a.group == g.id; } ).len();
    rows.append( { id: g.id, title: g.title, blurb: g.blurb, order: g.order, apps: n, categories: cs } );
   }
   if ( asJson ) println( envelope( "catalog groups", 0, rows ) );
   else for ( r in rows ) println( r.id & ": " & r.title & " (" & r.apps & " apps) - " & r.categories.toList( ", " ) );
   break;
  }
  if ( catVerb == "show" ) {
   found = catalogFind( cat, catArg );
   if ( structIsEmpty( found ) ) {
    println( "Unknown catalog id: " & catArg );
    CLIExit( 3 );
   }
   if ( asJson ) {
    println( envelope( "catalog show", 0, found ) );
   } else {
    println( found.name & " (" & found.id & ")" );
    println( found.description );
    println( "group: " & found.group & "/" & found.category & "  tier: " & found.tier & "  kind: " & found.kind );
    println( "source: " & found.source & ( structKeyExists( found, "targets" ) ? "  targets: " & found.targets.toList( " " ) : "" ) & ( structKeyExists( found, "url" ) ? "  url: " & found.url : "" ) );
    if ( structKeyExists( found, "homepage" ) ) println( "homepage: " & found.homepage );
    if ( !isNull( found.macos ) ) println( "macOS: " & found.macos );
    if ( structKeyExists( found, "note" ) ) println( "note: " & found.note );
   }
   break;
  }
  if ( catVerb == "check" ) {
   res = catalogCheck( cat );
   code = res.errors.len() ? 1 : 0;
   if ( asJson ) {
    println( envelope( "catalog check", code, res ) );
   } else {
    for ( e in res.errors ) println( "error: " & e );
    for ( w in res.warnings ) println( "warning: " & w );
    println( "catalog check: " & res.errors.len() & " errors, " & res.warnings.len() & " warnings, " & cat.apps.len() & " apps" );
   }
   CLIExit( code );
  }
  // list
  sel = cat.apps.filter( function( a ) {
   if ( structKeyExists( args.options, "group" ) && a.group != args.options.group ) return false;
   if ( structKeyExists( args.options, "category" ) && a.category != args.options.category ) return false;
   if ( structKeyExists( args.options, "tier" ) && a.tier != args.options.tier ) return false;
   if ( structKeyExists( args.options, "kind" ) && a.kind != args.options.kind ) return false;
   if ( structKeyExists( args.options, "source" ) && a.source != args.options.source ) return false;
   return true;
  } );
  if ( asJson ) println( envelope( "catalog list", 0, sel ) );
  else for ( a in sel ) println( catalogRow( a ) );
  break;
 case "config":
  cfgVerb = p.len() >= 2 ? p[2] : "";
  cfgName = p.len() >= 3 ? p[3] : "";
  cfgBad = !len( getSystemSetting( "HOME", "" ) ) || p.len() > 4 || ( p.len() == 4 && cfgVerb != "restore" ) || !arrayFind( [ "list", "diff", "apply", "restore", "history" ], cfgVerb );
  if ( cfgBad ) {
   println( "Usage: bxcachy config list|diff NAME|apply NAME|restore NAME ID|history [NAME] [--yes] [--dry-run] [--force] [--json]" );
   CLIExit( 2 );
  }
  yes = structKeyExists( args.options, "yes" );
  dryRun = structKeyExists( args.options, "dry-run" );
  force = structKeyExists( args.options, "force" );
  nl = chr( 10 );
  managed = { bxcachy: { name: "bxcachy", target: cfgHome() & "/bxcachy/bxcachy.json", mode: "600", content: '{' & nl & '  "schema_version": 1,' & nl & '  "desktop": "auto"' & nl & '}' & nl } };
  if ( cfgVerb == "list" || cfgVerb == "history" ) {
   rows = [];
   if ( cfgVerb == "list" ) {
    for ( key in managed ) rows.append( { name: key, target: managed[key].target, state: configState( managed[key] ) } );
   } else {
    rows = journalEntries( cfgName );
   }
   if ( asJson ) {
    println( jsonSerialize( rows ) );
   } else if ( cfgVerb == "list" ) {
    for ( r in rows ) println( r.name & ": " & r.state & " (" & r.target & ")" );
   } else {
    for ( r in rows ) println( r.id & " " & r.action & " " & r.name & " " & r.time );
    if ( !rows.len() ) println( "No history." );
   }
   break;
  }
  if ( !structKeyExists( managed, cfgName ) ) {
   println( "Unknown managed config: " & cfgName );
   CLIExit( 2 );
  }
  entry = managed[cfgName];
  if ( cfgVerb == "diff" ) {
   st = configState( entry );
   println( cfgName & ": " & st );
   if ( st == "outdated" || st == "drifted" ) {
    tmpSrc = getTempDirectory() & "/bxcachy-src-" & left( createUUID(), 8 );
    fileWrite( tmpSrc, entry.content );
    d = systemExecute( "diff", [ "-u", entry.target, tmpSrc ], 15, true );
    println( d.output );
    fileDelete( tmpSrc );
   }
   break;
  }
  if ( cfgVerb == "apply" ) {
   CLIExit( configApply( entry, yes, dryRun, force ) );
  }
  if ( p.len() != 4 ) {
   println( "Usage: bxcachy config restore NAME ID --yes" );
   CLIExit( 2 );
  }
  CLIExit( configRestore( entry, p[4], yes, dryRun ) );
  break;
 case "help":
  println( "BxCachy commands: version, doctor, prerequisites, desktop-list, tui-list, web-list, optional-list, optional-plan, profile-list, profile-plan, profile-install-plan, install-plan, package-status, package-source, profile-install, optional-install, install, plan, apps-doctor, dev-plan, config, catalog, help" );
  break;
 default:
  println( "Unsupported command: " & cmd );
  println( "Run bxcachy help" );
}
