// Turns facts about the machine and a request into the ordered steps of `bxcachy setup`. Pure: no I/O.
//
//   plasma( facts, opts )      -> { target, errors: [ text ], warnings: [ text ], notes: [ text ], steps: [ step ] }
//   undoPlasma( facts )        -> same shape
//   hyprland( facts, opts )    -> same shape (packages only for now; configs and keys are the next slices)
//   undoHyprland( facts )      -> same shape
//   step = { id, title, kind: "pacman"|"git"|"hyprkwin", commands: [ argv... ] }
//
// facts: { isRoot, hasSudo, kwinVersion ("6.6.2" or ""), desktop (XDG_CURRENT_DESKTOP), sessionType (XDG_SESSION_TYPE),
//          installed (set of pacman package names), hyprkwinInstalled, workDir (temp dir for the HyprKwin checkout),
//          os ("cachyos"/"arch"/...), arch ("x86_64"), hasPacman, hyprlandAdded (packages a previous `setup hyprland` installed) }
// opts:  { keys: bool, undoKeys: bool }
//
// Errors are preconditions (exit 4): nothing runs when there is one. HyprKwin is taken from a pinned full commit.
class SetupPlan {
    // The pinned HyprKwin release (v1.2.0). Re-pin by resolving a new tag and checking `tools/` still has the scripts used below.
    function pins() {
        return { hyprkwin: { repo: "https://github.com/DGBooth/HyprKwin.git", tag: "v1.2.0", commit: "31abb63939111a811d1e356c693cda5dbe54ed69" } };
    }

    // Packages HyprKwin's helper scripts need (python-dbus, qdbus6 from qt6-tools, PyGObject for hyprkwinctl) and git for the checkout.
    function plasmaDeps() {
        return [ "git", "python-dbus", "python-gobject", "qt6-tools" ];
    }

    // Plasma versions HyprKwin is tested on: 6.6 and 6.8; 6.7 should work but is untested.
    function plasmaSupport( version ) {
        var parts = listToArray( version, "." );
        if ( parts.len() < 2 || parts[1] != "6" ) return "unsupported";
        if ( parts[2] == "6" || parts[2] == "8" ) return "tested";
        if ( parts[2] == "7" ) return "untested";
        return "unsupported";
    }

    // The two commands that check out HyprKwin at the pinned commit into `dir`.
    function fetchCommands( dir ) {
        var pin = pins().hyprkwin;
        return [
            [ "git", "clone", "--quiet", pin.repo, dir ],
            [ "git", "-C", dir, "checkout", "--quiet", pin.commit ]
        ];
    }

    // A command that runs a script of the HyprKwin checkout from its own directory, as the normal user.
    function inCheckout( dir, script ) {
        var argv = [ "env", "-C", dir ];
        for ( var a in script ) argv.append( a );
        return argv;
    }

    // Preconditions shared by every plasma request. Returns { errors, warnings }.
    function plasmaPreflight( facts ) {
        var out = { errors: [], warnings: [] };
        if ( facts.isRoot ) out.errors.append( "Run as a regular user; sudo is used only for the pacman step shown in the plan" );
        if ( !len( facts.kwinVersion ) ) out.errors.append( "KDE Plasma is not installed (kwin was not found)" );
        else {
            var support = plasmaSupport( facts.kwinVersion );
            if ( support == "unsupported" ) out.errors.append( "HyprKwin supports Plasma 6.6 and 6.8; found " & facts.kwinVersion );
            if ( support == "untested" ) out.warnings.append( "Plasma " & facts.kwinVersion & " should work but HyprKwin is no longer tested on 6.7" );
        }
        if ( findNoCase( "kde", facts.desktop ) > 0 && lCase( facts.sessionType ) == "x11" ) out.errors.append( "HyprKwin needs a Wayland session; this is an X11 session" );
        return out;
    }

    // The steps for `setup plasma`, `setup plasma --keys` and `setup plasma --undo-keys`.
    function plasma( facts, opts ) {
        var out = { target: "plasma", errors: [], warnings: [], notes: [], steps: [] };
        var pre = plasmaPreflight( facts );
        out.errors = pre.errors; out.warnings = pre.warnings;
        if ( ( opts.keys ?: false ) && ( opts.undoKeys ?: false ) ) out.errors.append( "Choose --keys or --undo-keys, not both" );
        if ( ( opts.undoKeys ?: false ) && !facts.hyprkwinInstalled ) out.errors.append( "HyprKwin is not installed, so there are no keys to hand back" );
        var missing = plasmaDeps().filter( function( p ) { return !structKeyExists( facts.installed, p ); } );
        if ( missing.len() && !facts.hasSudo ) out.errors.append( "sudo is required to install " & missing.toList( " " ) & " but was not found" );
        if ( out.errors.len() ) return out;

        if ( missing.len() ) {
            var pac = [ "sudo", "pacman", "-S", "--needed", "--noconfirm" ];
            for ( var m in missing ) pac.append( m );
            out.steps.append( { id: "packages", title: "install " & missing.toList( " " ), kind: "pacman", commands: [ pac ] } );
        }
        out.steps.append( { id: "fetch", title: "check out HyprKwin " & pins().hyprkwin.tag & " (commit " & left( pins().hyprkwin.commit, 7 ) & ")", kind: "git", commands: fetchCommands( facts.workDir ) } );
        if ( opts.undoKeys ?: false ) {
            out.steps.append( { id: "keys-restore", title: "give Plasma's keys back to their old owners", kind: "hyprkwin", commands: [ inCheckout( facts.workDir, [ "python3", "tools/hyprkwin-shortcuts.py", "restore" ] ) ] } );
            return out;
        }
        out.steps.append( { id: "install", title: facts.hyprkwinInstalled ? "update HyprKwin (backs up your shortcuts first, reloads the script)" : "install HyprKwin and its animations (backs up your shortcuts first)", kind: "hyprkwin", commands: [ inCheckout( facts.workDir, [ "tools/install.sh" ] ) ] } );
        if ( opts.keys ?: false ) {
            out.steps.append( { id: "keys-apply", title: "hand Plasma's clashing keys (Meta+Left, Meta+1...) to HyprKwin", kind: "hyprkwin", commands: [ inCheckout( facts.workDir, [ "python3", "tools/hyprkwin-shortcuts.py", "apply" ] ) ] } );
        } else {
            out.notes.append( "Plasma keeps its own shortcuts. Run `bxcachy setup plasma --keys` to hand the clashing ones to HyprKwin (backed up; --undo-keys restores them)." );
        }
        if ( !facts.hyprkwinInstalled ) out.notes.append( "Log out and back in once so KWin picks up the animations effect." );
        return out;
    }

    // The packages `setup hyprland` installs, one `pacman -S --needed` call. All are in the official Arch `extra` repo (and mirrored
    // by CachyOS). Noctalia is the native `noctalia` package, the one CachyOS's own meta-package depends on. Not used: the Quickshell
    // variant `noctalia-shell` + `noctalia-qs` (the fork conflicts with `quickshell`) and `cachyos-hypr-noctalia`, which provides
    // and conflicts with `cachyos-desktop-settings` and could remove it from a KDE install.
    function hyprlandPackages() {
        return [ "hyprland", "noctalia", "uwsm", "hyprlock", "hypridle", "xdg-desktop-portal-hyprland", "hyprpolkitagent",
                 "qt6ct", "nwg-look", "hyprpicker", "grim", "slurp", "wl-clipboard", "brightnessctl", "kitty",
                 "adw-gtk-theme", "noto-fonts", "noto-fonts-emoji" ];
    }

    // Preconditions for `setup hyprland`. Returns { errors, warnings }.
    function hyprlandPreflight( facts ) {
        var out = { errors: [], warnings: [] };
        if ( facts.isRoot ) out.errors.append( "Run as a regular user; sudo is used only for the pacman step shown in the plan" );
        if ( !facts.hasPacman ) out.errors.append( "BxCachy requires Arch Linux or CachyOS (pacman was not found)" );
        else if ( !arrayFind( [ "cachyos", "arch" ], facts.os ) ) out.errors.append( "Unsupported OS: " & ( len( facts.os ) ? facts.os : "unknown" ) & " (CachyOS and Arch Linux only)" );
        if ( facts.arch != "x86_64" ) out.errors.append( "Unsupported CPU: " & facts.arch & " (x86_64 only)" );
        if ( structKeyExists( facts.installed, "noctalia-shell" ) || structKeyExists( facts.installed, "noctalia-qs" ) ) {
            out.warnings.append( "noctalia-shell or noctalia-qs (the Quickshell variant of Noctalia) is installed; setup installs the native `noctalia` package and does not touch it" );
        }
        return out;
    }

    // The steps for `setup hyprland`: the missing packages in one sudo pacman call.
    function hyprland( facts, opts ) {
        var out = { target: "hyprland", errors: [], warnings: [], notes: [], steps: [], added: [] };
        var pre = hyprlandPreflight( facts );
        out.errors = pre.errors; out.warnings = pre.warnings;
        var missing = hyprlandPackages().filter( function( p ) { return !structKeyExists( facts.installed, p ); } );
        if ( missing.len() && !facts.hasSudo ) out.errors.append( "sudo is required to install packages but was not found" );
        if ( out.errors.len() ) return out;
        if ( !missing.len() ) {
            out.notes.append( "Hyprland and Noctalia are already installed; nothing to do." );
            return out;
        }
        var pac = [ "sudo", "pacman", "-S", "--needed", "--noconfirm" ];
        for ( var m in missing ) pac.append( m );
        out.steps.append( { id: "packages", title: "install " & missing.len() & " packages (" & missing.toList( " " ) & ")", kind: "pacman", commands: [ pac ] } );
        out.added = missing;
        out.notes.append( "Log out and pick Hyprland at the login screen. KDE Plasma is untouched. Configs, keybindings and Noctalia settings come with the next setup slices." );
        return out;
    }

    // The steps for `setup undo hyprland`: removes only the packages a previous `setup hyprland` installed (never ones that were already there).
    function undoHyprland( facts ) {
        var out = { target: "hyprland", errors: [], warnings: [], notes: [], steps: [] };
        if ( facts.isRoot ) out.errors.append( "Run as a regular user" );
        var still = facts.hyprlandAdded.filter( function( p ) { return structKeyExists( facts.installed, p ); } );
        if ( !facts.hyprlandAdded.len() ) out.errors.append( "setup hyprland has not installed anything on this machine, nothing to undo" );
        else if ( !still.len() ) out.errors.append( "The packages setup installed are already gone" );
        if ( still.len() && !facts.hasSudo ) out.errors.append( "sudo is required to remove packages but was not found" );
        if ( out.errors.len() ) return out;
        var rm = [ "sudo", "pacman", "-Rs", "--noconfirm" ];
        for ( var m in still ) rm.append( m );
        out.steps.append( { id: "remove", title: "remove " & still.len() & " packages that setup installed (" & still.toList( " " ) & ")", kind: "pacman", commands: [ rm ] } );
        out.notes.append( "pacman refuses to remove a package another package still needs; if that happens nothing is removed and its message is shown. KDE Plasma is untouched." );
        return out;
    }

    // The steps for `setup undo plasma`: HyprKwin's own uninstall, which puts every global shortcut back.
    function undoPlasma( facts ) {
        var out = { target: "plasma", errors: [], warnings: [], notes: [], steps: [] };
        if ( facts.isRoot ) out.errors.append( "Run as a regular user" );
        if ( !facts.hyprkwinInstalled ) out.errors.append( "HyprKwin is not installed, nothing to undo" );
        if ( out.errors.len() ) return out;
        out.steps.append( { id: "fetch", title: "check out HyprKwin " & pins().hyprkwin.tag & " (for its uninstall script)", kind: "git", commands: fetchCommands( facts.workDir ) } );
        out.steps.append( { id: "uninstall", title: "uninstall HyprKwin and put every global shortcut back", kind: "hyprkwin", commands: [ inCheckout( facts.workDir, [ "tools/uninstall.sh" ] ) ] } );
        return out;
    }

    // The udev rule that lets the `input` group use /dev/uinput (xremap needs it).
    function udevRulePath() {
        return "/etc/udev/rules.d/99-bxcachy-input.rules";
    }

    // The rule text (one line).
    function udevRule() {
        return 'KERNEL=="uinput", GROUP="input", TAG+="uaccess"';
    }

    // The AUR package for a build: "hypr" or "kde".
    function xremapPackage( build ) {
        return "xremap-" & build & "-bin";
    }

    // Which xremap build suits the running session: "hypr", "kde", or "" when it cannot tell.
    function xremapBuild( facts, opts ) {
        if ( len( opts.build ?: "" ) ) return opts.build;
        if ( findNoCase( "hyprland", facts.desktop ) > 0 ) return "hypr";
        if ( findNoCase( "kde", facts.desktop ) > 0 ) return "kde";
        return "";
    }

    // The steps for `setup xremap`: AUR package, input-device access, the shared config and user service.
    // facts used: isRoot hasSudo hasYay desktop installed user groups udevRule
    function xremap( facts, opts ) {
        var out = { target: "xremap", errors: [], warnings: [], notes: [], steps: [], added: { package: "", group: false, udev: false } };
        var build = xremapBuild( facts, opts );
        if ( facts.isRoot ) out.errors.append( "Run as a regular user; sudo is used only for the steps shown in the plan" );
        if ( !arrayFind( [ "hypr", "kde" ], build ) ) out.errors.append( "Cannot tell which xremap build to use (run inside Hyprland or Plasma, or pass --build hypr|kde)" );
        if ( !facts.hasSudo ) out.errors.append( "sudo is required (udev rule and input group) but was not found" );
        var pkg = len( build ) ? xremapPackage( build ) : "";
        var havePkg = len( pkg ) && structKeyExists( facts.installed, pkg );
        if ( len( pkg ) && !havePkg && !facts.hasYay ) out.errors.append( "yay is required to install " & pkg & " from the AUR but was not found" );
        if ( out.errors.len() ) return out;
        if ( !havePkg ) {
            out.steps.append( { id: "package", title: "install " & pkg & " (AUR)", kind: "aur", commands: [ [ "yay", "-S", "--needed", "--noconfirm", pkg ] ] } );
            out.added.package = pkg;
        }
        if ( !facts.udevRule ) {
            out.steps.append( { id: "udev", title: "let the input group use /dev/uinput (" & udevRulePath() & ")", kind: "sudo", commands: [
                [ "sudo", "sh", "-c", "echo '" & udevRule() & "' > " & udevRulePath() ],
                [ "sudo", "udevadm", "control", "--reload-rules" ],
                [ "sudo", "udevadm", "trigger" ] ] } );
            out.added.udev = true;
        }
        if ( !arrayFind( facts.groups, "input" ) ) {
            out.steps.append( { id: "group", title: "add " & facts.user & " to the input group", kind: "sudo", commands: [ [ "sudo", "gpasswd", "-a", facts.user, "input" ] ] } );
            out.added.group = true;
        }
        out.steps.append( { id: "config", title: "write the shared shortcut files (xremap config, Hyprland binds, systemd user unit, Plasma Log Out)", kind: "keys", commands: [] } );
        out.steps.append( { id: "service", title: "enable the xremap user service", kind: "systemd", commands: [ [ "systemctl", "--user", "daemon-reload" ], [ "systemctl", "--user", "enable", "xremap.service" ] ] } );
        out.notes.append( "Log out and back in once: the input group and the service take effect at the next login." );
        return out;
    }

    // The steps for `setup undo xremap`: stops and removes what `setup xremap` added (the group only if it added it).
    function undoXremap( facts, state ) {
        var out = { target: "xremap", errors: [], warnings: [], notes: [], steps: [] };
        if ( facts.isRoot ) out.errors.append( "Run as a regular user" );
        if ( !structKeyExists( state, "package" ) ) out.errors.append( "setup xremap has not run on this machine, nothing to undo" );
        if ( !facts.hasSudo ) out.errors.append( "sudo is required but was not found" );
        if ( out.errors.len() ) return out;
        out.steps.append( { id: "service", title: "stop and disable the xremap user service", kind: "systemd", commands: [ [ "systemctl", "--user", "disable", "--now", "xremap.service" ] ] } );
        if ( len( state.package ) && structKeyExists( facts.installed, state.package ) ) out.steps.append( { id: "package", title: "remove " & state.package, kind: "pacman", commands: [ [ "sudo", "pacman", "-Rs", "--noconfirm", state.package ] ] } );
        if ( state.udev ) out.steps.append( { id: "udev", title: "remove the udev rule", kind: "sudo", commands: [ [ "sudo", "rm", "-f", udevRulePath() ], [ "sudo", "udevadm", "control", "--reload-rules" ] ] } );
        if ( state.group ) out.steps.append( { id: "group", title: "remove " & facts.user & " from the input group", kind: "sudo", commands: [ [ "sudo", "gpasswd", "-d", facts.user, "input" ] ] } );
        out.notes.append( "The shortcut files stay (restore them with `config restore`). Log out and back in for the group change." );
        return out;
    }
}
