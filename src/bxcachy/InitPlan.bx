// `bxcachy init`: turns the wizard's answers into an ordered list of ordinary commands. Pure (no files, no processes), so it
// is unit tested. Every answer is optional: a missing answer adds no step, and nothing runs that the user did not choose.
//
// A step is { id, title, argv }. argv is an argument array; argv[1] "bxcachy" means this program (the executor swaps in its own
// path and adds --yes). Answers that no command applies yet are listed in `pending`, so nothing is silently dropped.
class InitPlan {
    // Answer keys that are saved but have no command behind them yet.
    function pendingKeys() {
        return [];
    }

    // Answers that shape the Hyprland starter (applied by `setup hyprland`; pending when Hyprland is not being set up).
    function hyprlandKeys() {
        return [ "workspaces", "natural_scroll", "layouts", "theme", "wallpaper" ];
    }

    // The value of an answer, or a fallback when it was not answered.
    function pick( answers, key, fallback = "" ) {
        return structKeyExists( arguments.answers, arguments.key ) ? arguments.answers[ arguments.key ] : arguments.fallback;
    }

    // A truthy "set" answer: a non-empty array, a non-empty string other than "none", or true.
    function isSet( value ) {
        if ( isArray( arguments.value ) ) return arguments.value.len() > 0;
        var text = toString( arguments.value );
        return len( text ) > 0 && text != "none" && text != "false" && text != "no" && text != "0";
    }

    // The session the login screen should preselect: follows the desktop choice, and `both` uses login_session.
    function session( answers ) {
        var desktops = pick( arguments.answers, "desktops" );
        if ( desktops == "hyprland" ) return "hyprland";
        if ( desktops == "plasma" ) return "plasma";
        if ( desktops == "both" ) return pick( arguments.answers, "login_session", "hyprland" );
        return "";
    }

    // Whether an app may be installed for the chosen desktop(s): apps with a `shells` list are for those desktops only. shellMap is
    // id -> shells array (from the catalog); an unknown id or empty list means any desktop.
    function shellOk( id, desktops, shellMap ) {
        if ( !structKeyExists( arguments.shellMap, arguments.id ) || !arguments.shellMap[ arguments.id ].len() ) return true;
        if ( arguments.desktops == "hyprland" ) return arrayFind( arguments.shellMap[ arguments.id ], "hyprland" ) > 0;
        if ( arguments.desktops == "plasma" ) return arrayFind( arguments.shellMap[ arguments.id ], "plasma" ) > 0;
        return true;
    }

    // The plan: { steps, pending, errors }. shellMap (optional): catalog app id -> its shells, to keep desktop-specific apps off
    // the other desktop when "customize" picked them.
    function plan( answers, shellMap = {} ) {
        var a = arguments.answers;
        var out = { steps: [], pending: [], errors: [] };
        var desktops = pick( a, "desktops" );
        if ( len( desktops ) && !arrayFind( [ "hyprland", "plasma", "both" ], desktops ) ) out.errors.append( "desktops: unknown value " & desktops );
        var terminal = pick( a, "terminal" );
        var layout = pick( a, "layout" );
        var wantsHypr = desktops == "hyprland" || desktops == "both";
        var wantsPlasma = desktops == "plasma" || desktops == "both";
        if ( wantsHypr ) {
            var argv = [ "bxcachy", "setup", "hyprland" ];
            if ( len( terminal ) ) argv.append( "--terminal=" & terminal );
            if ( len( layout ) ) argv.append( "--layout=" & layout );
            if ( structKeyExists( a, "workspaces" ) ) argv.append( "--workspaces=" & a.workspaces );
            if ( isSet( pick( a, "natural_scroll", false ) ) ) argv.append( "--natural-scroll" );
            if ( pick( a, "layouts", [] ).len() ) argv.append( "--layouts=" & a.layouts.toList( "," ) );
            if ( len( pick( a, "theme" ) ) ) argv.append( "--theme=" & a.theme );
            if ( len( pick( a, "wallpaper" ) ) ) argv.append( "--wallpaper=" & a.wallpaper );
            out.steps.append( { id: "hyprland", title: "set up Hyprland + Noctalia" & ( len( terminal ) ? " (" & terminal & " on Super+Enter" & ( len( layout ) ? ", " & layout & " layout" : "" ) & ")" : "" ), argv: argv } );
        }
        if ( wantsPlasma ) out.steps.append( { id: "plasma", title: "set up KDE Plasma tiling (HyprKwin)", argv: [ "bxcachy", "setup", "plasma" ] } );
        var extras = pick( a, "terminals_extra", [] );
        if ( len( terminal ) || extras.len() ) {
            var targv = [ "bxcachy", "setup", "terminal" ];
            if ( len( terminal ) ) targv.append( "--default=" & terminal );
            if ( extras.len() ) targv.append( "--also=" & extras.toList( "," ) );
            out.steps.append( { id: "terminal", title: "install and configure terminals (" & ( len( terminal ) ? terminal : "default" ) & ( extras.len() ? " and " & extras.toList( ", " ) : "" ) & ")", argv: targv } );
        }
        // the colour theme goes after the terminals, so their starter configs and the generated theme files exist; a Dark/Light answer
        // of Light with the default theme picks the light BxCachy theme. Optional: the desktop may not be running during the install.
        var themeName = pick( a, "theme_name" );
        if ( themeName == "bxcachy" && pick( a, "theme" ) == "light" ) themeName = "bxcachy-light";
        if ( ( wantsHypr || wantsPlasma ) && len( themeName ) && themeName != "bxcachy" ) {
            var thargv = [ "bxcachy", "theme", "set", themeName ];
            if ( pick( a, "theme" ) == "auto" ) thargv.append( "--mode=auto" );
            out.steps.append( { id: "theme", title: "apply the " & themeName & " colour theme", argv: thargv, optional: true } );
        }
        var shell = pick( a, "shell" );
        if ( len( shell ) ) out.steps.append( { id: "shell", title: "set up " & shell & " with the Starship prompt", argv: [ "bxcachy", "setup", "shell", "--shell=" & shell ] } );
        if ( isSet( pick( a, "mac_keys", false ) ) ) {
            var build = desktops == "plasma" ? "kde" : "hypr";
            out.steps.append( { id: "xremap", title: "Cmd-style keys (xremap, " & build & ")", argv: [ "bxcachy", "setup", "xremap", "--build=" & build ] } );
        }
        // toolchains: one catalog profile each (java is the jvm profile: JDK 21, Maven, Gradle); Laravel's installer comes from Composer
        var profiles = { java: "jvm", php: "php", python: "python", go: "go" };
        var chosen = pick( a, "toolchains", [] );
        var jsApps = [];
        for ( var tc in [ "java", "php", "python", "go", "rust", "javascript" ] ) {
            if ( !arrayFind( chosen, tc ) ) continue;
            if ( tc == "rust" ) {
                // rustup itself comes with the install; this picks the stable toolchain (a failure is skipped, the plan goes on)
                out.steps.append( { id: "toolchain-rust", title: "set up Rust (rustup, stable toolchain)", argv: [ "rustup", "default", "stable" ], optional: true } );
                continue;
            }
            if ( tc == "javascript" ) {
                // runtimes: Node comes through nvm (`toolchain node`); Bun and Deno are catalog apps
                for ( var rt in pick( a, "js_runtimes", [ "node" ] ) ) {
                    if ( rt == "node" ) out.steps.append( { id: "toolchain-node", title: "install Node.js with nvm", argv: [ "bxcachy", "toolchain", "node" ] } );
                    else if ( rt == "bun" || rt == "deno" ) jsApps.append( rt );
                }
                continue;
            }
            out.steps.append( { id: "toolchain-" & tc, title: "install the " & tc & " toolchain", argv: [ "bxcachy", "profile-install", profiles[ tc ] ] } );
            if ( tc == "php" ) out.steps.append( { id: "laravel", title: "install the Laravel installer (composer global)", argv: [ "composer", "global", "require", "laravel/installer" ] } );
        }
        // agent skills (optional: needs the skills hub for boxlang and matchbox; a failure is skipped)
        var skillPick = pick( a, "agent_skills", [] );
        if ( skillPick.len() ) {
            var skArgv = [ "bxcachy", "skills", "install" ];
            for ( var sk in skillPick ) skArgv.append( sk );
            out.steps.append( { id: "agent-skills", title: "give your coding agents skills (" & skillPick.toList( ", " ) & ")", argv: skArgv, optional: true } );
        }
        // BoxLang modules from ForgeBox and the VS Code extension (optional: a failure is skipped, the plan goes on)
        var blMods = pick( a, "boxlang_modules", [] );
        if ( blMods.len() ) {
            var blArgv = [ "bxcachy", "boxlang", "modules", "install" ];
            for ( var bm in blMods ) blArgv.append( bm );
            out.steps.append( { id: "boxlang-modules", title: "install the BoxLang modules (" & blMods.toList( ", " ) & ")", argv: blArgv, optional: true } );
        }
        if ( pick( a, "boxlang_vscode", false ) ) out.steps.append( { id: "boxlang-vscode", title: "add the BoxLang extension to VS Code", argv: [ "bxcachy", "boxlang", "vscode" ], optional: true } );
        // containers: Podman is the engine the containers profile is built around; Docker is one extra package
        var engine = pick( a, "container_engine" );
        var vmWin = pick( a, "vm_windows" );
        var vmLin = pick( a, "vm_linux" );
        var vmWanted = ( len( vmWin ) && vmWin != "none" ) || ( len( vmLin ) && vmLin != "none" );
        if ( engine == "podman" || ( !len( engine ) && vmWanted ) ) out.steps.append( { id: "containers", title: "install Podman and its tools", argv: [ "bxcachy", "profile-install", "containers" ] } );
        if ( engine == "podman" && pick( a, "docker_compat", false ) == true ) out.steps.append( { id: "docker-compat", title: "make docker and docker compose run on Podman (podman-docker, podman-compose)", argv: [ "bxcachy", "containers", "docker-compat" ] } );
        if ( pick( a, "gaming" ) == "bundle" ) out.steps.append( { id: "gaming", title: "install the CachyOS gaming bundle", argv: [ "bxcachy", "profile-install", "gaming" ] } );
        // apps: Basic installs the catalog's recommended set for the chosen desktop(s); Customize installs what was ticked
        var mode = pick( a, "app_mode" );
        var chosenApps = [];
        if ( mode == "defaults" ) {
            var shellFlag = desktops == "hyprland" ? "--shell=hyprland" : ( desktops == "plasma" ? "--shell=plasma" : ( desktops == "both" ? "--shell=all" : "" ) );
            var bargv = [ "bxcachy", "install" ];
            if ( len( shellFlag ) ) bargv.append( shellFlag );
            out.steps.append( { id: "apps-basic", title: "install the recommended apps (the catalog's default set)", argv: bargv } );
        } else if ( mode == "custom" ) {
            for ( var cid in new bxcachy.AppPages().selected( a ) ) if ( shellOk( cid, desktops, arguments.shellMap ) ) chosenApps.append( cid );
        }
        var fileManager = pick( a, "file_manager" );
        if ( len( fileManager ) && !arrayFind( chosenApps, fileManager ) ) chosenApps.append( fileManager );
        for ( var wbBundle in pick( a, "web_bundles", [] ) ) out.steps.append( { id: "web-" & wbBundle, title: "add all the " & wbBundle & " web apps", argv: [ "bxcachy", "web", "install", wbBundle ], optional: true } );
        var dictation = pick( a, "dictation" );
        if ( dictation == "superwhisper" ) { if ( !arrayFind( chosenApps, "superwhisper" ) ) chosenApps.append( "superwhisper" ); }
        else if ( dictation == "voxtype" ) { for ( var dapp in [ "voxtype", "wtype" ] ) if ( !arrayFind( chosenApps, dapp ) ) chosenApps.append( dapp ); }
        var browser = pick( a, "default_browser" );
        if ( len( browser ) && !arrayFind( chosenApps, browser ) ) chosenApps.append( browser );
        // everything else that is one package each goes in a single install
        var apps = [];
        for ( var ca in chosenApps ) apps.append( ca );
        for ( var id in jsApps ) apps.append( id );
        for ( var id in pick( a, "ai_orchestrators", [] ) ) apps.append( id );
        // the coding agents: the ticked ones, plus the default agent if it was not ticked (it has to be there to be the default)
        var agentLib = new bxcachy.AiAgents();
        var agentIds = [];
        for ( var id in pick( a, "ai_agents", [] ) ) agentIds.append( id );
        var aiDefault = pick( a, "ai_default" );
        if ( isSet( aiDefault ) ) {
            if ( structIsEmpty( agentLib.find( aiDefault ) ) ) out.errors.append( "ai_default: unknown agent " & aiDefault );
            else if ( !arrayFind( agentIds, aiDefault ) ) agentIds.append( aiDefault );
        }
        for ( var id in agentIds ) apps.append( id );
        // local models: the apps you ticked, and the GPU build of Ollama when you named your card
        // agent sessions that survive closing the terminal are tmux sessions
        if ( agentIds.len() ) apps.append( "tmux" );
        // the pull-down AI shell on Plasma is Yakuake (Hyprland needs nothing extra)
        if ( agentIds.len() && wantsPlasma ) apps.append( "yakuake" );
        if ( pick( a, "night_shift", false ) && wantsHypr ) apps.append( "wlsunset" );
        if ( wantsHypr && pick( a, "gestures", false ) ) { apps.append( "libinput-gestures" ); apps.append( "bluez" ); }
        if ( pick( a, "airplay", false ) ) apps.append( "uxplay" );
        // the Plasma panel layout needs its widgets installed
        var panelsOn = wantsPlasma && pick( a, "plasma_panels" ) == "bxcachy";
        if ( panelsOn ) {
            for ( var pw in [ "panel-colorizer", "panel-colorizer-islands", "window-title", "kvitals" ] ) apps.append( pw );
            if ( pick( a, "plasma_weather", true ) ) apps.append( "kdeplasma-addons" );
            if ( pick( a, "plasma_agenda", false ) ) apps.append( "event-calendar" );
        }
        var localAi = pick( a, "ai_local", [] );
        for ( var id in localAi ) apps.append( id );
        var gpu = pick( a, "ai_local_gpu" );
        if ( arrayFind( localAi, "ollama" ) ) {
            if ( gpu == "nvidia" ) apps.append( "ollama-cuda" );
            else if ( gpu == "amd" ) apps.append( "ollama-rocm" );
        }
        if ( pick( a, "cloud_storage", false ) == true ) { apps.append( "rclone" ); apps.append( "fuse3" ); }
        for ( var id in pick( a, "remote_desktop", [] ) ) if ( !arrayFind( apps, id ) ) apps.append( id );
        for ( var id in pick( a, "desktop_utilities", [] ) ) if ( !arrayFind( apps, id ) ) apps.append( id );
        if ( engine == "docker" ) apps.append( "docker" );
        var vpnIds = { tailscale: "tailscale", wireguard: "wireguard", openvpn: "openvpn", mullvad: "mullvad", proton: "proton-vpn", nordvpn: "nordvpn" };
        var vpn = pick( a, "vpn" );
        if ( structKeyExists( vpnIds, vpn ) ) apps.append( vpnIds[ vpn ] );
        var pm = pick( a, "password_manager" );
        if ( len( pm ) && pm != "none" ) apps.append( pm );
        if ( pick( a, "gaming" ) == "steam" ) apps.append( "steam" );
        // launcher and menu providers: install the one that needs a package; the choice itself is recorded by `runner`
        var rn = new bxcachy.Runner();
        for ( var pv in [ pick( a, "launcher" ), pick( a, "menu" ) ] ) {
            var rid = len( pv ) ? rn.catalogId( pv ) : "";
            if ( len( rid ) && !arrayFind( apps, rid ) ) apps.append( rid );
        }
        for ( var id in pick( a, "backups", [] ) ) { apps.append( id ); if ( id == "snapper" ) apps.append( "snap-pac" ); }
        if ( arrayFind( pick( a, "backup_layers", [] ), "data" ) > 0 && !arrayFind( apps, "restic" ) ) apps.append( "restic" );
        if ( apps.len() ) {
            var iargv = [ "bxcachy", "install" ];
            for ( var id in apps ) iargv.append( id );
            out.steps.append( { id: "apps", title: "install " & apps.toList( ", " ), argv: iargv } );
        }
        if ( pick( a, "editor_starter" ) == "lazyvim" ) out.steps.append( { id: "editor-lazyvim", title: "install the LazyVim starter for Neovim with the BxCachy layer and BoxLang syntax (an existing ~/.config/nvim is left alone)", argv: [ "bxcachy", "editor", "lazyvim" ] } );
        // NordVPN needs its service and your group after the install (sudo; optional so a missing password prompt never stops the plan)
        if ( vpn == "nordvpn" ) out.steps.append( { id: "vpn-nordvpn", title: "enable the NordVPN service and add you to the nordvpn group (sudo)", argv: [ "bxcachy", "vpn", "nordvpn", "setup" ], optional: true } );
        // defaults: the browser and the terminal you picked (both are installed by now)
        if ( len( fileManager ) ) out.steps.append( { id: "default-filemanager", title: "make " & fileManager & " your default file manager", argv: [ "bxcachy", "default", "filemanager", fileManager ] } );
        if ( fileManager == "strata" ) out.steps.append( { id: "strata-integrations", title: "add Strata's LocalSend and KDE Connect Send to providers", argv: [ "bxcachy", "strata", "integrations" ], optional: true } );
        if ( len( browser ) ) out.steps.append( { id: "default-browser", title: "make " & browser & " your default browser", argv: [ "bxcachy", "default", "browser", browser ] } );
        if ( len( terminal ) ) out.steps.append( { id: "default-terminal", title: "make " & terminal & " your default terminal", argv: [ "bxcachy", "default", "terminal", terminal ] } );
        // databases: remember the container engine, then start each chosen service (nothing is started unless it was picked)
        var dbs = pick( a, "databases", [] );
        if ( dbs.len() || pick( a, "container_engine" ) == "docker" ) {
            if ( arrayFind( [ "podman", "docker" ], pick( a, "container_engine" ) ) ) out.steps.append( { id: "db-engine", title: "run databases with " & a.container_engine, argv: [ "bxcachy", "db", "engine", a.container_engine ] } );
        }
        for ( var db in dbs ) {
            var dargv = [ "bxcachy", "db", "start", db ];
            // asking for a password needs a terminal; the answer is typed at the prompt, never saved in answers.json or put on a command line
            if ( pick( a, "database_passwords" ) == "ask" && !arrayFind( [ "redis", "couchbase", "chroma", "qdrant", "weaviate" ], db ) ) dargv.append( "--ask-password" );
            out.steps.append( { id: "db-" & db, title: "start " & db & " (local container, 127.0.0.1 only)" & ( dargv.len() > 4 ? ", asking for its password" : "" ), argv: dargv } );
        }
        // the mail catcher (a development inbox in a container): optional, so a missing container engine never stops the plan
        if ( pick( a, "mail_catcher", false ) ) out.steps.append( { id: "mail-start", title: "start the mail catcher (SMTP 127.0.0.1:1025, inbox http://127.0.0.1:8025)", argv: [ "bxcachy", "mail", "start", "--yes" ], optional: true } );
        // virtual machines (containers): Windows with the version you chose, a Linux desktop called "desktop"; optional steps, so a missing KVM never stops the plan
        if ( len( vmWin ) && vmWin != "none" ) out.steps.append( { id: "vm-windows", title: "create a Windows VM (" & vmWin & "; it installs itself on the first start)", argv: [ "bxcachy", "vm", "create", "windows", "--version=" & vmWin ], optional: true } );
        if ( len( vmLin ) && vmLin != "none" ) out.steps.append( { id: "vm-linux", title: "create a Linux desktop in a container (" & vmLin & ")", argv: [ "bxcachy", "vm", "create", "linux", "desktop", "--tag=" & vmLin ], optional: true } );
        // AI: a keyring for the API keys, the keys you chose to type now (optional steps: skipping one never stops the plan), the
        // keys you chose to export to every shell, and the default agent
        if ( agentIds.len() ) out.steps.append( { id: "secrets-setup", title: "check for a keyring for your API keys (installs one, with libsecret and age, only if none is found)", argv: [ "bxcachy", "secrets", "setup" ] } );
        // keys to type: the key of every single-provider agent you chose, plus the providers you ticked (OpenCode and others take many)
        var keyEnvs = [];
        if ( pick( a, "ai_keys" ) == "now" ) {
            var provLib = new bxcachy.AiProviders();
            for ( var id in agentIds ) {
                var ag = agentLib.find( id );
                if ( !structIsEmpty( ag ) && ag.providers.len() == 1 ) { var env1 = provLib.find( ag.providers[ 1 ] ).env; if ( !arrayFind( keyEnvs, env1 ) ) keyEnvs.append( env1 ); }
            }
            for ( var pid in pick( a, "ai_providers", [] ) ) {
                var pv = provLib.find( pid );
                if ( structIsEmpty( pv ) ) out.errors.append( "ai_providers: unknown provider " & pid );
                else if ( !arrayFind( keyEnvs, pv.env ) ) keyEnvs.append( pv.env );
            }
            for ( var env in keyEnvs ) out.steps.append( { id: "key-" & env, title: "store your " & provLib.byEnv( env ).name & " API key (typed hidden; you can skip it)", argv: [ "bxcachy", "secrets", "set", env ], optional: true } );
            for ( var gk in pick( a, "ai_global_keys", [] ) ) {
                if ( arrayFind( keyEnvs, gk ) ) out.steps.append( { id: "global-" & gk, title: "export " & gk & " to every shell (you chose this; every program can read it)", argv: [ "bxcachy", "secrets", "global", "on", gk ], optional: true } );
            }
        }
        if ( isSet( aiDefault ) && !structIsEmpty( agentLib.find( aiDefault ) ) ) out.steps.append( { id: "ai-default", title: "make " & aiDefault & " your default coding agent", argv: [ "bxcachy", "ai", "default", aiDefault ] } );
        // Ollama: the service at boot if you asked, then the models you named (optional steps: a failed download never stops the plan)
        if ( arrayFind( localAi, "ollama" ) ) {
            if ( pick( a, "ai_ollama_service", false ) == true ) out.steps.append( { id: "ollama-service", title: "start the Ollama service now and at boot (sudo)", argv: [ "bxcachy", "ai", "models", "enable" ] } );
            for ( var mraw in listToArray( pick( a, "ai_models", "" ), "," ) ) {
                var model = trim( mraw );
                if ( !len( model ) ) continue;
                if ( reFind( "^[A-Za-z0-9._:/-]{1,100}$", model ) == 0 ) out.errors.append( "ai_models: bad model name " & model );
                else out.steps.append( { id: "model-" & model, title: "download the model " & model & " (several GB; you can skip it)", argv: [ "bxcachy", "ai", "models", "pull", model ], optional: true } );
            }
        }
        if ( len( pick( a, "launcher" ) ) ) out.steps.append( { id: "launcher", title: "use " & a.launcher & " as the app launcher (no shortcut is changed)", argv: [ "bxcachy", "runner", "set", a.launcher ] } );
        if ( len( pick( a, "menu" ) ) ) out.steps.append( { id: "menu", title: "use " & a.menu & " for BxCachy menus", argv: [ "bxcachy", "runner", "menu-set", a.menu ] } );
        var gname = pick( a, "git_name" );
        var gmail = pick( a, "git_email" );
        if ( len( gname ) ) out.steps.append( { id: "git-name", title: "git user.name", argv: [ "git", "config", "--global", "user.name", gname ] } );
        if ( len( gmail ) ) out.steps.append( { id: "git-email", title: "git user.email", argv: [ "git", "config", "--global", "user.email", gmail ] } );
        // an SSH key (ssh-keygen asks for the passphrase on the terminal, so it is optional: skipping it never stops the plan)
        if ( pick( a, "ssh_key", false ) == true ) {
            var skArgv = [ "bxcachy", "ssh", "key" ];
            if ( len( gmail ) ) skArgv.append( "--email=" & gmail );
            out.steps.append( { id: "ssh-key", title: "create an SSH key (ed25519; an existing key is kept; you type a passphrase or leave it empty)", argv: skArgv, optional: true } );
        }
        // the Plasma window layout of the workspace you are on (optional: it needs a running Plasma session; other workspaces start
        // with HyprKwin's own default, set in System Settings)
        if ( wantsPlasma && len( pick( a, "plasma_layout" ) ) ) {
            if ( !arrayFind( [ "dwindle", "master", "monocle", "scrolling", "stage" ], a.plasma_layout ) ) out.errors.append( "plasma_layout: unknown layout " & a.plasma_layout );
            else out.steps.append( { id: "plasma-layout", title: "use the " & a.plasma_layout & " window layout on this Plasma workspace (needs a running Plasma session)", argv: [ "bxcachy", "tiling", "layout", a.plasma_layout ], optional: true } );
        }
        // NAS, remote backup targets and the backup layers (the NAS, Remote backups and Backups pages). Passwords and keys are typed in the terminal
        // by the commands themselves (--ask-password, --ask-keys), so nothing secret is in the answers; each step is optional so a missing
        // network or a wrong password never stops the rest of the plan.
        var bkTargets = [];
        if ( pick( a, "nas_use", false ) == true ) {
            var nn = lCase( trim( pick( a, "nas_name" ) ) );
            if ( !len( nn ) ) nn = "nas";
            var nhost = trim( pick( a, "nas_host" ) );
            var nproto = pick( a, "nas_protocol", "smb" );
            var nuser = trim( pick( a, "nas_user" ) );
            var nshare = trim( pick( a, "nas_share" ) );
            if ( !len( nshare ) ) nshare = "backups";
            if ( !reFind( "^[a-z][a-z0-9-]{0,30}$", nn ) ) out.errors.append( "nas_name: lower case letters, digits and dashes" );
            else if ( !len( nhost ) ) out.errors.append( "nas_host: the address of the NAS is needed" );
            else if ( nproto == "smb" && !len( nuser ) ) out.errors.append( "nas_user: SMB needs a user name" );
            else {
                out.steps.append( { id: "nas-setup", title: "install the NAS tools (cifs-utils, nfs-utils, smbclient, avahi, rsync)", argv: [ "bxcachy", "nas", "setup", "--yes" ], optional: true } );
                var addArgv = [ "bxcachy", "nas", "add", nn, "--host=" & nhost, "--protocol=" & nproto ];
                if ( nproto == "smb" ) { addArgv.append( "--user=" & nuser ); addArgv.append( "--ask-password" ); }
                out.steps.append( { id: "nas-add", title: "save the NAS " & nn & ( nproto == "smb" ? " (you type its password; it goes to your keyring)" : "" ), argv: addArgv, optional: true } );
                out.steps.append( { id: "nas-mount", title: "mount " & nshare & " from " & nn, argv: [ "bxcachy", "nas", "mount", nn, nshare, "--yes" ], optional: true } );
                if ( pick( a, "nas_auto", true ) ) out.steps.append( { id: "nas-auto", title: "mount it by itself when something opens it", argv: [ "bxcachy", "nas", "auto", "on", nn, nshare, "--yes" ], optional: true } );
                out.steps.append( { id: "nas-use", title: "use " & nn & "/" & nshare & " as a backup place", argv: [ "bxcachy", "nas", "use", nn, nshare ] } );
                bkTargets.append( "nas-" & nn );
            }
        }
        var rtype = pick( a, "remote_type", "none" );
        if ( rtype != "none" ) {
            var rn2 = lCase( trim( pick( a, "remote_name" ) ) );
            if ( !len( rn2 ) ) rn2 = "cloud";
            var tArgv = [ "bxcachy", "backup", "data", "target", "add", rn2, "--type=" & rtype ];
            var need = { s3: [ "bucket" ], b2: [ "bucket" ], azure: [ "container" ], gs: [ "bucket", "project", "credentials" ], sftp: [ "host", "user" ], rclone: [ "remote" ], local: [] };
            var missingRemote = "";
            for ( var f in need[ rtype ] ) {
                var rv = trim( pick( a, "remote_" & f ) );
                if ( !len( rv ) ) missingRemote = f; else tArgv.append( "--" & f & "=" & rv );
            }
            for ( var o in [ "endpoint", "region", "path" ] ) {
                var ov = trim( pick( a, "remote_" & o ) );
                if ( len( ov ) && !( o == "endpoint" && rtype != "s3" ) && !( o == "region" && rtype != "s3" ) ) tArgv.append( "--" & o & "=" & ov );
            }
            if ( rtype == "local" && !len( trim( pick( a, "remote_path" ) ) ) ) missingRemote = "path";
            if ( !reFind( "^[a-z][a-z0-9-]{0,30}$", rn2 ) ) out.errors.append( "remote_name: lower case letters, digits and dashes" );
            else if ( len( missingRemote ) ) out.errors.append( "remote_" & missingRemote & ": needed for " & rtype );
            else {
                if ( arrayFind( [ "s3", "b2", "azure" ], rtype ) ) tArgv.append( "--ask-keys" );
                out.steps.append( { id: "backup-remote", title: "add the backup place " & rn2 & " (" & rtype & ")" & ( arrayFind( [ "s3", "b2", "azure" ], rtype ) ? "; you type the access keys, they go to your keyring" : "" ), argv: tArgv, optional: true } );
                bkTargets.append( rn2 );
            }
        }
        var layers = pick( a, "backup_layers", [] );
        if ( arrayFind( layers, "data" ) > 0 ) {
            if ( !bkTargets.len() ) out.pending.append( "backup_layers: files are chosen but there is no NAS or remote place yet; add one with bxcachy nas use or bxcachy backup data target add" );
            for ( var bt in bkTargets ) out.steps.append( { id: "backup-init-" & bt, title: "create the encrypted backup repository on " & bt, argv: [ "bxcachy", "backup", "data", "init", bt, "--yes" ], optional: true } );
            if ( bkTargets.len() ) out.steps.append( { id: "backup-default", title: "make " & bkTargets[ 1 ] & " the default backup place", argv: [ "bxcachy", "backup", "data", "default", bkTargets[ 1 ] ], optional: true } );
            var sched = pick( a, "backup_schedule", "daily" );
            if ( sched != "off" && bkTargets.len() ) out.steps.append( { id: "backup-schedule", title: "back up my files " & sched, argv: [ "bxcachy", "backup", "data", "schedule", sched, "--yes" ], optional: true } );
        }
        if ( arrayFind( layers, "snapshots" ) > 0 ) out.steps.append( { id: "backup-snapshots", title: "set up system snapshots (snapper on Btrfs, Timeshift elsewhere)", argv: [ "bxcachy", "backup", "snapshots", "setup", "--yes" ], optional: true } );
        if ( structKeyExists( a, "backup_layers" ) && arrayFind( layers, "config" ) == 0 ) out.steps.append( { id: "backup-config-off", title: "do not take a config snapshot before updates", argv: [ "bxcachy", "backup", "config", "auto", "off" ] } );
        // laptop power tools (power-profiles-daemon, upower): `power setup` does nothing on a machine without a battery, so this is safe everywhere
        if ( pick( a, "power_setup", false ) ) out.steps.append( { id: "power-setup", title: "set up laptop power tools (only when a battery is found)", argv: [ "bxcachy", "power", "setup" ], optional: true } );
        // update channel and the daily update notification
        if ( len( pick( a, "update_channel" ) ) ) out.steps.append( { id: "update-channel", title: "use the " & a.update_channel & " update channel", argv: [ "bxcachy", "update", "channel", a.update_channel ] } );
        if ( pick( a, "update_notifications", false ) ) out.steps.append( { id: "update-notifications", title: "check for updates daily and notify", argv: [ "bxcachy", "update", "notifications", "on" ], optional: true } );
        // night shift, trackpad gestures and the AirPlay receiver (optional: a failure is skipped)
        if ( pick( a, "night_shift", false ) ) out.steps.append( { id: "night-shift", title: "turn on night shift (sunset and sunrise from your time zone)", argv: [ "bxcachy", "nightshift", "on" ], optional: true } );
        if ( wantsHypr && pick( a, "gestures", false ) ) out.steps.append( { id: "gestures", title: "set up three-finger trackpad gestures", argv: [ "bxcachy", "input", "gestures" ], optional: true } );
        if ( pick( a, "airplay", false ) ) out.steps.append( { id: "airplay", title: "start the AirPlay receiver", argv: [ "bxcachy", "airplay", "on" ], optional: true } );
        // the Plasma panel layout (optional: it is applied now when Plasma is running, else at your next Plasma login) and the desktop count
        if ( wantsPlasma && len( pick( a, "plasma_panels" ) ) ) {
            var deskCount = pick( a, "workspaces", 4 );
            if ( a.plasma_panels == "bxcachy" ) {
                var ppArgv = [ "bxcachy", "plasma", "panels", "apply", "--desktops=" & deskCount ];
                if ( !pick( a, "plasma_weather", true ) ) ppArgv.append( "--without-weather" );
                if ( pick( a, "plasma_agenda", false ) ) ppArgv.append( "--agenda" );
                out.steps.append( { id: "plasma-panels", title: "apply the BxCachy Plasma panel layout (backed up first; at your next Plasma login if Plasma is not running)", argv: ppArgv, optional: true } );
            } else out.steps.append( { id: "plasma-desktops", title: "use " & deskCount & " virtual desktops", argv: [ "bxcachy", "plasma", "desktops", deskCount ], optional: true } );
        }
        // keyboard layouts for Plasma (Hyprland takes them through `setup hyprland --layouts`)
        if ( wantsPlasma && pick( a, "layouts", [] ).len() ) out.steps.append( { id: "plasma-keyboard", title: "set the Plasma keyboard layouts (" & a.layouts.toList( ", " ) & "; takes effect at your next login)", argv: [ "bxcachy", "setup", "keyboard", "--layouts=" & a.layouts.toList( "," ) ] } );
        var sess = session( a );
        if ( len( sess ) ) out.steps.append( { id: "session", title: "start on " & ( sess == "hyprland" ? "Hyprland" : "KDE Plasma" ) & " at the login screen", argv: [ "bxcachy", "session", "set", sess ] } );
        if ( !wantsHypr ) for ( var key in hyprlandKeys() ) {
            if ( key == "layouts" && wantsPlasma ) continue;
            if ( structKeyExists( a, key ) && isSet( a[ key ] ) ) out.pending.append( key );
        }
        // your own dotfiles go last so they win over the starter configs; replacing a file you have is asked at the prompt
        if ( len( pick( a, "dotfiles_repo" ) ) ) out.steps.append( { id: "dotfiles", title: "apply your dotfiles from " & a.dotfiles_repo & " (method detected; you are asked before any existing file is replaced)", argv: [ "bxcachy", "dotfiles", "apply", a.dotfiles_repo ] } );
        for ( var key in pendingKeys() ) {
            if ( structKeyExists( a, key ) && isSet( a[ key ] ) ) out.pending.append( key );
        }
        return out;
    }
}
