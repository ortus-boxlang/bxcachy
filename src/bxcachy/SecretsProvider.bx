// Secrets: the keys in your keyring. Names only; a value is shown only when you press v. Reads `secrets list`.
class SecretsProvider {
    function init( demo = false ) { variables.demo = arguments.demo; variables.sys = new bxcachy.TuiSys(); return this; }
    function id() { return "secrets"; }
    function icon() { return "key"; }
    function title() { return "Secrets"; }
    function hint() { return "values stay hidden until you ask"; }
    function live() { return false; }
    function emptyText() { return "No secrets yet. Add one in a terminal: bxcachy secrets set ANTHROPIC_API_KEY"; }
    function columns() { return [ { key: "name", label: "name", w: 28 }, { key: "type", label: "type", w: 8 }, { key: "provider", label: "provider", w: 14 }, { key: "value", label: "value", w: 0 } ]; }
    function style( r ) { return ""; }
    function detail( r ) { return [ r.name & " (" & r.type & ( len( r.provider ) ? ", " & r.provider : "" ) & ")", "v shows the value for one look. Setting a new value asks for it in a terminal: bxcachy secrets set " & r.name ]; }

    function actions() {
        return [
            { key: "v", label: "reveal", run: function( r ) { return { action: "show", title: "Value of " & r.name, args: [ "secrets", "get", r.name, "--show" ] }; } },
            { key: "u", label: "unset", run: function( r ) { return { action: "cli", title: "Unset " & r.name, args: [ "secrets", "unset", r.name ] }; } }
        ];
    }

    function load( q = "" ) {
        var src = variables.demo ? [ { name: "ANTHROPIC_API_KEY", type: "ai", provider: "anthropic" }, { name: "OPENAI_API_KEY", type: "ai", provider: "openai" }, { name: "GITHUB_TOKEN", type: "other", provider: "" } ] : ( variables.sys.bx( [ "secrets", "list" ] ).secrets ?: [] );
        var rows = [];
        for ( var s in src ) rows.append( { name: s.name, type: s.type ?: "other", provider: s.provider ?: "", value: "●●●●●●●●" } );
        return rows;
    }
}
