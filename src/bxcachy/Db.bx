// `bxcachy db`: local database and search services as containers (Podman by default, Docker by choice). Ported from the legacy
// bxcachy-db and bxcachy-vector, with more engines (DbEngines), one command shape, JSON output and exit codes.
//
// Rules: services listen on 127.0.0.1 only; a container that exists is never replaced (a stopped one is started); data lives in a
// named volume that `remove` keeps unless --delete-data is given; generated passwords are kept in mode-600 files under
// ~/.local/share/bxcachy/databases/<container>/ and never put on a command line (they go in an env file).
//
// Exit codes: 0 done, 2 usage or plan printed without --yes, 4 precondition (no container engine, unknown or unsupported engine,
// bad name or port, vm.max_map_count too low), 6 the container command failed.
class Db {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        variables.config = new bxcachy.ConfigService();
        variables.engines = new bxcachy.DbEngines();
        return this;
    }

    // ---- settings and paths ----
    function settingsFile() { return variables.config.cfgHome() & "/bxcachy/db.json"; }
    function dataHome() { return getSystemSetting( "BXCACHY_DATA_HOME", getSystemSetting( "HOME", "" ) & "/.local/share/bxcachy" ); }

    // The container engine program: podman (default) or docker.
    function engineCli() {
        if ( !fileExists( settingsFile() ) ) return "podman";
        try { var s = jsonDeserialize( fileRead( settingsFile() ) ); return arrayFind( [ "podman", "docker" ], s.engine ?: "" ) ? s.engine : "podman"; } catch ( any e ) { return "podman"; }
    }

    function containerName( engine, name ) { return "bxcachy-db-" & arguments.engine & "-" & arguments.name; }
    function stateDir( container ) { return dataHome() & "/databases/" & arguments.container; }
    function validName( name ) { return reFind( "^[a-zA-Z0-9-]{1,40}$", arguments.name ) > 0; }

    // ---- small helpers ----
    function say( command, code, data, asJson, lines = [], dryRun = false ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data, arguments.dryRun ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    // A copy of `base` with the keys of `extra` added or replaced.
    function merge( base, extra ) {
        var out = {};
        for ( var k in structKeyArray( arguments.base ) ) out[ k ] = arguments.base[ k ];
        for ( var k in structKeyArray( arguments.extra ) ) out[ k ] = arguments.extra[ k ];
        return out;
    }

    // Runs the container engine: [ engine, args... ]. Returns { exitCode, output, timeout }.
    function engineExec( args, timeout = 600 ) {
        var argv = [ engineCli() ];
        for ( var a in arguments.args ) argv.append( a );
        return variables.inst.exec( argv, arguments.timeout );
    }

    function engineAvailable() {
        try { return engineExec( [ "--version" ], 20 ).exitCode == 0; } catch ( any e ) { return false; }
    }

    function exists( container ) {
        try { return engineExec( [ "container", "inspect", arguments.container ], 30 ).exitCode == 0; } catch ( any e ) { return false; }
    }

    // "running", "exited", ... or "" when there is no such container.
    function stateOf( container ) {
        try {
            var r = engineExec( [ "container", "inspect", "--format", "{{.State.Status}}", arguments.container ], 30 );
            return r.exitCode == 0 ? trim( r.output ) : "";
        } catch ( any e ) { return ""; }
    }

    function maxMapCount() {
        var f = getSystemSetting( "BXCACHY_MAX_MAP_COUNT_FILE", "/proc/sys/vm/max_map_count" );
        try { return fileExists( f ) ? trim( fileRead( f ) ) + 0 : 0; } catch ( any e ) { return 0; }
    }

    // A random secret (hex, 24 random bytes) from the system's random source.
    function newSecret() {
        var r = variables.inst.exec( [ "sh", "-c", 'head -c 24 /dev/urandom | od -An -tx1 | tr -d "[:space:]"' ], 10 );
        return trim( r.output );
    }

    // Checks common to every verb that names an engine and an instance. Returns { error, engine, name, container }.
    function resolve( engineId, name ) {
        var e = variables.engines.get( arguments.engineId );
        if ( structIsEmpty( e ) ) return { error: "Unknown engine: " & arguments.engineId & " (use " & variables.engines.ids().toList( ", " ) & ")", code: 2 };
        if ( structKeyExists( e, "unsupported" ) ) return { error: e.title & ": " & e.unsupported, code: 4 };
        if ( !validName( arguments.name ) ) return { error: "The name may only contain letters, digits and hyphens (up to 40 characters)", code: 4 };
        return { error: "", code: 0, engine: e, name: arguments.name, container: containerName( e.id, arguments.name ) };
    }

    // ---- a password of the user's choice ----

    // "" when a password is acceptable for the engine, else why not. Never echoes the password.
    function checkPassword( engineId, pw ) {
        if ( len( arguments.pw ) < 8 ) return "The password must be at least 8 characters";
        if ( len( arguments.pw ) > 128 ) return "The password must be at most 128 characters";
        if ( reFind( "[[:space:][:cntrl:]]", arguments.pw ) ) return "The password cannot contain spaces, tabs or line breaks";
        if ( arguments.engineId == "opensearch" && !( reFind( "[A-Z]", arguments.pw ) && reFind( "[a-z]", arguments.pw ) && reFind( "[0-9]", arguments.pw ) && reFind( "[^A-Za-z0-9]", arguments.pw ) ) )
            return "OpenSearch needs an uppercase letter, a lowercase letter, a digit and a special character";
        return "";
    }

    // Asks for a password twice on the terminal without echo. BXCACHY_TTY_IN names a file to read the two lines from instead
    // (tests). Returns { error, password }.
    function askPassword() {
        var tmp = reReplace( getTempDirectory(), "/+$", "" ) & "/bxcachy-pw-" & left( createUUID(), 8 );
        var script = 'in="${BXCACHY_TTY_IN:-/dev/tty}"; exec 3< "$in"; ask() { if [ "$in" = /dev/tty ]; then printf "%s" "$1" > /dev/tty; stty -echo < /dev/tty; fi; IFS= read -r v <&3; if [ "$in" = /dev/tty ]; then stty echo < /dev/tty; echo > /dev/tty; fi; printf "%s" "$v"; }; ask "Password: " > "$1"; echo >> "$1"; ask "Repeat password: " >> "$1"';
        try {
            variables.inst.exec( [ "sh", "-c", script, "_", tmp ], 300 );
            var lines = fileExists( tmp ) ? listToArray( fileRead( tmp ), chr( 10 ), true ) : [];
        } finally {
            if ( fileExists( tmp ) ) fileDelete( tmp );
        }
        if ( lines.len() < 2 || !len( lines[ 1 ] ) ) return { error: "No password was entered (--ask-password needs a terminal)", password: "" };
        if ( lines[ 1 ] != lines[ 2 ] ) return { error: "The two passwords did not match", password: "" };
        return { error: "", password: lines[ 1 ] };
    }

    // ---- verbs ----

    // `db engines`
    function listEngines( asJson ) {
        var rows = variables.engines.all().map( function( e ) { return { id: e.id, title: e.title, kind: e.kind, image: e.image, port: e.port, supported: !structKeyExists( e, "unsupported" ) }; } );
        var lines = [];
        for ( var r in rows ) lines.append( left( r.id & repeatString( " ", 14 ), 14 ) & "  " & r.title & ( r.supported ? "  (" & r.image & ", port " & r.port & ")" : "  (not supported yet)" ) );
        return say( "db engines", 0, { engines: rows }, arguments.asJson, lines );
    }

    // `db list`: BxCachy's containers, running or not.
    function list( asJson ) {
        if ( !engineAvailable() ) return say( "db list", 4, { error: engineCli() & " was not found" }, arguments.asJson, [ "error: " & engineCli() & " was not found" ] );
        var r = engineExec( [ "ps", "-a", "--filter", "label=io.bxcachy.database=true", "--format", "{{.Names}}|{{.Status}}|{{.Image}}" ], 30 );
        var items = [];
        var lines = [];
        for ( var line in listToArray( r.output, chr( 10 ) ) ) {
            var parts = listToArray( trim( line ), "|", true );
            if ( parts.len() < 3 ) continue;
            var meta = readMeta( parts[ 1 ] );
            items.append( { container: parts[ 1 ], status: parts[ 2 ], image: parts[ 3 ], engine: meta.engine ?: "", name: meta.name ?: "", port: meta.port ?: 0 } );
            lines.append( parts[ 1 ] & "  " & parts[ 2 ] & "  " & parts[ 3 ] );
        }
        if ( !items.len() ) lines.append( "No BxCachy databases yet. Start one with: bxcachy db start ENGINE --yes" );
        return say( "db list", r.exitCode == 0 ? 0 : 6, { engine: engineCli(), databases: items }, arguments.asJson, lines );
    }

    function readMeta( container ) {
        var f = stateDir( arguments.container ) & "/meta.json";
        if ( !fileExists( f ) ) return {};
        try { return jsonDeserialize( fileRead( f ) ); } catch ( any e ) { return {}; }
    }

    // The container run command for an engine (argv after the engine program). secretEnvFile is "" for engines without a password.
    function runArgs( e, name, container, port, envFile ) {
        var a = [ "run", "-d", "--name", arguments.container, "--label", "io.bxcachy.database=true", "--label", "io.bxcachy.engine=" & arguments.e.id,
                  "--label", "io.bxcachy.instance=" & arguments.name, "--restart", "unless-stopped" ];
        for ( var m in variables.engines.portMaps( arguments.e, arguments.port ) ) { a.append( "-p" ); a.append( "127.0.0.1:" & m ); }
        a.append( "-v" ); a.append( arguments.container & ":" & arguments.e.volume );
        if ( len( arguments.envFile ) ) { a.append( "--env-file" ); a.append( arguments.envFile ); }
        for ( var v in arguments.e.env ) { a.append( "-e" ); a.append( v ); }
        a.append( arguments.e.image );
        for ( var x in arguments.e.args ) a.append( x );
        return a;
    }

    // `db start ENGINE [--name N] [--port P] [--yes] [--dry-run]`
    function start( engineId, name, port, yes, dryRun, asJson, passwordFile = "", ask = false ) {
        var cmd = "db start";
        var res = resolve( arguments.engineId, arguments.name );
        if ( len( res.error ) ) return say( cmd, res.code, { error: res.error }, arguments.asJson, [ "error: " & res.error ] );
        var e = res.engine;
        var p = len( toString( arguments.port ) ) ? arguments.port : e.port;
        var badPort = { error: "The port must be a whole number from 1024 to 65535" };
        if ( !isNumeric( p ) ) return say( cmd, 4, badPort, arguments.asJson, [ "error: " & badPort.error ] );
        p = p + 0;
        if ( p < 1024 || p > 65535 || int( p ) != p ) return say( cmd, 4, badPort, arguments.asJson, [ "error: " & badPort.error ] );
        p = int( p );
        if ( variables.engines.portIsFixed( e ) && p != e.port ) return say( cmd, 4, { error: e.title & " uses fixed ports, --port cannot change them" }, arguments.asJson, [ "error: " & e.title & " uses fixed ports, --port cannot change them" ] );
        // a password of the user's choice: from a file (never a command-line value) or typed at the prompt
        var chosen = "";
        var wants = len( arguments.passwordFile ) || arguments.ask;
        if ( wants ) {
            var pwErr = "";
            if ( structIsEmpty( e.secret ) ) pwErr = e.title & " has no password to set" & ( e.id == "couchbase" ? " here: set the administrator in its web console" : "" );
            else if ( len( arguments.passwordFile ) && arguments.ask ) pwErr = "Use --password-file or --ask-password, not both";
            else if ( len( arguments.passwordFile ) ) {
                if ( !fileExists( arguments.passwordFile ) ) pwErr = "Password file not found: " & arguments.passwordFile;
                else { chosen = reReplace( fileRead( arguments.passwordFile ), "[\r\n]+$", "" ); pwErr = checkPassword( e.id, chosen ); }
            }
            if ( len( pwErr ) ) return say( cmd, 4, { error: pwErr }, arguments.asJson, [ "error: " & pwErr ] );
        }
        if ( !engineAvailable() ) {
            var msg = engineCli() & " is required but was not found" & ( engineCli() == "podman" ? " (install it with: bxcachy profile-install containers; or choose Docker with: bxcachy db engine docker)" : "" );
            return say( cmd, 4, { error: msg }, arguments.asJson, [ "error: " & msg ] );
        }
        if ( e.minMapCount > 0 && maxMapCount() < e.minMapCount ) {
            var m2 = e.title & " needs vm.max_map_count of at least " & e.minMapCount & " (it is " & maxMapCount() & "). Raise it with: sudo sysctl -w vm.max_map_count=" & e.minMapCount & "  (BxCachy does not change system settings)";
            return say( cmd, 4, { error: m2 }, arguments.asJson, [ "error: " & m2 ] );
        }
        var state = stateOf( res.container );
        if ( wants && len( state ) ) return say( cmd, 4, { error: res.container & " already exists; a password can only be chosen when it is created" }, arguments.asJson, [ "error: " & res.container & " already exists; a password can only be chosen when it is created (remove it with --delete-data first to start over)" ] );
        var data = { engine: e.id, name: res.name, container: res.container, port: p, image: e.image, volume: res.container, listens: "127.0.0.1" };
        if ( state == "running" ) return say( cmd, 0, merge( data, { already: "running" } ), arguments.asJson, [ res.container & " is already running on 127.0.0.1:" & p ] );
        var verb = len( state ) ? "start the stopped container " & res.container : "create " & res.container & " from " & e.image & " on 127.0.0.1:" & p & " (data in the volume " & res.container & ")" & ( wants ? " with a password you choose" : "" );
        if ( !arguments.yes || arguments.dryRun ) {
            var code = arguments.dryRun ? 0 : 2;
            var lines = [ ( arguments.dryRun ? "Dry run" : "Plan" ) & ": " & cmd & " " & e.id, "  would " & verb, arguments.dryRun ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." ];
            return say( cmd, code, merge( data, { would: verb } ), arguments.asJson, lines, arguments.dryRun );
        }
        if ( len( state ) ) {
            var s = engineExec( [ "start", res.container ], 120 );
            return say( cmd, s.exitCode == 0 ? 0 : 6, merge( data, { started: s.exitCode == 0 } ), arguments.asJson, [ s.exitCode == 0 ? "Started " & res.container : "error: could not start " & res.container & " " & trim( s.output ) ] );
        }
        // create: the secret goes in an env file (mode 600), never on a command line
        var dir = stateDir( res.container );
        // (the folder is created by the first file written, so a refused password leaves nothing behind)
        var envFile = "";
        if ( !structIsEmpty( e.secret ) ) {
            if ( arguments.ask ) {
                var got = askPassword();
                var gotErr = len( got.error ) ? got.error : checkPassword( e.id, got.password );
                if ( len( gotErr ) ) return say( cmd, 4, { error: gotErr }, arguments.asJson, [ "error: " & gotErr ] );
                chosen = got.password;
            }
            // a kept data volume still has the password it was created with: reuse it, and refuse a different choice
            var kept = fileExists( dir & "/password" ) ? trim( fileRead( dir & "/password" ) ) : "";
            if ( len( kept ) && len( chosen ) && kept != chosen ) return say( cmd, 4, { error: "A kept data volume for this name still uses its old password" }, arguments.asJson, [ "error: a kept data volume for this name still uses its old password; remove it with: bxcachy db remove " & e.id & " --delete-data --yes, or start without choosing a password" ] );
            var pw = len( kept ) ? kept : ( len( chosen ) ? chosen : newSecret() & ( e.secret.suffix ?: "" ) );
            if ( len( pw ) < 8 ) return say( cmd, 4, { error: "Could not generate a password" }, arguments.asJson, [ "error: could not generate a password" ] );
            envFile = dir & "/database.env";
            var envText = "";
            for ( var en in e.secret.env ) envText &= en & "=" & pw & chr( 10 );
            variables.config.writeAtomic( dir & "/password", pw & chr( 10 ), "600" );
            variables.config.writeAtomic( envFile, envText, "600" );
        }
        variables.config.writeAtomic( dir & "/meta.json", jsonSerialize( { engine: e.id, name: res.name, port: p, image: e.image, created: now() & "" } ) & chr( 10 ), "600" );
        var r = engineExec( runArgs( e, res.name, res.container, p, envFile ), 1800 );
        if ( r.exitCode != 0 ) {
            if ( !exists( res.container ) && directoryExists( dir ) ) directoryDelete( dir, true );
            return say( cmd, 6, merge( data, { error: trim( r.output ) } ), arguments.asJson, [ "error: " & trim( r.output ) ] );
        }
        var out = [ "Started " & res.container & " on 127.0.0.1:" & p ];
        if ( !structIsEmpty( e.secret ) ) out.append( "Password: " & dir & "/password (mode 600). Show the connection with: bxcachy db info " & e.id & ( res.name != "default" ? " --name=" & res.name : "" ) );
        if ( len( e.note ) ) out.append( "Note: " & e.note );
        return say( cmd, 0, merge( data, { note: e.note, password_file: structIsEmpty( e.secret ) ? "" : dir & "/password" } ), arguments.asJson, out );
    }

    // stop | status | logs: act on an existing container.
    function act( verb, engineId, name, asJson ) {
        var cmd = "db " & arguments.verb;
        var res = resolve( arguments.engineId, arguments.name );
        if ( len( res.error ) ) return say( cmd, res.code, { error: res.error }, arguments.asJson, [ "error: " & res.error ] );
        if ( !engineAvailable() ) return say( cmd, 4, { error: engineCli() & " was not found" }, arguments.asJson, [ "error: " & engineCli() & " was not found" ] );
        var state = stateOf( res.container );
        if ( !len( state ) ) return say( cmd, 4, { error: res.container & " does not exist" }, arguments.asJson, [ "error: " & res.container & " does not exist (start it with: bxcachy db start " & res.engine.id & " --yes)" ] );
        if ( arguments.verb == "status" ) return say( cmd, 0, { container: res.container, status: state, engine: res.engine.id }, arguments.asJson, [ res.container & ": " & state ] );
        if ( arguments.verb == "logs" ) {
            var l = engineExec( [ "logs", "--tail", "200", res.container ], 60 );
            return say( cmd, l.exitCode == 0 ? 0 : 6, { container: res.container, logs: l.output }, arguments.asJson, [ l.output ] );
        }
        var s = engineExec( [ "stop", res.container ], 120 );
        return say( cmd, s.exitCode == 0 ? 0 : 6, { container: res.container, stopped: s.exitCode == 0 }, arguments.asJson, [ s.exitCode == 0 ? "Stopped " & res.container : "error: " & trim( s.output ) ] );
    }

    // `db remove ENGINE [--name N] [--delete-data] --yes`: removes the container; the data volume stays unless --delete-data.
    function remove( engineId, name, deleteData, yes, dryRun, asJson ) {
        var cmd = "db remove";
        var res = resolve( arguments.engineId, arguments.name );
        if ( len( res.error ) ) return say( cmd, res.code, { error: res.error }, arguments.asJson, [ "error: " & res.error ] );
        if ( !engineAvailable() ) return say( cmd, 4, { error: engineCli() & " was not found" }, arguments.asJson, [ "error: " & engineCli() & " was not found" ] );
        var what = "remove the container " & res.container & ( arguments.deleteData ? " AND delete its data volume and password file" : " (the data volume and password file are kept)" );
        if ( !arguments.yes || arguments.dryRun ) {
            var code = arguments.dryRun ? 0 : 2;
            return say( cmd, code, { container: res.container, would: what }, arguments.asJson, [ ( arguments.dryRun ? "Dry run" : "Plan" ) & ": would " & what, arguments.dryRun ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." ], arguments.dryRun );
        }
        var failed = "";
        if ( exists( res.container ) ) { var r = engineExec( [ "rm", "-f", res.container ], 120 ); if ( r.exitCode != 0 ) failed = trim( r.output ); }
        if ( !len( failed ) && arguments.deleteData ) {
            engineExec( [ "volume", "rm", res.container ], 60 );
            if ( directoryExists( stateDir( res.container ) ) ) directoryDelete( stateDir( res.container ), true );
        }
        if ( len( failed ) ) return say( cmd, 6, { container: res.container, error: failed }, arguments.asJson, [ "error: " & failed ] );
        return say( cmd, 0, { container: res.container, removed: true, data_deleted: arguments.deleteData }, arguments.asJson, [ "Removed " & res.container & ( arguments.deleteData ? " and its data" : ". The data volume and password file were kept; start the same name again to reuse them." ) ] );
    }

    // `db info ENGINE [--name N] [--show-password]`: where it listens and how to connect.
    function info( engineId, name, showPassword, asJson ) {
        var cmd = "db info";
        var res = resolve( arguments.engineId, arguments.name );
        if ( len( res.error ) ) return say( cmd, res.code, { error: res.error }, arguments.asJson, [ "error: " & res.error ] );
        var e = res.engine;
        var meta = readMeta( res.container );
        if ( structIsEmpty( meta ) ) return say( cmd, 4, { error: res.container & " was not started by BxCachy" }, arguments.asJson, [ "error: " & res.container & " was not started by BxCachy (start it with: bxcachy db start " & e.id & " --yes)" ] );
        var pwFile = stateDir( res.container ) & "/password";
        var pw = fileExists( pwFile ) ? trim( fileRead( pwFile ) ) : "";
        var shown = arguments.showPassword ? urlEncodedFormat( pw ) : "********";
        var url = structIsEmpty( e.secret ) ? "127.0.0.1:" & meta.port : replace( replace( e.secret.urlTemplate, "{password}", shown ), "{port}", meta.port );
        var lines = [ e.title & " (" & res.container & ")", "  listens on 127.0.0.1:" & meta.port, "  connect:   " & url ];
        if ( len( pw ) ) lines.append( "  password:  " & ( arguments.showPassword ? pw : "in " & pwFile & " (mode 600); add --show-password to print it" ) );
        if ( len( e.note ) ) lines.append( "  note:      " & e.note );
        return say( cmd, 0, { container: res.container, host: "127.0.0.1", port: meta.port, user: e.secret.user ?: "", url: url, password_file: len( pw ) ? pwFile : "", note: e.note }, arguments.asJson, lines );
    }

    // `db engine [podman|docker]`: show or set which container engine runs the services.
    function engine( choice, asJson ) {
        if ( !len( arguments.choice ) ) return say( "db engine", 0, { engine: engineCli() }, arguments.asJson, [ "Container engine: " & engineCli() ] );
        if ( !arrayFind( [ "podman", "docker" ], arguments.choice ) ) return say( "db engine", 2, { error: "Use podman or docker" }, arguments.asJson, [ "error: use podman or docker" ] );
        variables.config.writeAtomic( settingsFile(), jsonSerialize( { engine: arguments.choice } ) & chr( 10 ), "644" );
        return say( "db engine", 0, { engine: arguments.choice }, arguments.asJson, [ "Container engine: " & arguments.choice ] );
    }

    // ---- the control center (`db menu`): the same verbs in a menu, on whichever launcher the runner abstraction is set to ----

    // The first installed terminal, "" when none (the menu runs each action in one so its output stays visible).
    function terminalProgram() {
        for ( var t in [ "ghostty", "kitty", "foot", "alacritty", "konsole" ] ) {
            try { if ( variables.inst.exec( [ "sh", "-c", 'command -v "$1"', "_", t ], 10 ).exitCode == 0 ) return t; } catch ( any e ) {}
        }
        return "";
    }

    function menu() {
        try {
            return runMenu();
        } catch ( any err ) {
            println( "error: " & err.message );
            return 4;
        }
    }

    function runMenu() {
        var runner = new bxcachy.Runner( variables.cli, variables.inst.runner() );
        var term = terminalProgram();
        if ( !len( term ) ) { println( "error: the menu needs a terminal program to show results (ghostty, kitty, foot, alacritty or konsole)" ); return 4; }
        var supported = variables.engines.all().filter( function( e ) { return !structKeyExists( e, "unsupported" ); } );
        var actions = [ [ "Start", "start" ], [ "Stop", "stop" ], [ "Status", "status" ], [ "Connection info", "info" ], [ "Logs", "logs" ], [ "Remove (keeps the data)", "remove" ] ];
        var self = getSystemSetting( "BXCACHY_SELF", "bxcachy" );
        while ( true ) {
            var labels = supported.map( function( e ) { return e.title; } );
            labels.append( "Exit" );
            var pick = runner.select( "Databases", labels );
            if ( pick == 0 || pick == labels.len() ) return 0;
            var e = supported[ pick ];
            var al = actions.map( function( a ) { return a[ 1 ]; } );
            al.append( "Back" );
            var ap = runner.select( e.title, al );
            if ( ap == 0 || ap == al.len() ) continue;
            var verb = actions[ ap ][ 2 ];
            if ( arrayFind( [ "start", "remove" ], verb ) && runner.select( e.title, [ "Cancel", "Confirm " & actions[ ap ][ 1 ] ] ) != 2 ) continue;
            var argv = [ term, "-e", "sh", "-c", 'bxcachy_cmd="$1"; shift; "$bxcachy_cmd" "$@"; echo; echo "Press Enter to close"; read _', "_", self, "db", verb, e.id ];
            if ( arrayFind( [ "start", "remove" ], verb ) ) argv.append( "--yes" );
            var launch = [ "sh", "-c", 'setsid "$@" >/dev/null 2>&1 &', "_" ];
            for ( var part in argv ) launch.append( part );
            variables.inst.exec( launch, 10 );
        }
        return 0;
    }
}
