// `bxcachy ai models`: local models through Ollama.
//   list | ps                the models on disk | the models loaded now (`ollama list`, `ollama ps`)
//   pull NAME                download a model (shows Ollama's progress; the Ollama service must be running)
//   rm NAME --yes            delete a model from disk (plan without --yes)
//   enable [--yes]           start the Ollama service now and at boot (`sudo systemctl enable --now ollama`, the unit the package ships)
//   status                   whether Ollama is installed and its service is running
// A model name is letters, digits and . _ : / - (for example qwen3:8b). It is passed as one argument, never through a shell.
// Exit: 0 done, 2 usage or plan without --yes, 4 precondition (Ollama missing, bad name), otherwise Ollama's own exit code.
class AiModels {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        return this;
    }

    function say( command, code, data, asJson, lines = [] ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data, false ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function tryExec( argv, timeout = 60 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function hasOllama() { return tryExec( [ "sh", "-c", 'command -v ollama' ], 10 ).exitCode == 0; }
    function validModel( name ) { return reFind( "^[A-Za-z0-9._:/-]{1,100}$", arguments.name ) > 0; }

    function missing( cmd, asJson ) {
        return say( arguments.cmd, 4, { error: "Ollama is not installed" }, arguments.asJson, [ "error: Ollama is not installed. Install it: bxcachy install ollama" ] );
    }

    // `ai models list|ps`
    function show( what, asJson ) {
        var cmd = "ai models " & arguments.what;
        if ( !hasOllama() ) return missing( cmd, arguments.asJson );
        var r = tryExec( [ "ollama", arguments.what ], 30 );
        if ( r.exitCode != 0 ) return say( cmd, 6, { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ), "Is the service running? bxcachy ai models enable" ] );
        return say( cmd, 0, { output: trim( r.output ) }, arguments.asJson, [ trim( r.output ) ] );
    }

    // `ai models pull NAME`
    function pull( name, asJson ) {
        var cmd = "ai models pull";
        if ( !validModel( arguments.name ) ) return say( cmd, 4, { error: "Bad model name" }, arguments.asJson, [ "error: a model name is letters, digits and . _ : / - (for example qwen3:8b)" ] );
        if ( !hasOllama() ) return missing( cmd, arguments.asJson );
        if ( arguments.asJson ) {
            var r = tryExec( [ "ollama", "pull", arguments.name ], 7200 );
            return say( cmd, r.exitCode == 0 ? 0 : 6, { model: arguments.name, output: trim( r.output ) }, true );
        }
        var run = systemExecute( "ollama", [ "pull", arguments.name ], 0, false, ".", "", "", true, {}, true );
        if ( run.exitCode != 0 ) println( "Is the service running? bxcachy ai models enable" );
        return run.exitCode;
    }

    // `ai models rm NAME --yes`
    function remove( name, yes, asJson ) {
        var cmd = "ai models rm";
        if ( !validModel( arguments.name ) ) return say( cmd, 4, { error: "Bad model name" }, arguments.asJson, [ "error: bad model name" ] );
        if ( !hasOllama() ) return missing( cmd, arguments.asJson );
        if ( !arguments.yes ) return say( cmd, 2, { model: arguments.name }, arguments.asJson, [ "Plan: delete the model " & arguments.name & " from disk.", "Nothing was changed. Add --yes to apply." ] );
        var r = tryExec( [ "ollama", "rm", arguments.name ], 120 );
        if ( r.exitCode != 0 ) return say( cmd, 6, { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
        return say( cmd, 0, { model: arguments.name }, arguments.asJson, [ trim( r.output ) ] );
    }

    function serviceActive() { return trim( tryExec( [ "systemctl", "is-active", "ollama" ], 10 ).output ) == "active"; }

    // `ai models status`
    function status( asJson ) {
        var inst = hasOllama();
        var active = inst && serviceActive();
        return say( "ai models status", 0, { installed: inst, service_active: active }, arguments.asJson, [ "Ollama: " & ( inst ? "installed" : "not installed" ), "Service: " & ( active ? "running" : "not running" ) ] );
    }

    // `ai models enable [--yes]`
    function enable( yes, dryRun, asJson ) {
        var cmd = "ai models enable";
        if ( !hasOllama() ) return missing( cmd, arguments.asJson );
        var argv = [ "sudo", "systemctl", "enable", "--now", "ollama" ];
        if ( !arguments.yes || arguments.dryRun ) return say( cmd, arguments.dryRun ? 0 : 2, { command: argv }, arguments.asJson, [ ( arguments.dryRun ? "Dry run" : "Plan" ) & ": " & argv.toList( " " ), "Nothing was changed." & ( arguments.dryRun ? "" : " Add --yes to apply." ) ] );
        var r = tryExec( argv, 120 );
        if ( r.exitCode != 0 ) return say( cmd, 6, { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
        return say( cmd, 0, {}, arguments.asJson, [ "The Ollama service is enabled and running." ] );
    }
}
