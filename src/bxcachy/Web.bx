// `bxcachy web`: your own web apps, each with its own window and a launcher entry.
//   add NAME URL [--browser=ID] [--yes]   writes ~/.local/share/applications/bxcachy-web-NAME.desktop (Chromium-family browsers open the URL
//                                         with --app=URL, a window without tabs or address bar; Firefox has no app mode, so it opens a new window)
//   list                                  the web apps BxCachy made
//   rm NAME [--yes]                       deletes the entry
// The browser is --browser (brave, chromium, google-chrome, edge, firefox), else your default browser, else the first of those installed.
// An entry you edited by hand is kept (it is only replaced when it is still the file BxCachy wrote). NAME is letters, digits, - and _.
// Exit: 0 done, 2 plan without --yes, 4 precondition (bad name or URL, no browser found, the file was changed by you), 6 write failed.
// Browser commands: chromium is `chromium`; the others are the vendors' standard names (brave, google-chrome-stable, microsoft-edge-stable,
// firefox), not verified here.
class Web {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        variables.config = new bxcachy.ConfigService().quiet( true );
        return this;
    }

    function say( command, code, data, asJson, lines = [] ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data, false ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function appsDir() { return getSystemSetting( "XDG_DATA_HOME", getSystemSetting( "HOME", "" ) & "/.local/share" ) & "/applications"; }
    function fileFor( name ) { return appsDir() & "/bxcachy-web-" & arguments.name & ".desktop"; }
    function validName( name ) { return reFind( "^[A-Za-z0-9_-]{1,40}$", arguments.name ) > 0; }
    function validUrl( url ) { return reFind( "^https?://[^ ""'<>]+$", arguments.url ) > 0; }

    // id -> { cmd, app }: the command and whether it has an app mode.
    function browsers() {
        return {
            brave: { cmd: "brave", app: true },
            chromium: { cmd: "chromium", app: true },
            "google-chrome": { cmd: "google-chrome-stable", app: true },
            edge: { cmd: "microsoft-edge-stable", app: true },
            firefox: { cmd: "firefox", app: false }
        };
    }

    function installed( cmd ) {
        try { return variables.inst.exec( [ "sh", "-c", 'command -v "$1"', "_", arguments.cmd ], 10 ).exitCode == 0; } catch ( any e ) { return false; }
    }

    // The browser id to use: the one asked for, else the default browser, else the first installed.
    function pickBrowser( asked ) {
        var all = browsers();
        if ( len( arguments.asked ) ) return structKeyExists( all, arguments.asked ) ? arguments.asked : "";
        var dflt = "";
        try { dflt = trim( variables.inst.exec( [ "xdg-settings", "get", "default-web-browser" ], 10 ).output ); } catch ( any e ) {}
        for ( var id in structKeyArray( all ) ) if ( len( dflt ) && find( id, lcase( dflt ) ) > 0 && installed( all[ id ].cmd ) ) return id;
        for ( var id2 in [ "brave", "chromium", "google-chrome", "edge", "firefox" ] ) if ( installed( all[ id2 ].cmd ) ) return id2;
        return "";
    }

    function entryText( name, url, browser ) {
        var b = browsers()[ arguments.browser ];
        var exec = b.app ? b.cmd & " --app=" & arguments.url : b.cmd & " --new-window " & arguments.url;
        return "[Desktop Entry]" & chr( 10 ) & "# Written by bxcachy (web add). Edit it freely: BxCachy will not overwrite a changed file." & chr( 10 )
            & "Type=Application" & chr( 10 ) & "Name=" & arguments.name & chr( 10 ) & "Exec=" & exec & chr( 10 ) & "Icon=web-browser" & chr( 10 )
            & "Categories=Network;" & chr( 10 ) & "X-BxCachy-Web=" & arguments.url & chr( 10 );
    }

    // Asks for the name, the URL and the browser on the terminal (visible, one line each; Enter leaves the browser to the default).
    // BXCACHY_TTY_IN names a file to read the three lines from instead (tests). Returns { name, url, browser } (empty strings when nothing was typed).
    function askDetails() {
        var script = 'in="${BXCACHY_TTY_IN:-/dev/tty}"; exec 3< "$in"; for p in "Name: " "URL: " "Browser (brave, chromium, google-chrome, edge, firefox; Enter for the default): "; do [ "$in" = /dev/tty ] && printf "%s" "$p" > /dev/tty; IFS= read -r v <&3; printf "%s\n" "$v"; done';
        var out = "";
        try { out = variables.inst.exec( [ "sh", "-c", script ], 600 ).output; } catch ( any e ) {}
        var lines = listToArray( out, chr( 10 ), true );
        while ( lines.len() < 3 ) lines.append( "" );
        return { name: trim( lines[ 1 ] ), url: trim( lines[ 2 ] ), browser: trim( lines[ 3 ] ) };
    }

    // `web add` with no arguments: asks for the details, then adds the app (typing them is the consent, no --yes needed).
    function addInteractive( asJson ) {
        var d = askDetails();
        if ( !len( d.name ) || !len( d.url ) ) return say( "web add", 4, { error: "Name and URL are required" }, arguments.asJson, [ "error: a name and a URL are needed (this prompt needs a terminal)" ] );
        return add( d.name, d.url, d.browser, true, arguments.asJson );
    }

    // `web add NAME URL`
    function add( name, url, browser, yes, asJson ) {
        var cmd = "web add";
        if ( !validName( arguments.name ) ) return say( cmd, 4, { error: "Bad name" }, arguments.asJson, [ "error: a name is letters, digits, - and _ (up to 40)" ] );
        if ( !validUrl( arguments.url ) ) return say( cmd, 4, { error: "Bad URL" }, arguments.asJson, [ "error: the URL must start with http:// or https:// and have no spaces or quotes" ] );
        var b = pickBrowser( arguments.browser );
        if ( !len( b ) ) return say( cmd, 4, { error: "No browser" }, arguments.asJson, [ len( arguments.browser ) ? "error: unknown browser " & arguments.browser & " (use brave, chromium, google-chrome, edge, firefox)" : "error: no supported browser is installed. Install one: bxcachy install brave" ] );
        var entry = { name: "web-" & arguments.name, target: fileFor( arguments.name ), mode: "644", content: entryText( arguments.name, arguments.url, b ) };
        var state = variables.config.configState( entry );
        var data = { name: arguments.name, url: arguments.url, browser: b, file: entry.target, app_mode: browsers()[ b ].app };
        if ( state == "drifted" || state == "blocked" ) return say( cmd, 4, merge( data, { error: "Changed by you" } ), arguments.asJson, [ "error: " & entry.target & " was changed by you, so it was kept. Delete it (bxcachy web rm " & arguments.name & " --yes) to start over." ] );
        if ( !arguments.yes ) return say( cmd, 2, data, arguments.asJson, [ "Plan: add the web app " & arguments.name & " (" & arguments.url & ") with " & b & ( browsers()[ b ].app ? " in app mode" : " (no app mode: opens a new window)" ), "Nothing was changed. Add --yes to apply." ] );
        if ( variables.config.configWrite( entry, entry.content, "apply", true, false ) != 0 ) return say( cmd, 6, merge( data, { error: "Could not write the entry" } ), arguments.asJson, [ "error: could not write " & entry.target ] );
        return say( cmd, 0, data, arguments.asJson, [ "Added " & arguments.name & ". Find it in your app launcher." ] );
    }

    function merge( base, extra ) {
        var out = {};
        for ( var k in structKeyArray( arguments.base ) ) out[ k ] = arguments.base[ k ];
        for ( var k in structKeyArray( arguments.extra ) ) out[ k ] = arguments.extra[ k ];
        return out;
    }

    // The web apps BxCachy made: [ { name, url } ].
    function apps() {
        var out = [];
        if ( !directoryExists( appsDir() ) ) return out;
        for ( var f in directoryList( appsDir(), false, "name" ) ) {
            if ( left( f, 12 ) != "bxcachy-web-" || right( f, 8 ) != ".desktop" ) continue;
            var n = mid( f, 13, len( f ) - 20 );
            var url = "";
            for ( var line in listToArray( fileRead( appsDir() & "/" & f ), chr( 10 ) ) ) if ( left( line, 14 ) == "X-BxCachy-Web=" ) url = mid( line, 15, len( line ) );
            out.append( { name: n, url: url } );
        }
        return out;
    }

    function list( asJson ) {
        var rows = apps();
        return say( "web list", 0, { apps: rows }, arguments.asJson, rows.len() ? rows.map( function( r ) { return r.name & "  " & r.url; } ) : [ "No web apps yet. Add one: bxcachy web add NAME URL" ] );
    }

    // `web rm NAME [--yes]`
    function remove( name, yes, asJson ) {
        var cmd = "web rm";
        if ( !validName( arguments.name ) ) return say( cmd, 4, { error: "Bad name" }, arguments.asJson, [ "error: bad name" ] );
        var f = fileFor( arguments.name );
        if ( !fileExists( f ) ) return say( cmd, 4, { error: "No such web app" }, arguments.asJson, [ "error: there is no web app " & arguments.name ] );
        if ( !arguments.yes ) return say( cmd, 2, { name: arguments.name }, arguments.asJson, [ "Plan: delete " & f, "Nothing was changed. Add --yes to apply." ] );
        fileDelete( f );
        return say( cmd, 0, { name: arguments.name }, arguments.asJson, [ arguments.name & " was removed." ] );
    }
}
