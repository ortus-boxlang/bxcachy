// Machines: databases and VMs that BxCachy runs, with start and stop. Reads `db list` and `vm list` (through DashboardData).
class MachinesProvider {
    function init( demo = false, data = "" ) { variables.demo = arguments.demo; variables.data = isSimpleValue( arguments.data ) ? new bxcachy.DashboardData( {} ) : arguments.data; return this; }
    function id() { return "machines"; }
    function title() { return "Machines"; }
    function hint() { return "databases and VMs"; }
    function live() { return false; }
    function emptyText() { return "No databases or VMs yet. Start one: bxcachy db start postgres --yes"; }
    function columns() { return [ { key: "mark", label: "", w: 3 }, { key: "name", label: "name", w: 22 }, { key: "kind", label: "kind", w: 8 }, { key: "state", label: "state", w: 10 }, { key: "port", label: "port", w: 8 }, { key: "engine", label: "engine / what", w: 0 } ]; }
    function style( r ) { return r.state == "running" ? "" : "dim"; }
    function detail( r ) { return [ r.kind == "db" ? "Database " & r.name & " (" & r.engine & ")" & ( r.port ? " on port " & r.port : "" ) : "VM " & r.name & " (" & r.engine & ")", r.state == "running" ? "Running. Press s to stop it." : "Stopped. Press s to start it." ]; }

    function actions() {
        return [
            { key: "s", label: "start/stop", run: function( r ) {
                var verb = r.state == "running" ? "stop" : "start";
                var args = r.kind == "db" ? [ "db", verb, r.engine, "--name=" & r.name ] : [ "vm", verb, r.name ];
                return { action: "cli", title: ( verb == "stop" ? "Stop " : "Start " ) & r.name, args: args };
            } },
            { key: "i", label: "info", run: function( r ) { return { action: "show", title: "Info: " & r.name, args: r.kind == "db" ? [ "db", "info", r.engine, "--name=" & r.name ] : [ "vm", "info", r.name ] }; } }
        ];
    }

    function load( q = "" ) {
        var src = variables.data.machines();
        var rows = [];
        for ( var m in src ) rows.append( { mark: m.state == "running" ? "●" : "○", name: m.name, kind: m.kind, state: m.state, port: m.port ? m.port : "", engine: m.engine ?: "" } );
        return rows;
    }
}
