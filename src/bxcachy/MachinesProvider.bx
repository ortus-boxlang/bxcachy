// Machines: the VMs BxCachy runs (Windows and Linux desktops in containers), with start, stop, info and create. Reads `vm list` (through DashboardData).
class MachinesProvider {
    function init( demo = false, data = "" ) { variables.demo = arguments.demo; variables.data = isSimpleValue( arguments.data ) ? new bxcachy.DashboardData( {} ) : arguments.data; return this; }
    function id() { return "machines"; }
    function title() { return "Machines"; }
    function hint() { return "Windows and Linux desktops in containers"; }
    function live() { return false; }
    function emptyText() { return "No VMs yet. Press n to create a Linux desktop."; }
    function columns() { return [ { key: "mark", label: "", w: 3 }, { key: "name", label: "name", w: 22 }, { key: "kind", label: "kind", w: 8 }, { key: "state", label: "state", w: 10 }, { key: "port", label: "port", w: 8 }, { key: "engine", label: "what", w: 0 } ]; }
    function style( r ) { return r.state == "running" ? "" : "dim"; }
    function detail( r ) { return [ "VM " & r.name & " (" & r.engine & ")" & ( r.port ? " on port " & r.port : "" ), r.state == "running" ? "Running. Press s to stop it." : "Stopped. Press s to start it." ]; }

    function actions() {
        return [
            { key: "s", label: "start/stop", run: function( r ) { var verb = r.state == "running" ? "stop" : "start"; return { action: "cli", title: ( verb == "stop" ? "Stop " : "Start " ) & r.name, args: [ "vm", verb, r.name ] }; } },
            { key: "i", label: "info", run: function( r ) { return { action: "show", title: "Info: " & r.name, args: [ "vm", "info", r.name ] }; } },
            { key: "n", label: "new Linux", run: function( r ) { return { action: "ask", title: "New Linux desktop", prompt: "Name for the VM (letters, digits, dashes)", make: function( v ) { return { action: "cli", title: "Create " & v, args: [ "vm", "create", "linux", v ] }; } }; } }
        ];
    }

    function load( q = "" ) {
        var src = variables.data.machines();
        var rows = [];
        for ( var m in src ) if ( m.kind == "vm" ) rows.append( { mark: m.state == "running" ? "●" : "○", name: m.name, kind: m.kind, state: m.state, port: m.port ? m.port : "", engine: m.engine ?: "" } );
        return rows;
    }
}
