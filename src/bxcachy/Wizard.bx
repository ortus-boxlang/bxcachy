// Runs the setup wizard: draws WizardView frames on the MatchBox terminal canvas and feeds keys, clicks and the mouse
// wheel to WizardApp until the user finishes (Enter on the review) or cancels (Ctrl+C). It runs nothing itself:
// the caller acts on the answers.
//
//   result = new bxcachy.Wizard( spec, preset ).run();   // { outcome: "done"|"cancelled", answers: {...} }
class Wizard {
    function init( spec, preset = {} ) {
        variables.app = new bxcachy.WizardApp( arguments.spec, arguments.preset );
        return this;
    }

    function app() { return variables.app; }

    // One event from the terminal: a key, a click, the wheel (resizes just redraw).
    function handle( ev ) {
        if ( arguments.ev.type == "key" ) variables.app.onKey( arguments.ev.key );
        else if ( arguments.ev.type == "click" ) variables.app.act( variables.view.hitAt( arguments.ev.x, arguments.ev.y ) );
        else if ( arguments.ev.type == "scroll" ) variables.app.onScroll( arguments.ev.direction );
        return this;
    }

    function run() {
        variables.tui = createObject( "rust", "tui.TUI" );
        variables.view = new bxcachy.WizardView( variables.tui );
        variables.tui.init();
        try {
            var tick = 0;
            while ( variables.app.outcome() == "running" ) {
                var size = variables.tui.size();
                variables.view.paint( variables.app, tick, size.width, size.height );
                variables.tui.end_frame();
                var ev = variables.tui.poll_event( 50 );
                if ( !isNull( ev ) ) handle( ev );
                tick++;
            }
        } finally {
            variables.tui.shutdown();
        }
        return { outcome: variables.app.outcome(), answers: variables.app.finalAnswers() };
    }
}
