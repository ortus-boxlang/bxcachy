// `bxcachy ai session`: coding agents that keep running when you close the terminal, as tmux sessions.
//   start [ID] [--name=N] [--dir=PATH]   a detached session `bxcachy-AGENT[-N]` running the agent (the default one when no ID) in PATH
//                                         (the current folder by default), with only its own API keys loaded (`secrets run`)
//   list                                  your BxCachy sessions
//   attach NAME                           join one (needs a terminal); detach with the tmux prefix then d
//   stop NAME --yes                       end one (plan without --yes)
// NAME is the full session name or what follows `bxcachy-`. Exit: 0 done, 2 usage or plan without --yes, 4 precondition (tmux or the agent
// missing, bad name, no such session), 6 a tmux command failed.
class AiSession {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        variables.ai = new bxcachy.Ai( arguments.cli, arguments.runner );
        variables.agents = new bxcachy.AiAgents();
        return this;
    }

    function prefix() { return "bxcachy-"; }

    function say( command, code, data, asJson, lines = [], dryRun = false ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data, arguments.dryRun ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function tryExec( argv, timeout = 30 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function validPart( text ) { return reFind( "^[A-Za-z0-9_-]{1,40}$", arguments.text ) > 0; }

    // Full session name for what the user typed.
    function fullName( name ) {
        return left( arguments.name, len( prefix() ) ) == prefix() ? arguments.name : prefix() & arguments.name;
    }

    // The names of BxCachy's tmux sessions (empty when tmux has no server running).
    function names() {
        var r = tryExec( [ "tmux", "list-sessions", "-F", "##{session_name}" ], 15 );
        if ( r.exitCode != 0 ) return [];
        return listToArray( r.output, chr( 10 ) ).map( function( n ) { return trim( n ); } ).filter( function( n ) { return left( n, len( prefix() ) ) == prefix(); } );
    }

    function hasTmux() { return tryExec( [ "sh", "-c", 'command -v tmux' ], 10 ).exitCode == 0; }

    function quoted( argv ) {
        var q = chr( 39 );
        return arguments.argv.map( function( w ) { return q & replace( w, q, q & chr( 92 ) & q & q, "all" ) & q; } ).toList( " " );
    }

    // `ai session start [ID] [--name=N] [--dir=PATH] [--dry-run]`
    function start( id, name, dir, dryRun, asJson ) {
        var cmd = "ai session start";
        var pick = len( arguments.id ) ? arguments.id : variables.ai.defaultId();
        if ( !len( pick ) ) return say( cmd, 4, { error: "No agent" }, arguments.asJson, [ "error: no agent given and no default set. Use: bxcachy ai session start claude-code" ] );
        var a = variables.agents.find( pick );
        if ( structIsEmpty( a ) ) return say( cmd, 4, { error: "Unknown agent" }, arguments.asJson, [ "error: unknown agent " & pick & " (use " & variables.agents.ids().toList( ", " ) & ")" ] );
        if ( len( arguments.name ) && !validPart( arguments.name ) ) return say( cmd, 4, { error: "Bad name" }, arguments.asJson, [ "error: a session name is letters, digits, - and _ (up to 40)" ] );
        if ( !hasTmux() ) return say( cmd, 4, { error: "tmux is not installed" }, arguments.asJson, [ "error: tmux is not installed. Install it: bxcachy install tmux" ] );
        if ( !variables.ai.installed( a.command ) ) return say( cmd, 4, { error: a.id & " is not installed" }, arguments.asJson, [ "error: " & a.name & " is not installed. Install it first: bxcachy install " & a.id ] );
        var folder = len( arguments.dir ) ? arguments.dir : getSystemSetting( "PWD", "." );
        if ( !directoryExists( folder ) ) return say( cmd, 4, { error: "No such folder" }, arguments.asJson, [ "error: " & folder & " is not a folder" ] );
        var session = prefix() & a.id & ( len( arguments.name ) ? "-" & arguments.name : "" );
        var inner = variables.ai.agentCommand( a );
        var argv = [ "tmux", "new-session", "-d", "-s", session, "-c", folder, quoted( inner ) ];
        var data = { session: session, agent: a.id, dir: folder, command: argv };
        if ( arrayFind( names(), session ) ) return say( cmd, 0, merge( data, { existed: true } ), arguments.asJson, [ session & " is already running. Join it: bxcachy ai session attach " & session ] );
        if ( arguments.dryRun ) return say( cmd, 0, data, arguments.asJson, [ "Dry run: " & argv.toList( " " ) ], true );
        var r = tryExec( argv, 30 );
        if ( r.exitCode != 0 ) return say( cmd, 6, merge( data, { error: trim( r.output ) } ), arguments.asJson, [ "error: tmux could not start the session: " & trim( r.output ) ] );
        return say( cmd, 0, merge( data, { existed: false } ), arguments.asJson, [ "Started " & session & " in " & folder & ". Join it: bxcachy ai session attach " & session ] );
    }

    function merge( base, extra ) {
        var out = {};
        for ( var k in structKeyArray( arguments.base ) ) out[ k ] = arguments.base[ k ];
        for ( var k in structKeyArray( arguments.extra ) ) out[ k ] = arguments.extra[ k ];
        return out;
    }

    // `ai session list`
    function list( asJson ) {
        var all = names();
        return say( "ai session list", 0, { sessions: all }, arguments.asJson, all.len() ? all : [ "No agent sessions are running. Start one: bxcachy ai session start" ] );
    }

    // `ai session attach NAME`
    function attach( name, asJson ) {
        var cmd = "ai session attach";
        if ( !validPart( replace( arguments.name, prefix(), "" ) ) ) return say( cmd, 4, { error: "Bad name" }, arguments.asJson, [ "error: bad session name" ] );
        if ( !hasTmux() ) return say( cmd, 4, { error: "tmux is not installed" }, arguments.asJson, [ "error: tmux is not installed. Install it: bxcachy install tmux" ] );
        var session = fullName( arguments.name );
        if ( !arrayFind( names(), session ) ) return say( cmd, 4, { error: "No such session" }, arguments.asJson, [ "error: no session " & session & " (see: bxcachy ai session list)" ] );
        var r = systemExecute( "tmux", [ "attach-session", "-t", session ], 0, false, ".", "", "", true, {}, true );
        return r.exitCode;
    }

    // `ai session stop NAME --yes`
    function stop( name, yes, asJson ) {
        var cmd = "ai session stop";
        if ( !validPart( replace( arguments.name, prefix(), "" ) ) ) return say( cmd, 4, { error: "Bad name" }, arguments.asJson, [ "error: bad session name" ] );
        var session = fullName( arguments.name );
        if ( !arrayFind( names(), session ) ) return say( cmd, 4, { error: "No such session" }, arguments.asJson, [ "error: no session " & session ] );
        if ( !arguments.yes ) return say( cmd, 2, { session: session }, arguments.asJson, [ "Plan: end " & session & " and whatever is running in it.", "Nothing was changed. Add --yes to apply." ] );
        var r = tryExec( [ "tmux", "kill-session", "-t", session ], 15 );
        if ( r.exitCode != 0 ) return say( cmd, 6, { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
        return say( cmd, 0, { session: session }, arguments.asJson, [ session & " was ended." ] );
    }
}
