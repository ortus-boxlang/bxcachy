// `bxcachy containers`: Podman made comfortable, and docker commands that work on it.
//   doctor                  checks: Podman installed, rootless, subuid/subgid, compose, the user socket, the docker shim
//   socket enable [--yes]   starts the rootless API socket (systemctl --user enable --now podman.socket) and prints DOCKER_HOST
//   docker-compat [--yes]   installs podman-docker (a `docker` command that runs Podman) and podman-compose (`sudo pacman -S --needed`)
// podman-docker conflicts with the docker package, so it is refused while docker is installed. Package names checked on archlinux.org
// 2026-11-12 (podman-docker ships /usr/bin/docker; podman ships podman.socket as a user unit too).
// Exit: 0 done / all checks pass, 2 plan without --yes, 4 precondition (or a check failed in `doctor`), 6 a command failed.
class Containers {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        return this;
    }

    function say( command, code, data, asJson, lines = [] ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data, false ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function tryExec( argv, timeout = 30 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function has( name ) { return tryExec( [ "sh", "-c", 'command -v "$1"', "_", arguments.name ], 10 ).exitCode == 0; }
    function pacmanHas( pkg ) { return tryExec( [ "pacman", "-Q", arguments.pkg ], 15 ).exitCode == 0; }

    function check( id, ok, detail, fix = "" ) { return { id: arguments.id, ok: arguments.ok, detail: arguments.detail, fix: arguments.fix }; }

    // `containers doctor`
    function doctor( asJson ) {
        var rows = [];
        var podman = has( "podman" );
        rows.append( check( "podman", podman, podman ? "installed" : "not installed", "bxcachy profile-install containers" ) );
        if ( podman ) {
            var rl = tryExec( [ "podman", "info", "--format", "{{.Host.Security.Rootless}}" ], 30 );
            var rootless = trim( rl.output ) == "true";
            rows.append( check( "rootless", rootless, rootless ? "running without root" : "podman is not rootless for this user" ) );
            var user = getSystemSetting( "USER", "" );
            var etc = getSystemSetting( "BXCACHY_ETC", "/etc" );
            var subs = tryExec( [ "sh", "-c", 'grep -q "^$1:" "$2/subuid" && grep -q "^$1:" "$2/subgid"', "_", user, etc ], 10 ).exitCode == 0;
            rows.append( check( "subuid", subs, subs ? "subuid and subgid entries exist" : "no subuid/subgid range for " & user, "sudo usermod --add-subuids 100000-165535 --add-subgids 100000-165535 " & user ) );
            var compose = has( "podman-compose" ) || has( "docker-compose" );
            rows.append( check( "compose", compose, compose ? "a compose tool is installed" : "no compose tool", "bxcachy containers docker-compat" ) );
            var sock = trim( tryExec( [ "systemctl", "--user", "is-active", "podman.socket" ], 10 ).output ) == "active";
            rows.append( check( "socket", sock, sock ? "the user socket is active" : "the user socket is not active (tools that expect the Docker API need it)", "bxcachy containers socket enable" ) );
            var shim = has( "docker" ) && find( "podman", lcase( tryExec( [ "docker", "--version" ], 10 ).output ) ) > 0;
            rows.append( check( "docker-shim", shim, shim ? "`docker` runs Podman" : "no docker command that runs Podman", "bxcachy containers docker-compat" ) );
        }
        var bad = rows.filter( function( r ) { return !r.ok; } );
        var lines = rows.map( function( r ) { return ( r.ok ? "ok    " : "FIX   " ) & r.id & ": " & r.detail & ( !r.ok && len( r.fix ) ? "   -> " & r.fix : "" ); } );
        return say( "containers doctor", bad.len() ? 4 : 0, { ok: !bad.len(), checks: rows }, arguments.asJson, lines );
    }

    // `containers socket enable [--yes]`
    function socketEnable( yes, asJson ) {
        var cmd = "containers socket enable";
        var argv = [ "systemctl", "--user", "enable", "--now", "podman.socket" ];
        var host = "unix://" & getSystemSetting( "XDG_RUNTIME_DIR", "/run/user/1000" ) & "/podman/podman.sock";
        if ( !has( "podman" ) ) return say( cmd, 4, { error: "Podman is not installed" }, arguments.asJson, [ "error: Podman is not installed. Install it: bxcachy profile-install containers" ] );
        if ( !arguments.yes ) return say( cmd, 2, { command: argv, docker_host: host }, arguments.asJson, [ "Plan: " & argv.toList( " " ), "Then tools that speak the Docker API use DOCKER_HOST=" & host, "Nothing was changed. Add --yes to apply." ] );
        var r = tryExec( argv, 30 );
        if ( r.exitCode != 0 ) return say( cmd, 6, { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
        return say( cmd, 0, { docker_host: host }, arguments.asJson, [ "The Podman socket is active.", "Point Docker-API tools at it: export DOCKER_HOST=" & host ] );
    }

    // `containers docker-compat [--yes]`
    function dockerCompat( yes, asJson ) {
        var cmd = "containers docker-compat";
        if ( pacmanHas( "docker" ) ) return say( cmd, 4, { error: "docker is installed" }, arguments.asJson, [ "error: the docker package is installed and conflicts with podman-docker. Remove it first, or keep using real Docker (bxcachy db engine docker)." ] );
        var pkgs = [];
        for ( var p in [ "podman-docker", "podman-compose" ] ) if ( !pacmanHas( p ) ) pkgs.append( p );
        var data = { packages: pkgs };
        if ( !pkgs.len() ) return say( cmd, 0, data, arguments.asJson, [ "Already in place: `docker` runs Podman and podman-compose is installed." ] );
        if ( !arguments.yes ) return say( cmd, 2, data, arguments.asJson, [ "Plan: sudo pacman -S --needed " & pkgs.toList( " " ), "After it, `docker ...` and `docker compose ...` run on Podman.", "Nothing was changed. Add --yes to apply." ] );
        var argv = [ "sudo", "pacman", "-S", "--needed", "--noconfirm" ];
        for ( var q in pkgs ) argv.append( q );
        var r = tryExec( argv, 1800 );
        if ( r.exitCode != 0 ) return say( cmd, 6, { error: trim( r.output ) }, arguments.asJson, [ "error: could not install " & pkgs.toList( ", " ) & ": " & trim( r.output ) ] );
        return say( cmd, 0, data, arguments.asJson, [ "Installed " & pkgs.toList( ", " ) & ". `docker` now runs Podman. Optional: bxcachy containers socket enable" ] );
    }
}
