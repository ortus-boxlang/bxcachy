// `bxcachy secrets`: the one way to store API keys and tokens, and to load them into a program's environment.
//   set NAME [--from-file=F]   store a value (typed hidden at the terminal, or read from a file; never given on the command line)
//   list | get NAME [--show] | unset NAME --yes | status
//   run [NAMES...] -- CMD...   run CMD with those secrets in ITS environment only (nothing is written to disk)
//   env [NAMES...]             print `export NAME='value'` lines, for `eval` (the opt-in global export builds on this)
// Names are plain environment variable names (ANTHROPIC_API_KEY ...). Values live in the desktop keyring (libsecret, `secret-tool`)
// when one is running; otherwise in private files (mode 600 in a mode 700 folder). The choice is saved in secrets.json and shown by
// `status`. Values are never printed unless you ask (get --show, env), never put on a command line, never logged, never in answers.json.
// Exit codes: 0 done, 2 usage or plan without --yes, 4 precondition (bad name, missing secret, no value), 6 the store failed.
class Secrets {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        variables.config = new bxcachy.ConfigService();
        return this;
    }

    // ---- registry: the keys the coding agents read (vendor docs; the user can store any other valid name too) ----
    function known() {
        return [
            { name: "ANTHROPIC_API_KEY", label: "Anthropic API key", used_by: [ "claude-code" ], commands: [ "claude" ] },
            { name: "OPENAI_API_KEY", label: "OpenAI API key", used_by: [ "codex-cli" ], commands: [ "codex" ] },
            { name: "GEMINI_API_KEY", label: "Google Gemini API key", used_by: [ "gemini-cli" ], commands: [ "gemini" ] }
        ];
    }

    function validName( name ) { return reFind( "^[A-Z_][A-Z0-9_]{0,63}$", arguments.name ) > 0; }

    // ---- paths and settings ----
    function settingsFile() { return variables.config.cfgHome() & "/bxcachy/secrets.json"; }
    function dataHome() { return getSystemSetting( "BXCACHY_DATA_HOME", getSystemSetting( "HOME", "" ) & "/.local/share/bxcachy" ); }
    function fileDir() { return dataHome() & "/secrets"; }

    function say( command, code, data, asJson, lines = [] ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data, false ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    // Runs argv (no shell involved unless argv is sh -c). `input` goes to the program's standard input. Returns { exitCode, output }.
    function sx( argv, timeout = 60, input = "" ) {
        var rest = [];
        for ( var i = 2; i <= arguments.argv.len(); i++ ) rest.append( arguments.argv[ i ] );
        if ( len( arguments.input ) ) return systemExecute( arguments.argv[ 1 ], rest, arguments.timeout, true, ".", "", "", true, {}, false, arguments.input );
        return systemExecute( arguments.argv[ 1 ], rest, arguments.timeout, true );
    }

    function hasCommand( name ) {
        try { return sx( [ "sh", "-c", 'command -v "$1"', "_", arguments.name ], 10 ).exitCode == 0; } catch ( any e ) { return false; }
    }

    // ---- backends ----

    // True when `secret-tool` exists and a Secret Service (KWallet, GNOME Keyring, KeePassXC ...) is running or can be started.
    function keyringAvailable() {
        if ( !hasCommand( "secret-tool" ) ) return false;
        try {
            var r = sx( [ "sh", "-c", '{ busctl --user list --no-legend 2>/dev/null; busctl --user list --activatable --no-legend 2>/dev/null; } | grep -q "org.freedesktop.secrets"' ], 15 );
            return r.exitCode == 0;
        } catch ( any e ) { return false; }
    }

    // The backend in use: the saved choice, else keyring when one is available, else file.
    function backend() {
        var saved = readSettings().backend;
        if ( arrayFind( [ "keyring", "file" ], saved ) ) return saved;
        return keyringAvailable() ? "keyring" : "file";
    }

    function readSettings() {
        var d = { backend: "", global: [] };
        if ( fileExists( settingsFile() ) ) {
            try {
                var s = jsonDeserialize( fileRead( settingsFile() ) );
                d.backend = s.backend ?: "";
                d.global = isArray( s.global ?: "" ) ? s.global : [];
            } catch ( any e ) {}
        }
        return d;
    }

    function writeSettings( s ) {
        var body = serializeJSON( arguments.s ) & chr( 10 );
        return variables.config.configWrite( { name: "secrets-settings", target: settingsFile(), mode: "600", content: body }, body, "apply", true, false ) == 0;
    }

    function setBackend( name ) {
        var s = readSettings();
        s.backend = arguments.name;
        return writeSettings( s );
    }

    // Stores a value. Returns "" or an error message.
    function store( name, value ) {
        if ( backend() == "keyring" ) {
            var r = sx( [ "secret-tool", "store", "--label=BxCachy " & arguments.name, "service", "bxcachy", "name", arguments.name ], 60, arguments.value );
            return r.exitCode == 0 ? "" : "the keyring refused the value: " & trim( r.output );
        }
        var f = fileDir() & "/" & arguments.name;
        var w = sx( [ "sh", "-c", 'umask 077; mkdir -p "$1" && chmod 700 "$1" && cat > "$2" && chmod 600 "$2"', "_", fileDir(), f ], 30, arguments.value );
        return w.exitCode == 0 ? "" : "could not write the private file";
    }

    // The stored value, or "" when there is none (a stored value is never empty).
    function fetch( name ) {
        if ( backend() == "keyring" ) {
            var r = sx( [ "secret-tool", "lookup", "service", "bxcachy", "name", arguments.name ], 30 );
            return r.exitCode == 0 ? reReplace( r.output, "[\r\n]+$", "" ) : "";
        }
        var f = fileDir() & "/" & arguments.name;
        return fileExists( f ) ? reReplace( fileRead( f ), "[\r\n]+$", "" ) : "";
    }

    function drop( name ) {
        if ( backend() == "keyring" ) return sx( [ "secret-tool", "clear", "service", "bxcachy", "name", arguments.name ], 30 ).exitCode == 0;
        var f = fileDir() & "/" & arguments.name;
        if ( fileExists( f ) ) fileDelete( f );
        return true;
    }

    // Names that have a stored value, sorted.
    function names() {
        var out = [];
        if ( backend() == "keyring" ) {
            var r = sx( [ "secret-tool", "search", "--all", "service", "bxcachy" ], 30 );
            for ( var line in listToArray( r.output, chr( 10 ) ) ) {
                var t = trim( line );
                if ( left( t, 17 ) == "attribute.name = " ) out.append( trim( mid( t, 18, len( t ) ) ) );
            }
        } else if ( directoryExists( fileDir() ) ) {
            for ( var f in directoryList( fileDir(), false, "name" ) ) if ( validName( f ) ) out.append( f );
        }
        return out.sort( function( a, b ) { return compare( a, b ); } );
    }

    // Reads one value without echo. BXCACHY_TTY_IN names a file to read the line from instead (tests). The prompt goes to the
    // terminal, the value comes back on standard output, so nothing is written to disk. Returns the value or "".
    function ask( label ) {
        var script = 'in="${BXCACHY_TTY_IN:-/dev/tty}"; exec 3< "$in"; if [ "$in" = /dev/tty ]; then printf "%s" "$1" > /dev/tty; stty -echo < /dev/tty; fi; IFS= read -r v <&3; if [ "$in" = /dev/tty ]; then stty echo < /dev/tty; echo > /dev/tty; fi; printf "%s" "$v"';
        try { return sx( [ "sh", "-c", script, "_", arguments.label ], 600 ).output; } catch ( any e ) { return ""; }
    }

    function usedBy( name ) {
        for ( var k in known() ) if ( k.name == arguments.name ) return k.used_by;
        return [];
    }

    // ---- verbs ----

    // `secrets status`
    function status( asJson ) {
        var be = backend();
        var kr = keyringAvailable();
        var n = names().len();
        var data = { backend: be, keyring_available: kr, count: n };
        var lines = [ "Backend: " & ( be == "keyring" ? "desktop keyring (libsecret)" : "private files in " & fileDir() ), "Keyring available: " & ( kr ? "yes" : "no" ), "Stored secrets: " & n ];
        if ( be == "file" && !kr ) arrayAppend( lines, "No keyring was found. Run `bxcachy secrets setup` to install one, or keep the private files." );
        return say( "secrets status", 0, data, arguments.asJson, lines );
    }

    // `secrets set NAME [--from-file=F]`. Replaces an existing value.
    function setValue( name, fromFile, asJson ) {
        var cmd = "secrets set";
        if ( !validName( arguments.name ) ) return say( cmd, 4, { error: "Bad name" }, arguments.asJson, [ "error: a secret name looks like ANTHROPIC_API_KEY (capital letters, digits, underscores)" ] );
        var value = "";
        if ( len( arguments.fromFile ) ) {
            if ( !fileExists( arguments.fromFile ) ) return say( cmd, 4, { error: "File not found" }, arguments.asJson, [ "error: " & arguments.fromFile & " was not found" ] );
            value = reReplace( fileRead( arguments.fromFile ), "[\r\n]+$", "" );
        } else {
            value = reReplace( ask( arguments.name & ": " ), "[\r\n]+$", "" );
        }
        if ( !len( value ) ) return say( cmd, 4, { error: "No value" }, arguments.asJson, [ "error: no value was given (the prompt needs a terminal, or use --from-file)" ] );
        if ( find( chr( 10 ), value ) ) return say( cmd, 4, { error: "Value has a newline" }, arguments.asJson, [ "error: a value must be one line" ] );
        var replaced = len( fetch( arguments.name ) ) > 0;
        var err = store( arguments.name, value );
        if ( len( err ) ) return say( cmd, 6, { error: err }, arguments.asJson, [ "error: " & err ] );
        applyFiles();
        return say( cmd, 0, { name: arguments.name, replaced: replaced, backend: backend() }, arguments.asJson, [ arguments.name & ( replaced ? " was replaced" : " was saved" ) & " (" & backend() & ")." ] );
    }

    // `secrets list`
    function list( asJson ) {
        var rows = names().map( function( n ) { return { name: n, used_by: usedBy( n ) }; } );
        var lines = rows.map( function( r ) { return r.name & ( r.used_by.len() ? "  (" & r.used_by.toList( ", " ) & ")" : "" ); } );
        if ( !rows.len() ) lines = [ "No secrets stored yet. Add one: bxcachy secrets set ANTHROPIC_API_KEY" ];
        return say( "secrets list", 0, { backend: backend(), secrets: rows }, arguments.asJson, lines );
    }

    // `secrets get NAME [--show]`
    function getValue( name, show, asJson ) {
        var cmd = "secrets get";
        if ( !validName( arguments.name ) ) return say( cmd, 4, { error: "Bad name" }, arguments.asJson, [ "error: a secret name looks like ANTHROPIC_API_KEY" ] );
        var v = fetch( arguments.name );
        if ( !len( v ) ) return say( cmd, 4, { error: arguments.name & " is not set" }, arguments.asJson, [ "error: " & arguments.name & " is not set" ] );
        var data = { name: arguments.name, length: len( v ) };
        if ( arguments.show ) data.value = v;
        return say( cmd, 0, data, arguments.asJson, [ arguments.show ? v : arguments.name & " is set (" & len( v ) & " characters). Use --show to print it." ] );
    }

    // `secrets unset NAME --yes`
    function unset( name, yes, asJson ) {
        var cmd = "secrets unset";
        if ( !validName( arguments.name ) ) return say( cmd, 4, { error: "Bad name" }, arguments.asJson, [ "error: a secret name looks like ANTHROPIC_API_KEY" ] );
        if ( !len( fetch( arguments.name ) ) ) return say( cmd, 4, { error: arguments.name & " is not set" }, arguments.asJson, [ "error: " & arguments.name & " is not set" ] );
        if ( !arguments.yes ) return say( cmd, 2, { name: arguments.name }, arguments.asJson, [ "Plan: delete the stored value of " & arguments.name, "Nothing was changed. Add --yes to apply." ] );
        drop( arguments.name );
        return say( cmd, 0, { name: arguments.name }, arguments.asJson, [ arguments.name & " was deleted." ] );
    }

    // The values for the names that are set, as a struct. Missing names are listed in `missing`.
    function load( wanted ) {
        var env = {};
        var missing = [];
        for ( var n in arguments.wanted ) {
            var v = fetch( n );
            if ( len( v ) ) env[ n ] = v; else missing.append( n );
        }
        return { env: env, missing: missing };
    }

    // `secrets run [NAMES...] [--strict] -- CMD...`. The program runs with the secrets in its own environment and the terminal attached.
    // Returns the program's exit code. A secret that is not set is skipped (the program may have another way to log in) unless
    // --strict, which stops with exit 4.
    function run( wanted, command, strict ) {
        if ( !arguments.command.len() ) { println( "Usage: bxcachy secrets run [NAMES...] [--strict] -- COMMAND [ARGS...]" ); return 2; }
        for ( var n in arguments.wanted ) if ( !validName( n ) ) { println( "error: bad secret name " & n ); return 4; }
        var got = load( arguments.wanted );
        if ( got.missing.len() && arguments.strict ) { println( "error: not set: " & got.missing.toList( ", " ) ); return 4; }
        var rest = [];
        for ( var i = 2; i <= arguments.command.len(); i++ ) rest.append( arguments.command[ i ] );
        var r = systemExecute( arguments.command[ 1 ], rest, 0, false, ".", "", "", true, got.env, true );
        return r.exitCode;
    }

    // `secrets env [NAMES...]`: export lines for the names that are set (all stored names when none are given).
    function env( wanted ) {
        var list = arguments.wanted.len() ? arguments.wanted : names();
        var q = chr( 39 );
        var esc = q & chr( 92 ) & q & q;
        for ( var n in list ) {
            if ( !validName( n ) ) continue;
            var v = fetch( n );
            if ( len( v ) ) println( "export " & n & "=" & q & replace( v, q, esc, "all" ) & q );
        }
        return 0;
    }

    // ---- loading into shells ----
    // Two managed files hold NO values: secrets.sh (bash, zsh) and secrets.fish. They define a wrapper per coding-agent command, so
    // typing `claude` runs it through `secrets run` with just its own key, and, for names the user chose to export globally, load the
    // session cache (a mode 600 file in XDG_RUNTIME_DIR, a tmpfs wiped at logout) and fill it once per login with `secrets unlock`.
    function shFile() { return variables.config.cfgHome() & "/bxcachy/secrets.sh"; }
    function fishFile() { return variables.config.cfgHome() & "/bxcachy/secrets.fish"; }
    function cacheFile( ext ) {
        var rt = getSystemSetting( "XDG_RUNTIME_DIR", "" );
        return len( rt ) ? rt & "/bxcachy-secrets." & arguments.ext : "";
    }

    function wrapperPairs( stored, globalNames ) {
        var out = [];
        for ( var k in known() ) {
            if ( !arrayFind( arguments.stored, k.name ) || arrayFind( arguments.globalNames, k.name ) ) continue;
            for ( var c in k.commands ) out.append( { key: k.name, cmd: c } );
        }
        return out;
    }

    function renderShell( kind, stored, globalNames ) {
        var nl = chr( 10 );
        var fish = arguments.kind == "fish";
        var out = "# BxCachy secrets loader (managed by `bxcachy secrets`). It holds no values; they stay in your keyring." & nl;
        for ( var w in wrapperPairs( arguments.stored, arguments.globalNames ) ) {
            if ( fish ) out &= "function " & w.cmd & nl & "    bxcachy secrets run " & w.key & " -- command " & w.cmd & " $argv" & nl & "end" & nl;
            else out &= w.cmd & "() { bxcachy secrets run " & w.key & " -- command " & w.cmd & ' "$@"; }' & nl;
        }
        if ( arguments.globalNames.len() ) {
            var ext = fish ? "fish" : "env";
            out &= "# Global export (you chose it for: " & arguments.globalNames.toList( ", " ) & "). Every program you start can read these." & nl;
            if ( fish ) out &= 'if set -q XDG_RUNTIME_DIR' & nl & '    test -r "$XDG_RUNTIME_DIR/bxcachy-secrets.fish"; or bxcachy secrets unlock >/dev/null 2>&1' & nl & '    test -r "$XDG_RUNTIME_DIR/bxcachy-secrets.fish"; and source "$XDG_RUNTIME_DIR/bxcachy-secrets.fish"' & nl & 'end' & nl;
            else out &= 'if [ -n "$XDG_RUNTIME_DIR" ]; then' & nl & '    [ -r "$XDG_RUNTIME_DIR/bxcachy-secrets.env" ] || bxcachy secrets unlock >/dev/null 2>&1' & nl & '    [ -r "$XDG_RUNTIME_DIR/bxcachy-secrets.env" ] && . "$XDG_RUNTIME_DIR/bxcachy-secrets.env"' & nl & 'fi' & nl;
        }
        return out;
    }

    // Rewrites the two loader files from what is stored and chosen. Returns true when both were written.
    function applyFiles() {
        var stored = names();
        var g = readSettings().global.filter( function( n ) { return arrayFind( stored, n ); } );
        var ok = true;
        for ( var f in [ { kind: "sh", path: shFile() }, { kind: "fish", path: fishFile() } ] ) {
            var body = renderShell( f.kind, stored, g );
            if ( variables.config.configWrite( { name: "secrets-" & f.kind, target: f.path, mode: "644", content: body }, body, "apply", true, false ) != 0 ) ok = false;
        }
        return ok;
    }

    // Fills the session cache with the globally exported secrets (this is the once-per-login keyring unlock).
    function writeCache() {
        var envFile = cacheFile( "env" );
        if ( !len( envFile ) ) return "XDG_RUNTIME_DIR is not set";
        var q = chr( 39 );
        var esc = q & chr( 92 ) & q & q;
        var fq = chr( 92 ) & q;
        var shBody = "";
        var fishBody = "";
        for ( var n in readSettings().global ) {
            var v = fetch( n );
            if ( !len( v ) ) continue;
            shBody &= "export " & n & "=" & q & replace( v, q, esc, "all" ) & q & chr( 10 );
            fishBody &= "set -gx " & n & " " & q & replace( replace( v, chr( 92 ), chr( 92 ) & chr( 92 ), "all" ), q, fq, "all" ) & q & chr( 10 );
        }
        var r1 = sx( [ "sh", "-c", 'umask 077; cat > "$1"', "_", envFile ], 30, len( shBody ) ? shBody : chr( 10 ) );
        var r2 = sx( [ "sh", "-c", 'umask 077; cat > "$1"', "_", cacheFile( "fish" ) ], 30, len( fishBody ) ? fishBody : chr( 10 ) );
        return r1.exitCode == 0 && r2.exitCode == 0 ? "" : "could not write the session cache";
    }

    function dropCache() {
        for ( var e in [ "env", "fish" ] ) { var f = cacheFile( e ); if ( len( f ) && fileExists( f ) ) fileDelete( f ); }
    }

    // `secrets apply`
    function apply( yes, dryRun, asJson ) {
        var cmd = "secrets apply";
        var data = { files: [ shFile(), fishFile() ], wrappers: wrapperPairs( names(), readSettings().global ).map( function( w ) { return w.cmd; } ) };
        if ( !arguments.yes || arguments.dryRun ) return say( cmd, arguments.dryRun ? 0 : 2, data, arguments.asJson, [ ( arguments.dryRun ? "Dry run" : "Plan" ) & ": write " & shFile() & " and " & fishFile() & " (wrappers: " & data.wrappers.toList( ", " ) & ")", "Nothing was changed." & ( arguments.dryRun ? "" : " Add --yes to apply." ) ] );
        if ( !applyFiles() ) return say( cmd, 6, { error: "Could not write the loader files" }, arguments.asJson, [ "error: could not write the loader files" ] );
        return say( cmd, 0, data, arguments.asJson, [ "Wrote " & shFile() & " and " & fishFile() & ". New shells load them." ] );
    }

    // `secrets global on NAME --yes | off NAME | show`
    function globalCmd( action, name, yes, asJson ) {
        var cmd = "secrets global";
        var s = readSettings();
        if ( arguments.action == "show" ) return say( cmd, 0, { global: s.global }, arguments.asJson, [ s.global.len() ? "Exported to every shell: " & s.global.toList( ", " ) : "No secret is exported globally. They load per command." ] );
        if ( !validName( arguments.name ) ) return say( cmd, 4, { error: "Bad name" }, arguments.asJson, [ "error: a secret name looks like ANTHROPIC_API_KEY" ] );
        if ( arguments.action == "on" ) {
            if ( !len( fetch( arguments.name ) ) ) return say( cmd, 4, { error: arguments.name & " is not set" }, arguments.asJson, [ "error: " & arguments.name & " is not set. Store it first: bxcachy secrets set " & arguments.name ] );
            if ( !arguments.yes ) return say( cmd, 2, { name: arguments.name }, arguments.asJson, [ "Plan: export " & arguments.name & " to every new shell.", "Warning: every program you start, including AI agents and anything they run, can read it. The default (per command) gives it only to the program that needs it.", "Nothing was changed. Add --yes to apply." ] );
            if ( !arrayFind( s.global, arguments.name ) ) s.global.append( arguments.name );
        } else if ( arguments.action == "off" ) {
            var nm = arguments.name;
            s.global = s.global.filter( function( n ) { return n != nm; } );
        } else return say( cmd, 2, {}, arguments.asJson, [ "Usage: bxcachy secrets global on NAME --yes | off NAME | show" ] );
        writeSettings( s );
        applyFiles();
        if ( s.global.len() ) writeCache(); else dropCache();
        return say( cmd, 0, { name: arguments.name, action: arguments.action, global: s.global }, arguments.asJson, [ arguments.name & ( arguments.action == "on" ? " is now exported to every new shell." : " is back to per-command loading." ) ] );
    }

    // `secrets unlock`: refill the session cache (shells call this once per login when something is exported globally). `lock` empties it.
    function unlock( asJson ) {
        var err = writeCache();
        if ( len( err ) ) return say( "secrets unlock", 6, { error: err }, arguments.asJson, [ "error: " & err ] );
        return say( "secrets unlock", 0, { global: readSettings().global }, arguments.asJson, [ "Session cache filled." ] );
    }

    function lock( asJson ) {
        dropCache();
        return say( "secrets lock", 0, {}, arguments.asJson, [ "Session cache removed." ] );
    }

    // ---- moving between machines ----
    // The export text: one `export NAME='value'` line per stored secret.
    function exportText() {
        var q = chr( 39 );
        var esc = q & chr( 92 ) & q & q;
        var out = "";
        for ( var n in names() ) {
            var v = fetch( n );
            if ( len( v ) ) out &= "export " & n & "=" & q & replace( v, q, esc, "all" ) & q & chr( 10 );
        }
        return out;
    }

    // Parses export text or a .env file into { name, value } rows. Comments, blank lines and bad names are skipped.
    function parseEnv( text ) {
        var q = chr( 39 );
        var out = [];
        for ( var raw in listToArray( replace( arguments.text, chr( 13 ), "", "all" ), chr( 10 ) ) ) {
            var line = trim( raw );
            if ( !len( line ) || left( line, 1 ) == "##" ) continue;
            if ( left( line, 7 ) == "export " ) line = trim( mid( line, 8, len( line ) ) );
            var eqAt = find( "=", line );
            if ( eqAt < 2 ) continue;
            var n = trim( left( line, eqAt - 1 ) );
            var v = trim( mid( line, eqAt + 1, len( line ) ) );
            if ( !validName( n ) ) continue;
            if ( len( v ) >= 2 && left( v, 1 ) == q && right( v, 1 ) == q ) v = replace( mid( v, 2, len( v ) - 2 ), q & chr( 92 ) & q & q, q, "all" );
            else if ( len( v ) >= 2 && left( v, 1 ) == '"' && right( v, 1 ) == '"' ) v = mid( v, 2, len( v ) - 2 );
            if ( len( v ) ) out.append( { name: n, value: v } );
        }
        return out;
    }

    // `secrets export FILE [--plain] [--force] [--yes]`: a passphrase-encrypted age file (age asks for the passphrase on the terminal),
    // or with --plain a readable .env file (mode 600; it holds every key in the clear, so treat it as a secret). Plan without --yes.
    function exportTo( file, plain, force, yes, asJson ) {
        var cmd = "secrets export";
        var n = names().len();
        if ( !n ) return say( cmd, 4, { error: "Nothing stored" }, arguments.asJson, [ "error: no secrets are stored, nothing to export" ] );
        if ( fileExists( arguments.file ) && !arguments.force ) return say( cmd, 4, { error: arguments.file & " exists" }, arguments.asJson, [ "error: " & arguments.file & " already exists (use --force to replace it)" ] );
        if ( !arguments.plain && !hasCommand( "age" ) ) return say( cmd, 4, { error: "age was not found" }, arguments.asJson, [ "error: age was not found. Install it: sudo pacman -S age (or use --plain)" ] );
        var data = { file: arguments.file, count: n, encrypted: !arguments.plain };
        if ( !arguments.yes ) return say( cmd, 2, data, arguments.asJson, [ "Plan: write " & n & " secret(s) to " & arguments.file & ( arguments.plain ? " as PLAIN TEXT (mode 600). Anyone who reads the file has your keys." : ", encrypted with a passphrase you will be asked for." ), "Nothing was changed. Add --yes to apply." ] );
        var text = exportText();
        var r = arguments.plain
            ? sx( [ "sh", "-c", 'umask 077; cat > "$1"', "_", arguments.file ], 30, text )
            : sx( [ "sh", "-c", 'umask 077; exec age -p -o "$1"', "_", arguments.file ], 600, text );
        if ( r.exitCode != 0 ) return say( cmd, 6, { error: "The export failed" }, arguments.asJson, [ "error: the export failed" & ( len( trim( r.output ) ) ? ": " & trim( r.output ) : "" ) ] );
        return say( cmd, 0, data, arguments.asJson, [ "Exported " & n & " secret(s) to " & arguments.file & ( arguments.plain ? " (plain text, keep it private)." : " (encrypted). Move it, then: bxcachy secrets import " & arguments.file ) ] );
    }

    // `secrets import FILE [--overwrite] [--yes]`: an age file from `export`, or a .env file. A name that already has a different
    // value is left alone unless --overwrite.
    function importFrom( file, overwrite, yes, asJson ) {
        var cmd = "secrets import";
        if ( !fileExists( arguments.file ) ) return say( cmd, 4, { error: "File not found" }, arguments.asJson, [ "error: " & arguments.file & " was not found" ] );
        var head = sx( [ "head", "-c", "20", arguments.file ], 10 ).output;
        var text = "";
        if ( left( head, 20 ) == "age-encryption.org/v" || left( head, 11 ) == "-----BEGIN " ) {
            if ( !hasCommand( "age" ) ) return say( cmd, 4, { error: "age was not found" }, arguments.asJson, [ "error: age was not found. Install it: sudo pacman -S age" ] );
            var d = sx( [ "age", "-d", arguments.file ], 600 );
            if ( d.exitCode != 0 ) return say( cmd, 4, { error: "Could not decrypt" }, arguments.asJson, [ "error: could not decrypt " & arguments.file & " (wrong passphrase?)" ] );
            text = d.output;
        } else text = fileRead( arguments.file );
        var rows = parseEnv( text );
        if ( !rows.len() ) return say( cmd, 4, { error: "No secrets found" }, arguments.asJson, [ "error: no secrets were found in " & arguments.file ] );
        var plan = rows.map( function( r ) {
            var cur = fetch( r.name );
            var st = !len( cur ) ? "new" : ( cur == r.value ? "same" : "differs" );
            return { name: r.name, value: r.value, status: st };
        } );
        var ow = arguments.overwrite;
        var shown = plan.map( function( r ) { return { name: r.name, status: r.status }; } );
        var lines = plan.map( function( r ) { return r.name & ": " & ( r.status == "differs" ? ( ow ? "will be replaced" : "differs, kept (use --overwrite)" ) : r.status == "same" ? "already stored" : "will be added" ); } );
        if ( !arguments.yes ) { arrayAppend( lines, "Nothing was changed. Add --yes to apply." ); return say( cmd, 2, { secrets: shown }, arguments.asJson, lines ); }
        var done = [];
        for ( var r in plan ) {
            if ( r.status == "same" || ( r.status == "differs" && !arguments.overwrite ) ) continue;
            var err = store( r.name, r.value );
            if ( len( err ) ) return say( cmd, 6, { error: err }, arguments.asJson, [ "error: " & r.name & ": " & err ] );
            done.append( r.name );
        }
        if ( done.len() ) applyFiles();
        arrayAppend( lines, "Imported " & done.len() & " secret(s)." );
        return say( cmd, 0, { secrets: shown, imported: done }, arguments.asJson, lines );
    }

    // ---- keyring check and install ----
    // True when something on the user D-Bus provides org.freedesktop.secrets (running, or started on demand).
    function secretServiceOnBus() {
        try {
            return sx( [ "sh", "-c", '{ busctl --user list --no-legend 2>/dev/null; busctl --user list --activatable --no-legend 2>/dev/null; } | grep -q "org.freedesktop.secrets"' ], 15 ).exitCode == 0;
        } catch ( any e ) { return false; }
    }

    function onPlasma() {
        return findNoCase( "KDE", getSystemSetting( "XDG_CURRENT_DESKTOP", "" ) ) > 0 || hasCommand( "plasmashell" );
    }

    // `secrets setup [--keyring=kwallet|gnome-keyring|none] [--yes] [--dry-run]`: makes sure there is a keyring and the tools around
    // it: libsecret (secret-tool) and age (encrypted export). With no Secret Service on the machine it installs one: KWallet on
    // Plasma, GNOME Keyring otherwise (or the one you name). --keyring=none keeps the private-file store instead and installs no keyring.
    function setup( keyring, yes, dryRun, asJson ) {
        var cmd = "secrets setup";
        if ( len( arguments.keyring ) && !arrayFind( [ "kwallet", "gnome-keyring", "none" ], arguments.keyring ) ) return say( cmd, 4, { error: "Unknown keyring" }, arguments.asJson, [ "error: unknown keyring " & arguments.keyring & " (use kwallet, gnome-keyring or none)" ] );
        if ( !hasCommand( "pacman" ) ) return say( cmd, 4, { error: "pacman was not found" }, arguments.asJson, [ "error: pacman was not found (this runs on CachyOS or Arch)" ] );
        var pkgs = [];
        if ( !hasCommand( "secret-tool" ) ) pkgs.append( "libsecret" );
        if ( !hasCommand( "age" ) ) pkgs.append( "age" );
        var onBus = secretServiceOnBus();
        var choice = arguments.keyring;
        if ( choice == "none" ) { /* no keyring package */ }
        else if ( !onBus ) {
            if ( !len( choice ) ) choice = onPlasma() ? "kwallet" : "gnome-keyring";
            pkgs.append( choice == "kwallet" ? "kwallet" : "gnome-keyring" );
        }
        var data = { packages: pkgs, keyring_found: onBus, keyring_install: !onBus && choice != "none" ? choice : "", file_backend: choice == "none" };
        var lines = [];
        if ( onBus ) lines.append( "A keyring is already running. It will be used." );
        else if ( choice == "none" ) lines.append( "No keyring will be installed. Secrets stay in private files (mode 600)." );
        else lines.append( "No keyring was found, so " & choice & " will be installed. It is the default place for your secrets." );
        if ( pkgs.len() ) lines.append( "Install: sudo pacman -S --needed " & pkgs.toList( " " ) ); else lines.append( "Nothing to install." );
        if ( !arguments.yes || arguments.dryRun ) {
            arrayAppend( lines, arguments.dryRun ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." );
            return say( cmd, arguments.dryRun ? 0 : 2, data, arguments.asJson, lines );
        }
        if ( pkgs.len() ) {
            var argv = [ "sudo", "pacman", "-S", "--needed", "--noconfirm" ];
            for ( var pk in pkgs ) argv.append( pk );
            var ins = variables.inst.exec( argv, 1800 );
            if ( ins.exitCode != 0 ) return say( cmd, 6, { error: "pacman failed" }, arguments.asJson, [ "error: could not install " & pkgs.toList( ", " ) & ": " & trim( ins.output ) ] );
        }
        if ( choice == "none" ) setBackend( "file" );
        arrayAppend( lines, "Done." & ( !onBus && choice != "none" ? " The first time a secret is stored, " & choice & " asks you to create its password (use your login password so it unlocks with you)." : "" ) );
        return say( cmd, 0, data, arguments.asJson, lines );
    }
}
