// The registry of launcher providers. Each provider is DATA, not code: how to toggle it, and (when it has one) how to use it as a
// menu. Adding a launcher means adding one descriptor here; nothing else in BxCachy names a launcher. Callers use Runner.launch()
// and Runner.select(), so switching providers never touches them.
//
// A descriptor:
//   id        the provider name
//   title     what the wizard shows
//   package   catalog app id that installs it ("" when it comes with the desktop)
//   launch    argv that opens or toggles the launcher ([] for `system`, which the desktop owns)
//   menu      an empty struct (no dmenu mode), or { argv, icons, returns }
//               argv      the dmenu command; {prompt} is replaced
//               icons     true when it understands Rofi's extended dmenu icon protocol ("label" NUL "icon" US "name")
//               returns   "index" (it prints the 0-based number of the choice) or "text" (it prints the chosen label)
class RunnerProviders {
    function all() {
        return [
            { id: "system", title: "Desktop default", package: "", launch: [], menu: {} },
            { id: "noctalia", title: "Noctalia launcher", package: "", launch: [ "noctalia", "msg", "panel-toggle", "launcher" ], menu: {} },
            { id: "walker", title: "Walker", package: "walker", launch: [ "walker" ], menu: { argv: [ "walker", "--dmenu" ], icons: false, returns: "text" } },
            { id: "rofi", title: "Rofi", package: "rofi", launch: [ "rofi", "-show", "drun" ], menu: { argv: [ "rofi", "-dmenu", "-i", "-show-icons", "-format", "i", "-p", "{prompt}" ], input: [ "rofi", "-dmenu", "-l", "0", "-p", "{prompt}" ], icons: true, returns: "index" } },
            { id: "fuzzel", title: "Fuzzel", package: "fuzzel", launch: [ "fuzzel" ], menu: { argv: [ "fuzzel", "--dmenu", "--index", "--prompt", "{prompt}" ], icons: true, returns: "index" } },
            { id: "wofi", title: "Wofi", package: "wofi", launch: [ "wofi", "--show", "drun" ], menu: { argv: [ "wofi", "--dmenu", "--insensitive", "--prompt", "{prompt}" ], icons: false, returns: "text" } },
            { id: "krunner", title: "KRunner", package: "", launch: [ "krunner" ], menu: {} },
            { id: "vicinae", title: "Vicinae", package: "vicinae", launch: [ "vicinae", "toggle" ], menu: { argv: [ "vicinae", "dmenu", "--prompt", "{prompt}" ], icons: false, returns: "text" } },
            { id: "custom", title: "Custom command", package: "", launch: [], menu: {} }
        ];
    }

    function ids() { return all().map( function( p ) { return p.id; } ); }

    // Providers that can serve as a menu (they have a dmenu mode).
    function menuIds() { return all().filter( function( p ) { return !structIsEmpty( p.menu ); } ).map( function( p ) { return p.id; } ); }

    // One descriptor by id, or an empty struct.
    function get( id ) {
        for ( var p in all() ) if ( p.id == arguments.id ) return p;
        return {};
    }
}
