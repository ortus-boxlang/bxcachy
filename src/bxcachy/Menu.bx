// `bxcachy menu`: the BxCachy control center, shown with the menu provider you chose (`runner menu-set`: Rofi, Walker, Fuzzel, ...).
//   menu                  interactive. The first entry searches every entry at once (your provider filters as you type); sections open in place
//   menu items [--json]   the menu tree as data (what the menu shows), for scripts and tests
//   menu search TEXT      the entries whose path contains TEXT, with the command each one runs (the CLI mirror of the search)
// The tree is MenuTree (Omarchy's skeleton plus Develop for what is ours). Entry kinds: spawn (starts a command detached), run (in a terminal
// window, waits for Enter), open (a URL), pick (choose from a live list, then run), ask (type a line, then run), pkgsearch (find a package in
// the repos or the AUR, then install it), catalog (the apps of one catalog group), db, webcreate, webrm. `confirm` entries ask first.
// Nothing here changes the system by itself: every entry runs a command that has its own plan and --yes rules (the destructive ones are
// started with --yes only after you confirm). Exit: 0 done or cancelled, 4 precondition (no menu program, no terminal for a `run` entry).
class Menu {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        return this;
    }

    function self() { return getSystemSetting( "BXCACHY_SELF", "bxcachy" ); }

    // The tree, with the catalog groups filled in.
    function tree() {
        var groups = [];
        try {
            var cat = new bxcachy.Catalog().load();
            var g = cat.groups;
            arraySort( g, function( a, b ) { return a.order < b.order ? -1 : ( a.order > b.order ? 1 : 0 ); } );
            for ( var x in g ) groups.append( { id: x.id, title: x.title } );
        } catch ( any e ) {}
        return new bxcachy.MenuTree().sections( groups );
    }

    // Every entry that does something, with its path ("Appearance > Theme").
    function flatten( entries, prefix = "" ) {
        var out = [];
        for ( var e in arguments.entries ) {
            var path = ( len( arguments.prefix ) ? arguments.prefix & " > " : "" ) & e.label;
            if ( e.kind == "sub" ) { for ( var c in flatten( e.children, path ) ) out.append( c ); }
            else out.append( { path: path, entry: e } );
        }
        return out;
    }

    // What an entry runs, as text.
    function describe( e ) {
        var c = structKeyExists( e, "argv" ) ? "bxcachy " & e.argv.toList( " " ) : "";
        switch ( e.kind ) {
            case "spawn": return "opens: " & c;
            case "run": return "shows in a terminal: " & c;
            case "open": return "opens " & e.url;
            case "pick": return "choose from " & e.source & ", then: " & c;
            case "ask": return "asks for text, then: " & c;
            case "pkgsearch": return "searches " & ( e.source == "aur" ? "the AUR" : "the repos and the AUR" ) & ", then: bxcachy pkg install NAME --yes";
            case "catalog": return "lists the " & e.label & " apps, then: bxcachy install ID --yes";
            case "db": return "opens the databases menu: bxcachy db menu";
            case "webcreate": return "asks for a name and a URL, then: bxcachy web add NAME URL";
            case "webrm": return "pick one, confirm, then: bxcachy web rm NAME";
        }
        return "";
    }

    function say( command, code, data, asJson, lines = [] ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data, false ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    // The tree as indented text lines.
    function lineList( entries, depth ) {
        var out = [];
        var pad = repeatString( "  ", arguments.depth );
        for ( var r in arguments.entries ) {
            if ( r.kind == "sub" ) { out.append( pad & r.label ); for ( var l in lineList( r.children, arguments.depth + 1 ) ) out.append( l ); }
            else out.append( pad & r.label & ( len( describe( r ) ) ? "   (" & describe( r ) & ")" : "" ) );
        }
        return out;
    }

    function show( asJson ) {
        var rows = tree();
        return say( "menu items", 0, { menu: rows, entries: flatten( rows ).len() }, arguments.asJson, lineList( rows, 0 ) );
    }

    // `menu search TEXT`: the entries whose path contains TEXT.
    function search( text, asJson ) {
        var t = lCase( trim( arguments.text ) );
        var hits = flatten( tree() ).filter( function( f ) { return findNoCase( t, f.path ) > 0; } );
        var rows = hits.map( function( h ) { return { path: h.path, kind: h.entry.kind, does: describe( h.entry ) }; } );
        var lines = rows.map( function( r ) { return r.path & "   (" & r.does & ")"; } );
        if ( !rows.len() ) lines.append( "No menu entry matches " & arguments.text );
        return say( "menu search", 0, { query: arguments.text, results: rows }, arguments.asJson, lines );
    }

    // ---- live lists for pick entries ----
    function exec( argv, timeout = 30 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function has( name ) { return exec( [ "sh", "-c", 'command -v "$1"', "_", arguments.name ], 10 ).exitCode == 0; }

    // [ { label, value, current } ] for a source. Empty when there is nothing to choose.
    function choices( source ) {
        var out = [];
        var src = arguments.source;
        if ( src == "themes" ) {
            var th = new bxcachy.Theme( variables.cli );
            var cur = th.readState().name;
            for ( var n in th.names() ) out.append( { label: n, value: n, current: n == cur } );
        } else if ( src == "user-themes" ) {
            var th2 = new bxcachy.Theme( variables.cli );
            var all = th2.discover();
            for ( var k in th2.names() ) if ( all[ k ].origin == "user" ) out.append( { label: k, value: k, current: false } );
        } else if ( src == "browsers" || src == "filemanagers" ) {
            var cat = new bxcachy.Catalog().load();
            var pk = new bxcachy.Packages( variables.cli, cat );
            var names = pk.installedNames();
            var wantCat = src == "browsers" ? "Browsers" : "File Management";
            for ( var a in cat.apps ) if ( a.category == wantCat && a.source != "web" && pk.isInstalled( a, names ) ) out.append( { label: a.name, value: a.id, current: false } );
        } else if ( src == "terminals" ) {
            var tc = new bxcachy.TerminalConfig( true );
            for ( var t in tc.terminals() ) if ( has( t.cmd ) ) out.append( { label: t.id, value: t.id, current: false } );
        } else if ( src == "packages" ) {
            var r = exec( [ self(), "pkg", "installed", "--explicit", "--json" ], 60 );
            try { for ( var p in jsonDeserialize( r.output ).data.packages ) out.append( { label: p.name & " " & p.version, value: p.name, current: false } ); } catch ( any e ) {}
        } else if ( src == "apps-installed" ) {
            var cat2 = new bxcachy.Catalog().load();
            var pk2 = new bxcachy.Packages( variables.cli, cat2 );
            var names2 = pk2.installedNames();
            for ( var b in cat2.apps ) if ( pk2.isInstalled( b, names2 ) ) out.append( { label: b.name & "  (" & b.id & ")", value: b.id, current: false } );
        } else if ( src == "vms" ) {
            for ( var v in new bxcachy.Vm( variables.cli ).allRecords() ) out.append( { label: v.name & "  (" & v.kind & ")", value: v.name, current: false } );
        } else if ( src == "fonts" || src == "fonts-uninstalled" ) {
            for ( var fo in new bxcachy.Appearance( variables.cli ).fontRows() ) if ( ( src == "fonts" ) == fo.installed ) out.append( { label: fo.label & "  (" & fo.family & ")", value: fo.id, current: false } );
        } else if ( src == "backgrounds" ) {
            for ( var im in new bxcachy.Appearance( variables.cli ).images() ) out.append( { label: im.name, value: im.path, current: false } );
        } else if ( src == "skills-installed" ) {
            var sr = exec( [ self(), "skills", "installed", "--json" ], 30 );
            try { for ( var s in jsonDeserialize( sr.output ).data.skills ) out.append( { label: s.name, value: s.name, current: false } ); } catch ( any e ) {}
        }
        return out;
    }

    // ---- running things ----
    // The terminal program (and the flag that precedes the command) for `run` entries.
    function terminalArgv() {
        for ( var t in [ "ghostty", "kitty", "foot", "alacritty", "konsole" ] ) {
            if ( has( t ) ) return arrayFind( [ "ghostty", "alacritty", "konsole" ], t ) ? [ t, "-e" ] : [ t ];
        }
        return [];
    }

    function detach( argv ) {
        var run = [ "sh", "-c", 'setsid "$@" >/dev/null 2>&1 &', "_" ];
        for ( var p in arguments.argv ) run.append( p );
        variables.inst.exec( run, 10 );
    }

    // Starts one entry (spawn or run).
    function start( entry ) {
        if ( arguments.entry.kind == "spawn" ) {
            var sp = [ self() ];
            for ( var a in arguments.entry.argv ) sp.append( a );
            detach( sp );
            return 0;
        }
        var term = terminalArgv();
        if ( !term.len() ) { println( "error: this entry needs a terminal program (ghostty, kitty, foot, alacritty or konsole)" ); return 4; }
        var argv = [];
        for ( var t in term ) argv.append( t );
        for ( var w in [ "sh", "-c", 'bxcachy_cmd="$1"; shift; "$bxcachy_cmd" "$@"; echo; echo "Press Enter to close"; read _', "_", self() ] ) argv.append( w );
        for ( var a2 in arguments.entry.argv ) argv.append( a2 );
        detach( argv );
        return 0;
    }

    function sub( argv, value ) {
        return arguments.argv.map( function( a ) { return replace( a, "{}", value, "all" ); } );
    }

    function confirm( runner, text ) {
        return arguments.runner.select( arguments.text, [ "Cancel", "Yes" ] ) == 2;
    }

    function note( runner, text ) { arguments.runner.select( arguments.text, [ "OK" ] ); }

    function pickAndRun( runner, e ) {
        var ch = choices( e.source );
        if ( !ch.len() ) { note( arguments.runner, "Nothing to choose here" ); return 0; }
        var labels = ch.map( function( c ) { return ( c.current ? "✓ " : "  " ) & c.label; } );
        var pick = arguments.runner.select( e.label, labels );
        if ( pick == 0 ) return 0;
        var chosen = ch[ pick ];
        if ( structKeyExists( e, "confirm" ) && !confirm( arguments.runner, replace( e.confirm, "{}", chosen.value, "all" ) ) ) return 0;
        return start( { kind: e.mode ?: "spawn", argv: sub( e.argv, chosen.value ) } );
    }

    function askAndRun( runner, e ) {
        if ( !arguments.runner.inputSupported() ) { note( arguments.runner, "Your menu provider cannot take typed text. Run: bxcachy " & e.argv.toList( " " ) ); return 0; }
        var text = arguments.runner.input( e.prompt );
        if ( !len( text ) ) return 0;
        return start( { kind: e.mode ?: "run", argv: sub( e.argv, text ) } );
    }

    // Package search: ask for text, list the matches (repos and AUR), confirm, install in a terminal (sudo may ask for a password).
    function pkgSearchFlow( runner, e ) {
        if ( !arguments.runner.inputSupported() ) { note( arguments.runner, "Your menu provider cannot take typed text. Run: bxcachy pkg search TEXT" ); return 0; }
        var text = arguments.runner.input( e.source == "aur" ? "Search the AUR" : "Search packages" );
        if ( !len( text ) ) return 0;
        var r = exec( [ self(), "pkg", "search", text, "--source=" & e.source, "--limit=60", "--json" ], 90 );
        var rows = [];
        try { rows = jsonDeserialize( r.output ).data.results; } catch ( any x ) {}
        if ( !rows.len() ) { note( arguments.runner, "No packages match " & text ); return 0; }
        var labels = rows.map( function( p ) { return ( p.installed ? "✓ " : "  " ) & p.repo & "/" & p.name & " " & p.version & ( len( p.description ) ? "  " & left( p.description, 70 ) : "" ); } );
        var pick = arguments.runner.select( "Install which package?", labels );
        if ( pick == 0 ) return 0;
        var chosen = rows[ pick ];
        if ( chosen.installed ) { note( arguments.runner, chosen.name & " is already installed" ); return 0; }
        if ( !confirm( arguments.runner, "Install " & chosen.name & ( chosen.source == "aur" ? " from the AUR (a user-submitted build script)?" : "?" ) ) ) return 0;
        var argv = [ "pkg", "install", chosen.name, "--yes" ];
        if ( chosen.source == "aur" ) argv.append( "--aur" );
        return start( { kind: "run", argv: argv } );
    }

    // The apps of one catalog group: pick one, confirm, install it in a terminal.
    function catalogFlow( runner, e ) {
        var cat = new bxcachy.Catalog().load();
        var pk = new bxcachy.Packages( variables.cli, cat );
        var names = pk.installedNames();
        var apps = cat.apps.filter( function( a ) { return a.group == e.group; } );
        arraySort( apps, function( a, b ) { return compareNoCase( a.name, b.name ); } );
        if ( !apps.len() ) { note( arguments.runner, "No apps in this group" ); return 0; }
        var labels = apps.map( function( a ) { return ( pk.isInstalled( a, names ) ? "✓ " : "  " ) & a.name & "  " & left( a.description ?: "", 70 ); } );
        var pick = arguments.runner.select( e.label, labels );
        if ( pick == 0 ) return 0;
        var chosen = apps[ pick ];
        if ( pk.isInstalled( chosen, names ) ) { note( arguments.runner, chosen.name & " is already installed" ); return 0; }
        if ( !confirm( arguments.runner, "Install " & chosen.name & "?" ) ) return 0;
        return start( { kind: "run", argv: [ "install", chosen.id, "--yes" ] } );
    }

    // Create web app, Omarchy style: asks for the name and the URL, then adds it. Providers that cannot take typed text open a terminal
    // that asks the same questions (`bxcachy web add`).
    function createWebApp( runner ) {
        if ( !arguments.runner.inputSupported() ) return start( { kind: "run", argv: [ "web", "add" ] } );
        var name = arguments.runner.input( "Web app name" );
        if ( !len( name ) ) return 0;
        var url = arguments.runner.input( "URL (https://...)" );
        if ( !len( url ) ) return 0;
        var r = variables.inst.exec( [ self(), "web", "add", name, url, "--yes" ], 60 );
        arguments.runner.select( r.exitCode == 0 ? "Added " & name : "Could not add " & name & ": " & left( trim( r.output ), 120 ), [ "OK" ] );
        return 0;
    }

    // Remove a web app: pick one, confirm, delete.
    function removeWebApp( runner ) {
        var apps = new bxcachy.Web( variables.cli, variables.inst.runner() ).apps();
        if ( !apps.len() ) { note( arguments.runner, "No web apps yet" ); return 0; }
        var labels = apps.map( function( a ) { return a.name & "  " & a.url; } );
        var pick = arguments.runner.select( "Remove which web app?", labels );
        if ( pick == 0 ) return 0;
        if ( !confirm( arguments.runner, "Remove " & apps[ pick ].name & "?" ) ) return 0;
        variables.inst.exec( [ self(), "web", "rm", apps[ pick ].name, "--yes" ], 30 );
        return 0;
    }

    // Does one entry (anything but a submenu). Returns an exit code (0 keeps the menu open).
    function activate( runner, e ) {
        switch ( e.kind ) {
            case "db": new bxcachy.Db( variables.cli, variables.inst.runner() ).menu(); return 0;
            case "webcreate": return createWebApp( arguments.runner );
            case "webrm": return removeWebApp( arguments.runner );
            case "pick": return pickAndRun( arguments.runner, e );
            case "ask": return askAndRun( arguments.runner, e );
            case "pkgsearch": return pkgSearchFlow( arguments.runner, e );
            case "catalog": return catalogFlow( arguments.runner, e );
            case "open": detach( [ "xdg-open", e.url ] ); return 0;
        }
        if ( structKeyExists( e, "confirm" ) && !confirm( arguments.runner, e.confirm ) ) return 0;
        return start( e );
    }

    // Search everything: one flat list of every entry's path; your provider filters as you type.
    function searchAll( runner, entries ) {
        var flat = flatten( arguments.entries );
        var pick = arguments.runner.select( "Search", flat.map( function( f ) { return f.path; } ) );
        if ( pick == 0 ) return 0;
        return activate( arguments.runner, flat[ pick ].entry );
    }

    // Shows one level and follows the choice. Returns when the user goes back or cancels. The top level starts with Search.
    function level( runner, title, entries, top = false ) {
        while ( true ) {
            var labels = arguments.entries.map( function( e ) { return e.label; } );
            var off = 0;
            if ( arguments.top ) { labels.prepend( "Search…" ); off = 1; }
            labels.append( arguments.top ? "Exit" : "Back" );
            var pick = arguments.runner.select( arguments.title, labels );
            if ( pick == 0 || pick == labels.len() ) return 0;
            if ( arguments.top && pick == 1 ) { var sc = searchAll( arguments.runner, arguments.entries ); if ( sc != 0 ) return sc; continue; }
            var e = arguments.entries[ pick - off ];
            if ( e.kind == "sub" ) { var inner = level( arguments.runner, e.label, e.children ); if ( inner != 0 ) return inner; }
            else { var rc = activate( arguments.runner, e ); if ( rc != 0 ) return rc; }
        }
        return 0;
    }

    function run() {
        try {
            var runner = new bxcachy.Runner( variables.cli, variables.inst.runner() );
            return level( runner, "BxCachy", tree(), true );
        } catch ( any err ) {
            println( "error: " & err.message );
            return 4;
        }
    }
}
