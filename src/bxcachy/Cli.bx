// Shared output helpers: the --json envelope (docs/architecture/COMMAND-CONTRACT.md section 4).
class Cli {
    function init( version ) {
        variables.version = arguments.version;
        return this;
    }

    // One JSON object on stdout, nothing else.
    function envelope( command, exitCode, data, dryRun = false ) {
        return jsonSerialize( { schema: 1, command: command, version: variables.version, ok: exitCode == 0, exit: exitCode, dry_run: dryRun, data: data, warnings: [] } );
    }

    // Prints a key/value listing as lines, or as the JSON envelope with --json.
    function emitMap( command, asJson, map, suffix ) {
        if ( asJson ) {
            println( envelope( command, 0, map ) );
            return;
        }
        for ( key in map ) println( key & ": " & map[key] & suffix );
    }
}
