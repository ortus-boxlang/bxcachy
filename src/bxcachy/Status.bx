// `bxcachy status`: what this machine already has, in the wizard's terms (read-only). For each question the system can answer it lists what
// it found (installed apps, the default terminal, browser, shell, AI default, runner, desktops), then how many apps of the default set are
// still missing. The same scan fills the wizard when you run `bxcachy init` again. Exit 0.
class Status {
    function init( cli ) {
        variables.cli = arguments.cli;
        return this;
    }

    function run( asJson ) {
        var spec = new bxcachy.Init( variables.cli ).wizardSpec();
        var sys = new bxcachy.SystemState();
        var found = sys.scan( spec );
        var rows = [];
        for ( var pg in spec.pages ) for ( var q in pg.questions ) {
            if ( !structKeyExists( found.answers, q.id ) && !structKeyExists( found.installed, q.id ) ) continue;
            if ( left( q.id, 5 ) == "apps_" ) continue;   // the Customize pages are counted below
            var v = structKeyExists( found.answers, q.id ) ? found.answers[ q.id ] : found.installed[ q.id ];
            rows.append( { id: q.id, label: q.label, page: pg.title, value: v } );
        }
        var installedApps = 0;
        for ( var q2 in found.installed ) if ( left( q2, 5 ) == "apps_" ) installedApps += found.installed[ q2 ].len();
        var pk = new bxcachy.Packages();
        var missing = new bxcachy.Resolver().resolve( sys.catalogData(), { shell: pk.defaultShell(), rootFs: pk.rootFs(), installed: function( a ) { return sys.appInstalled( a.id ); } } ).selected.map( function( a ) { return a.id; } );
        var data = { detected: rows, installed_catalog_apps: installedApps, default_apps_missing: missing };
        if ( arguments.asJson ) { println( variables.cli.envelope( "status", 0, data ) ); return 0; }
        println( "This machine, in the wizard's terms:" );
        for ( var r in rows ) println( "  " & left( r.page & ": " & r.label & repeatString( " ", 60 ), 52 ) & ( isArray( r.value ) ? r.value.toList( ", " ) : r.value ) );
        if ( !rows.len() ) println( "  nothing BxCachy knows about was found yet" );
        println( "Default apps not installed: " & missing.len() & ( missing.len() ? " (" & missing.toList( ", " ) & ")" : "" ) );
        println( "Run `bxcachy init` to tune it (installed options are marked, nothing is removed), or `bxcachy init --fresh` for the defaults." );
        return 0;
    }
}
