// The coding agents BxCachy knows: the catalog app that installs each, the command it starts, and the providers whose API keys it
// accepts (AiProviders ids). A single-provider agent implies its key; OpenCode accepts many. One list for the wizard,
// `bxcachy ai` and `bxcachy secrets`: an agent is only ever given keys from its own list.
class AiAgents {
    function all() {
        var many = [ "anthropic", "openai", "google", "openrouter", "novita", "opencode", "groq", "mistral", "deepseek", "xai", "together" ];
        return [
            { id: "claude-code", name: "Claude Code", command: "claude", providers: [ "anthropic" ] },
            { id: "codex-cli", name: "Codex", command: "codex", providers: [ "openai" ] },
            { id: "gemini-cli", name: "Gemini CLI", command: "gemini", providers: [ "google" ] },
            { id: "opencode-cli", name: "OpenCode", command: "opencode", providers: many }
        ];
    }

    function ids() { return all().map( function( a ) { return a.id; } ); }

    // The agent for an id, or an empty struct.
    function find( id ) {
        for ( var a in all() ) if ( a.id == arguments.id ) return a;
        return {};
    }

    // The environment variable names an agent accepts.
    function keys( agent ) {
        var prov = new bxcachy.AiProviders();
        return arguments.agent.providers.map( function( id ) { return prov.find( id ).env; } );
    }
}
