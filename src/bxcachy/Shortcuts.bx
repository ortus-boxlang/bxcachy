// The one shortcut table shared by Hyprland and KDE Plasma (docs/architecture/COMMAND-CONTRACT.md section 13.4).
// Pure: no I/O. `render( target )` turns the table into the text each target needs:
//   xremap   YAML for the Cmd-style keys (one file, read by both xremap builds)
//   hyprland Hyprland `bind` lines for the keys that are not remaps
//   plasma   kglobalshortcutsrc lines for the keys that are not remaps
class Shortcuts {
    function init() {
        return this;
    }

    // Terminal window classes: in these, Cmd+C/V send Ctrl+Shift+C/V because plain Ctrl+C interrupts the running program.
    function terminals() {
        return [ "kitty", "Alacritty", "foot", "org.wezfurlong.wezterm", "com.mitchellh.ghostty", "org.kde.konsole", "konsole" ];
    }

    // Rows: id, keys (what the user presses), action (words), kind remap|bind.
    // remap rows: to (key sent), termTo (key sent in terminals, optional).
    // bind rows: hyprland (full bind line), plasma (kglobalshortcutsrc group, key, value).
    function table() {
        return [
            { id: "copy", keys: "Super+C", action: "Copy", kind: "remap", to: "Ctrl-c", termTo: "Ctrl-Shift-c" },
            { id: "paste", keys: "Super+V", action: "Paste", kind: "remap", to: "Ctrl-v", termTo: "Ctrl-Shift-v" },
            { id: "switch-windows", keys: "Super+Tab", action: "Switch windows", kind: "remap", to: "Alt-Tab" },
            { id: "logout", keys: "Super+Shift+Q", action: "Log out to the login screen", kind: "bind",
              hyprland: 'hl.bind(mainMod .. " + SHIFT + Q", hl.dsp.exec_cmd("uwsm stop"))',
              plasma: { group: "ksmserver", key: "Log Out", value: "Meta+Shift+Q,Ctrl+Alt+Del,Log Out" } },
            // Hyprland only (kind hypr-bind): on Plasma the AI shell is Yakuake, whose shortcut you set in System Settings.
            { id: "ai-shell", keys: "Super+`", action: "Pull-down AI shell", kind: "hypr-bind",
              hyprland: 'hl.bind(mainMod .. " + grave", hl.dsp.exec_cmd([[sh -c ''PATH="$HOME/.local/bin:$PATH"; bxcachy ai shell'']]))' }
        ];
    }

    // The table as text lines for `keys show`.
    function show() {
        return table().map( function( r ) {
            return { id: r.id, keys: r.keys, action: r.action, how: r.kind == "remap" ? "xremap" : ( r.kind == "hypr-bind" ? "Hyprland binding" : "desktop binding" ) };
        } );
    }

    // True for the render targets.
    function targets() {
        return [ "xremap", "hyprland", "plasma" ];
    }

    // Rendered text for one target.
    function render( target ) {
        if ( target == "xremap" ) return xremap();
        if ( target == "hyprland" ) return hyprland();
        if ( target == "plasma" ) return plasma();
        throw( type = "Shortcuts.target", message = "Unknown target: " & target );
    }

    // xremap YAML: terminal rules first (only), then the general rules (not terminals).
    function xremap() {
        var remaps = table().filter( function( r ) { return r.kind == "remap"; } );
        var termList = terminals().map( function( c ) { return "'" & c & "'"; } ).toList( ", " );
        var out = [ "# Written by bxcachy (keys). Cmd-style keys, same on Hyprland and Plasma.", "keymap:" ];
        out.append( "  - name: Cmd keys in terminals" );
        out.append( "    application:" );
        out.append( "      only: [" & termList & "]" );
        out.append( "    remap:" );
        for ( var r in remaps ) out.append( "      Super-" & lcase( listLast( r.keys, "+" ) ) & ": " & ( structKeyExists( r, "termTo" ) ? r.termTo : r.to ) );
        out.append( "  - name: Cmd keys everywhere else" );
        out.append( "    application:" );
        out.append( "      not: [" & termList & "]" );
        out.append( "    remap:" );
        for ( var r in remaps ) out.append( "      Super-" & lcase( listLast( r.keys, "+" ) ) & ": " & r.to );
        return out.toList( chr( 10 ) ) & chr( 10 );
    }

    // The Hyprland Lua module (Hyprland 0.55+ reads hyprland.lua; Noctalia's docs use the same API).
    // Written to ~/.config/hypr/bxcachy.lua; hyprland.lua loads it with `require("bxcachy")` (see hyprlandLoadLine).
    // Lines come from the Noctalia v5 Hyprland docs: https://docs.noctalia.dev/noctalia/v5.4.0/compositor-settings/hyprland/
    function hyprland() {
        var out = [
            '-- Written by bxcachy (keys). Edit with `bxcachy keys apply`, not by hand.',
            'local mainMod = "SUPER"',
            'local ipc = "noctalia msg "',
            '',
            '-- Noctalia starts with the session',
            'hl.on("hyprland.start", function()',
            '  hl.exec_cmd("noctalia")',
            'end)',
            '',
            '-- Super+Space opens the launcher you chose (`bxcachy runner set`; Noctalia by default). If that cannot run, Noctalia opens.',
            'hl.bind(mainMod .. "+Space", hl.dsp.exec_cmd([[sh -c ''PATH="$HOME/.local/bin:$PATH"; bxcachy runner launch || noctalia msg panel-toggle launcher'']]))',
            '-- Noctalia panels and the window switcher (Super+Tab is remapped to Alt+Tab by xremap)',
            'hl.bind(mainMod .. "+S", hl.dsp.exec_cmd(ipc .. "panel-toggle control-center"))',
            'hl.bind(mainMod .. "+comma", hl.dsp.exec_cmd(ipc .. "settings-toggle"))',
            'hl.bind("ALT + Tab", hl.dsp.exec_cmd(ipc .. "window-switcher hold"))',
            '',
            '-- Shared shortcuts from the bxcachy table'
        ];
        for ( var r in table() ) if ( r.kind == "bind" || r.kind == "hypr-bind" ) out.append( r.hyprland );
        out.append( '' );
        out.append( '-- The pull-down AI shell (bxcachy ai shell) lives on the special workspace "ai"; its window class is set by the terminal it starts' );
        out.append( 'hl.window_rule({ name = "bxcachy-ai", match = { class = "^com.bxcachy.ai$" }, workspace = "special:ai", float = true })' );
        out.append( '' );
        out.append( '-- Noctalia settings window floats; its panels get blur and no layer animation' );
        out.append( 'hl.window_rule({ match = { class = "dev.noctalia.Noctalia" }, float = true, size = { 1080, 920 } })' );
        out.append( 'hl.layer_rule({ name = "noctalia", match = { namespace = "^noctalia-(bar-.+|notification|dock|panel|attached-panel|osd|window-switcher)$" }, no_anim = true, ignore_alpha = 0.5, blur = true, blur_popups = true })' );
        return out.toList( chr( 10 ) ) & chr( 10 );
    }

    // The one line hyprland.lua needs to load the module above.
    function hyprlandLoadLine() {
        return 'require("bxcachy")';
    }

    // kglobalshortcutsrc fragment for Plasma.
    function plasma() {
        var out = [ "# Written by bxcachy (keys)." ];
        for ( var r in table() ) if ( r.kind == "bind" ) {
            out.append( "[" & r.plasma.group & "]" );
            out.append( r.plasma.key & "=" & r.plasma.value );
        }
        return out.toList( chr( 10 ) ) & chr( 10 );
    }

    // The files bxcachy manages for the shortcuts, in the config service entry shape (name, target, mode, content).
    // They join `config list|diff|apply|restore`. The Hyprland file still has to be `source`d from hyprland.conf.
    function entries( cfgHome ) {
        return [
            { name: "xremap", target: cfgHome & "/xremap/config.yml", mode: "644", content: xremap() },
            { name: "hypr-keys", target: cfgHome & "/hypr/bxcachy.lua", mode: "644", content: hyprland() },
            { name: "xremap-service", target: cfgHome & "/systemd/user/xremap.service", mode: "644", content: xremapService() }
        ];
    }

    // Plasma settings written with kwriteconfig6 into kglobalshortcutsrc: [ { group, key, value } ].
    function plasmaSettings() {
        return table().filter( function( r ) { return r.kind == "bind"; } ).map( function( r ) { return r.plasma; } );
    }

    // The systemd user unit that runs xremap with the shared config. Enabled by `setup xremap`.
    function xremapService() {
        return [ "# Written by bxcachy (keys).", "[Unit]", "Description=xremap key remapper (bxcachy)", "PartOf=graphical-session.target", "After=graphical-session.target",
                 "", "[Service]", "ExecStart=/usr/bin/xremap %h/.config/xremap/config.yml", "Restart=on-failure",
                 "", "[Install]", "WantedBy=graphical-session.target" ].toList( chr( 10 ) ) & chr( 10 );
    }
}
