// What the Dashboard page shows, gathered from the machine: system meters, machines that run, backup freshness and the things that need attention.
//   new bxcachy.DashboardData( cli ).collect()  -> { host, os, kernel, uptime, cpu, mem:{used,total}, disk:{used,total}, battery:{present,percent,charging},
//                                                    updates (-1 when unknown), machines:[{kind,name,state,port}], backups:[{id,label,count,latest,error}], now }
//   new bxcachy.DashboardData( cli ).attention( data ) -> [ { level (warn|error|ok), text, key, action } ] where action is an intent for the shell
//   new bxcachy.DashboardData( cli ).demo()  -> made-up data for screenshots and tests
// Every part is read on its own and a failing part is left empty, so the page always opens. BXCACHY_DASHBOARD_FILE (a JSON file) replaces the real reads.
// BXCACHY_POWER_DIR replaces /sys/class/power_supply (the same switch SystemState uses).
class DashboardData {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.runner = arguments.runner;
        return this;
    }

    function readText( file ) { try { return fileExists( arguments.file ) ? trim( fileRead( arguments.file ) ) : ""; } catch ( any e ) { return ""; } }
    function self() { return getSystemSetting( "BXCACHY_SELF", "bxcachy" ); }

    function osName() {
        for ( var l in listToArray( readText( "/etc/os-release" ), chr( 10 ) ) ) if ( left( l, 12 ) == "PRETTY_NAME=" ) return replace( mid( l, 13, 100 ), chr( 34 ), "", "all" );
        return "Linux";
    }

    function memInfo() {
        var out = { used: 0, total: 0 };
        var total = 0; var avail = 0;
        for ( var l in listToArray( readText( "/proc/meminfo" ), chr( 10 ) ) ) {
            if ( left( l, 9 ) == "MemTotal:" ) total = int( val( trim( mid( l, 10, 30 ) ) ) ) * 1024;
            if ( left( l, 13 ) == "MemAvailable:" ) avail = int( val( trim( mid( l, 14, 30 ) ) ) ) * 1024;
        }
        out.total = total; out.used = max( 0, total - avail );
        return out;
    }

    function cpuFraction() {
        var load1 = val( listFirst( readText( "/proc/loadavg" ), " " ) );
        var n = 0;
        for ( var l in listToArray( readText( "/proc/cpuinfo" ), chr( 10 ) ) ) if ( left( l, 9 ) == "processor" ) n++;
        return min( 1, load1 / max( 1, n ) );
    }

    function diskInfo() {
        var out = { used: 0, total: 0 };
        try {
            var r = systemExecute( "df", [ "-B1", "--output=size,used", "/" ], 10, true );
            var lines = listToArray( r.output, chr( 10 ) );
            if ( lines.len() >= 2 ) { var parts = listToArray( trim( lines[ 2 ] ), " " ); if ( parts.len() >= 2 ) { out.total = val( parts[ 1 ] ); out.used = val( parts[ 2 ] ); } }
        } catch ( any e ) {}
        return out;
    }

    function batteryInfo() {
        var dir = getSystemSetting( "BXCACHY_POWER_DIR", "/sys/class/power_supply" );
        var out = { present: false, percent: 0, charging: false };
        try {
            for ( var d in directoryList( dir, false, "name" ) ) {
                if ( readText( dir & "/" & d & "/type" ) == "Battery" ) {
                    out.present = true;
                    out.percent = int( val( readText( dir & "/" & d & "/capacity" ) ) );
                    out.charging = readText( dir & "/" & d & "/status" ) != "Discharging";
                    break;
                }
            }
        } catch ( any e ) {}
        return out;
    }

    function updateCount() {
        try {
            var r = systemExecute( "checkupdates", [], 60, true );
            if ( r.exitCode == 0 ) return listToArray( trim( r.output ), chr( 10 ) ).len();
            if ( r.exitCode == 2 ) return 0;
        } catch ( any e ) {}
        return -1;
    }

    function dbMachines() {
        var rows = [];
        try {
            var r = systemExecute( self(), [ "db", "list", "--json" ], 40, true );
            var j = jsonDeserialize( r.output );
            var list = structKeyExists( j.data, "databases" ) ? j.data.databases : [];
            for ( var d in list ) rows.append( { kind: "db", name: len( d.name ) ? d.name : d.container, state: left( d.status, 2 ) == "Up" ? "running" : "stopped", port: d.port ?: 0 } );
        } catch ( any e ) {}
        return rows;
    }

    function vmMachines() {
        var rows = [];
        try {
            var r = systemExecute( self(), [ "vm", "list", "--json" ], 40, true );
            var j = jsonDeserialize( r.output );
            var list = structKeyExists( j.data, "vms" ) ? j.data.vms : [];
            for ( var m in list ) rows.append( { kind: "vm", name: m.name, state: m.state == "running" ? "running" : "stopped", port: 0 } );
        } catch ( any e ) {}
        return rows;
    }

    function machines() {
        var rows = dbMachines();
        for ( var m in vmMachines() ) rows.append( m );
        return rows;
    }

    function backupRows() {
        var out = [];
        try {
            var t = new bxcachy.BackupTimeline( variables.cli, variables.runner ).build( true );
            for ( var r in t.rows ) out.append( { id: r.id, label: r.label, count: r.points.len(), latest: r.points.len() ? r.points[ 1 ].epoch : 0, error: r.error ?: "", ages: agesOf( r, t.now ) } );
            return { now: t.now, rows: out };
        } catch ( any e ) {}
        return { now: new bxcachy.BackupTimeline( variables.cli ).nowEpoch(), rows: out };
    }

    // The last 8 backups of a row as a count per equal slice of its history, for a sparkline.
    function agesOf( row, now ) {
        var pts = arguments.row.points;
        if ( !pts.len() ) return [];
        var oldest = pts[ pts.len() ].epoch;
        var span = max( 1, arguments.now - oldest );
        var buckets = [ 0, 0, 0, 0, 0, 0, 0, 0 ];
        for ( var p in pts ) { var i = min( 8, 1 + int( ( p.epoch - oldest ) / span * 8 ) ); buckets[ i ] = buckets[ i ] + 1; }
        return buckets;
    }

    function collect() {
        var forced = getSystemSetting( "BXCACHY_DASHBOARD_FILE", "" );
        if ( len( forced ) && fileExists( forced ) ) return jsonDeserialize( fileRead( forced ) );
        var out = {};
        var bk = backupRows();
        out.host = readText( "/proc/sys/kernel/hostname" );
        out.os = osName();
        out.kernel = readText( "/proc/sys/kernel/osrelease" );
        out.uptime = int( val( listFirst( readText( "/proc/uptime" ), " " ) ) );
        out.cpu = cpuFraction();
        out.mem = memInfo();
        out.disk = diskInfo();
        out.battery = batteryInfo();
        out.updates = updateCount();
        out.machines = machines();
        out.backups = bk.rows;
        out.now = bk.now;
        return out;
    }

    // ---- what needs attention ----
    function attention( data ) {
        var d = arguments.data;
        var out = [];
        if ( d.updates > 0 ) out.append( { level: "warn", text: d.updates & " updates available", key: "u", action: { action: "cli", title: "System update", args: [ "system", "update" ] } } );
        for ( var b in d.backups ) {
            if ( b.id == "system" || b.id == "config" || left( b.id, 6 ) == "files-" ) {
                if ( len( b.error ) ) continue;
                if ( !b.count && b.id != "system" ) { out.append( { level: "warn", text: b.label & ": no backup yet", key: "b", action: { action: "launch", target: "timemachine" } } ); continue; }
                if ( b.count && d.now - b.latest > 2 * 86400 ) out.append( { level: "warn", text: b.label & " backup is " & int( ( d.now - b.latest ) / 86400 ) & " days old", key: "b", action: { action: "launch", target: "timemachine" } } );
            }
        }
        if ( d.disk.total > 0 && d.disk.used / d.disk.total >= 0.85 ) out.append( { level: d.disk.used / d.disk.total >= 0.95 ? "error" : "warn", text: "Disk is " & round( d.disk.used / d.disk.total * 100 ) & "% full", key: "", action: {} } );
        if ( d.battery.present && !d.battery.charging && d.battery.percent <= 20 ) out.append( { level: "error", text: "Battery at " & d.battery.percent & "%", key: "", action: {} } );
        return out;
    }

    // ---- made-up data ----
    function demo() {
        var now = 1794583800;
        return {
            host: "orion", os: "CachyOS", kernel: "6.18.4-cachyos", uptime: 3 * 86400 + 4 * 3600, cpu: 0.23,
            mem: { used: 9876893696, total: 17179869184 }, disk: { used: 417000000000, total: 512000000000 }, battery: { present: true, percent: 64, charging: false },
            updates: 14, now: now,
            machines: [ { kind: "db", name: "postgres", state: "running", port: 5432 }, { kind: "db", name: "redis", state: "running", port: 6379 }, { kind: "vm", name: "win11", state: "stopped", port: 0 }, { kind: "vm", name: "webtop-ubuntu", state: "running", port: 3001 } ],
            backups: [
                { id: "system", label: "System", count: 24, latest: now - 3 * 3600, error: "", ages: [ 1, 1, 2, 3, 3, 4, 5, 5 ] },
                { id: "config", label: "Config", count: 9, latest: now - 1800, error: "", ages: [ 1, 1, 1, 1, 2, 1, 1, 1 ] },
                { id: "files-nas", label: "Files nas", count: 12, latest: now - 3 * 86400, error: "", ages: [ 1, 1, 1, 2, 2, 2, 2, 1 ] }
            ]
        };
    }
}
