// `bxcachy time ...`: the time zone, for when you travel (and plain NTP).
//   time status [--json]                 zone, clock, NTP, and whether the automatic zone daemon runs
//   time zone                            the current zone
//   time zone --list                     every zone (timedatectl list-timezones)
//   time zone ZONE [--yes]               set it (sudo timedatectl set-timezone); a plan without --yes
//   time sync [--yes]                    set the zone once from your IP address (`tzupdate`, AUR); use it after you land
//   time auto on|off [--yes]             follow your location by itself: installs geoclue and automatic-timezoned, writes the service and
//                                        a geoclue drop-in, enables it. This sends your Wi-Fi networks or IP address to a location web service.
//   time ntp on|off [--yes]              network time sync (timedatectl set-ntp)
// What `auto on` writes (the AUR package ships no unit; the daemon's README says it needs GeoClue to allow it without an agent):
//   /etc/systemd/system/automatic-timezoned.service   runs the daemon as root (root may set the zone without a polkit rule)
//   /etc/geoclue/conf.d/90-bxcachy-timezone.conf      [agent] whitelist= (empty: no agent needed) and [automatic-timezoned] allowed, system, any user
// Test overrides: BXCACHY_SYSTEMD_DIR, BXCACHY_GEOCLUE_DIR.
// Exit: 0 ok, 2 bad usage or a plan without --yes, 4 precondition (unknown zone, no tool), 5 and 6 and 7 from the install steps.
class Time {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        return this;
    }

    function env( name, fallback ) {
        var v = getSystemSetting( arguments.name, "" );
        return len( v ) ? v : arguments.fallback;
    }

    function tryExec( argv, timeout = 30 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function has( name ) { return tryExec( [ "sh", "-c", 'command -v "$1"', "_", arguments.name ], 10 ).exitCode == 0; }
    function say( code, data, asJson, lines = [], dry = false ) {
        if ( arguments.asJson ) println( variables.cli.envelope( "time", arguments.code, arguments.data, arguments.dry ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }
    function fail( code, msg, asJson ) { return say( arguments.code, { error: arguments.msg }, arguments.asJson, [ "error: " & arguments.msg ] ); }

    function unitFile() { return env( "BXCACHY_SYSTEMD_DIR", "/etc/systemd/system" ) & "/automatic-timezoned.service"; }
    function geoclueFile() { return env( "BXCACHY_GEOCLUE_DIR", "/etc/geoclue/conf.d" ) & "/90-bxcachy-timezone.conf"; }

    function unitText() {
        return "# Written by `bxcachy time auto on`. Remove with `bxcachy time auto off`." & chr( 10 )
            & "[Unit]" & chr( 10 ) & "Description=Automatically update system timezone based on location" & chr( 10 )
            & "Requires=geoclue.service" & chr( 10 ) & "After=geoclue.service" & chr( 10 ) & chr( 10 )
            & "[Service]" & chr( 10 ) & "ExecStart=/usr/bin/automatic-timezoned" & chr( 10 ) & chr( 10 )
            & "[Install]" & chr( 10 ) & "WantedBy=multi-user.target" & chr( 10 );
    }

    function geoclueText() {
        return "; Written by `bxcachy time auto on`. Remove with `bxcachy time auto off`." & chr( 10 )
            & "[agent]" & chr( 10 ) & "whitelist=" & chr( 10 ) & chr( 10 )
            & "[automatic-timezoned]" & chr( 10 ) & "allowed=true" & chr( 10 ) & "system=true" & chr( 10 ) & "users=" & chr( 10 );
    }

    // key=value lines of `timedatectl show`.
    function facts() {
        var f = { timezone: "", ntp: false, synchronized: false, rtc_local: false, time: "" };
        var r = tryExec( [ "timedatectl", "show" ], 10 );
        if ( r.exitCode == 0 ) {
            for ( var line in listToArray( r.output, chr( 10 ) ) ) {
                var k = listFirst( line, "=" );
                var v = trim( listRest( line, "=" ) );
                if ( k == "Timezone" ) f.timezone = v;
                if ( k == "NTP" ) f.ntp = v == "yes";
                if ( k == "NTPSynchronized" ) f.synchronized = v == "yes";
                if ( k == "LocalRTC" ) f.rtc_local = v == "yes";
                if ( k == "TimeUSec" ) f.time = v;
            }
        }
        return f;
    }

    function zones() {
        var r = tryExec( [ "timedatectl", "list-timezones" ], 15 );
        return r.exitCode == 0 ? listToArray( trim( r.output ), chr( 10 ) ) : [];
    }

    function autoActive() { return tryExec( [ "systemctl", "is-active", "--quiet", "automatic-timezoned.service" ], 10 ).exitCode == 0; }

    // ---- commands ----
    function statusCmd( asJson ) {
        var f = facts();
        var auto = autoActive();
        var data = { timezone: f.timezone, ntp: f.ntp, synchronized: f.synchronized, rtc_local: f.rtc_local, automatic_zone: auto };
        var lines = [ "zone: " & ( len( f.timezone ) ? f.timezone : "unknown" ), "network time: " & ( f.ntp ? "on" : "off" ) & ( f.synchronized ? ", synchronized" : "" ),
            "automatic zone: " & ( auto ? "on (follows your location)" : "off (bxcachy time auto on, or bxcachy time sync after you travel)" ) ];
        if ( f.rtc_local ) lines.append( "note: the hardware clock is in local time (usual with Windows dual boot)" );
        return say( 0, data, arguments.asJson, lines );
    }

    // Shows the plan, or runs the commands. cmds: [ argv ], title for the plan.
    function runPlan( title, cmds, yes, dry, asJson, data = {} ) {
        var d = arguments.data;
        d.commands = arguments.cmds.map( function( c ) { return c.toList( " " ); } );
        if ( !arguments.yes || arguments.dry ) {
            var lines = [ ( arguments.dry ? "Dry run: " : "Plan: " ) & arguments.title ];
            for ( var c in arguments.cmds ) lines.append( "  " & c.toList( " " ) );
            lines.append( arguments.dry ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." );
            return say( arguments.dry ? 0 : 2, d, arguments.asJson, lines, arguments.dry );
        }
        for ( var cmd in arguments.cmds ) {
            var r = tryExec( cmd, 600 );
            if ( r.exitCode != 0 ) return say( 6, { error: trim( r.output ), step: cmd.toList( " " ) }, arguments.asJson, [ "error: " & cmd.toList( " " ) & ": " & trim( r.output ) ] );
        }
        return say( 0, d, arguments.asJson, [ arguments.title & ": done" ] );
    }

    function zoneCmd( args, yes, dry, asJson ) {
        if ( !arguments.args.len() ) return say( 0, { timezone: facts().timezone }, arguments.asJson, [ facts().timezone ] );
        if ( arguments.args[ 1 ] == "--list" || arguments.args[ 1 ] == "list" ) { var z = zones(); return say( 0, { zones: z }, arguments.asJson, z ); }
        if ( arguments.args.len() != 1 ) return fail( 2, "Usage: bxcachy time zone [--list | ZONE]", arguments.asJson );
        var want = arguments.args[ 1 ];
        var all = zones();
        if ( all.len() && !arrayFind( all, want ) ) return fail( 4, want & " is not a time zone (bxcachy time zone --list)", arguments.asJson );
        if ( !all.len() && !reFind( "^[A-Za-z0-9_+/-]+$", want ) ) return fail( 4, want & " is not a time zone", arguments.asJson );
        return runPlan( "set the time zone to " & want, [ [ "sudo", "timedatectl", "set-timezone", want ] ], arguments.yes, arguments.dry, arguments.asJson, { timezone: want } );
    }

    function syncCmd( yes, dry, asJson ) {
        var steps = [];
        var before = facts().timezone;
        var d = { was: before };
        if ( !has( "tzupdate" ) ) {
            var built = variables.inst.steps( [ { id: "tzupdate", source: "aur", targets: [ "tzupdate" ] } ], variables.inst.isRoot() );
            d.install = built.steps;
            if ( !arguments.yes || arguments.dry ) return say( arguments.dry ? 0 : 2, d, arguments.asJson, [ ( arguments.dry ? "Dry run" : "Plan" ) & ": install tzupdate (AUR), then set the time zone from your IP address", "Nothing was changed." & ( arguments.dry ? "" : " Add --yes to apply." ) ], arguments.dry );
            var res = variables.inst.run( built.steps );
            if ( variables.inst.exitCode( res ) != 0 ) return say( variables.inst.exitCode( res ), { failed: res.failed }, arguments.asJson, res.failed.map( function( f ) { return "Failed: " & f.id & ": " & f.error; } ) );
        }
        var code = runPlan( "set the time zone from your IP address (tzupdate)", [ [ "sudo", "tzupdate" ] ], arguments.yes, arguments.dry, arguments.asJson, d );
        if ( code == 0 && arguments.yes && !arguments.dry && !arguments.asJson ) println( "zone: " & before & " -> " & facts().timezone );
        return code;
    }

    function autoCmd( args, yes, dry, asJson ) {
        var v = arguments.args.len() == 1 ? arguments.args[ 1 ] : "";
        if ( v == "status" ) return say( 0, { automatic_zone: autoActive() }, arguments.asJson, [ "automatic zone: " & ( autoActive() ? "on" : "off" ) ] );
        if ( v != "on" && v != "off" ) return fail( 2, "Usage: bxcachy time auto on|off|status", arguments.asJson );
        var tmpU = getTempDirectory() & "/bxcachy-tz-unit-" & createUUID();
        var tmpG = getTempDirectory() & "/bxcachy-tz-geoclue-" & createUUID();
        var d = { unit: unitFile(), geoclue: geoclueFile() };
        var privacy = "Privacy: GeoClue looks up your location online (the Wi-Fi networks around you or your IP address) through a location web service, each time you move.";
        if ( v == "off" ) {
            return runPlan( "turn the automatic time zone off", [ [ "sudo", "systemctl", "disable", "--now", "automatic-timezoned.service" ], [ "sudo", "rm", "-f", unitFile(), geoclueFile() ], [ "sudo", "systemctl", "daemon-reload" ] ], arguments.yes, arguments.dry, arguments.asJson, d );
        }
        var apps = [ { id: "geoclue", source: "pacman", targets: [ "geoclue" ] } ];
        if ( !has( "automatic-timezoned" ) ) apps.append( { id: "automatic-timezoned", source: "aur", targets: [ "automatic-timezoned" ] } );
        var built = variables.inst.steps( apps, variables.inst.isRoot() );
        d.install = built.steps;
        var after = [ [ "sudo", "install", "-Dm644", tmpU, unitFile() ], [ "sudo", "install", "-Dm644", tmpG, geoclueFile() ], [ "sudo", "systemctl", "daemon-reload" ], [ "sudo", "systemctl", "enable", "--now", "automatic-timezoned.service" ] ];
        if ( !arguments.yes || arguments.dry ) {
            var lines = [ ( arguments.dry ? "Dry run" : "Plan" ) & ": follow your location with the time zone", privacy ];
            for ( var st in built.steps ) for ( var c in st.commands ) lines.append( "  " & st.kind & ": " & c.toList( " " ) );
            for ( var a in after ) lines.append( "  " & a.toList( " " ) );
            lines.append( "Nothing was changed." & ( arguments.dry ? "" : " Add --yes to apply." ) );
            d.commands = after.map( function( c ) { return c.toList( " " ); } );
            return say( arguments.dry ? 0 : 2, d, arguments.asJson, lines, arguments.dry );
        }
        if ( variables.inst.isRoot() ) return fail( 4, "run as a regular user: AUR packages are never built as root", arguments.asJson );
        var res = variables.inst.run( built.steps );
        if ( variables.inst.exitCode( res ) != 0 ) return say( variables.inst.exitCode( res ), { failed: res.failed }, arguments.asJson, res.failed.map( function( f ) { return "Failed: " & f.id & ": " & f.error; } ) );
        fileWrite( tmpU, unitText() );
        fileWrite( tmpG, geoclueText() );
        var code = runPlan( "follow your location with the time zone", after, true, false, arguments.asJson, d );
        try { fileDelete( tmpU ); fileDelete( tmpG ); } catch ( any e ) {}
        if ( code == 0 && !arguments.asJson ) { println( privacy ); println( "If the zone does not change, read: journalctl -u automatic-timezoned" ); }
        return code;
    }

    function ntpCmd( args, yes, dry, asJson ) {
        var v = arguments.args.len() == 1 ? arguments.args[ 1 ] : "";
        if ( v != "on" && v != "off" ) return fail( 2, "Usage: bxcachy time ntp on|off", arguments.asJson );
        return runPlan( "turn network time " & v, [ [ "sudo", "timedatectl", "set-ntp", v == "on" ? "true" : "false" ] ], arguments.yes, arguments.dry, arguments.asJson, { ntp: v == "on" } );
    }

    function run( words, dry = false, yes = false, asJson = false ) {
        var verb = arguments.words.len() ? arguments.words[ 1 ] : "";
        var rest = [];
        for ( var i = 2; i <= arguments.words.len(); i++ ) rest.append( arguments.words[ i ] );
        if ( verb == "" || verb == "status" ) return statusCmd( arguments.asJson );
        if ( verb == "zone" ) return zoneCmd( rest, arguments.yes, arguments.dry, arguments.asJson );
        if ( verb == "sync" ) return syncCmd( arguments.yes, arguments.dry, arguments.asJson );
        if ( verb == "auto" ) return autoCmd( rest, arguments.yes, arguments.dry, arguments.asJson );
        if ( verb == "ntp" ) return ntpCmd( rest, arguments.yes, arguments.dry, arguments.asJson );
        return fail( 2, "Usage: bxcachy time status | zone [--list|ZONE] | sync | auto on|off|status | ntp on|off", arguments.asJson );
    }
}
