// `bxcachy boxlang`: the BoxLang developer ecosystem on top of what install.sh puts in place (Java 21, bvm, mvm, BoxLang, MatchBox).
//   status                      what is installed: boxlang, bvm, mvm, matchbox, bx-module, VS Code and the BoxLang extension
//   use VERSION                 `bvm install VERSION` when missing, then `bvm use VERSION` (latest, snapshot or a number)
//   matchbox use VERSION        the same with mvm for MatchBox
//   modules list|search TEXT    the BoxLang modules on ForgeBox (its public API: /api/v1/entries?type=boxlang-modules)
//   modules install SLUG...     `bx-module install SLUG...`; modules installed|outdated|update wrap bx-module
//   vscode                      `code --install-extension ortus-solutions.vscode-boxlang` and the developer pack
//   links                       the BoxLang sites (docs, AI, Sites, Agents, MatchBox, ForgeBox, Skills, Try BoxLang...)
//   welcome                     writes and opens the getting-started page
// Commands come from the BoxLang docs (bvm, bx-module) and the MatchBox quick installer README (mvm). Exit: 0 done, 4 a tool is missing,
// 6 a command failed.
class Boxlang {
    variables.forgebox = "https://forgebox.io/api/v1";
    variables.extension = "ortus-solutions.vscode-boxlang";
    variables.pack = "ortus-solutions.vscode-boxlang-developer-pack";

    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        return this;
    }

    function say( code, data, asJson, lines = [] ) {
        if ( arguments.asJson ) println( variables.cli.envelope( "boxlang", arguments.code, arguments.data ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function tryExec( argv, timeout = 120 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message, timeout: false }; }
    }

    function has( name ) { return tryExec( [ "sh", "-c", 'command -v "$1"', "_", arguments.name ], 10 ).exitCode == 0; }

    function links() {
        return [
            { id: "try", title: "Try BoxLang", url: "https://try.boxlang.io", about: "Write and run BoxLang in the browser" },
            { id: "boxlang", title: "BoxLang", url: "https://boxlang.io", about: "The language" },
            { id: "docs", title: "BoxLang docs", url: "https://boxlang.ortusbooks.com", about: "The reference and guides" },
            { id: "ai", title: "BoxLang AI", url: "https://ai.boxlang.io", about: "The AI and agent framework (bx-ai)" },
            { id: "ai-docs", title: "BoxLang AI docs", url: "https://ai.ortusbooks.com", about: "The bx-ai book" },
            { id: "agents", title: "BoxLang Agents", url: "https://bxagents.ai", about: "Agents on BoxLang" },
            { id: "sites", title: "BoxLang Sites", url: "https://bxsites.io", about: "Sites on BoxLang (bx-sites)" },
            { id: "matchbox", title: "MatchBox", url: "https://matchbox.boxlang.io", about: "Compile BoxLang to native binaries" },
            { id: "forgebox", title: "ForgeBox", url: "https://forgebox.io", about: "The module and package registry" },
            { id: "skills", title: "BoxLang skills", url: "https://skills.boxlang.io", about: "Agent skills for BoxLang" },
            { id: "academy", title: "BoxLang Academy", url: "https://academy.boxlang.io", about: "Free training" },
            { id: "plans", title: "BoxLang+", url: "https://boxlang.io/plans", about: "Support and premium modules" },
            { id: "github", title: "GitHub", url: "https://github.com/ortus-boxlang", about: "The source" },
            { id: "itb", title: "Into the Box", url: "https://intothebox.com", about: "The conference" }
        ];
    }

    function versionOf( cmd, args ) {
        if ( !has( arguments.cmd ) ) return "";
        var r = tryExec( [ arguments.cmd, arguments.args ], 30 );
        return r.exitCode == 0 ? trim( listFirst( r.output, chr( 10 ) ) ) : "";
    }

    function bvmCurrent() {
        if ( !has( "bvm" ) ) return "";
        var r = tryExec( [ "bvm", "current" ], 30 );
        return r.exitCode == 0 ? trim( listFirst( r.output, chr( 10 ) ) ) : "";
    }

    function status( asJson ) {
        var vsx = has( "code" ) ? tryExec( [ "code", "--list-extensions" ], 60 ).output : "";
        var d = {
            boxlang: versionOf( "boxlang", "--version" ), bvm: bvmCurrent(),
            matchbox: versionOf( "matchbox", "--version" ), mvm: has( "mvm" ), bx_module: has( "bx-module" ),
            vscode: has( "code" ), vscode_extension: find( variables.extension, vsx ) > 0
        };
        return say( 0, d, arguments.asJson, [
            "BoxLang:   " & ( len( d.boxlang ) ? d.boxlang : "not installed" ) & ( len( d.bvm ) ? "  (bvm: " & d.bvm & ")" : "" ),
            "MatchBox:  " & ( len( d.matchbox ) ? d.matchbox : "not installed" ) & ( d.mvm ? "  (mvm)" : "" ),
            "Modules:   " & ( d.bx_module ? "bx-module is available" : "bx-module not found" ),
            "VS Code:   " & ( d.vscode ? ( d.vscode_extension ? "installed, BoxLang extension present" : "installed, BoxLang extension missing: bxcachy boxlang vscode" ) : "not installed" )
        ] );
    }

    // `use VERSION` (bvm) or `matchbox use VERSION` (mvm)
    function use( tool, version, asJson ) {
        if ( !has( arguments.tool ) ) return say( 4, { error: arguments.tool & " was not found" }, arguments.asJson, [ "error: " & arguments.tool & " was not found (install.sh installs it)" ] );
        if ( !reFind( "^[A-Za-z0-9._+-]{1,40}$", arguments.version ) ) return say( 4, { error: "bad version" }, arguments.asJson, [ "error: bad version " & arguments.version ] );
        var have = tryExec( [ arguments.tool, "list" ], 60 ).output;
        if ( find( arguments.version, have ) == 0 ) {
            var i = tryExec( [ arguments.tool, "install", arguments.version ], 1800 );
            if ( i.exitCode != 0 ) return say( 6, { error: trim( i.output ) }, arguments.asJson, [ "error: " & arguments.tool & " install " & arguments.version & " failed" ] );
        }
        var r = tryExec( [ arguments.tool, "use", arguments.version ], 60 );
        if ( r.exitCode != 0 ) return say( 6, { error: trim( r.output ) }, arguments.asJson, [ "error: " & arguments.tool & " use " & arguments.version & " failed" ] );
        return say( 0, { tool: arguments.tool, version: arguments.version }, arguments.asJson, [ arguments.tool & " now uses " & arguments.version ] );
    }

    // ForgeBox: [ { slug, title, version, description } ]
    function forgeboxModules( term ) {
        var url = variables.forgebox & "/entries?type=boxlang-modules&maxrows=100" & ( len( arguments.term ) ? "&searchTerm=" & urlEncodedFormat( arguments.term ) : "" );
        var r = tryExec( [ "curl", "-fsSL", "--max-time", "30", url ], 60 );
        if ( r.exitCode != 0 ) return { ok: false, error: "ForgeBox did not answer", rows: [] };
        try {
            var j = jsonDeserialize( r.output );
            var rows = [];
            for ( var e in j.data.results ) rows.append( { slug: e.slug, title: e.title ?: e.slug, version: e.latestVersion.version ?: "", description: left( replace( e.summary ?: "", chr( 10 ), " ", "all" ), 100 ) } );
            return { ok: true, rows: rows };
        } catch ( any e ) { return { ok: false, error: "unexpected answer from ForgeBox", rows: [] }; }
    }

    function modules( action, args, asJson ) {
        if ( arguments.action == "list" || arguments.action == "search" ) {
            var f = forgeboxModules( arguments.action == "search" && arguments.args.len() ? arguments.args.toList( " " ) : "" );
            if ( !f.ok ) return say( 6, { error: f.error }, arguments.asJson, [ "error: " & f.error ] );
            return say( 0, { modules: f.rows }, arguments.asJson, f.rows.map( function( m ) { return m.slug & "  " & m.version & "  " & m.description; } ) );
        }
        if ( !has( "bx-module" ) ) return say( 4, { error: "bx-module was not found" }, arguments.asJson, [ "error: bx-module was not found (the BoxLang quick installer or bvm installs it)" ] );
        for ( var a in arguments.args ) if ( !reFind( "^[A-Za-z0-9._@+-]{1,60}$", a ) ) return say( 4, { error: "bad module name" }, arguments.asJson, [ "error: bad module name " & a ] );
        var words = { install: "install", installed: "list", outdated: "outdated", update: "update" };
        if ( !structKeyExists( words, arguments.action ) ) return say( 4, { error: "unknown action" }, arguments.asJson, [ "error: unknown action " & arguments.action ] );
        if ( arguments.action == "install" && !arguments.args.len() ) return say( 4, { error: "name the modules" }, arguments.asJson, [ "error: name the modules to install" ] );
        var argv = [ "bx-module", words[ arguments.action ] ];
        for ( var m in arguments.args ) argv.append( m );
        if ( arguments.action == "update" ) argv.append( "--force" );
        var r = tryExec( argv, 1800 );
        if ( r.exitCode != 0 ) return say( 6, { error: trim( r.output ) }, arguments.asJson, [ "error: bx-module " & words[ arguments.action ] & " failed" ] );
        return say( 0, { output: trim( r.output ) }, arguments.asJson, [ trim( r.output ) ] );
    }

    function vscode( asJson ) {
        if ( !has( "code" ) ) return say( 4, { error: "code was not found" }, arguments.asJson, [ "error: VS Code was not found. Install it: bxcachy install vscode" ] );
        var done = [];
        for ( var ext in [ variables.extension, variables.pack ] ) {
            var r = tryExec( [ "code", "--install-extension", ext, "--force" ], 300 );
            if ( r.exitCode == 0 ) done.append( ext );
        }
        if ( !done.len() ) return say( 6, { error: "could not install the extension" }, arguments.asJson, [ "error: could not install the BoxLang extension (is it on your editor's marketplace?)" ] );
        return say( 0, { installed: done }, arguments.asJson, [ "Installed: " & done.toList( ", " ) ] );
    }

    function showLinks( asJson ) {
        return say( 0, { links: links() }, arguments.asJson, links().map( function( l ) { return l.title & "  " & l.url & "  " & l.about; } ) );
    }

    function welcomeFile() { return new bxcachy.ConfigService().quiet( true ).cfgHome() & "/bxcachy/welcome.html"; }

    function welcomeHtml() {
        var rows = links().map( function( l ) { return '<li><a href="' & l.url & '">' & l.title & '</a> <span>' & l.about & '</span></li>'; } ).toList( chr( 10 ) );
        return '<!doctype html><meta charset="utf-8"><title>Welcome to BxCachy</title>' & chr( 10 )
            & '<style>body{font:16px system-ui;background:##0d1117;color:##e6edf3;max-width:46rem;margin:3rem auto;padding:0 1rem}h1{background:linear-gradient(90deg,##00dbff,##00ff78);-webkit-background-clip:text;color:transparent}a{color:##00dbff}li{margin:.5rem 0}span{color:##8b949e}code{background:##161b22;padding:.1rem .4rem;border-radius:4px}</style>' & chr( 10 )
            & '<h1>Welcome to BxCachy</h1><p>Your developer machine is set up. BoxLang and MatchBox are installed.</p>' & chr( 10 )
            & '<h2>Start here</h2><ol><li>Open <a href="https://try.boxlang.io">Try BoxLang</a> and run something.</li><li>In a terminal: <code>boxlang --version</code>, then <code>bxcachy boxlang modules list</code>.</li><li>Compile a script to a native binary with MatchBox: <code>matchbox script.bxs</code> (docs: <a href="https://matchbox.boxlang.io">matchbox.boxlang.io</a>).</li></ol>' & chr( 10 )
            & '<h2>The BoxLang ecosystem</h2><ul>' & rows & '</ul>' & chr( 10 );
    }

    function welcome( open, asJson ) {
        var f = welcomeFile();
        var dir = getDirectoryFromPath( f );
        if ( !directoryExists( dir ) ) directoryCreate( dir, true );
        fileWrite( f, welcomeHtml() );
        if ( arguments.open && has( "xdg-open" ) ) tryExec( [ "sh", "-c", 'setsid xdg-open "$1" >/dev/null 2>&1 &', "_", f ], 10 );
        return say( 0, { file: f }, arguments.asJson, [ "Welcome page: " & f ] );
    }
}
