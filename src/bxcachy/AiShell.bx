// `bxcachy ai shell [toggle|status] [--backend=hyprland|yakuake] [--dry-run]`: the pull-down AI shell. One shortcut shows and hides a
// terminal that runs your default coding agent (or a plain shell when none is set); it keeps its session while hidden.
//   hyprland  a terminal with its own window class (com.bxcachy.ai); the Hyprland module's window rule sends it to the special
//             workspace `ai`; later calls toggle that workspace. Size and place are set at launch, best effort.
//   yakuake   KDE's drop-down terminal (Plasma). The first call starts Yakuake, opens a tab that runs the agent; later calls
//             toggle its window. Methods used over D-Bus: toggleWindowState, addSession, runCommand.
// Exit: 0 done, 4 precondition (no backend, no terminal that can carry a window class, agent not installed), 6 a command failed.
// The Hyprland and Yakuake calls follow their documentation but have not run on a real desktop yet (acceptance checklist).
class AiShell {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        variables.ai = new bxcachy.Ai( arguments.cli, arguments.runner );
        variables.agents = new bxcachy.AiAgents();
        return this;
    }

    function windowClass() { return "com.bxcachy.ai"; }
    function workspaceName() { return "ai"; }

    function say( command, code, data, asJson, lines = [], dryRun = false ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data, arguments.dryRun ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function backend( forced = "" ) {
        if ( len( arguments.forced ) ) return arguments.forced;
        if ( len( getSystemSetting( "HYPRLAND_INSTANCE_SIGNATURE", "" ) ) ) return "hyprland";
        if ( findNoCase( "KDE", getSystemSetting( "XDG_CURRENT_DESKTOP", "" ) ) ) return "yakuake";
        return "";
    }

    function tryExec( argv, timeout = 20 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function detach( argv ) {
        var run = [ "sh", "-c", 'setsid "$@" >/dev/null 2>&1 &', "_" ];
        for ( var p in arguments.argv ) run.append( p );
        return tryExec( run, 10 );
    }

    // What the shell runs: the default agent through `secrets run`, else your login shell.
    function inner() {
        var id = variables.ai.defaultId();
        if ( len( id ) ) {
            var a = variables.agents.find( id );
            if ( !structIsEmpty( a ) && variables.ai.installed( a.command ) ) return { argv: variables.ai.agentCommand( a ), label: a.name };
        }
        return { argv: [ getSystemSetting( "SHELL", "sh" ) ], label: "your shell" };
    }

    // A terminal that can give its window a class: the one named first in xdg-terminals.list when it can, else the first installed that can.
    function terminal() {
        var tc = new bxcachy.TerminalConfig( true );
        var pref = variables.ai.terminal();
        var order = [];
        if ( !structIsEmpty( pref ) ) order.append( pref.id );
        for ( var id in tc.ids() ) if ( !arrayFind( order, id ) ) order.append( id );
        for ( var id in order ) {
            var t = tc.find( id );
            if ( len( tc.classArgs( id, windowClass() ) ) && variables.ai.installed( t.cmd ) ) return { id: id, cmd: t.cmd, classArgs: tc.classArgs( id, windowClass() ), execFlag: arrayFind( [ "ghostty", "alacritty" ], id ) ? [ "-e" ] : [] };
        }
        return {};
    }

    // ---- Hyprland ----
    function hasWindow() {
        var r = tryExec( [ "hyprctl", "clients", "-j" ], 10 );
        if ( r.exitCode != 0 ) return false;
        try { for ( var c in jsonDeserialize( r.output ) ) if ( ( c.class ?: "" ) == windowClass() ) return true; } catch ( any e ) {}
        return false;
    }

    function hyprlandToggle( dryRun ) {
        var steps = [];
        if ( !hasWindow() ) {
            var term = terminal();
            if ( structIsEmpty( term ) ) return { code: 4, error: "no terminal that can set a window class is installed (ghostty, kitty, alacritty, foot)" };
            var inn = inner();
            var argv = [ term.cmd ];
            for ( var p in term.classArgs ) argv.append( p );
            for ( var p in term.execFlag ) argv.append( p );
            for ( var p in inn.argv ) argv.append( p );
            steps.append( argv );
            if ( !arguments.dryRun ) detach( argv );
            // size and place it as a drop-down from the top once its window exists (best effort; Hyprland dispatchers)
            var sel = ",class:" & windowClass();
            steps.append( [ "hyprctl", "dispatch", "resizewindowpixel", "exact 100% 45%" & sel ] );
            steps.append( [ "hyprctl", "dispatch", "movewindowpixel", "exact 0 0" & sel ] );
            if ( !arguments.dryRun ) {
                for ( var i = 1; i <= 20; i++ ) { if ( hasWindow() ) break; tryExec( [ "sleep", "0.2" ], 5 ); }
                tryExec( steps[ 2 ], 10 ); tryExec( steps[ 3 ], 10 );
            }
            return { code: 0, action: "opened", label: inn.label, steps: steps };
        }
        var t1 = [ "hyprctl", "dispatch", "togglespecialworkspace", workspaceName() ];
        steps.append( t1 );
        if ( !arguments.dryRun ) {
            var r = tryExec( t1, 10 );
            // Hyprland's Lua mode may want the Lua form of the same dispatcher
            if ( r.exitCode != 0 ) r = tryExec( [ "hyprctl", "dispatch", 'hl.dsp.workspace.toggle_special("' & workspaceName() & '")' ], 10 );
            if ( r.exitCode != 0 ) return { code: 6, error: "hyprctl could not toggle the special workspace: " & trim( r.output ) };
        }
        return { code: 0, action: "toggled", label: "", steps: steps };
    }

    // ---- Yakuake ----
    function yakuakeRunning() {
        var r = tryExec( [ "dbus-send", "--session", "--print-reply", "--dest=org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus.NameHasOwner", "string:org.kde.yakuake" ], 10 );
        return r.exitCode == 0 && find( "boolean true", r.output ) > 0;
    }

    function yakuakeCall( path, method, args = [] ) {
        var argv = [ "dbus-send", "--session", "--type=method_call", "--dest=org.kde.yakuake", arguments.path, "org.kde.yakuake." & arguments.method ];
        for ( var a in arguments.args ) argv.append( a );
        return argv;
    }

    // The command line typed into the Yakuake tab: the argv, single-quoted word by word.
    function quoted( argv ) {
        var q = chr( 39 );
        return arguments.argv.map( function( w ) { return q & replace( w, q, q & chr( 92 ) & q & q, "all" ) & q; } ).toList( " " );
    }

    function stateFile() {
        var rt = getSystemSetting( "XDG_RUNTIME_DIR", "" );
        return len( rt ) ? rt & "/bxcachy-ai-shell" : "";
    }

    // Starts Yakuake when it is not running and waits for its D-Bus name. Returns { error, steps }.
    function yakuakeStart( dryRun ) {
        if ( !variables.ai.installed( "yakuake" ) ) return { error: "Yakuake is not installed. Install it: bxcachy install yakuake", code: 4, steps: [] };
        if ( arguments.dryRun ) return { error: "", code: 0, steps: [ [ "yakuake" ] ] };
        detach( [ "yakuake" ] );
        for ( var n = 1; n <= 25; n++ ) {
            if ( yakuakeRunning() ) return { error: "", code: 0, steps: [ [ "yakuake" ] ] };
            tryExec( [ "sleep", "0.2" ], 5 );
        }
        return { error: "Yakuake did not start", code: 6, steps: [ [ "yakuake" ] ] };
    }

    // Opens a tab that runs the agent (or your shell). Returns { error, steps, label }.
    function yakuakeOpenTab( dryRun ) {
        var plan = inner();
        var add = yakuakeCall( "/yakuake/sessions", "addSession" );
        var run = yakuakeCall( "/yakuake/sessions", "runCommand", [ "string:" & quoted( plan.argv ) ] );
        if ( !arguments.dryRun ) {
            var first = tryExec( add, 10 );
            if ( first.exitCode != 0 ) return { error: "Yakuake refused a new tab: " & trim( first.output ), steps: [], label: "" };
            var second = tryExec( run, 10 );
            if ( second.exitCode != 0 ) return { error: "Yakuake refused the command: " & trim( second.output ), steps: [], label: "" };
            var st = stateFile();
            if ( len( st ) ) fileWrite( st, "tab" & chr( 10 ) );
        }
        return { error: "", steps: [ add, run ], label: plan.label };
    }

    function yakuakeToggle( dryRun ) {
        var steps = [];
        var wasRunning = yakuakeRunning();
        var tabFile = stateFile();
        var haveTab = wasRunning && len( tabFile ) > 0 && fileExists( tabFile );
        if ( !wasRunning ) {
            var started = yakuakeStart( arguments.dryRun );
            if ( started.error != "" ) return { code: started.code, error: started.error };
            for ( var s1 in started.steps ) steps.append( s1 );
        }
        var shown = "";
        if ( !haveTab ) {
            var tab = yakuakeOpenTab( arguments.dryRun );
            if ( tab.error != "" ) return { code: 6, error: tab.error };
            for ( var s2 in tab.steps ) steps.append( s2 );
            shown = tab.label;
        }
        var toggle = yakuakeCall( "/yakuake/window", "toggleWindowState" );
        steps.append( toggle );
        if ( !arguments.dryRun ) {
            var done = tryExec( toggle, 10 );
            if ( done.exitCode != 0 ) return { code: 6, error: "Yakuake could not toggle: " & trim( done.output ) };
        }
        return { code: 0, action: haveTab ? "toggled" : "opened", label: shown, steps: steps };
    }

    // `ai shell [toggle|status]`
    function run( action, forced, dryRun, asJson ) {
        var cmd = "ai shell";
        var be = backend( arguments.forced );
        if ( !arrayFind( [ "hyprland", "yakuake" ], be ) ) return say( cmd, 4, { error: "No backend" }, arguments.asJson, [ "error: the pull-down AI shell needs a Hyprland session or KDE Plasma (Yakuake). Use --backend=hyprland or --backend=yakuake to choose." ] );
        if ( arguments.action == "status" ) {
            var present = be == "hyprland" ? hasWindow() : yakuakeRunning();
            return say( cmd, 0, { backend: be, running: present }, arguments.asJson, [ "Backend: " & be, "Window: " & ( present ? "open" : "not started" ) ] );
        }
        if ( arguments.action != "toggle" ) return say( cmd, 2, {}, arguments.asJson, [ "Usage: bxcachy ai shell [toggle|status] [--backend=hyprland|yakuake] [--dry-run] [--json]" ] );
        var r = be == "hyprland" ? hyprlandToggle( arguments.dryRun ) : yakuakeToggle( arguments.dryRun );
        if ( r.code != 0 ) return say( cmd, r.code, { error: r.error, backend: be }, arguments.asJson, [ "error: " & r.error ] );
        var data = { backend: be, action: r.action, runs: r.label, steps: r.steps };
        var msg = arguments.dryRun ? "Dry run: " & r.steps.map( function( s ) { return s.toList( " " ); } ).toList( " ; " ) : "AI shell " & r.action & ( len( r.label ) ? " (" & r.label & ")" : "" ) & ".";
        return say( cmd, 0, data, arguments.asJson, [ msg ], arguments.dryRun );
    }
}
