// Storage: NAS shares and cloud remotes with their mount state. Reads `nas list` and `cloud status`.
class StorageProvider {
    function init( demo = false ) { variables.demo = arguments.demo; variables.sys = new bxcachy.TuiSys(); return this; }
    function id() { return "storage"; }
    function icon() { return "hdd"; }
    function title() { return "Storage"; }
    function hint() { return "NAS and cloud"; }
    function live() { return false; }
    function emptyText() { return "No NAS or cloud yet. Add a NAS: bxcachy nas add NAME --host=HOST"; }
    function columns() { return [ { key: "mark", label: "", w: 3 }, { key: "name", label: "name", w: 22 }, { key: "kind", label: "kind", w: 10 }, { key: "state", label: "state", w: 14 }, { key: "where", label: "where", w: 0 } ]; }
    function style( r ) { return r.state == "mounted" ? "ok" : "dim"; }
    function detail( r ) { return [ r.name & " (" & r.kind & ") " & r.where, r.state == "mounted" ? "Mounted. Press u to unmount." : "Not mounted. Press m to mount." ]; }

    function actions() {
        return [
            { key: "m", label: "mount", run: function( r ) { return r.kind == "cloud" ? { action: "cli", title: "Mount " & r.name, args: [ "cloud", "mount", r.name ] } : { action: "cli", title: "Mount " & r.name, args: [ "nas", "mount", r.nas, r.share ] }; } },
            { key: "u", label: "unmount", run: function( r ) { return r.kind == "cloud" ? { action: "cli", title: "Unmount " & r.name, args: [ "cloud", "unmount", r.name ] } : { action: "cli", title: "Unmount " & r.name, args: [ "nas", "unmount", r.nas, r.share ] }; } },
            { key: "t", label: "test", run: function( r ) { return { action: "show", title: "Test " & r.name, args: r.kind == "cloud" ? [ "cloud", "status" ] : [ "nas", "test", r.nas, r.share ] }; } }
        ];
    }

    function load( q = "" ) {
        if ( variables.demo ) return [ { mark: "●", name: "syno/backups", kind: "smb", state: "mounted", where: "/mnt/nas/backups", nas: "syno", share: "backups" }, { mark: "●", name: "syno/media", kind: "nfs", state: "mounted", where: "/mnt/nas/media", nas: "syno", share: "media" }, { mark: "○", name: "syno/photos", kind: "smb", state: "not mounted", where: "/mnt/nas/photos", nas: "syno", share: "photos" }, { mark: "●", name: "gdrive", kind: "cloud", state: "mounted", where: "~/Cloud/gdrive", nas: "", share: "" } ];
        var rows = [];
        for ( var n in ( variables.sys.bx( [ "nas", "list" ] ).nas ?: [] ) ) {
            var shares = n.shares ?: {};
            for ( var sh in structKeyArray( shares ) ) rows.append( { mark: "○", name: n.name & "/" & sh, kind: n.protocol ?: "nas", state: ( shares[ sh ].mounted ?: false ) ? "mounted" : "not mounted", where: shares[ sh ].mountpoint ?: "", nas: n.name, share: sh } );
        }
        for ( var c in ( variables.sys.bx( [ "cloud", "status" ] ).mounts ?: [] ) ) rows.append( { mark: "●", name: c.name ?: "", kind: "cloud", state: ( c.mounted ?: false ) ? "mounted" : "not mounted", where: c.path ?: "", nas: "", share: "" } );
        for ( var r in rows ) r.mark = r.state == "mounted" ? "●" : "○";
        return rows;
    }
}
