// Java Manager: your Java homes (BxCachy installs, SDKMAN, the system) through `bxcachy java`. Install, set the default, remove.
class JavaProvider {
    function init( demo = false ) { variables.demo = arguments.demo; variables.sys = new bxcachy.TuiSys(); return this; }
    function id() { return "java"; }
    function title() { return "Java"; }
    function hint() { return "* default for new shells   > this shell"; }
    function live() { return false; }
    function emptyText() { return "No Java found. Press i to install one."; }
    function columns() { return [ { key: "mark", label: "", w: 4 }, { key: "version", label: "version", w: 14 }, { key: "vendor", label: "vendor", w: 24 }, { key: "source", label: "from", w: 10 }, { key: "path", label: "path", w: 0 } ]; }
    function style( r ) { return r.default ? "ok" : ""; }
    function detail( r ) { return [ r.id & "   " & r.path, ( r.default ? "The default for new shells. " : "" ) & ( r.active ? "This shell uses it." : "" ) & ( r.removable ? "" : " Managed by " & r.source & "." ) ]; }

    function actions() {
        return [
            { key: "d", label: "default", run: function( r ) { return { action: "cli", title: "Default Java: " & r.version, args: [ "java", "default", r.id ] }; } },
            { key: "i", label: "install", run: function( r ) { return { action: "ask", title: "Install Java", prompt: "Which major version? (21, 17, 25 ...)", make: function( v ) { return { action: "cli", title: "Install Java " & v, args: [ "java", "install", v ] }; } }; } },
            { key: "x", label: "remove", run: function( r ) { return { action: "cli", title: "Remove " & r.id, args: [ "java", "remove", r.id ] }; } }
        ];
    }

    function load( q = "" ) {
        var homes = variables.demo ? demoHomes() : ( variables.sys.bx( [ "java", "list" ] ).homes ?: [] );
        var rows = [];
        for ( var h in homes ) { h.mark = ( h.default ? "*" : " " ) & ( h.active ? ">" : " " ); rows.append( h ); }
        return rows;
    }

    function demoHomes() {
        var h = function( id, v, vendor, source, path, def, act ) { return { id: id, major: int( val( listFirst( v, "." ) ) ), version: v, vendor: vendor, source: source, path: path, default: def, active: act, removable: source == "bxcachy" }; };
        return [ h( "temurin-21.0.13_9", "21.0.13", "Eclipse Adoptium", "bxcachy", "~/.local/share/bxcachy/java/temurin-21.0.13_9", true, true ), h( "sdkman-17.0.13-tem", "17.0.13", "Eclipse Adoptium", "sdkman", "~/.sdkman/candidates/java/17.0.13-tem", false, false ), h( "system-java-11-openjdk", "11.0.25", "Arch Linux", "system", "/usr/lib/jvm/java-11-openjdk", false, false ) ];
    }
}
