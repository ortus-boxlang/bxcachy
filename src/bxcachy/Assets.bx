// The brand images (logo, icon, wallpapers) embedded in the binary (AssetData) and written to the user's disk.
// MatchBox's fileWrite writes text (a binary value is turned into a string), so each image is written as base64 text and decoded with coreutils `base64 -d` into the target file.
//
// Exit codes: list 0; install 0 done, 2 without --yes, 4 precondition (root, no base64).
class Assets {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        variables.data = new bxcachy.AssetData();
        return this;
    }

    // Where each image goes: wallpapers in ~/Pictures/BxCachy, logo and icon in ~/.local/share/bxcachy.
    function target( name ) {
        var home = getSystemSetting( "HOME", "" );
        if ( left( name, 11 ) == "wallpapers/" ) return home & "/Pictures/BxCachy/" & mid( name, 12, len( name ) );
        return home & "/.local/share/bxcachy/" & name;
    }

    // Writes one embedded image to a path (via a .b64 text file and `base64 -d`).
    function decode( name, dest ) {
        directoryCreate( getDirectoryFromPath( dest ), true, true );
        fileWrite( dest & ".b64", variables.data.base64( name ) );
        var r = variables.inst.exec( [ "sh", "-c", 'base64 -d "$1" > "$2"', "sh", dest & ".b64", dest ], 60 );
        fileDelete( dest & ".b64" );
        if ( r.exitCode != 0 ) throw( type = "Assets.decode", message = "base64 -d failed for " & name );
    }

    // `assets list`
    function list( asJson ) {
        var rows = variables.data.names().map( function( n ) { return { name: n, target: target( n ), present: fileExists( target( n ) ) }; } );
        if ( asJson ) { println( variables.cli.envelope( "assets list", 0, { assets: rows } ) ); return 0; }
        for ( var r in rows ) println( r.name & " -> " & r.target & ( r.present ? " (present)" : "" ) );
        return 0;
    }

    // `assets install [--yes] [--dry-run]`: writes the images that are missing; never overwrites a file the user changed.
    function install( yes, dryRun, asJson ) {
        if ( variables.inst.isRoot() || !variables.inst.hasCommand( "base64" ) ) {
            var msg = variables.inst.isRoot() ? "Run as a regular user" : "base64 (coreutils) was not found";
            if ( asJson ) println( variables.cli.envelope( "assets install", 4, { errors: [ msg ] } ) ); else println( "error: " & msg );
            return 4;
        }
        var plan = variables.data.names().filter( function( n ) { return !fileExists( target( n ) ); } );
        var kept = variables.data.names().filter( function( n ) { return fileExists( target( n ) ); } );
        if ( !yes || dryRun ) {
            var code = dryRun ? 0 : 2;
            if ( asJson ) { println( variables.cli.envelope( "assets install", code, { write: plan, present: kept }, dryRun ) ); return code; }
            for ( var n in plan ) println( "write " & target( n ) );
            for ( var k in kept ) println( "keep  " & target( k ) & " (already there)" );
            println( dryRun ? "Dry run, nothing changed." : "Nothing changed. Pass --yes to proceed." );
            return code;
        }
        for ( var n in plan ) decode( n, target( n ) );
        if ( asJson ) println( variables.cli.envelope( "assets install", 0, { written: plan, present: kept } ) );
        else println( "Wrote " & plan.len() & " images, kept " & kept.len() & "." );
        return 0;
    }
}
