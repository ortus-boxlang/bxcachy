// `bxcachy pkg`: any package from the pacman repos or the AUR, and `bxcachy remove`: uninstall anything BxCachy installed.
//   pkg search TEXT [--source=all|repo|aur] [--limit=40]   repos (pacman -Ss) and the AUR (the RPC), installed ones marked
//   pkg info NAME                                           where it comes from, version, description
//   pkg install NAME... [--aur] [--yes] [--dry-run]         repo packages with pacman, AUR packages with yay; a plan until --yes
//   pkg remove NAME... [--yes] [--dry-run]                  pacman -Rns (the package, its unused dependencies and its system config files)
//   pkg installed [--explicit]                              what is installed (explicit = what you asked for, not dependencies)
//   remove ID_OR_PACKAGE... [--yes] [--dry-run]             catalog app ids (packages, AUR, PKGBUILD builds and web app launchers) or package names
// AUR packages are user-submitted build scripts: the plan says so and `yay -G NAME` shows one before you install it. A few core packages are
// never removed. Nothing in your home folder is deleted: apps keep their settings in ~/.config unless you delete them yourself.
// Exit: 0 done, 2 plan without --yes or bad usage, 4 precondition (unknown package, nothing installed, root with AUR, no yay, protected),
// 5 or 6 a command failed, 7 some done and some failed.
class Pkg {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        return this;
    }

    function say( command, code, data, asJson, lines = [], dryRun = false ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data, arguments.dryRun ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function fail( command, code, msg, asJson ) {
        return say( arguments.command, arguments.code, { error: arguments.msg }, arguments.asJson, [ "error: " & arguments.msg ] );
    }

    function tryExec( argv, timeout = 60 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message, timeout: false }; }
    }

    function aurBase() { return getSystemSetting( "BXCACHY_AUR_URL", "https://aur.archlinux.org/rpc/v5" ); }

    // Letters, digits and . _ + - and spaces: safe to put in a URL path and a pacman pattern.
    function validText( t ) { return reFind( "^[A-Za-z0-9._+ -]{1,60}$", arguments.t ) > 0; }
    function validName( n ) { return reFind( "^[a-z0-9@._+-]{1,100}$", arguments.n ) > 0; }

    // Names pacman has installed, as a set.
    function installedSet() {
        var s = {};
        var r = tryExec( [ "pacman", "-Qq" ], 30 );
        if ( r.exitCode == 0 ) for ( var n in listToArray( r.output, chr( 10 ) ) ) if ( len( trim( n ) ) ) s[ trim( n ) ] = true;
        return s;
    }

    // Packages that are never removed here (the system would not boot, or BxCachy would lose its own tools).
    function protectedName( n ) {
        var exact = [ "base", "pacman", "sudo", "systemd", "glibc", "bash", "coreutils", "filesystem", "linux-firmware", "grub", "systemd-sysvcompat", "util-linux", "shadow", "cachyos-keyring", "archlinux-keyring" ];
        if ( arrayFind( exact, arguments.n ) ) return true;
        return reFind( "^linux(-cachyos|-lts|-zen|-hardened)?(-nvidia.*|-headers)?$", arguments.n ) > 0 || reFind( "^cachyos-(settings|hooks|keyring|mirrorlist|v[34]-mirrorlist|rate-mirrors)$", arguments.n ) > 0;
    }

    // ---- search ----
    // pacman -Ss output: "repo/name version [group] [installed]" then an indented description line.
    function searchRepo( text, installed ) {
        var out = [];
        var r = tryExec( [ "pacman", "-Ss", "--color", "never", arguments.text ], 30 );
        if ( r.exitCode != 0 && !len( trim( r.output ) ) ) return out;
        var cur = {};
        for ( var raw in listToArray( r.output, chr( 10 ), true ) ) {
            if ( !len( trim( raw ) ) ) continue;
            if ( left( raw, 1 ) == " " || left( raw, 1 ) == chr( 9 ) ) { if ( structKeyExists( cur, "name" ) ) cur.description = trim( raw ); continue; }
            var m = reFind( "^([a-z0-9._+-]+)/([^ ]+) ([^ ]+)(.*)$", raw, 1, true );
            if ( !m.pos[ 1 ] ) continue;
            if ( structKeyExists( cur, "name" ) ) out.append( cur );
            var nm = mid( raw, m.pos[ 3 ], m.len[ 3 ] );
            cur = { name: nm, version: mid( raw, m.pos[ 4 ], m.len[ 4 ] ), source: "repo", repo: mid( raw, m.pos[ 2 ], m.len[ 2 ] ), description: "", installed: structKeyExists( arguments.installed, nm ), votes: 0, popularity: 0, outdated: false };
        }
        if ( structKeyExists( cur, "name" ) ) out.append( cur );
        return out;
    }

    function aurGet( path ) {
        var r = tryExec( [ "curl", "-fsS", "-m", "20", aurBase() & path ], 30 );
        if ( r.exitCode != 0 ) return { ok: false, error: "the AUR did not answer (" & left( trim( r.output ), 80 ) & ")", results: [] };
        // The RPC's keys are capitalized (Name, Version, ...). MatchBox keeps one spelling per key name, so they are lower cased in the text
        // first; otherwise they leak into our own lower case keys when the rows are serialized.
        var txt = r.output;
        for ( var k in [ "Name", "Version", "Description", "Popularity", "NumVotes", "OutOfDate", "Maintainer", "URL" ] ) txt = replace( txt, '"' & k & '":', '"' & lCase( k ) & '":', "all" );
        try {
            var j = jsonDeserialize( txt );
            if ( ( j.type ?: "" ) == "error" ) return { ok: false, error: j.error ?: "AUR error", results: [] };
            return { ok: true, error: "", results: j.results ?: [] };
        } catch ( any e ) { return { ok: false, error: "the AUR answer could not be read", results: [] }; }
    }

    function aurRow( x, installed ) {
        return { name: x.name, version: x.version, source: "aur", repo: "aur", description: x.description ?: "", installed: structKeyExists( arguments.installed, x.name ), votes: x.numvotes ?: 0, popularity: x.popularity ?: 0, outdated: structKeyExists( x, "outofdate" ) && !isNull( x.outofdate ) && x.outofdate != "" && x.outofdate != 0 };
    }

    function searchAur( text, installed ) {
        var g = aurGet( "/search/" & replace( arguments.text, " ", "%20", "all" ) & "?by=name-desc" );
        var rows = [];
        for ( var x in g.results ) rows.append( aurRow( x, arguments.installed ) );
        return { ok: g.ok, error: g.error, rows: rows };
    }

    // Exact name first, then repo packages, then AUR by popularity.
    function rank( rows, text ) {
        var t = lCase( trim( arguments.text ) );
        var scored = arguments.rows.map( function( r ) {
            var s = lCase( r.name ) == t ? 0 : ( left( lCase( r.name ), len( t ) ) == t ? 1 : 2 );
            return { s: s * 10 + ( r.source == "repo" ? 0 : 5 ), p: r.popularity + 0, row: r };
        } );
        arraySort( scored, function( a, b ) { return a.s != b.s ? ( a.s < b.s ? -1 : 1 ) : ( a.p > b.p ? -1 : ( a.p < b.p ? 1 : 0 ) ); } );
        return scored.map( function( x ) { return x.row; } );
    }

    function search( text, source, limit, asJson ) {
        var cmd = "pkg search";
        if ( !len( trim( arguments.text ) ) || !validText( arguments.text ) ) return fail( cmd, 2, "Usage: bxcachy pkg search TEXT [--source=all|repo|aur] [--limit=N] (letters, digits and . _ + - only)", arguments.asJson );
        if ( !arrayFind( [ "all", "repo", "aur" ], arguments.source ) ) return fail( cmd, 2, "--source must be all, repo or aur", arguments.asJson );
        var inst = installedSet();
        var rows = [];
        var notes = [];
        if ( arguments.source != "aur" ) for ( var r in searchRepo( arguments.text, inst ) ) rows.append( r );
        if ( arguments.source != "repo" ) {
            var a = searchAur( arguments.text, inst );
            if ( !a.ok ) notes.append( a.error ); else for ( var ar in a.rows ) rows.append( ar );
        }
        rows = rank( rows, arguments.text );
        var total = rows.len();
        var lim = max( 1, arguments.limit );
        if ( rows.len() > lim ) rows = rows.slice( 1, lim );
        var lines = rows.map( function( r ) { return ( r.installed ? "* " : "  " ) & r.repo & "/" & r.name & " " & r.version & ( r.outdated ? " (out of date)" : "" ) & ( r.source == "aur" ? "  [" & r.votes & " votes]" : "" ) & ( len( r.description ) ? "  " & left( r.description, 80 ) : "" ); } );
        if ( !rows.len() ) lines.append( "No packages match " & arguments.text );
        else lines.append( total & " found" & ( total > rows.len() ? ", showing " & rows.len() : "" ) & ". * = installed. Install: bxcachy pkg install NAME" );
        for ( var n in notes ) lines.append( "note: " & n );
        return say( cmd, 0, { query: arguments.text, total: total, results: rows, notes: notes }, arguments.asJson, lines );
    }

    // Where a name can be had: "repo" when pacman knows it, "aur" when the AUR does, "" otherwise.
    function origin( name ) {
        if ( tryExec( [ "pacman", "-Si", arguments.name ], 20 ).exitCode == 0 ) return "repo";
        var g = aurGet( "/info?arg[]=" & arguments.name );
        return g.ok && g.results.len() ? "aur" : "";
    }

    function info( name, asJson ) {
        var cmd = "pkg info";
        if ( !validName( arguments.name ) ) return fail( cmd, 2, "Usage: bxcachy pkg info NAME", arguments.asJson );
        var inst = installedSet();
        var o = origin( arguments.name );
        if ( !len( o ) ) return fail( cmd, 4, arguments.name & " was not found in the repos or the AUR", arguments.asJson );
        var d = { name: arguments.name, source: o, installed: structKeyExists( inst, arguments.name ), details: "" };
        if ( o == "repo" ) d.details = trim( tryExec( [ "pacman", "-Si", arguments.name ], 20 ).output );
        else { var g = aurGet( "/info?arg[]=" & arguments.name ); var x = g.results[ 1 ]; d.details = "AUR " & x.name & " " & x.version & chr( 10 ) & ( x.description ?: "" ) & chr( 10 ) & "Maintainer: " & ( x.maintainer ?: "orphaned" ) & "  Votes: " & ( x.numvotes ?: 0 ) & "  URL: " & ( x.url ?: "" ); d.maintainer = x.maintainer ?: ""; }
        return say( cmd, 0, d, arguments.asJson, [ d.details, d.installed ? "(installed)" : "(not installed)" ] );
    }

    function installed( explicit, asJson ) {
        var cmd = "pkg installed";
        var r = tryExec( [ "pacman", arguments.explicit ? "-Qe" : "-Q" ], 30 );
        var rows = [];
        for ( var l in listToArray( r.output, chr( 10 ) ) ) { var parts = listToArray( trim( l ), " " ); if ( parts.len() >= 2 ) rows.append( { name: parts[ 1 ], version: parts[ 2 ] } ); }
        return say( cmd, r.exitCode == 0 ? 0 : 4, { packages: rows, explicit: arguments.explicit }, arguments.asJson, rows.map( function( p ) { return p.name & " " & p.version; } ) );
    }

    // ---- install ----
    function install( names, forceAur, yes, dryRun, asJson ) {
        var cmd = "pkg install";
        if ( !arguments.names.len() ) return fail( cmd, 2, "Usage: bxcachy pkg install NAME... [--aur] [--yes] [--dry-run]", arguments.asJson );
        for ( var n in arguments.names ) if ( !validName( n ) ) return fail( cmd, 2, "Bad package name: " & n, arguments.asJson );
        var inst = installedSet();
        var apps = [];
        var skipped = [];
        var unknown = [];
        for ( var nm in arguments.names ) {
            if ( structKeyExists( inst, nm ) ) { skipped.append( { name: nm, reason: "already installed" } ); continue; }
            var o = arguments.forceAur ? "aur" : origin( nm );
            if ( arguments.forceAur && origin( nm ) == "" ) o = "";
            if ( !len( o ) ) { unknown.append( nm ); continue; }
            apps.append( { id: nm, source: o == "repo" ? "pacman" : "aur", targets: [ nm ] } );
        }
        if ( unknown.len() ) return say( cmd, 4, { error: "not found: " & unknown.toList( ", " ), unknown: unknown }, arguments.asJson, [ "error: not found in the repos or the AUR: " & unknown.toList( ", " ) & " (bxcachy pkg search TEXT)" ] );
        var built = variables.inst.steps( apps, variables.inst.isRoot() );
        var hasAur = apps.filter( function( a ) { return a.source == "aur"; } ).len() > 0;
        var data = { packages: apps.map( function( a ) { return { name: a.id, source: a.source == "pacman" ? "repo" : "aur" }; } ), skipped: skipped, steps: built.steps };
        if ( !apps.len() ) return say( cmd, 0, data, arguments.asJson, [ "Nothing to do: " & skipped.map( function( s ) { return s.name; } ).toList( ", " ) & " already installed." ] );
        if ( !arguments.yes || arguments.dryRun ) {
            var lines = [ ( arguments.dryRun ? "Dry run" : "Plan" ) & ": install " & apps.map( function( a ) { return a.id & " (" & ( a.source == "pacman" ? "repo" : "AUR" ) & ")"; } ).toList( ", " ) ];
            for ( var st in built.steps ) for ( var c in st.commands ) lines.append( "  " & st.kind & ": " & c.toList( " " ) );
            if ( hasAur ) lines.append( "AUR packages are built from user-submitted scripts. Read one first with: yay -G NAME" );
            lines.append( arguments.dryRun ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." );
            return say( cmd, arguments.dryRun ? 0 : 2, data, arguments.asJson, lines, arguments.dryRun );
        }
        if ( hasAur && variables.inst.isRoot() ) return fail( cmd, 4, "AUR packages are never built as root", arguments.asJson );
        if ( hasAur && !variables.inst.hasCommand( "yay" ) ) return fail( cmd, 4, "yay is not installed (the BxCachy installer adds it); AUR packages need it", arguments.asJson );
        var res = variables.inst.run( built.steps );
        var code = variables.inst.exitCode( res );
        var out = res.done.map( function( d ) { return "Installed: " & d.id; } );
        for ( var f in res.failed ) out.append( "Failed: " & f.id & ": " & f.error );
        data.done = res.done; data.failed = res.failed;
        return say( cmd, code, data, arguments.asJson, out );
    }

    // ---- remove ----
    // A plan for removing package names: only installed ones, never protected ones.
    function removeNames( names, yes, dryRun, asJson, cmd = "pkg remove", extra = {} ) {
        var inst = installedSet();
        var todo = [];
        var skipped = [];
        var blocked = [];
        for ( var n in arguments.names ) {
            if ( !validName( n ) ) { blocked.append( { name: n, reason: "bad package name" } ); continue; }
            if ( protectedName( n ) ) { blocked.append( { name: n, reason: "protected: the system needs it" } ); continue; }
            if ( !structKeyExists( inst, n ) ) { skipped.append( { name: n, reason: "not installed" } ); continue; }
            if ( !arrayFind( todo, n ) ) todo.append( n );
        }
        var pac = variables.inst.isRoot() ? [ "pacman" ] : [ "sudo", "pacman" ];
        var data = merge( { remove: todo, skipped: skipped, blocked: blocked, command: todo.len() ? pac.toList( " " ) & " -Rns --noconfirm " & todo.toList( " " ) : "" }, arguments.extra );
        if ( !todo.len() ) {
            var why = blocked.map( function( b ) { return b.name & ": " & b.reason; } ).toList( "; " );
            var sk = skipped.map( function( s ) { return s.name & ": " & s.reason; } ).toList( "; " );
            return say( arguments.cmd, blocked.len() ? 4 : 0, data, arguments.asJson, [ blocked.len() ? "error: nothing removed (" & why & ")" : "Nothing to do (" & sk & ")." ] );
        }
        if ( !arguments.yes || arguments.dryRun ) {
            var lines = [ ( arguments.dryRun ? "Dry run" : "Plan" ) & ": remove " & todo.toList( ", " ) & " with their unused dependencies and system config files (pacman -Rns). Your files in ~/.config and ~/.local are not touched." ];
            for ( var b in blocked ) lines.append( "  skipped " & b.name & ": " & b.reason );
            for ( var s in skipped ) lines.append( "  skipped " & s.name & ": " & s.reason );
            lines.append( arguments.dryRun ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." );
            return say( arguments.cmd, arguments.dryRun ? 0 : 2, data, arguments.asJson, lines, arguments.dryRun );
        }
        var done = [];
        var failed = [];
        for ( var t in todo ) {
            var argv = duplicate( pac );
            for ( var a in [ "-Rns", "--noconfirm", t ] ) argv.append( a );
            var r = tryExec( argv, 600 );
            if ( r.exitCode == 0 ) done.append( t ); else failed.append( { name: t, error: trim( r.output ) } );
        }
        data.done = done; data.failed = failed;
        var lines2 = done.map( function( d ) { return "Removed: " & d; } );
        for ( var f in failed ) lines2.append( "Failed: " & f.name & ": " & left( f.error, 160 ) );
        return say( arguments.cmd, !failed.len() ? 0 : ( done.len() ? 7 : 5 ), data, arguments.asJson, lines2 );
    }

    function merge( a, b ) {
        var o = {};
        for ( var k in arguments.a ) o[ k ] = arguments.a[ k ];
        for ( var k2 in arguments.b ) o[ k2 ] = arguments.b[ k2 ];
        return o;
    }

    function remove( names, yes, dryRun, asJson ) {
        if ( !arguments.names.len() ) return fail( "pkg remove", 2, "Usage: bxcachy pkg remove NAME... [--yes] [--dry-run]", arguments.asJson );
        return removeNames( arguments.names, arguments.yes, arguments.dryRun, arguments.asJson );
    }

    // `remove ID_OR_PACKAGE...`: a catalog app id removes what installing it put there (its packages, or the web launcher);
    // anything else is taken as a package name.
    function removeApps( ids, yes, dryRun, asJson ) {
        var cmd = "remove";
        if ( !arguments.ids.len() ) return fail( cmd, 2, "Usage: bxcachy remove ID_OR_PACKAGE... [--yes] [--dry-run]", arguments.asJson );
        var cat = new bxcachy.Catalog();
        var data = cat.load();
        var pk = new bxcachy.Packages( variables.cli, data );
        var pkgs = [];
        var launchers = [];
        var manual = [];
        var apps = [];
        for ( var id in arguments.ids ) {
            var app = cat.find( data, id );
            if ( structIsEmpty( app ) ) { pkgs.append( id ); continue; }
            apps.append( id );
            if ( app.source == "web" ) launchers.append( { id: id, path: pk.launcherPath( id ) } );
            else if ( ( app.source == "pacman" || app.source == "aur" || app.source == "pkgbuild" ) && structKeyExists( app, "targets" ) ) for ( var t in app.targets ) pkgs.append( t );
            else manual.append( { id: id, source: app.source, note: "was installed by its vendor script; use its own uninstaller" } );
        }
        var gone = launchers.filter( function( l ) { return fileExists( l.path ); } );
        var extra = { apps: apps, launchers: gone, manual: manual };
        if ( !pkgs.len() && !gone.len() ) {
            if ( manual.len() ) return say( cmd, 4, extra, arguments.asJson, manual.map( function( m ) { return "error: " & m.id & " " & m.note; } ) );
            return say( cmd, 0, extra, arguments.asJson, [ "Nothing to do: nothing of that is installed." ] );
        }
        if ( !pkgs.len() ) {
            if ( !arguments.yes || arguments.dryRun ) return say( cmd, arguments.dryRun ? 0 : 2, extra, arguments.asJson, [ ( arguments.dryRun ? "Dry run" : "Plan" ) & ": remove the web app launchers " & gone.map( function( g ) { return g.id; } ).toList( ", " ), arguments.dryRun ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." ], arguments.dryRun );
            for ( var g in gone ) fileDelete( g.path );
            return say( cmd, 0, extra, arguments.asJson, gone.map( function( g ) { return "Removed web app: " & g.id; } ) );
        }
        if ( arguments.yes && !arguments.dryRun ) for ( var g2 in gone ) fileDelete( g2.path );
        return removeNames( pkgs, arguments.yes, arguments.dryRun, arguments.asJson, cmd, extra );
    }
}
