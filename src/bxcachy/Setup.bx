// `bxcachy setup`: gathers the facts, asks SetupPlan for the steps, prints the plan and runs it.
// Rules as for `install` (COMMAND-CONTRACT section 2): no --yes prints the plan and exits 2, --dry-run exits 0, a failed
// precondition exits 4 before anything changes, a failing step stops the steps after it. Exit 5 pacman step failed,
// 6 another step failed, 7 something was done before the failure. The runner is injectable for tests.
class Setup {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        return this;
    }

    // The version of the installed kwin package ("6.6.2"), or "" when it is not installed.
    function kwinVersion() {
        try {
            var r = variables.inst.exec( [ "pacman", "-Q", "kwin" ], 15 );
            if ( r.exitCode != 0 ) return "";
            var parts = listToArray( trim( r.output ), " " );
            return parts.len() >= 2 ? listFirst( parts[2], "-" ) : "";
        } catch ( any e ) {
            return "";
        }
    }

    // True when HyprKwin looks installed for this user (its data folder or a hyprkwin script package).
    function hyprkwinInstalled() {
        var home = getSystemSetting( "HOME", "" );
        if ( directoryExists( home & "/.local/share/hyprkwin" ) ) return true;
        var scripts = home & "/.local/share/kwin/scripts";
        if ( !directoryExists( scripts ) ) return false;
        for ( var d in directoryList( scripts, false, "name" ) ) if ( left( lCase( d ), 8 ) == "hyprkwin" ) return true;
        return false;
    }

    // The OS id from os-release (BXCACHY_OS_RELEASE overrides the file for tests): "cachyos", "arch" or whatever the file says.
    function osId() {
        var file = getSystemSetting( "BXCACHY_OS_RELEASE", "/etc/os-release" );
        if ( !fileExists( file ) ) return "";
        for ( var line in listToArray( fileRead( file ), chr( 10 ) ) ) {
            if ( left( line, 3 ) == "ID=" ) return lCase( replace( replace( mid( line, 4, len( line ) ), '"', "", "all" ), "'", "", "all" ) );
        }
        return "";
    }

    // Where `setup hyprland` remembers which packages it installed (so undo removes only those).
    function hyprlandStateFile() {
        return new bxcachy.ConfigService().stateDir() & "/setup-hyprland.json";
    }

    // The packages a previous `setup hyprland` installed ([] when none).
    function hyprlandAdded() {
        var file = hyprlandStateFile();
        if ( !fileExists( file ) ) return [];
        try {
            var data = jsonDeserialize( fileRead( file ) );
            return data.packages;
        } catch ( any e ) {
            return [];
        }
    }

    // Everything SetupPlan needs to know about this machine.
    function facts() {
        return {
            os: osId(),
            arch: trim( variables.inst.exec( [ "uname", "-m" ], 10 ).output ),
            hasPacman: variables.inst.hasCommand( "pacman" ),
            hyprlandAdded: hyprlandAdded(),
            isRoot: variables.inst.isRoot(),
            hasSudo: variables.inst.hasCommand( "sudo" ),
            kwinVersion: kwinVersion(),
            desktop: getSystemSetting( "XDG_CURRENT_DESKTOP", "" ),
            sessionType: getSystemSetting( "XDG_SESSION_TYPE", "" ),
            installed: new bxcachy.Packages( variables.cli, {} ).installedNames(),
            hyprkwinInstalled: hyprkwinInstalled(),
            user: getSystemSetting( "USER", "" ),
            loginShell: getSystemSetting( "SHELL", "" ),
            hasYay: variables.inst.hasCommand( "yay" ),
            groups: listToArray( trim( variables.inst.exec( [ "id", "-nG" ], 10 ).output ), " " ),
            udevRule: fileExists( new bxcachy.SetupPlan().udevRulePath() ),
            workDir: reReplace( getTempDirectory(), "/+$", "" ) & "/bxcachy-hyprkwin-" & left( createUUID(), 8 )
        };
    }

    // `setup terminal [--default=ghostty] [--also=kitty,foot]`
    function terminal( opts, yes, dryRun, asJson ) {
        var f = facts();
        var plan = new bxcachy.SetupPlan().terminal( f, opts );
        return execute( "setup terminal", plan, f, yes, dryRun, asJson );
    }

    // `setup shell [--shell=zsh|fish|bash]`
    function shell( opts, yes, dryRun, asJson ) {
        var f = facts();
        return execute( "setup shell", new bxcachy.SetupPlan().shell( f, opts ), f, yes, dryRun, asJson );
    }

    // `setup plasma [--keys | --undo-keys]`
    function plasma( opts, yes, dryRun, asJson ) {
        var f = facts();
        return execute( "setup plasma", new bxcachy.SetupPlan().plasma( f, opts ), f, yes, dryRun, asJson );
    }

    // `setup undo plasma`
    function undoPlasma( yes, dryRun, asJson ) {
        var f = facts();
        return execute( "setup undo plasma", new bxcachy.SetupPlan().undoPlasma( f ), f, yes, dryRun, asJson );
    }

    // `setup hyprland`: the missing packages, then the list of what was installed is remembered for undo.
    function hyprland( opts, yes, dryRun, asJson ) {
        var f = facts();
        var plan = new bxcachy.SetupPlan().hyprland( f, opts );
        var exit = execute( "setup hyprland", plan, f, yes, dryRun, asJson );
        if ( exit == 0 && yes && !dryRun && plan.added.len() ) {
            var merged = hyprlandAdded();
            for ( var p in plan.added ) if ( !arrayFind( merged, p ) ) merged.append( p );
            new bxcachy.ConfigService().writeAtomic( hyprlandStateFile(), jsonSerialize( { packages: merged, time: now() & "" } ), "600" );
        }
        return exit;
    }

    // `setup undo hyprland`: removes only the packages setup installed, then forgets them.
    function undoHyprland( yes, dryRun, asJson ) {
        var f = facts();
        var exit = execute( "setup undo hyprland", new bxcachy.SetupPlan().undoHyprland( f ), f, yes, dryRun, asJson );
        if ( exit == 0 && yes && !dryRun && fileExists( hyprlandStateFile() ) ) fileDelete( hyprlandStateFile() );
        return exit;
    }

    // Where `setup xremap` remembers what it added (package, udev rule, group) so undo removes only that.
    function xremapStateFile() {
        return new bxcachy.ConfigService().stateDir() & "/setup-xremap.json";
    }

    // `setup xremap [--build=hypr|kde]`
    function xremap( opts, yes, dryRun, asJson ) {
        var f = facts();
        var plan = new bxcachy.SetupPlan().xremap( f, opts );
        var exit = execute( "setup xremap", plan, f, yes, dryRun, asJson );
        if ( exit == 0 && yes && !dryRun && plan.steps.len() ) {
            var old = fileExists( xremapStateFile() ) ? jsonDeserialize( fileRead( xremapStateFile() ) ) : { package: "", group: false, udev: false };
            if ( len( plan.added.package ) ) old.package = plan.added.package;
            if ( plan.added.group ) old.group = true;
            if ( plan.added.udev ) old.udev = true;
            new bxcachy.ConfigService().writeAtomic( xremapStateFile(), jsonSerialize( old ), "600" );
        }
        return exit;
    }

    // `setup undo xremap`
    function undoXremap( yes, dryRun, asJson ) {
        var f = facts();
        var state = fileExists( xremapStateFile() ) ? jsonDeserialize( fileRead( xremapStateFile() ) ) : {};
        var exit = execute( "setup undo xremap", new bxcachy.SetupPlan().undoXremap( f, state ), f, yes, dryRun, asJson );
        if ( exit == 0 && yes && !dryRun && fileExists( xremapStateFile() ) ) fileDelete( xremapStateFile() );
        return exit;
    }

    // `setup status`
    function status( asJson ) {
        var have = new bxcachy.Packages( variables.cli, {} ).installedNames();
        var wanted = new bxcachy.SetupPlan().hyprlandPackages();
        var present = wanted.filter( function( p ) { return structKeyExists( have, p ); } );
        var data = { plasma: { kwin: kwinVersion(), hyprkwin: hyprkwinInstalled() }, hyprland: { installed: present.len(), wanted: wanted.len(), complete: present.len() == wanted.len() } };
        if ( asJson ) println( variables.cli.envelope( "setup status", 0, data ) );
        else {
            println( "plasma: kwin " & ( len( data.plasma.kwin ) ? data.plasma.kwin : "not installed" ) );
            println( "plasma: HyprKwin " & ( data.plasma.hyprkwin ? "installed" : "not installed" ) );
            println( "hyprland: " & data.hyprland.installed & " of " & data.hyprland.wanted & " packages installed" );
        }
        return 0;
    }

    // Prints the plan (or the errors) and, with --yes, runs the steps. Returns the exit code.
    function execute( command, plan, facts, yes, dryRun, asJson ) {
        var data = { target: plan.target, errors: plan.errors, warnings: plan.warnings, notes: plan.notes, steps: plan.steps, done: [], failed: [], skipped: [] };
        if ( plan.errors.len() ) {
            if ( asJson ) println( variables.cli.envelope( command, 4, data ) );
            else for ( var e in plan.errors ) println( "error: " & e );
            return 4;
        }
        if ( !yes || dryRun ) {
            var code = dryRun ? 0 : 2;
            if ( asJson ) { println( variables.cli.envelope( command, code, data, dryRun ) ); return code; }
            println( ( dryRun ? "Dry run" : "Plan" ) & ": " & command & ", " & plan.steps.len() & " steps" );
            for ( var w in plan.warnings ) println( "  warning: " & w );
            for ( var s in plan.steps ) {
                println( "  " & s.id & ": " & s.title );
                for ( var c in s.commands ) println( "    " & c.toList( " " ) );
            }
            for ( var n in plan.notes ) println( "  note: " & n );
            println( dryRun ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." );
            return code;
        }
        var stopped = false; var firstKind = "";
        for ( var step in plan.steps ) {
            if ( stopped ) { data.skipped.append( { id: step.id, reason: "an earlier step failed" } ); continue; }
            var problem = "";
            if ( step.kind == "keys" && new bxcachy.KeysService( variables.cli, variables.inst.runner(), asJson ).apply( true, false, false, false ) != 0 ) problem = "failed";
            if ( step.kind == "assets" ) {
                try { new bxcachy.Assets( variables.cli, variables.inst.runner() ).writeMissing(); } catch ( any e ) { problem = "failed: " & e.message; }
            }
            if ( step.kind == "shell" ) {
                var sh = new bxcachy.ShellConfig( asJson ).apply( step.shell );
                if ( sh.failed.len() ) problem = "failed (" & sh.failed.toList( ", " ) & ")";
                else if ( !asJson ) println( "shell config: wrote " & ( sh.written.len() ? sh.written.toList( ", " ) : "nothing" ) & "; kept " & ( sh.kept.len() ? sh.kept.toList( ", " ) : "nothing" ) );
            }
            if ( step.kind == "terminal" ) {
                var tr = new bxcachy.TerminalConfig( asJson ).apply( step.terminals );
                if ( tr.failed.len() ) problem = "failed (" & tr.failed.toList( ", " ) & ")";
                else if ( !asJson ) println( "terminal configs: wrote " & ( tr.written.len() ? tr.written.toList( ", " ) : "nothing" ) & "; kept " & ( tr.kept.len() ? tr.kept.toList( ", " ) : "nothing" ) );
            }
            if ( step.kind == "starter" ) {
                var st = new bxcachy.Starter( asJson, structKeyExists( step, "opts" ) ? step.opts : {} ).apply();
                if ( st.failed.len() ) problem = "failed (" & st.failed.toList( ", " ) & ")";
                else if ( !asJson ) println( "starter configs: wrote " & ( st.written.len() ? st.written.toList( ", " ) : "nothing" ) & "; kept " & ( st.kept.len() ? st.kept.toList( ", " ) : "nothing" ) );
            }
            for ( var cmd in step.commands ) {
                if ( len( problem ) ) continue;
                var r = variables.inst.exec( cmd, 1800 );
                if ( r.timeout ) problem = "timed out";
                else if ( r.exitCode != 0 ) problem = "failed (exit " & r.exitCode & ")";
            }
            if ( len( problem ) ) { data.failed.append( { id: step.id, error: step.title & " " & problem } ); stopped = true; firstKind = step.kind; }
            else data.done.append( { id: step.id } );
        }
        if ( directoryExists( facts.workDir ) ) { try { directoryDelete( facts.workDir, true ); } catch ( any e ) {} }
        var exit = !data.failed.len() ? 0 : ( data.done.len() ? 7 : ( firstKind == "pacman" ? 5 : 6 ) );
        if ( asJson ) { println( variables.cli.envelope( command, exit, data ) ); return exit; }
        for ( var d in data.done ) println( "Done: " & d.id );
        for ( var f in data.failed ) println( "Failed: " & f.id & ": " & f.error );
        for ( var k in data.skipped ) println( "Skipped: " & k.id & " (" & k.reason & ")" );
        if ( !data.failed.len() ) for ( var n in plan.notes ) println( "Note: " & n );
        return exit;
    }
}
