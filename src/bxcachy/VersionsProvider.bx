// Version Managers: one row per tool with its manager and what is active. Enter on a row opens that tool's page. Built from the same sources as the deep pages.
class VersionsProvider {
    function init( demo = false ) { variables.demo = arguments.demo; variables.sys = new bxcachy.TuiSys(); return this; }
    function id() { return "versions"; }
    function title() { return "Versions"; }
    function hint() { return "bvm, mvm and nvm in one place"; }
    function live() { return false; }
    function emptyText() { return "No version managers found."; }
    function columns() { return [ { key: "tool", label: "tool", w: 14 }, { key: "manager", label: "manager", w: 12 }, { key: "active", label: "active", w: 18 }, { key: "extra", label: "", w: 0 } ]; }
    function style( r ) { return r.active == "-" ? "dim" : ""; }
    function detail( r ) { return [ r.tool & " is managed by " & r.manager & ".", len( r.page ) ? "Enter opens the " & r.tool & " page." : "No deeper page for this one yet." ]; }

    function actions() {
        return [ { key: "Enter", label: "open", run: function( r ) { return len( r.page ) ? { action: "goto", page: r.page } : {}; } } ];
    }

    function nodeActive() {
        var d = getSystemSetting( "NVM_DIR", getSystemSetting( "HOME", "" ) & "/.nvm" ) & "/versions/node";
        try { if ( directoryExists( d ) ) { var names = directoryList( d, false, "name" ); arraySort( names, "textnocase", "desc" ); return names.len() ? { v: names[ 1 ], n: names.len() } : { v: "", n: 0 }; } } catch ( any e ) {}
        return { v: "", n: 0 };
    }

    function load( q = "" ) {
        if ( variables.demo ) return [
            { tool: "BoxLang", manager: "bvm", active: "1.8.0", extra: "3 installed", page: "boxlang" }, { tool: "MatchBox", manager: "mvm", active: "0.14.0", extra: "", page: "" },
            { tool: "Java", manager: "bxcachy java", active: "21.0.13", extra: "3 homes", page: "java" }, { tool: "Node", manager: "nvm", active: "22.11.0", extra: "5 versions", page: "" } ];
        var st = variables.sys.bx( [ "boxlang", "status" ] );
        var homes = variables.sys.bx( [ "java", "list" ] ).homes ?: [];
        var javaAct = "-";
        for ( var h in homes ) if ( h.default || h.active ) { javaAct = h.version; break; }
        var node = nodeActive();
        return [
            { tool: "BoxLang", manager: "bvm", active: len( st.boxlang ?: "" ) ? reReplace( st.boxlang, "^.*v", "" ) : "-", extra: len( st.bvm ?: "" ) ? "bvm " & st.bvm : "bvm not found", page: "boxlang" },
            { tool: "MatchBox", manager: "mvm", active: len( st.matchbox ?: "" ) ? st.matchbox : "-", extra: ( st.mvm ?: false ) ? "" : "mvm not found", page: "" },
            { tool: "Java", manager: "bxcachy java", active: javaAct, extra: homes.len() & " homes", page: "java" },
            { tool: "Node", manager: "nvm", active: len( node.v ) ? node.v : "-", extra: node.n ? node.n & " versions" : "nvm not found", page: "" } ];
    }
}
