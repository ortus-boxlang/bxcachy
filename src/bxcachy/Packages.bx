// Read-only package commands on the catalog: lists, profiles, plan, package-status, package-source.
// Selection is the Resolver's job; this class gathers system facts (installed packages, running shell),
// prints human or --json output and returns the exit code. Nothing here changes the system.
class Packages {
    function init( cli, cat ) {
        variables.cli = arguments.cli;
        variables.cat = arguments.cat;
        return this;
    }

    // Names of all installed pacman packages as a set. Empty when pacman is missing or times out.
    function installedNames() {
        var names = {};
        try {
            var r = systemExecute( "pacman", [ "-Qq" ], 15, true );
            if ( !r.timeout && r.exitCode == 0 ) {
                for ( var n in listToArray( r.output, chr( 10 ) ) ) if ( len( trim( n ) ) ) names[trim( n )] = true;
            }
        } catch ( any e ) {
        }
        return names;
    }

    // Where `install` puts the launcher of a web app (decided in COMMAND-CONTRACT section 11).
    function launcherPath( id ) {
        return getSystemSetting( "HOME", "" ) & "/.local/share/applications/bxcachy-" & id & ".desktop";
    }

    // True when the app is on the system: every target installed, or the launcher file for a web app.
    function isInstalled( app, names ) {
        if ( app.source == "web" ) return fileExists( launcherPath( app.id ) );
        if ( !structKeyExists( app, "targets" ) || !app.targets.len() ) return false;
        for ( var t in app.targets ) if ( !structKeyExists( names, t ) ) return false;
        return true;
    }

    // The running shell ("hyprland", "plasma" or "" when unknown) from XDG_CURRENT_DESKTOP.
    function defaultShell() {
        return new bxcachy.Resolver().detectShell( getSystemSetting( "XDG_CURRENT_DESKTOP", "" ) );
    }

    // desktop-list, tui-list, web-list, optional-list: the catalog filtered by kind or tier.
    function listApps( command, asJson ) {
        var rows = variables.cat.apps.filter( function( a ) {
            if ( command == "optional-list" ) return a.tier == "optional";
            return a.kind == replace( command, "-list", "" );
        } );
        if ( asJson ) println( variables.cli.envelope( command, 0, rows ) );
        else for ( var a in rows ) println( new bxcachy.Catalog().row( a ) );
        return 0;
    }

    // profile-list: every catalog profile with how many default and optional apps it has.
    function profiles( asJson ) {
        var rows = [];
        for ( var pr in variables.cat.profiles ) {
            var d = 0; var o = 0;
            for ( var a in variables.cat.apps ) {
                if ( !structKeyExists( a, "profiles" ) || !structKeyExists( a.profiles, pr.id ) ) continue;
                if ( a.profiles[pr.id] == "default" ) d++; else o++;
            }
            rows.append( { id: pr.id, title: pr.title, blurb: pr.blurb, default: d, optional: o } );
        }
        if ( asJson ) println( variables.cli.envelope( "profile-list", 0, rows ) );
        else for ( var r in rows ) println( r.id & ": " & r.title & " (" & r["default"] & " default, " & r.optional & " optional) - " & r.blurb );
        return 0;
    }

    // plan and its aliases: the resolver's answer, nothing installed. Exit 2 usage, 3 a named app has no source.
    function plan( command, req, asJson ) {
        var names = installedNames();
        var self = this;
        req.installed = function( a ) { return self.isInstalled( a, names ); };
        var res = new bxcachy.Resolver().resolve( variables.cat, req );
        if ( res.errors.len() ) {
            for ( var e in res.errors ) println( "error: " & e );
            return 2;
        }
        var wouldInstall = res.selected.map( function( a ) {
            return { id: a.id, source: a.source, targets: structKeyExists( a, "targets" ) ? a.targets : [] };
        } );
        var code = res.failed.len() ? 3 : 0;
        if ( asJson ) {
            var selection = { mode: res.mode, ids: req.ids, profile: req.profile, optional: req.optional, shell: req.shell };
            println( variables.cli.envelope( command, code, { selection: selection, would_install: wouldInstall, done: [], failed: res.failed, skipped: res.skipped } ) );
            return code;
        }
        var label = res.mode == "default" ? "default tier" : ( res.mode == "profile" ? "profile " & req.profile : "named apps" );
        println( "Plan (" & label & ( len( req.shell ) ? ", shell " & req.shell : "" ) & "): " & wouldInstall.len() & " to install, " & res.skipped.len() & " skipped" );
        for ( var w in wouldInstall ) println( "  " & w.id & "  [" & w.source & "]" );
        var counts = {};
        for ( var s in res.skipped ) counts[s.reason] = ( structKeyExists( counts, s.reason ) ? counts[s.reason] : 0 ) + 1;
        var parts = [];
        for ( var reason in [ "optional", "wrong_shell", "unresolved", "installed" ] ) if ( structKeyExists( counts, reason ) ) parts.append( reason & " " & counts[reason] );
        if ( parts.len() ) println( "Skipped: " & parts.toList( ", " ) );
        for ( var f in res.failed ) println( "Failed: " & f.id & " (" & f.error & ")" );
        println( "Read-only plan; nothing was installed." );
        return code;
    }

    // package-status ID: 0 installed, 1 missing, 3 unknown id.
    function status( id, asJson ) {
        var app = new bxcachy.Catalog().find( variables.cat, id );
        if ( structIsEmpty( app ) ) {
            println( "Unknown catalog id: " & id );
            return 3;
        }
        var installed = isInstalled( app, installedNames() );
        var code = installed ? 0 : 1;
        if ( asJson ) println( variables.cli.envelope( "package-status", code, { id: id, source: app.source, installed: installed } ) );
        else println( id & ": " & ( installed ? "installed" : "missing" ) );
        return code;
    }

    // package-source ID: where the catalog says the app comes from. 3 for an unknown id.
    function source( id, asJson ) {
        var app = new bxcachy.Catalog().find( variables.cat, id );
        if ( structIsEmpty( app ) ) {
            println( "Unknown catalog id: " & id );
            return 3;
        }
        var targets = structKeyExists( app, "targets" ) ? app.targets : [];
        if ( asJson ) println( variables.cli.envelope( "package-source", 0, { id: id, source: app.source, targets: targets, tier: app.tier, group: app.group } ) );
        else println( id & ": " & app.source & ( targets.len() ? " (" & targets.toList( " " ) & ")" : "" ) & "  tier: " & app.tier & "  group: " & app.group );
        return 0;
    }
}
