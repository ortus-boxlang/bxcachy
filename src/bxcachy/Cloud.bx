// `bxcachy cloud`: cloud storage as folders, with rclone.
//   remotes                       the remotes rclone knows (`rclone listremotes`)
//   configure                     runs `rclone config` on your terminal (rclone asks everything itself; BxCachy never sees your logins)
//   mount NAME [--path=DIR] [--yes]   writes ~/.config/systemd/user/bxcachy-cloud-NAME.service and starts it: `rclone mount NAME: DIR`,
//                                 DIR is ~/Cloud/NAME by default. It starts at every login. Needs fuse3 (fusermount3).
//   unmount NAME [--yes]          stops and disables it (the unit file is deleted only while it is still the one BxCachy wrote)
//   status                        the mounts BxCachy made and whether each is running
// A unit file you edited is never overwritten (exit 4). The unit uses Type=notify, which rclone mount supports, so systemd waits until
// the mount is up. Exit: 0 done, 2 plan without --yes, 4 precondition, 6 a command failed. Package facts checked on archlinux.org
// 2026-11-12: rclone (extra) ships /usr/bin/rclone and lists fuse3 as its optional dependency "for rclone mount"; fuse3 ships fusermount3.
class Cloud {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxcachy.Installer( arguments.runner );
        variables.config = new bxcachy.ConfigService().quiet( true );
        return this;
    }

    function say( command, code, data, asJson, lines = [] ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data, false ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function tryExec( argv, timeout = 30 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function has( name ) { return tryExec( [ "sh", "-c", 'command -v "$1"', "_", arguments.name ], 10 ).exitCode == 0; }
    function validName( name ) { return reFind( "^[A-Za-z0-9_-]{1,40}$", arguments.name ) > 0; }
    function unitName( name ) { return "bxcachy-cloud-" & arguments.name & ".service"; }
    function unitDir() { return variables.config.cfgHome() & "/systemd/user"; }
    function defaultDir( name ) { return getSystemSetting( "HOME", "" ) & "/Cloud/" & arguments.name; }

    function remotes() {
        var r = tryExec( [ "rclone", "listremotes" ], 20 );
        if ( r.exitCode != 0 ) return [];
        return listToArray( r.output, chr( 10 ) ).map( function( l ) { return reReplace( trim( l ), ":$", "" ); } ).filter( function( l ) { return len( l ) > 0; } );
    }

    function needRclone( cmd, asJson ) {
        if ( has( "rclone" ) ) return 0;
        return say( arguments.cmd, 4, { error: "rclone is not installed" }, arguments.asJson, [ "error: rclone is not installed. Install: bxcachy install rclone fuse3" ] );
    }

    function listRemotes( asJson ) {
        var cmd = "cloud remotes";
        var n = needRclone( cmd, arguments.asJson );
        if ( n != 0 ) return n;
        var rows = remotes();
        return say( cmd, 0, { remotes: rows }, arguments.asJson, rows.len() ? rows : [ "No remotes yet. Add one: bxcachy cloud configure" ] );
    }

    function configure() {
        if ( !has( "rclone" ) ) { println( "error: rclone is not installed. Install: bxcachy install rclone fuse3" ); return 4; }
        var r = systemExecute( "rclone", [ "config" ], 0, false, ".", "", "", true, {}, true );
        return r.exitCode;
    }

    function unitText( name, dir ) {
        var nl = chr( 10 );
        return "# Written by bxcachy (cloud mount). Edit it freely: BxCachy will not overwrite a changed file." & nl & "[Unit]" & nl
            & "Description=rclone mount of " & arguments.name & " (bxcachy)" & nl & "After=network-online.target" & nl & "Wants=network-online.target" & nl & nl
            & "[Service]" & nl & "Type=notify" & nl & "ExecStartPre=/usr/bin/mkdir -p " & arguments.dir & nl
            & "ExecStart=/usr/bin/rclone mount " & arguments.name & ": " & arguments.dir & " --vfs-cache-mode writes" & nl
            & "ExecStop=/usr/bin/fusermount3 -u " & arguments.dir & nl & "Restart=on-failure" & nl & "RestartSec=10" & nl & nl
            & "[Install]" & nl & "WantedBy=default.target" & nl;
    }

    // `cloud mount NAME [--path=DIR] [--yes]`
    function mount( name, path, yes, asJson ) {
        var cmd = "cloud mount";
        if ( !validName( arguments.name ) ) return say( cmd, 4, { error: "Bad name" }, arguments.asJson, [ "error: a remote name is letters, digits, - and _" ] );
        var n = needRclone( cmd, arguments.asJson );
        if ( n != 0 ) return n;
        if ( !has( "fusermount3" ) ) return say( cmd, 4, { error: "fuse3 is not installed" }, arguments.asJson, [ "error: fuse3 is not installed (rclone mount needs it). Install: bxcachy install fuse3" ] );
        if ( !arrayFind( remotes(), arguments.name ) ) return say( cmd, 4, { error: "Unknown remote" }, arguments.asJson, [ "error: rclone has no remote called " & arguments.name & ". Add it: bxcachy cloud configure" ] );
        var dir = len( arguments.path ) ? arguments.path : defaultDir( arguments.name );
        if ( find( " ", dir ) || find( chr( 34 ), dir ) || find( chr( 39 ), dir ) || left( dir, 1 ) != "/" ) return say( cmd, 4, { error: "Bad path" }, arguments.asJson, [ "error: the folder must be an absolute path without spaces or quotes" ] );
        var entry = { name: "cloud-" & arguments.name, target: unitDir() & "/" & unitName( arguments.name ), mode: "644", content: unitText( arguments.name, dir ) };
        var state = variables.config.configState( entry );
        var data = { remote: arguments.name, folder: dir, unit: entry.target };
        if ( state == "drifted" || state == "blocked" ) return say( cmd, 4, data, arguments.asJson, [ "error: " & entry.target & " was changed by you, so it was kept. Unmount it first (bxcachy cloud unmount " & arguments.name & " --yes) and delete the file to start over." ] );
        if ( !arguments.yes ) return say( cmd, 2, data, arguments.asJson, [ "Plan: mount " & arguments.name & ": at " & dir & " through the user service " & unitName( arguments.name ) & " (starts at every login).", "Nothing was changed. Add --yes to apply." ] );
        if ( variables.config.configWrite( entry, entry.content, "apply", true, false ) != 0 ) return say( cmd, 6, data, arguments.asJson, [ "error: could not write " & entry.target ] );
        tryExec( [ "systemctl", "--user", "daemon-reload" ], 20 );
        var r = tryExec( [ "systemctl", "--user", "enable", "--now", unitName( arguments.name ) ], 60 );
        if ( r.exitCode != 0 ) return say( cmd, 6, merge( data, { error: trim( r.output ) } ), arguments.asJson, [ "error: could not start the mount: " & trim( r.output ), "See: journalctl --user -u " & unitName( arguments.name ) ] );
        return say( cmd, 0, data, arguments.asJson, [ arguments.name & " is mounted at " & dir & " and will be again at every login." ] );
    }

    function merge( base, extra ) {
        var out = {};
        for ( var k in structKeyArray( arguments.base ) ) out[ k ] = arguments.base[ k ];
        for ( var k in structKeyArray( arguments.extra ) ) out[ k ] = arguments.extra[ k ];
        return out;
    }

    // `cloud unmount NAME [--yes]`
    function unmount( name, yes, asJson ) {
        var cmd = "cloud unmount";
        if ( !validName( arguments.name ) ) return say( cmd, 4, { error: "Bad name" }, arguments.asJson, [ "error: bad name" ] );
        var unit = unitDir() & "/" & unitName( arguments.name );
        if ( !fileExists( unit ) ) return say( cmd, 4, { error: "No such mount" }, arguments.asJson, [ "error: BxCachy has no mount for " & arguments.name ] );
        if ( !arguments.yes ) return say( cmd, 2, { remote: arguments.name }, arguments.asJson, [ "Plan: stop and disable " & unitName( arguments.name ) & ".", "Nothing was changed. Add --yes to apply." ] );
        var r = tryExec( [ "systemctl", "--user", "disable", "--now", unitName( arguments.name ) ], 60 );
        if ( r.exitCode != 0 ) return say( cmd, 6, { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
        var m = reFind( "--vfs-cache-mode writes", fileRead( unit ) );
        var dirLine = "";
        for ( var line in listToArray( fileRead( unit ), chr( 10 ) ) ) if ( left( line, 10 ) == "ExecStart=" ) dirLine = line;
        var folder = len( dirLine ) ? listLast( replace( dirLine, " --vfs-cache-mode writes", "" ), " " ) : "";
        var clean = len( folder ) && fileRead( unit ) == unitText( arguments.name, folder );
        if ( clean ) { fileDelete( unit ); tryExec( [ "systemctl", "--user", "daemon-reload" ], 20 ); }
        return say( cmd, 0, { remote: arguments.name, unit_removed: clean }, arguments.asJson, [ arguments.name & " was unmounted." & ( clean ? "" : " The unit file was kept because you changed it." ) ] );
    }

    // `cloud status`
    function status( asJson ) {
        var rows = [];
        if ( directoryExists( unitDir() ) ) for ( var f in directoryList( unitDir(), false, "name" ) ) {
            if ( left( f, 14 ) != "bxcachy-cloud-" || right( f, 8 ) != ".service" ) continue;
            var n = mid( f, 15, len( f ) - 22 );
            rows.append( { remote: n, active: trim( tryExec( [ "systemctl", "--user", "is-active", f ], 10 ).output ) == "active" } );
        }
        return say( "cloud status", 0, { mounts: rows }, arguments.asJson, rows.len() ? rows.map( function( r ) { return r.remote & "  " & ( r.active ? "mounted" : "not running" ); } ) : [ "No cloud mounts. Add one: bxcachy cloud mount NAME" ] );
    }
}
