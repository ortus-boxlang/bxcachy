              "label": "Codex",
              "description": "OpenAI''s coding agent."
            },
            {
              "value": "gemini-cli",
              "label": "Gemini CLI",
              "description": "Google''s coding agent."
            },
            {
              "value": "opencode-cli",
              "label": "OpenCode",
              "description": "Open source coding agent; works with many providers."
            }
          ],
          "help": "Terminal agents that write code with you. Pick the ones you use."
        },
        {
          "type": "choice",
          "id": "ai_default",
          "label": "Default agent",
          "help": "The one `bxcachy ai launch` opens in your terminal. You can change it later.",
          "default": "claude-code",
          "when": {
            "id": "ai_agents",
            "nonempty": true
          },
          "options": [
            {
              "value": "claude-code",
              "label": "Claude Code",
              "description": "Anthropic''s coding agent."
            },
            {
              "value": "codex-cli",
              "label": "Codex",
              "description": "OpenAI''s coding agent."
            },
            {
              "value": "gemini-cli",
              "label": "Gemini CLI",
              "description": "Google''s coding agent."
            },
            {
              "value": "opencode-cli",
              "label": "OpenCode",
              "description": "Open source coding agent; works with many providers."
            }
          ]
        },
        {
          "type": "multi",
          "id": "ai_orchestrators",
          "label": "AI coding orchestration",
          "help": "Run several coding agents at once, each in its own git worktree.",
          "default": [
            "pane"
          ],
          "options": [
            {
              "value": "pane",
              "label": "Pane",
              "description": "Desktop app for parallel agents with a diff viewer and git workflow. The BxCachy default."
            },
            {
              "value": "orca",
              "label": "Orca",
              "description": "Agentic coding IDE from Stably: parallel agents across repos."
            },
            {
              "value": "herdr",
              "label": "Herdr",
              "description": "Terminal workspace manager with live status for each agent."
            }
          ]
        },
        {
          "type": "choice",
          "id": "ai_keys",
          "label": "API keys",
          "help": "Stored in your desktop keyring (BxCachy installs one if you have none), never in files or shell history. Skip any prompt you do not want.",
          "default": "later",
          "when": {
            "id": "ai_agents",
            "nonempty": true
          },
          "options": [
            {
              "value": "later",
              "label": "Add them later",
              "description": "Nothing is asked now. Later: bxcachy secrets set NAME."
            },
            {
              "value": "now",
              "label": "Enter them at the end of the install",
              "description": "You type each key hidden at the terminal, and can skip any."
            }
          ]
        },
        {
          "type": "multi",
          "id": "ai_providers",
          "label": "Other provider keys",
          "help": "Agents like OpenCode work with many providers. Tick the ones you have a key for. The key of each single-provider agent you picked is already included.",
          "default": [],
          "when": {
            "id": "ai_keys",
            "equals": "now"
          },
          "options": [
            {
              "value": "anthropic",
              "label": "Anthropic",
              "description": "ANTHROPIC_API_KEY"
            },
            {
              "value": "openai",
              "label": "OpenAI",
              "description": "OPENAI_API_KEY"
            },
            {
              "value": "google",
              "label": "Google Gemini",
              "description": "GEMINI_API_KEY"
            },
            {
              "value": "openrouter",
              "label": "OpenRouter",
              "description": "OPENROUTER_API_KEY"
            },
            {
              "value": "novita",
              "label": "Novita AI",
              "description": "NOVITA_API_KEY"
            },
            {
              "value": "opencode",
              "label": "OpenCode",
              "description": "OPENCODE_API_KEY"
            },
            {
              "value": "groq",
              "label": "Groq",
              "description": "GROQ_API_KEY"
            },
            {
              "value": "mistral",
              "label": "Mistral",
              "description": "MISTRAL_API_KEY"
            },
            {
              "value": "deepseek",
              "label": "DeepSeek",
              "description": "DEEPSEEK_API_KEY"
            },
            {
              "value": "xai",
              "label": "xAI",
              "description": "XAI_API_KEY"
            },
            {
              "value": "together",
              "label": "Together AI",
              "description": "TOGETHER_API_KEY"
            }
          ]
        },
        {
          "type": "multi",
          "id": "ai_global_keys",
          "label": "Export to every shell?",
          "help": "Default is NO: a key is given only to its own agent, when you start it. Exporting makes it readable by every program you start, including AI agents and anything they run.",
          "default": [],
          "when": {
            "id": "ai_keys",
            "equals": "now"
          },
          "options": [
            {
              "value": "ANTHROPIC_API_KEY",
              "label": "ANTHROPIC_API_KEY",
              "description": "Anthropic"
            },
            {
              "value": "OPENAI_API_KEY",
              "label": "OPENAI_API_KEY",
              "description": "OpenAI"
            },
            {
              "value": "GEMINI_API_KEY",
              "label": "GEMINI_API_KEY",
              "description": "Google Gemini"
            },
            {
              "value": "OPENROUTER_API_KEY",
              "label": "OPENROUTER_API_KEY",
              "description": "OpenRouter"
            },
            {
              "value": "NOVITA_API_KEY",
              "label": "NOVITA_API_KEY",
              "description": "Novita AI"
            },
            {
              "value": "OPENCODE_API_KEY",
              "label": "OPENCODE_API_KEY",
              "description": "OpenCode"
            },
            {
              "value": "GROQ_API_KEY",
              "label": "GROQ_API_KEY",
              "description": "Groq"
            },
            {
              "value": "MISTRAL_API_KEY",
              "label": "MISTRAL_API_KEY",
              "description": "Mistral"
            },
            {
              "value": "DEEPSEEK_API_KEY",
              "label": "DEEPSEEK_API_KEY",
              "description": "DeepSeek"
            },
            {
              "value": "XAI_API_KEY",
              "label": "XAI_API_KEY",
              "description": "xAI"
            },
            {
              "value": "TOGETHER_API_KEY",
              "label": "TOGETHER_API_KEY",
              "description": "Together AI"
            }
          ]
        },
        {
          "type": "multi",
          "id": "ai_local",
          "label": "Local models",
          "help": "Run AI models on this machine, no cloud. Nothing is preselected.",
          "default": [],
          "options": [
            {
              "value": "ollama",
              "label": "Ollama",
              "description": "Run models from the command line; the usual backend for local agents."
            },
            {
              "value": "lm-studio",
              "label": "LM Studio",
              "description": "Desktop app to find, download and chat with models."
            },
            {
              "value": "jan",
              "label": "Jan",
              "description": "Open source ChatGPT-style app that runs fully offline."
            },
            {
              "value": "koboldcpp",
              "label": "KoboldCpp",
              "description": "Single-file text generation for GGUF models, with a web UI."
            },
            {
              "value": "gpt4all",
              "label": "GPT4All",
              "description": "Simple local chat app for open models."
            }
          ]
        },
        {
          "type": "choice",
          "id": "ai_local_gpu",
          "label": "Ollama GPU support",
          "help": "Ollama runs on the CPU unless you add the GPU build for your card.",
          "default": "none",
          "when": {
            "id": "ai_local",
            "has": "ollama"
          },
          "options": [
            {
              "value": "none",
              "label": "CPU only (or I will set it up later)",
              "description": "Just the ollama package."
            },
            {
              "value": "nvidia",
              "label": "NVIDIA (CUDA)",
              "description": "Adds ollama-cuda, which pulls in the CUDA toolkit."
            },
            {
              "value": "amd",
              "label": "AMD (ROCm)",
              "description": "Adds ollama-rocm, which pulls in HIP/ROCm libraries."
            }
          ]
        },
        {
          "type": "confirm",
          "id": "ai_ollama_service",
          "label": "Start Ollama at boot",
          "default": true,
          "help": "Enables the ollama service the package ships (needs sudo). Without it, start it yourself before pulling models.",
          "when": {
            "id": "ai_local",
            "has": "ollama"
          }
        },
        {
          "type": "text",
          "id": "ai_models",
          "label": "Models to download",
          "default": "",
          "placeholder": "qwen3:8b, llama3.2",
          "help": "Ollama model names, comma separated. Leave empty to download none now. Sizes are several GB each.",
          "when": {
            "id": "ai_local",
            "has": "ollama"
          }
        }
      ]
    },
    {
      "id": "extras",
      "title": "Extras",
      "intro": "A few more things that make a machine feel like yours.",
      "questions": [
        {
          "type": "choice",
          "id": "vpn",
          "label": "VPN",
          "default": "tailscale",
          "options": [
            {
              "value": "none",
              "label": "None",
              "description": ""
            },
            {
              "value": "tailscale",
              "label": "Tailscale",
              "description": "Zero-config private network between your machines."
            },
            {
              "value": "wireguard",
              "label": "WireGuard",
              "description": "Fast, simple VPN tunnels."
            },
            {
              "value": "openvpn",
              "label": "OpenVPN",
              "description": "The long-standing open source VPN client."
            },
            {
              "value": "mullvad",
              "label": "Mullvad",
              "description": "Privacy-focused VPN with its own app."
            },
            {
              "value": "proton",
              "label": "Proton VPN",
              "description": "Proton''s VPN app."
            },
            {
              "value": "nordvpn",
              "label": "NordVPN",
              "description": "NordVPN''s command-line client (AUR). BxCachy also enables its service and your group."
            }
          ]
        },
        {
          "type": "choice",
          "id": "password_manager",
          "label": "Password manager",
          "default": "bitwarden",
          "options": [
            {
              "value": "bitwarden",
              "label": "Bitwarden",
              "description": "Open source, synced."
            },
            {
              "value": "keepassxc",
              "label": "KeePassXC",
              "description": "Local files, no account."
            },
            {
              "value": "1password",
              "label": "1Password",
              "description": "Polished, subscription."
            }
          ]
        },
        {
          "type": "choice",
          "id": "gaming",
          "label": "Gaming",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "No gaming",
              "description": ""
            },
            {
              "value": "steam",
              "label": "Steam only",
              "description": "Just Steam."
            },
            {
              "value": "bundle",
              "label": "Full CachyOS gaming bundle",
              "description": "Steam, Lutris, Heroic, Proton tools, MangoHud and more."
            }
          ]
        },
        {
          "type": "multi",
          "id": "backups",
          "label": "Backups and snapshots",
          "help": "Tools only; BxCachy does not schedule anything yet.",
          "default": [],
          "options": [
            {
              "value": "snapper",
              "label": "Snapper + snap-pac",
              "description": "Btrfs snapshots, one before and after every pacman update."
            },
            {
              "value": "restic",
              "label": "restic",
              "description": "Fast encrypted backups to local disks or the cloud."
            },
            {
              "value": "borg",
              "label": "BorgBackup",
              "description": "Deduplicating backups with compression."
            }
          ]
        },
        {
          "type": "multi",
          "id": "desktop_utilities",
          "label": "Desktop utilities",
          "default": [
            "cliphist",
            "wf-recorder"
          ],
          "help": "Small tools with BxCachy shortcuts on Hyprland: clipboard history (Super+Shift+V) and screen recording (Super+Shift+R).",
          "when": {
            "id": "desktops",
            "in": [
              "hyprland",
              "both"
            ]
          },
          "options": [
            {
              "value": "cliphist",
              "label": "Clipboard history",
              "description": "cliphist: pick earlier copies with Super+Shift+V."
            },
            {
              "value": "wf-recorder",
              "label": "Screen recording",
              "description": "wf-recorder: Super+Shift+R starts and stops, with Alt a region."
            },
            {
              "value": "pavucontrol",
              "label": "Volume control",
              "description": "pavucontrol: a window to set volumes and outputs."
            },
            {
              "value": "nwg-displays",
              "label": "Monitor layout",
              "description": "nwg-displays: arrange monitors, resolution and scale."
            },
            {
              "value": "playerctl",
              "label": "Media keys",
              "description": "playerctl: control any media player from the keyboard."
            }
          ]
        },
        {
          "type": "multi",
          "id": "remote_desktop",
          "label": "Remote desktop",
          "default": [],
          "help": "Reach other machines, or let them reach this one. Nothing is preselected.",
          "options": [
            {
              "value": "remmina",
              "label": "Remmina",
              "description": "RDP, VNC and SSH client."
            },
            {
              "value": "rustdesk",
              "label": "RustDesk",
              "description": "Open source remote desktop with its own relay."
            },
            {
              "value": "moonlight",
              "label": "Moonlight",
              "description": "Stream games and your desktop from a Sunshine or NVIDIA host."
            },
            {
              "value": "sunshine",
              "label": "Sunshine",
              "description": "Host: stream this machine to Moonlight clients."
            }
          ]
        },
        {
          "type": "confirm",
          "id": "cloud_storage",
          "label": "Cloud storage (rclone)",
          "default": false,
          "help": "Installs rclone and fuse3. Afterwards `bxcachy cloud configure` adds your accounts and `bxcachy cloud mount NAME` makes a folder of one."
        }
      ]
    },
    {
      "id": "import",
      "title": "Import",
      "intro": "Bring your own dotfiles. This runs last, so your files win over BxCachy''s starter configs.",
      "questions": [
        {
          "type": "text",
          "id": "dotfiles_repo",
          "label": "Dotfiles repository (optional)",
          "help": "A git URL or a local path. Leave empty to skip.",
          "default": "",
          "placeholder": "https://github.com/you/dotfiles"
        },
        {
          "type": "info",
          "label": "How it works",
          "help": "BxCachy detects whether the repository uses chezmoi, yadm, stow or plain files. Nothing is replaced without asking: files you already have are listed, and each one is backed up first. Undo any time with: bxcachy dotfiles undo."
        }
      ]
    }
  ]
}'; }
}
