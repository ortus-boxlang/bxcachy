// The Dashboard page of the Control Center: a summary first (what needs attention), then system meters, what runs and how fresh your backups are.
// A page is any class with the same five methods, so the Control Center can host it:
//   id() title() load() keys() paint( kit, x, y, w, h, tick, phase ) onKey( key ) -> intent  act( hit ) -> intent  onScroll( dir ) -> intent
// An intent is a struct: {} (nothing), { action: "goto", page }, { action: "launch", target } (leave the Control Center and run that screen), { action: "cli", title, args } (plan first).
class DashboardPage {
    function init( data ) {
        variables.provider = arguments.data;
        variables.data = {};
        variables.att = [];
        variables.cursor = 1;
        variables.loaded = false;
        return this;
    }

    function id() { return "dashboard"; }
    function icon() { return "home"; }
    function usesLeft() { return false; }
    function title() { return "Dashboard"; }

    function load() {
        variables.data = variables.provider.collect();
        variables.att = variables.provider.attention( variables.data );
        variables.cursor = min( max( 1, variables.cursor ), max( 1, variables.att.len() ) );
        variables.loaded = true;
        return this;
    }

    function state() { return { data: variables.data, attention: variables.att, cursor: variables.cursor }; }
    function keys() { return [ [ "↑↓", "move" ], [ "Enter", "fix it" ], [ "r", "refresh" ], [ "b", "backups" ] ]; }

    function onKey( key ) {
        var k = arguments.key;
        if ( k == "Up" || compare( k, "k" ) == 0 ) { variables.cursor = max( 1, variables.cursor - 1 ); return {}; }
        if ( k == "Down" || compare( k, "j" ) == 0 ) { variables.cursor = min( max( 1, variables.att.len() ), variables.cursor + 1 ); return {}; }
        if ( compare( k, "r" ) == 0 ) { load(); return {}; }
        if ( compare( k, "b" ) == 0 ) return { action: "launch", target: "timemachine" };
        if ( k == "Enter" && variables.att.len() ) return variables.att[ variables.cursor ].action;
        for ( var a in variables.att ) if ( len( a.key ) && compare( a.key, k ) == 0 ) return a.action;
        return {};
    }

    function act( hit ) {
        if ( arguments.hit.kind == "att" ) { variables.cursor = arguments.hit.n; return variables.att[ arguments.hit.n ].action; }
        if ( arguments.hit.kind == "backups" ) return { action: "launch", target: "timemachine" };
        return {};
    }

    function onScroll( dir ) { return onKey( arguments.dir == "up" ? "Up" : "Down" ); }

    function ago( seconds ) {
        var a = max( 0, arguments.seconds );
        if ( a < 5400 ) return round( a / 60 ) & " min ago";
        if ( a < 129600 ) return round( a / 3600 ) & " h ago";
        return int( a / 86400 ) & " days ago";
    }

    function paint( kit, x, y, w, h, tick, phase ) {
        var p = arguments.kit;
        var d = variables.data;
        var C = function( n ) { return p.color( n ); };
        if ( !variables.loaded ) { p.put( x + 2, y + 1, "Reading the machine...", C( "OVERLAY" ), C( "BASE" ) ); return; }
        var colW = int( ( arguments.w - 3 ) / 2 );
        var bx2 = arguments.x + colW + 3;
        // header line
        p.put( arguments.x + 1, arguments.y, d.host, C( "TEXT" ), C( "BASE" ), true );
        var up = d.uptime >= 86400 ? int( d.uptime / 86400 ) & " d " & int( ( d.uptime mod 86400 ) / 3600 ) & " h" : int( d.uptime / 3600 ) & " h";
        p.put( arguments.x + 2 + len( d.host ), arguments.y, d.os & " · " & d.kernel & " · up " & up, C( "OVERLAY" ), C( "BASE" ) );
        var ok = !variables.att.len();
        var badge = ok ? "● healthy" : "▲ " & variables.att.len() & " to look at";
        p.put( arguments.x + arguments.w - len( badge ) - 1, arguments.y, badge, ok ? C( "GREEN" ) : C( "YELLOW" ), C( "BASE" ), true );
        // attention
        var top = arguments.y + 2;
        p.panel( arguments.x, top, colW, 8, "Needs attention", false, arguments.phase );
        var i = 0;
        if ( ok ) p.put( arguments.x + 2, top + 1, "✓ Disk, services and backups look fine", C( "GREEN" ), C( "MANTLE" ) );
        for ( var a in variables.att ) {
            i++;
            if ( i > 6 ) break;
            var on = i == variables.cursor;
            var icon = a.level == "error" ? "●" : "▲";
            var col = a.level == "error" ? C( "RED" ) : C( "YELLOW" );
            if ( on ) p.fillRect( arguments.x + 1, top + i, colW - 2, 1, C( "SURFACE0" ) );
            var bg = on ? C( "SURFACE0" ) : C( "MANTLE" );
            p.put( arguments.x + 2, top + i, icon, col, bg, true );
            p.put( arguments.x + 4, top + i, p.trunc( a.text, colW - 14 ), on ? C( "GREEN" ) : C( "TEXT" ), bg, on );
            if ( len( a.key ) ) p.put( arguments.x + colW - 5, top + i, a.key, C( "GREEN" ), bg, true );
            p.hit( "att", arguments.x + 1, top + i, colW - 2, 1, i );
        }
        // system
        p.panel( bx2, top, colW, 8, "System", false, arguments.phase );
        var mw = colW - 24;
        var row = function( yy, name, frac, text, warn ) {
            p.put( bx2 + 2, yy, name, C( "SUB" ), C( "MANTLE" ) );
            p.meter( bx2 + 8, yy, mw, frac, warn, 0.92 );
            p.put( bx2 + 9 + mw, yy, text, C( "TEXT" ), C( "MANTLE" ) );
        };
        row( top + 1, "CPU", d.cpu, round( d.cpu * 100 ) & "%", 0.75 );
        row( top + 2, "RAM", d.mem.total ? d.mem.used / d.mem.total : 0, p.size( d.mem.used ), 0.8 );
        row( top + 3, "Disk", d.disk.total ? d.disk.used / d.disk.total : 0, round( d.disk.total ? d.disk.used / d.disk.total * 100 : 0 ) & "%", 0.85 );
        if ( d.battery.present ) row( top + 4, "Batt", d.battery.percent / 100, d.battery.percent & "%" & ( d.battery.charging ? " ⚡" : "" ), 2 );
        // machines
        var ty = top + 9;
        var mh = max( 6, min( 9, max( d.machines.len(), d.backups.len() + 1 ) + 2 ) );
        p.panel( arguments.x, ty, colW, mh, "Running", false, arguments.phase );
        var n = 0;
        if ( !d.machines.len() ) p.put( arguments.x + 2, ty + 1, "No databases or VMs yet", C( "OVERLAY" ), C( "MANTLE" ) );
        for ( var m in d.machines ) {
            n++;
            if ( n > mh - 2 ) break;
            var on2 = m.state == "running";
            p.put( arguments.x + 2, ty + n, on2 ? "●" : "○", on2 ? C( "GREEN" ) : C( "OVERLAY" ), C( "MANTLE" ) );
            p.put( arguments.x + 4, ty + n, p.trunc( m.name, colW - 24 ), on2 ? C( "TEXT" ) : C( "OVERLAY" ), C( "MANTLE" ) );
            p.put( arguments.x + colW - 18, ty + n, ( m.port ? ":" & m.port : "" ), C( "SUB" ), C( "MANTLE" ) );
            p.put( arguments.x + colW - 10, ty + n, m.kind, C( "OVERLAY" ), C( "MANTLE" ) );
        }
        // backups
        p.panel( bx2, ty, colW, mh, "Backups", false, arguments.phase );
        n = 0;
        for ( var b in d.backups ) {
            n++;
            if ( n > mh - 2 ) break;
            var stale = b.count && d.now - b.latest > 2 * 86400;
            p.put( bx2 + 2, ty + n, left( b.label & "          ", 11 ), C( "SUB" ), C( "MANTLE" ) );
            if ( b.count ) {
                p.spark( bx2 + 13, ty + n, 8, b.ages, stale ? C( "YELLOW" ) : C( "GREEN" ) );
                p.put( bx2 + 23, ty + n, ago( d.now - b.latest ), stale ? C( "YELLOW" ) : C( "OVERLAY" ), C( "MANTLE" ) );
            } else p.put( bx2 + 13, ty + n, len( b.error ) ? p.trunc( b.error, colW - 16 ) : "none yet", C( "OVERLAY" ), C( "MANTLE" ) );
        }
        p.put( bx2 + 2, ty + mh - 2, "Enter opens BxTimeMachine", C( "OVERLAY" ), C( "MANTLE" ) );
        p.hit( "backups", bx2, ty, colW, mh );
    }
}
