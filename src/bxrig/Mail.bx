// `bxrig mail`: a mail catcher for development. Everything your app sends to 127.0.0.1:1025 lands in an inbox you can read, and nothing leaves the machine.
// It runs Mailpit (image axllent/mailpit) in a container: SMTP on 1025, the web inbox and its REST API on 8025, both on 127.0.0.1 only.
//   bxrig mail start [--keep] [--smtp-port=1025] [--ui-port=8025] [--yes] [--dry-run]
//   bxrig mail stop | status | remove [--keep-data] [--yes] [--dry-run]
//   bxrig mail list [--limit=50] [--json]     the messages, newest first
//   bxrig mail show ID [--json]               headers, text body and attachments of one message
//   bxrig mail delete ID [--yes] [--dry-run]  deletes one message
//   bxrig mail clear [--yes] [--dry-run]      deletes every message (the catcher keeps running)
//   bxrig mail open [ID]                      the web inbox (or one message rendered as a page) in your browser
//   bxrig mail test [--to=ADDR] [--subject=TEXT]   sends one sample message through the API so you can see the inbox work
//   bxrig mail env [--json]                   the SMTP settings to put in your app (BoxLang or ColdBox, Laravel, Spring Boot, Node and a generic list)
// Mail is thrown away when the catcher stops: without --keep the container runs with --rm and no volume, so `stop` deletes it and its mail.
// With --keep the inbox is stored in ~/.local/share/bxrig/mail (mounted at /data, MP_DATABASE=/data/mailpit.db) and survives stop and start.
// The container engine is the one `bxrig db engine` chose (podman by default, docker by choice).
// Exit: 0 ok, 2 usage or a plan shown without --yes, 4 precondition (no container engine, bad port, catcher not running, unknown message),
//       6 the container command or an API call failed.
// Overrides for tests: BXRIG_MAIL_API (replaces http://127.0.0.1:UIPORT), BXRIG_DATA_HOME.
class Mail {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.db = new bxrig.Db( arguments.cli, arguments.runner );
        variables.config = new bxrig.ConfigService();
        return this;
    }

    function image() { return "axllent/mailpit"; }
    function container() { return "bxrig-mail"; }
    function dir() { return variables.db.dataHome() & "/mail"; }
    function metaFile() { return dir() & "/meta.json"; }

    function say( command, code, data, asJson, lines = [], dryRun = false ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data, arguments.dryRun ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function fail( command, code, msg, asJson ) { return say( arguments.command, arguments.code, { error: arguments.msg }, arguments.asJson, [ "error: " & arguments.msg ] ); }

    function meta() {
        try { return fileExists( metaFile() ) ? jsonDeserialize( fileRead( metaFile() ) ) : {}; } catch ( any e ) { return {}; }
    }

    function smtpPort() { var m = meta(); return structKeyExists( m, "smtp" ) ? m.smtp : 1025; }
    function uiPort() { var m = meta(); return structKeyExists( m, "ui" ) ? m.ui : 8025; }

    // The web UI and API address, without a trailing slash.
    function base() {
        var forced = getSystemSetting( "BXRIG_MAIL_API", "" );
        return len( forced ) ? reReplace( forced, "/+$", "" ) : "http://127.0.0.1:" & uiPort();
    }

    // ---- HTTP to the catcher (curl) ----
    // method GET|POST|DELETE, path starts with /. Returns { ok, status, body }.
    function http( method, path, body = "" ) {
        var a = [ "-sS", "--max-time", "10", "-o", "-", "-w", chr( 10 ) & "%{http_code}", "-X", arguments.method, base() & arguments.path ];
        if ( len( arguments.body ) ) { a.append( "-H" ); a.append( "Content-Type: application/json" ); a.append( "-d" ); a.append( arguments.body ); }
        try {
            var r = systemExecute( "curl", a, 20, true );
            if ( r.exitCode != 0 ) return { ok: false, status: 0, body: r.output };
            var text = r.output;
            var nl = chr( 10 );
            var cut = len( text ) - len( listLast( text, nl ) );
            var status = int( val( listLast( text, nl ) ) );
            return { ok: status >= 200 && status < 300, status: status, body: cut > 1 ? left( text, cut - 1 ) : "" };
        } catch ( any e ) { return { ok: false, status: 0, body: e.message }; }
    }

    // The parsed JSON of a GET, or { ok:false } when the catcher does not answer.
    function getJson( path ) {
        var r = http( "GET", arguments.path );
        if ( !r.ok ) return { ok: false, status: r.status };
        try { return { ok: true, data: jsonDeserialize( r.body ) }; } catch ( any e ) { return { ok: false, status: r.status }; }
    }

    function notRunning( command, asJson ) {
        return fail( arguments.command, 4, "The mail catcher is not answering at " & base() & ". Start it with: bxrig mail start --yes", arguments.asJson );
    }

    // ---- reading messages (the Control Center page uses these too) ----
    function addr( a ) {
        if ( !isStruct( arguments.a ) ) return "";
        var n = arguments.a.Name ?: "";
        var m = arguments.a.Address ?: "";
        return len( n ) ? n & " <" & m & ">" : m;
    }

    function addrList( list ) {
        var out = [];
        if ( isArray( arguments.list ) ) for ( var x in arguments.list ) out.append( addr( x ) );
        return out;
    }

    // Rows [ { mid, sender, sender_address, recipient, subject_line, received, bytes, attachment_count, seen, preview } ] newest first, or { error } when the catcher is down.
    // (The names differ from the API's own On purpose: MatchBox keeps the capitalisation of the first spelling it sees, so `id` would come out as `ID`.)
    function messages( limit = 50 ) {
        var g = getJson( "/api/v1/messages?limit=" & int( val( arguments.limit ) ) );
        if ( !g.ok ) return { error: true };
        var out = [];
        var list = structKeyExists( g.data, "messages" ) && isArray( g.data.messages ) ? g.data.messages : [];
        for ( var m in list ) {
            var from = structKeyExists( m, "From" ) && isStruct( m.From ) ? m.From : {};
            var to = structKeyExists( m, "To" ) && isArray( m.To ) && m.To.len() ? m.To[ 1 ] : {};
            out.append( { mid: m.ID ?: "", sender: len( from.Name ?: "" ) ? from.Name : ( from.Address ?: "" ), sender_address: from.Address ?: "", recipient: to.Address ?: "", subject_line: m.Subject ?: "", received: replace( left( m.Created ?: "", 19 ), "T", " " ),
                          bytes: m.Size ?: 0, attachment_count: isNumeric( m.Attachments ?: 0 ) ? m.Attachments : 0, seen: m.Read ?: false, preview: m.Snippet ?: "" } );
        }
        return { total: g.data.total ?: out.len(), unread: g.data.unread ?: 0, messages: out };
    }

    // One message: { mid, sender, to_list, cc_list, bcc_list, subject_line, sent, body_text, body_html, files:[{file_name,type,bytes}] } or {} when there is no such message.
    function message( id ) {
        var g = getJson( "/api/v1/message/" & arguments.id );
        if ( !g.ok ) return {};
        var m = g.data;
        var atts = [];
        if ( structKeyExists( m, "Attachments" ) && isArray( m.Attachments ) ) for ( var a in m.Attachments ) atts.append( { file_name: a.FileName ?: "", type: a.ContentType ?: "", bytes: a.Size ?: 0 } );
        return { mid: m.ID ?: arguments.id, sender: addr( m.From ?: {} ), to_list: addrList( m.To ?: [] ), cc_list: addrList( m.Cc ?: [] ), bcc_list: addrList( m.Bcc ?: [] ), subject_line: m.Subject ?: "", sent: m.Date ?: "", body_text: m.Text ?: "", body_html: m.HTML ?: "", files: atts };
    }

    function validId( id ) { return reFind( "^[A-Za-z0-9_-]{4,64}$", arguments.id ) > 0; }
    function viewUrl( id ) { return base() & "/view/" & arguments.id & ".html"; }

    // ---- container verbs ----
    function validPort( p ) { return isNumeric( arguments.p ) && int( val( arguments.p ) ) == val( arguments.p ) && val( arguments.p ) >= 1024 && val( arguments.p ) <= 65535; }

    function runArgs( smtp, ui, keep ) {
        var a = [ "run", "-d", "--name", container(), "--label", "io.bxrig.mail=true" ];
        if ( arguments.keep ) { a.append( "--restart" ); a.append( "unless-stopped" ); a.append( "-v" ); a.append( dir() & ":/data:Z" ); a.append( "-e" ); a.append( "MP_DATABASE=/data/mailpit.db" ); }
        else a.append( "--rm" );
        for ( var e in [ "MP_SMTP_AUTH_ACCEPT_ANY=1", "MP_SMTP_AUTH_ALLOW_INSECURE=1", "MP_MAX_MESSAGES=5000" ] ) { a.append( "-e" ); a.append( e ); }
        a.append( "-p" ); a.append( "127.0.0.1:" & arguments.smtp & ":1025" );
        a.append( "-p" ); a.append( "127.0.0.1:" & arguments.ui & ":8025" );
        a.append( image() );
        return a;
    }

    function start( smtp, ui, keep, yes, dry, asJson ) {
        var cmd = "mail start";
        var sp = len( toString( arguments.smtp ) ) ? arguments.smtp : 1025;
        var up = len( toString( arguments.ui ) ) ? arguments.ui : 8025;
        if ( !validPort( sp ) || !validPort( up ) ) return fail( cmd, 4, "The ports must be whole numbers from 1024 to 65535", arguments.asJson );
        sp = int( val( sp ) ); up = int( val( up ) );
        if ( sp == up ) return fail( cmd, 4, "The SMTP port and the web port must differ", arguments.asJson );
        if ( !variables.db.engineAvailable() ) {
            var msg = variables.db.engineCli() & " is required but was not found" & ( variables.db.engineCli() == "podman" ? " (install it with: bxrig profile-install containers; or choose Docker with: bxrig db engine docker)" : "" );
            return fail( cmd, 4, msg, arguments.asJson );
        }
        var state = variables.db.stateOf( container() );
        var data = { container: container(), image: image(), smtp: "127.0.0.1:" & sp, web: "http://127.0.0.1:" & up, keep: arguments.keep };
        if ( state == "running" ) return say( cmd, 0, structAppendNew( data, { already: "running" } ), arguments.asJson, [ container() & " is already running: SMTP 127.0.0.1:" & smtpPort() & ", inbox http://127.0.0.1:" & uiPort() ] );
        var verb = len( state ) ? "start the stopped container " & container() & " (its mail is kept)" : "run " & image() & " as " & container() & ": SMTP 127.0.0.1:" & sp & ", web inbox http://127.0.0.1:" & up & ( arguments.keep ? ", inbox stored in " & dir() : ", mail thrown away when it stops" );
        if ( !arguments.yes || arguments.dry ) {
            var lines = [ ( arguments.dry ? "Dry run" : "Plan" ) & ": mail start", "  would " & verb, arguments.dry ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." ];
            return say( cmd, arguments.dry ? 0 : 2, structAppendNew( data, { would: verb } ), arguments.asJson, lines, arguments.dry );
        }
        if ( len( state ) ) {
            var s = variables.db.engineExec( [ "start", container() ], 120 );
            return say( cmd, s.exitCode == 0 ? 0 : 6, structAppendNew( data, { started: s.exitCode == 0 } ), arguments.asJson, [ s.exitCode == 0 ? "Started " & container() : "error: could not start " & container() & " " & trim( s.output ) ] );
        }
        if ( arguments.keep ) directoryCreate( dir(), true, true );
        var r = variables.db.engineExec( runArgs( sp, up, arguments.keep ), 1800 );
        if ( r.exitCode != 0 ) return say( cmd, 6, structAppendNew( data, { error: trim( r.output ) } ), arguments.asJson, [ "error: " & trim( r.output ) ] );
        directoryCreate( dir(), true, true );
        variables.config.writeAtomic( metaFile(), jsonSerialize( { smtp: sp, ui: up, keep: arguments.keep, image: image(), created: now() & "" } ) & chr( 10 ), "644" );
        return say( cmd, 0, data, arguments.asJson, [ "Mail catcher started.", "  SMTP:  127.0.0.1:" & sp & "  (no TLS, any login is accepted)", "  Inbox: http://127.0.0.1:" & up, arguments.keep ? "  Mail is kept in " & dir() & " between stops." : "  Mail is thrown away when it stops. Use --keep to keep it.", "Settings for your app: bxrig mail env" ] );
    }

    // A copy of base with the keys of extra added (the keys of extra win).
    function structAppendNew( base, extra ) {
        var out = {};
        for ( var k in structKeyArray( arguments.base ) ) out[ k ] = arguments.base[ k ];
        for ( var k2 in structKeyArray( arguments.extra ) ) out[ k2 ] = arguments.extra[ k2 ];
        return out;
    }

    function stop( asJson ) {
        var cmd = "mail stop";
        if ( !variables.db.engineAvailable() ) return fail( cmd, 4, variables.db.engineCli() & " was not found", arguments.asJson );
        var state = variables.db.stateOf( container() );
        if ( !len( state ) ) return fail( cmd, 4, container() & " does not exist (start it with: bxrig mail start --yes)", arguments.asJson );
        var keep = structKeyExists( meta(), "keep" ) ? meta().keep : false;
        var s = variables.db.engineExec( [ "stop", container() ], 120 );
        if ( s.exitCode != 0 ) return fail( cmd, 6, trim( s.output ), arguments.asJson );
        return say( cmd, 0, { container: container(), stopped: true, kept: keep }, arguments.asJson, [ "Stopped " & container() & ( keep ? ". Its mail is kept." : ". Its mail is gone." ) ] );
    }

    function status( asJson ) {
        var cmd = "mail status";
        var engineOk = variables.db.engineAvailable();
        var state = engineOk ? variables.db.stateOf( container() ) : "";
        var count = messages( 1 );
        var up = !structKeyExists( count, "error" );
        var data = { container: container(), state: len( state ) ? state : "none", engine: variables.db.engineCli(), smtp: "127.0.0.1:" & smtpPort(), web: base(), answering: up, total: up ? count.total : 0, unread: up ? count.unread : 0, keep: structKeyExists( meta(), "keep" ) ? meta().keep : false };
        var lines = [ container() & ": " & data.state, "  SMTP 127.0.0.1:" & smtpPort() & "   inbox " & base() ];
        if ( up ) lines.append( "  " & count.total & " messages, " & count.unread & " unread" );
        else lines.append( "  not answering" & ( data.state == "none" ? ". Start it with: bxrig mail start --yes" : "" ) );
        return say( cmd, 0, data, arguments.asJson, lines );
    }

    function remove( keepData, yes, dry, asJson ) {
        var cmd = "mail remove";
        if ( !variables.db.engineAvailable() ) return fail( cmd, 4, variables.db.engineCli() & " was not found", arguments.asJson );
        var has = variables.db.exists( container() );
        var hasFiles = directoryExists( dir() );
        if ( !has && !hasFiles ) return fail( cmd, 4, "There is nothing to remove for " & container(), arguments.asJson );
        var what = "remove the container " & container() & ( arguments.keepData ? " (the stored mail in " & dir() & " is KEPT)" : " AND DELETE the stored mail in " & dir() );
        if ( !arguments.yes || arguments.dry ) return say( cmd, arguments.dry ? 0 : 2, { container: container(), would: what, deletes_data: !arguments.keepData }, arguments.asJson, [ ( arguments.dry ? "Dry run" : "Plan" ) & ": would " & what, arguments.dry ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." ], arguments.dry );
        if ( has ) {
            var r = variables.db.engineExec( [ "rm", "-f", container() ], 120 );
            if ( r.exitCode != 0 ) return fail( cmd, 6, trim( r.output ), arguments.asJson );
        }
        if ( !arguments.keepData && hasFiles ) directoryDelete( dir(), true );
        return say( cmd, 0, { container: container(), removed: true, data_deleted: !arguments.keepData }, arguments.asJson, [ "Removed " & container() ] );
    }

    // ---- messages ----
    function list( limit, asJson ) {
        var cmd = "mail list";
        var lim = isNumeric( arguments.limit ) && val( arguments.limit ) > 0 ? int( val( arguments.limit ) ) : 50;
        var m = messages( lim );
        if ( structKeyExists( m, "error" ) ) return notRunning( cmd, arguments.asJson );
        var lines = [];
        for ( var x in m.messages ) lines.append( ( x.seen ? " " : "*" ) & " " & left( x.mid & "                      ", 23 ) & left( x.received & "    ", 20 ) & left( x.sender & repeatString( " ", 24 ), 24 ) & x.subject_line );
        if ( !m.messages.len() ) lines.append( "The inbox is empty. Point your app at 127.0.0.1:" & smtpPort() & " (settings: bxrig mail env)." );
        else lines.append( m.total & " messages, " & m.unread & " unread (* marks unread)" );
        return say( cmd, 0, m, arguments.asJson, lines );
    }

    function show( id, asJson ) {
        var cmd = "mail show";
        if ( !validId( arguments.id ) ) return say( cmd, 2, { error: "usage" }, arguments.asJson, [ "Usage: bxrig mail show ID   (the ID comes from: bxrig mail list)" ] );
        var probe = messages( 1 );
        if ( structKeyExists( probe, "error" ) ) return notRunning( cmd, arguments.asJson );
        var m = message( arguments.id );
        if ( !structCount( m ) ) return fail( cmd, 4, "There is no message " & arguments.id, arguments.asJson );
        var lines = [ "From:    " & m.sender, "To:      " & m.to_list.toList( ", " ) ];
        if ( m.cc_list.len() ) lines.append( "Cc:      " & m.cc_list.toList( ", " ) );
        lines.append( "Date:    " & m.sent );
        lines.append( "Subject: " & m.subject_line );
        for ( var a in m.files ) lines.append( "Attached: " & a.file_name & " (" & a.type & ", " & a.bytes & " bytes)" );
        lines.append( "" );
        if ( len( m.body_text ) ) for ( var l in listToArray( m.body_text, chr( 10 ), true ) ) lines.append( l );
        else lines.append( len( m.body_html ) ? "(no text part; it is HTML only. See it with: bxrig mail open " & arguments.id & ")" : "(empty body)" );
        return say( cmd, 0, m, arguments.asJson, lines );
    }

    function clear( yes, dry, asJson ) {
        var cmd = "mail clear";
        var m = messages( 1 );
        if ( structKeyExists( m, "error" ) ) return notRunning( cmd, arguments.asJson );
        var plan = [ ( arguments.dry ? "Dry run" : "Plan" ) & ": would delete all " & m.total & " messages in the inbox.", arguments.dry ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." ];
        if ( !arguments.yes || arguments.dry ) return say( cmd, arguments.dry ? 0 : 2, { would_delete: m.total }, arguments.asJson, plan, arguments.dry );
        var r = http( "DELETE", "/api/v1/messages" );
        if ( !r.ok ) return fail( cmd, 6, "The catcher refused the request (HTTP " & r.status & ")", arguments.asJson );
        return say( cmd, 0, { deleted: m.total }, arguments.asJson, [ "Deleted " & m.total & " messages." ] );
    }

    function deleteOne( id, yes, dry, asJson ) {
        var cmd = "mail delete";
        if ( !validId( arguments.id ) ) return say( cmd, 2, { error: "usage" }, arguments.asJson, [ "Usage: bxrig mail delete ID [--yes] [--dry-run]" ] );
        var m = message( arguments.id );
        if ( !structCount( m ) ) return structKeyExists( messages( 1 ), "error" ) ? notRunning( cmd, arguments.asJson ) : fail( cmd, 4, "There is no message " & arguments.id, arguments.asJson );
        var plan = [ ( arguments.dry ? "Dry run" : "Plan" ) & ": would delete the message " & chr( 34 ) & m.subject_line & chr( 34 ) & " from " & m.sender & ".", arguments.dry ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." ];
        if ( !arguments.yes || arguments.dry ) return say( cmd, arguments.dry ? 0 : 2, { mid: arguments.id, subject_line: m.subject_line }, arguments.asJson, plan, arguments.dry );
        if ( !deleteIds( [ arguments.id ] ) ) return fail( cmd, 6, "The catcher refused the request", arguments.asJson );
        return say( cmd, 0, { mid: arguments.id, deleted: true }, arguments.asJson, [ "Deleted the message." ] );
    }

    // Deletes the given message ids (the Control Center uses this). Returns true on success.
    function deleteIds( ids ) {
        return http( "DELETE", "/api/v1/messages", jsonSerialize( { IDs: arguments.ids } ) ).ok;
    }

    function openUi( id, asJson ) {
        var cmd = "mail open";
        if ( len( arguments.id ) && !validId( arguments.id ) ) return say( cmd, 2, { error: "usage" }, arguments.asJson, [ "Usage: bxrig mail open [ID]" ] );
        var url = len( arguments.id ) ? viewUrl( arguments.id ) : base();
        var code = 1;
        try { code = systemExecute( "xdg-open", [ url ], 10, true ).exitCode; } catch ( any e ) {}
        if ( code != 0 ) return say( cmd, 4, { url: url, error: "no browser launcher (xdg-open)" }, arguments.asJson, [ "error: could not run xdg-open. Open this address yourself:", url ] );
        return say( cmd, 0, { url: url }, arguments.asJson, [ "Opened " & url ] );
    }

    function test( to, subject, asJson ) {
        var cmd = "mail test";
        var probe = messages( 1 );
        if ( structKeyExists( probe, "error" ) ) return notRunning( cmd, arguments.asJson );
        var rcpt = len( arguments.to ) ? arguments.to : "you@example.test";
        var subj = len( arguments.subject ) ? arguments.subject : "Test mail from BxRig";
        var body = jsonSerialize( { From: { Email: "bxrig@localhost", Name: "BxRig" }, To: [ { Email: rcpt } ], Subject: subj, Text: "If you can read this in the inbox, your mail catcher works." & chr( 10 ) & "Point your app at 127.0.0.1:" & smtpPort() & "." } );
        var r = http( "POST", "/api/v1/send", body );
        if ( !r.ok ) return fail( cmd, 6, "The catcher refused the test message (HTTP " & r.status & ")", arguments.asJson );
        return say( cmd, 0, { recipient: rcpt, subject_line: subj }, arguments.asJson, [ "Sent a test message to " & rcpt & ". See it with: bxrig mail list" ] );
    }

    function envLines( asJson ) {
        var port = smtpPort();
        var settings = [
            { stack: "Generic", lines: [ "host: 127.0.0.1", "port: " & port, "encryption: none (no SSL, no TLS)", "login: not needed (any user and password is accepted)" ] },
            { stack: "BoxLang and ColdBox", lines: [ "In your mail settings use SMTP server 127.0.0.1, port " & port & ", no SSL or TLS, no username or password." ] },
            { stack: "Laravel (.env)", lines: [ "MAIL_MAILER=smtp", "MAIL_HOST=127.0.0.1", "MAIL_PORT=" & port, "MAIL_USERNAME=null", "MAIL_PASSWORD=null", "MAIL_ENCRYPTION=null" ] },
            { stack: "Spring Boot (application.properties)", lines: [ "spring.mail.host=127.0.0.1", "spring.mail.port=" & port ] },
            { stack: "Node (nodemailer)", lines: [ "{ host: '127.0.0.1', port: " & port & ", secure: false }" ] },
            { stack: "Environment variables", lines: [ "SMTP_HOST=127.0.0.1", "SMTP_PORT=" & port ] }
        ];
        var lines = [];
        for ( var s in settings ) { lines.append( s.stack ); for ( var l in s.lines ) lines.append( "  " & l ); }
        lines.append( "Inbox: " & base() );
        return say( "mail env", 0, { host: "127.0.0.1", port: port, web: base(), settings: settings }, arguments.asJson, lines );
    }

    function run( words, opts, yes, dry, asJson ) {
        var sub = arguments.words.len() ? arguments.words[ 1 ] : "status";
        var arg = arguments.words.len() >= 2 ? arguments.words[ 2 ] : "";
        var o = arguments.opts;
        if ( sub == "start" ) return start( o[ "smtp-port" ] ?: "", o[ "ui-port" ] ?: "", structKeyExists( o, "keep" ), arguments.yes, arguments.dry, arguments.asJson );
        if ( sub == "stop" ) return stop( arguments.asJson );
        if ( sub == "status" ) return status( arguments.asJson );
        if ( sub == "remove" ) return remove( structKeyExists( o, "keep-data" ), arguments.yes, arguments.dry, arguments.asJson );
        if ( sub == "list" ) return list( o.limit ?: "", arguments.asJson );
        if ( sub == "show" ) return show( arg, arguments.asJson );
        if ( sub == "clear" ) return clear( arguments.yes, arguments.dry, arguments.asJson );
        if ( sub == "delete" ) return deleteOne( arg, arguments.yes, arguments.dry, arguments.asJson );
        if ( sub == "open" ) return openUi( arg, arguments.asJson );
        if ( sub == "test" ) return test( o.to ?: "", o.subject ?: "", arguments.asJson );
        if ( sub == "env" ) return envLines( arguments.asJson );
        return say( "mail", 2, { error: "usage" }, arguments.asJson, [ "Usage: bxrig mail start [--keep] [--smtp-port=N] [--ui-port=N] | stop | status | remove [--keep-data] | list [--limit=N] | show ID | delete ID | clear | open [ID] | test [--to=ADDR] | env [--yes] [--dry-run] [--json]" ] );
    }
}
