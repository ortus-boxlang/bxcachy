// The model of the Control Center: which page is open, where the keys go, and the plan-then-confirm box. Pure, no drawing and no commands.
//   app = new bxrig.ControlCenterApp( pages, startId )   pages: classes with id() title() load() keys() paint() onKey() act() onScroll()
//   app.onKey( key ) / app.act( hit ) / app.onScroll( dir ) return an intent for the runner: {} or { action: "cli", title, args, confirmed }.
//   app.outcome() is "running", "quit", or "launch:NAME" (leave the Control Center and run that screen).
// Keys: Tab and Shift+Tab (or ] and [) change page; Left moves to the sidebar (Up and Down pick a page there), Right or Enter goes back to the page;
// q, Escape or Ctrl+c leave. A page gets every other key while the page has focus. A page intent of "goto" opens another page; "launch" leaves.
// The sidebar: \ and Ctrl+b collapse and expand it (while a page is taking text only Ctrl+b does); with it collapsed Left expands it again; a click on
// a "sidetoggle" region does the same. It opens as `sidebar` says: "" open (but collapsed on a narrow terminal), "on" open always, "off" collapsed.
// Nothing about it is remembered.
class ControlCenterApp {
    function init( pages, startId = "", sidebar = "" ) {
        variables.pages = arguments.pages;
        variables.idx = 1;
        for ( var i = 1; i <= variables.pages.len(); i++ ) if ( variables.pages[ i ].id() == arguments.startId ) variables.idx = i;
        variables.focus = "page";
        variables.outcome = "running";
        variables.modal = {};
        variables.mode = "main";
        variables.message = "";
        variables.ask = {};
        variables.loaded = {};
        variables.sidebar = arguments.sidebar != "off";
        variables.forced = arguments.sidebar == "on";
        variables.toggled = arguments.sidebar == "off";
        variables.narrow = false;
        ensureLoaded();
        return this;
    }

    // ---- the sidebar ----
    // The view tells the app how wide the terminal is; below 90 columns the sidebar starts collapsed unless it was asked for or toggled.
    function noteWidth( width ) { variables.narrow = arguments.width < 90; }
    function sidebarOpen() { return ( variables.toggled || variables.forced ) ? variables.sidebar : ( variables.sidebar && !variables.narrow ); }
    function toggleSidebar() {
        variables.sidebar = !sidebarOpen();
        variables.toggled = true;
        if ( !variables.sidebar ) variables.focus = "page";
        return this;
    }

    function outcome() { return variables.outcome; }
    function pageList() { return variables.pages; }
    function index() { return variables.idx; }
    function page() { return variables.pages[ variables.idx ]; }
    function focus() { return variables.focus; }
    function mode() { return variables.mode; }
    function modal() { return variables.modal; }
    function message() { return variables.message; }
    function ask() { return variables.ask; }

    function ensureLoaded() {
        var id = page().id();
        if ( !structKeyExists( variables.loaded, id ) ) { page().load(); variables.loaded[ id ] = true; }
    }

    function goto( id ) {
        for ( var i = 1; i <= variables.pages.len(); i++ ) if ( variables.pages[ i ].id() == arguments.id ) { variables.idx = i; ensureLoaded(); return true; }
        return false;
    }

    function step( d ) {
        var n = variables.pages.len();
        variables.idx = ( ( variables.idx - 1 + arguments.d + n ) mod n ) + 1;
        ensureLoaded();
    }

    // The runner shows the plan of a command and later its result here.
    function showPlan( title, lines, intent ) { variables.modal = { title: arguments.title, lines: arguments.lines, intent: arguments.intent }; variables.mode = "confirm"; }
    function showResult( title, lines ) { variables.modal = { title: arguments.title, lines: arguments.lines }; variables.mode = "result"; page().load(); }

    function handleIntent( it ) {
        if ( !structCount( arguments.it ) ) return {};
        if ( arguments.it.action == "goto" ) { goto( arguments.it.page ); return {}; }
        if ( arguments.it.action == "reload" ) { page().load(); return {}; }
        if ( arguments.it.action == "ask" ) { variables.ask = { title: arguments.it.title, prompt: arguments.it.prompt, make: arguments.it.make, input: "" }; variables.mode = "ask"; return {}; }
        if ( arguments.it.action == "launch" ) { variables.outcome = "launch:" & arguments.it.target; return {}; }
        return arguments.it;
    }

    function onKey( key ) {
        var k = arguments.key;
        if ( k == "Ctrl+c" ) { variables.outcome = "quit"; return {}; }
        variables.message = "";
        if ( variables.mode == "result" ) { variables.mode = "main"; return {}; }
        if ( variables.mode == "ask" ) {
            if ( k == "Escape" ) { variables.mode = "main"; return {}; }
            if ( k == "Enter" ) {
                var v = trim( variables.ask.input );
                variables.mode = "main";
                return len( v ) ? variables.ask.make( v ) : {};
            }
            if ( k == "Backspace" ) { variables.ask.input = len( variables.ask.input ) ? left( variables.ask.input, len( variables.ask.input ) - 1 ) : ""; return {}; }
            if ( k == "Space" ) variables.ask.input &= " ";
            else if ( len( k ) == 1 ) variables.ask.input &= k;
            return {};
        }
        if ( variables.mode == "confirm" ) {
            if ( k == "y" || k == "Y" || k == "Enter" ) { var it = variables.modal.intent; it.confirmed = true; variables.mode = "main"; return it; }
            if ( k == "n" || k == "N" || k == "Escape" || k == "q" ) variables.mode = "main";
            return {};
        }
        if ( k == "Ctrl+b" ) { toggleSidebar(); return {}; }
        if ( compare( k, chr( 92 ) ) == 0 && !pageCaptures() ) { toggleSidebar(); return {}; }
        if ( k == "Tab" || k == "]" ) { step( 1 ); return {}; }
        if ( k == "Shift+Tab" || k == "BackTab" || k == "[" ) { step( -1 ); return {}; }
        if ( variables.focus == "sidebar" && sidebarOpen() ) {
            if ( k == "Up" || compare( k, "k" ) == 0 ) { step( -1 ); return {}; }
            if ( k == "Down" || compare( k, "j" ) == 0 ) { step( 1 ); return {}; }
            if ( k == "Right" || k == "Enter" || compare( k, "l" ) == 0 ) { variables.focus = "page"; return {}; }
            if ( compare( k, "q" ) == 0 || k == "Escape" ) { variables.outcome = "quit"; return {}; }
            return {};
        }
        if ( pageCaptures() ) return handleIntent( page().onKey( k ) );
        if ( k == "Left" ) { if ( sidebarOpen() ) variables.focus = "sidebar"; else toggleSidebar(); return {}; }
        if ( compare( k, "q" ) == 0 || k == "Escape" ) { variables.outcome = "quit"; return {}; }
        return handleIntent( page().onKey( k ) );
    }

    // A page that is taking text (a filter or a search) gets every key, q and Escape included.
    function pageCaptures() { return page().usesLeft(); }

    function act( hit ) {
        var h = arguments.hit;
        if ( variables.mode == "confirm" ) {
            if ( h.kind == "yes" ) return onKey( "y" );
            if ( h.kind == "no" ) return onKey( "n" );
            return {};
        }
        if ( variables.mode == "result" ) { variables.mode = "main"; return {}; }
        if ( variables.mode == "ask" ) { if ( h.kind == "askok" ) return onKey( "Enter" ); if ( h.kind == "askno" ) return onKey( "Escape" ); return {}; }
        if ( h.kind == "sidetoggle" ) { toggleSidebar(); return {}; }
        if ( h.kind == "nav" ) { variables.idx = h.n; variables.focus = "page"; ensureLoaded(); return {}; }
        return handleIntent( page().act( h ) );
    }

    function onScroll( dir ) {
        if ( variables.mode != "main" ) return {};
        return handleIntent( page().onScroll( arguments.dir ) );
    }
}
