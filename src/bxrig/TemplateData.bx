            case "shell.zsh":
                return '## BxRig shell setup for zsh (managed by `bxrig setup shell`; your own settings belong in ~/.zshrc).
## Plugins come from pacman (zsh-autosuggestions, zsh-syntax-highlighting, zsh-completions), not from a plugin manager.
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY AUTO_CD INTERACTIVE_COMMENTS

autoload -Uz compinit && compinit
zstyle '':completion:*'' menu select
zstyle '':completion:*'' matcher-list ''m:{a-z}={A-Za-z}''

[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
command -v fzf >/dev/null && source <(fzf --zsh)
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
## syntax highlighting must be loaded after everything that binds keys or widgets
[[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
## Starship prompt (the same prompt in every shell; config: ~/.config/starship.toml)
command -v starship >/dev/null && eval "$(starship init zsh)"
## API keys: per-command loaders written by `bxrig secrets` (no values in this file)
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/bxrig/secrets.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/bxrig/secrets.sh"
## Java: the default home chosen with `bxrig java default` (no file, no change)
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/bxrig/java.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/bxrig/java.sh"
## Maven and Gradle from SDKMAN, set by `bxrig sdk` (no file, no change)
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/bxrig/sdk.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/bxrig/sdk.sh"' & chr( 10 );
            case "shell.bash":
                return '## BxRig shell setup for bash (managed by `bxrig setup shell`; your own settings belong in ~/.bashrc).
HISTSIZE=50000
HISTFILESIZE=50000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize autocd 2>/dev/null

[[ -r /usr/share/bash-completion/bash_completion ]] && source /usr/share/bash-completion/bash_completion
command -v fzf >/dev/null && eval "$(fzf --bash)"
command -v zoxide >/dev/null && eval "$(zoxide init bash)"
## Starship prompt (the same prompt in every shell; config: ~/.config/starship.toml)
command -v starship >/dev/null && eval "$(starship init bash)"
## API keys: per-command loaders written by `bxrig secrets` (no values in this file)
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/bxrig/secrets.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/bxrig/secrets.sh"
## Java: the default home chosen with `bxrig java default` (no file, no change)
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/bxrig/java.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/bxrig/java.sh"
## Maven and Gradle from SDKMAN, set by `bxrig sdk` (no file, no change)
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/bxrig/sdk.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/bxrig/sdk.sh"' & chr( 10 );
            case "shell.fish":
                return '## BxRig shell setup for fish (managed by `bxrig setup shell`; your own settings belong in ~/.config/fish/config.fish).
## Fish has autosuggestions, syntax highlighting and completions built in.
if status is-interactive
    command -q fzf; and fzf --fish | source
    command -q zoxide; and zoxide init fish | source
    ## Starship prompt (the same prompt in every shell; config: ~/.config/starship.toml)
    command -q starship; and starship init fish | source
end
## API keys: per-command loaders written by `bxrig secrets` (no values in this file)
set -l bxc_cfg $HOME/.config; set -q XDG_CONFIG_HOME; and set bxc_cfg $XDG_CONFIG_HOME
test -r "$bxc_cfg/bxrig/secrets.fish"; and source "$bxc_cfg/bxrig/secrets.fish"
test -r "$bxc_cfg/bxrig/java.fish"; and source "$bxc_cfg/bxrig/java.fish"
test -r "$bxc_cfg/bxrig/sdk.fish"; and source "$bxc_cfg/bxrig/sdk.fish"' & chr( 10 );
            case "nvim/lua/config/bxrig.lua":
                return '-- Written by bxrig (editor lazyvim). Loaded from options.lua. Rewritten by `bxrig editor refresh`; keep your own changes in options.lua.
vim.opt.relativenumber = false
vim.g.autoformat = false

-- Over SSH, yank and paste through the terminal (OSC 52, :help clipboard-osc52). Inside tmux add
--   set -as terminal-features ",*:clipboard"
-- to your tmux.conf so tmux passes it on.
if vim.env.SSH_TTY or vim.env.SSH_CONNECTION then
  local ok, osc52 = pcall(require, "vim.ui.clipboard.osc52")
  if ok then
    vim.g.clipboard = {
      name = "OSC 52",
      copy = { ["+"] = osc52.copy("+"), ["*"] = osc52.copy("*") },
      paste = { ["+"] = osc52.paste("+"), ["*"] = osc52.paste("*") },
    }
  end
end' & chr( 10 );
            case "nvim/lua/plugins/bxrig.lua":
                return '-- Written by bxrig (editor lazyvim). Rewritten by `bxrig editor refresh`; add your own plugins in other files.
return {
  -- no news popups on startup
  { "LazyVim/LazyVim", opts = { news = { lazyvim = false, neovim = false } } },
  -- no scroll animation
  { "folke/snacks.nvim", opts = { scroll = { enabled = false } } },
  -- let the status line show the terminal background: lualine''s auto theme paints its middle sections a solid colour,
  -- so they are cleared on every theme it builds (it builds again on each colourscheme change)
  {
    "nvim-lualine/lualine.nvim",
    opts = function(_, opts)
      opts.options = opts.options or {}
      opts.options.theme = function()
        local theme = require("lualine.utils.loader").load_theme("auto")
        for _, mode in pairs(theme) do
          for _, section in ipairs({ "b", "c" }) do
            if mode[section] then mode[section].bg = "None" end
          end
        end
        return theme
      end
    end,
  },
}' & chr( 10 );
            case "nvim/lua/plugins/boxlang.lua":
                return '-- BoxLang syntax highlighting (.bx, .bxs = boxlang, .bxm = boxlangTemplate): https://github.com/ortus-boxlang/vim-boxlang
-- Loaded at startup (not by filetype) so its ftdetect runs before the first buffer is read.
return {
  { "ortus-boxlang/vim-boxlang", lazy = false },
}' & chr( 10 );
            case "nvim/lua/plugins/bxrig-themes.lua":
                return '-- Written by bxrig (editor lazyvim). Every theme''s colourscheme plugin is listed (lazy, not loaded) so `bxrig theme set` never has to
-- clone anything while you work: the specs come from the theme files `bxrig theme` keeps in ~/.config/bxrig/nvim-themes/.
local dir = (os.getenv("BXRIG_CONFIG_HOME") or ((os.getenv("HOME") or "") .. "/.config")) .. "/bxrig/nvim-themes"
local specs = {}
for _, file in ipairs(vim.fn.glob(dir .. "/*.lua", false, true)) do
  local ok, theme = pcall(dofile, file)
  if ok and type(theme) == "table" then
    for _, spec in ipairs(theme) do
      if type(spec) == "table" and spec[1] ~= "LazyVim/LazyVim" then
        local lazy_spec = vim.deepcopy(spec)
        lazy_spec.lazy = true
        table.insert(specs, lazy_spec)
      end
    end
  end
end
return specs' & chr( 10 );
            case "nvim/lua/plugins/bxrig-theme-reload.lua":
                return '-- Written by bxrig (editor lazyvim). Applies a theme change live: `bxrig theme set` rewrites the file lua/plugins/theme.lua links to,
-- this watches its folder and re-applies the colourscheme it names (no restart).
return {
  {
    name = "bxrig-theme-reload",
    dir = vim.fn.stdpath("config"),
    lazy = false,
    priority = 1000,
    config = function()
      local link = vim.fn.stdpath("config") .. "/lua/plugins/theme.lua"
      local target = vim.fn.resolve(link)
      if target == link or vim.fn.filereadable(target) == 0 then return end

      local function colorscheme()
        local ok, spec = pcall(dofile, link)
        if not ok or type(spec) ~= "table" then return nil end
        for _, entry in ipairs(spec) do
          if entry[1] == "LazyVim/LazyVim" and entry.opts and entry.opts.colorscheme then return entry.opts.colorscheme end
        end
      end

      local function apply()
        local name = colorscheme()
        if not name then return end
        vim.schedule(function()
          vim.cmd("highlight clear")
          if vim.fn.exists("syntax_on") == 1 then vim.cmd("syntax reset") end
          pcall(vim.cmd.colorscheme, name)
        end)
      end

      local watcher = (vim.uv or vim.loop).new_fs_event()
      local pending = false
      watcher:start(vim.fn.fnamemodify(target, ":h"), {}, function()
        if pending then return end
        pending = true
        vim.defer_fn(function()
          pending = false
          apply()
        end, 150)
      end)
    end,
  },
}' & chr( 10 );
            case "nvim/plugin/after/bxrig-transparency.lua":
                return '-- Written by bxrig (editor lazyvim). Makes the editor show the terminal background: the background of these highlight groups is
-- cleared (their other attributes stay), at startup and again after every colourscheme change.
local groups = {
  "Normal", "NormalNC", "NormalFloat", "FloatBorder", "Pmenu", "Terminal", "EndOfBuffer", "FoldColumn", "Folded",
  "SignColumn", "LineNr", "CursorLineNr", "StatusLine", "StatusLineNC", "WhichKeyFloat",
  "TelescopeBorder", "TelescopeNormal", "TelescopePromptBorder", "TelescopePromptTitle",
  "NeoTreeNormal", "NeoTreeNormalNC", "NeoTreeVertSplit", "NeoTreeWinSeparator", "NeoTreeEndOfBuffer",
  "NvimTreeNormal", "NvimTreeVertSplit", "NvimTreeEndOfBuffer",
  "NotifyINFOBody", "NotifyERRORBody", "NotifyWARNBody", "NotifyTRACEBody", "NotifyDEBUGBody",
  "NotifyINFOTitle", "NotifyERRORTitle", "NotifyWARNTitle", "NotifyTRACETitle", "NotifyDEBUGTitle",
  "SnacksNormal", "SnacksNormalNC", "SnacksPicter", "SnacksPickerBorder",
}

local function make_transparent(name)
  local ok, hl = pcall(vim.api.nvim_get_hl, 0, { name = name, link = false })
  if ok then
    hl.bg = nil
    vim.api.nvim_set_hl(0, name, hl)
  end
end

local function apply()
  for _, name in ipairs(groups) do make_transparent(name) end
end

apply()
vim.api.nvim_create_autocmd("ColorScheme", { group = vim.api.nvim_create_augroup("bxrig_transparency", { clear = true }), callback = apply })' & chr( 10 );
            case "nvm.json":
                return '{"version":"v0.41.0","installer":"https://raw.githubusercontent.com/nvm-sh/nvm/v0.41.0/install.sh","node":"lts/*"}';
        }
        return "";
    }
}
