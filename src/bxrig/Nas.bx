// `bxrig nas ...`: your NAS boxes as first-class citizens: connection details, shares, mounts (also automatic) and backup targets.
//   nas setup [--yes]                              install the tools (cifs-utils, nfs-utils, smbclient, avahi, nss-mdns, rsync) and start avahi
//   nas discover [--json]                          find NAS boxes announcing SMB or NFS on the network (avahi)
//   nas add NAME --host=H [--protocol=smb|nfs] [--user=U] [--vers=3.1.1] [--ask-password | --password-file=F]
//   nas list | show NAME | remove NAME [--yes]
//   nas shares NAME                                the shares (SMB) or exports (NFS) the NAS offers
//   nas mount NAME SHARE [--yes] | unmount NAME SHARE [--yes]     a mount now, at ~/NAS/NAME/SHARE
//   nas auto on|off NAME SHARE [--yes]             mount automatically on first use (systemd .automount; a sleeping NAS never blocks login)
//   nas test NAME [SHARE]                          reachable, signed in, mounted, writable, free space
//   nas sync NAME SRC --to=SHARE[/PATH] [--delete] [--yes]   a plain mirror of a folder with rsync (nothing is deleted unless --delete)
//   nas use NAME SHARE [--path=bxrig-backup]     make a share a backup target (see `backup data setup`)
// Passwords: kept in the keyring (`bxrig secrets`, key BXRIG_NAS_<NAME>_PASSWORD). SMB mounts at boot need a root-only credentials file
// (/etc/bxrig/nas/NAME.cred, mode 600), because mount.cifs reads it as root; the plan says so. The SMB version is negotiated (the highest
// the NAS and the kernel share) unless you give --vers. NFS needs no password. Mounts are yours (uid and gid) with private modes.
// Test overrides: BXRIG_NAS_CRED_DIR, BXRIG_SYSTEMD_DIR, BXRIG_NAS_HOME, BXRIG_NAS_REACH (yes or no: skip the network probe).
// Exit: 0 ok, 2 bad usage or a plan without --yes, 4 precondition (no such NAS, missing tool, unreachable), 6 a command failed.
class Nas {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxrig.Installer( arguments.runner );
        variables.cfgSvc = new bxrig.ConfigService().quiet( true );
        return this;
    }

    function env( name, fallback ) {
        var v = getSystemSetting( arguments.name, "" );
        return len( v ) ? v : arguments.fallback;
    }

    function tryExec( argv, timeout = 30 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function has( name ) { return tryExec( [ "sh", "-c", 'command -v "$1"', "_", arguments.name ], 10 ).exitCode == 0; }
    function say( code, data, asJson, lines = [], dry = false ) {
        if ( arguments.asJson ) println( variables.cli.envelope( "nas", arguments.code, arguments.data, arguments.dry ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }
    function fail( code, msg, asJson ) { return say( arguments.code, { error: arguments.msg }, arguments.asJson, [ "error: " & arguments.msg ] ); }

    function home() { return getSystemSetting( "HOME", "" ); }
    function cfg() { return variables.cfgSvc.cfgHome(); }
    function nasFile() { return cfg() & "/bxrig/nas.json"; }
    function backupFile() { return cfg() & "/bxrig/backup.json"; }
    function credDir() { return env( "BXRIG_NAS_CRED_DIR", "/etc/bxrig/nas" ); }
    function unitDir() { return env( "BXRIG_SYSTEMD_DIR", "/etc/systemd/system" ); }
    function nasHome() { return env( "BXRIG_NAS_HOME", home() & "/NAS" ); }
    function credFile( name ) { return credDir() & "/" & arguments.name & ".cred"; }
    function secretKey( name ) { return "BXRIG_NAS_" & uCase( replace( arguments.name, "-", "_", "all" ) ) & "_PASSWORD"; }
    function secrets() { return new bxrig.Secrets( variables.cli ); }
    function validName( n ) { return reFind( "^[a-z][a-z0-9-]{0,30}$", arguments.n ) > 0; }
    function validHost( h ) { return reFind( "^[A-Za-z0-9]([A-Za-z0-9.:-]*[A-Za-z0-9])?$", arguments.h ) > 0; }
    function validShare( s ) { return reFind( "^/?[A-Za-z0-9][A-Za-z0-9 ._$/-]{0,100}$", arguments.s ) > 0 && find( "..", arguments.s ) == 0; }
    function validUser( u ) { return reFind( "^[A-Za-z0-9._@-]{1,64}$", arguments.u ) > 0; }

    // ---- state ----
    function read() {
        var s = { nas: {} };
        if ( fileExists( nasFile() ) ) { try { var j = jsonDeserialize( fileRead( nasFile() ) ); if ( structKeyExists( j, "nas" ) ) s.nas = j.nas; } catch ( any e ) {} }
        return s;
    }

    function write( s ) {
        directoryCreate( getDirectoryFromPath( nasFile() ), true, true );
        fileWrite( nasFile(), jsonSerialize( arguments.s ) & chr( 10 ) );
    }

    function get( name ) {
        var s = read();
        return structKeyExists( s.nas, arguments.name ) ? s.nas[ arguments.name ] : {};
    }

    function mountPoint( name, share ) {
        var leaf = listLast( arguments.share, "/" );
        return nasHome() & "/" & arguments.name & "/" & leaf;
    }

    // A plan without --yes, else the commands in order. cmds: [ argv ].
    function finish( title, shown, cmds, yes, dry, asJson, data = {} ) {
        var d = arguments.data;
        d.commands = arguments.cmds.map( function( c ) { return c.toList( " " ); } );
        if ( !arguments.yes || arguments.dry ) {
            var lines = [ ( arguments.dry ? "Dry run: " : "Plan: " ) & arguments.title ];
            for ( var s in arguments.shown ) lines.append( "  " & s );
            for ( var c in arguments.cmds ) lines.append( "  " & c.toList( " " ) );
            lines.append( arguments.dry ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." );
            return say( arguments.dry ? 0 : 2, d, arguments.asJson, lines, arguments.dry );
        }
        for ( var x in arguments.cmds ) {
            var r = tryExec( x, 600 );
            if ( r.exitCode != 0 ) return say( 6, { error: trim( r.output ), step: x.toList( " " ) }, arguments.asJson, [ "error: " & x.toList( " " ) & ": " & trim( r.output ) ] );
        }
        return say( 0, d, arguments.asJson, [ arguments.title & ": done" ] );
    }

    // A private temp file holding text (mode 600). Returns its path.
    function privateTemp( text ) {
        var f = getTempDirectory() & "/bxrig-nas-" & createUUID();
        tryExec( [ "sh", "-c", 'umask 077; : > "$1"', "_", f ], 10 );
        fileWrite( f, arguments.text );
        return f;
    }

    // ---- setup and discovery ----
    function setupCmd( yes, dry, asJson ) {
        var cmds = [ [ "sudo", "pacman", "-S", "--needed", "--noconfirm", "cifs-utils", "nfs-utils", "smbclient", "avahi", "nss-mdns", "rsync" ], [ "sudo", "systemctl", "enable", "--now", "avahi-daemon.service" ] ];
        return finish( "install the NAS tools and start avahi (so names like synology.local resolve; add mdns_minimal to the hosts line of /etc/nsswitch.conf if they do not)", [], cmds, arguments.yes, arguments.dry, arguments.asJson );
    }

    function discoverCmd( asJson ) {
        if ( !has( "avahi-browse" ) ) return fail( 4, "avahi-browse was not found (bxrig nas setup --yes)", arguments.asJson );
        var found = {};
        var out = [];
        for ( var svc in [ "_smb._tcp", "_nfs._tcp" ] ) {
            var r = tryExec( [ "avahi-browse", "-rtp", svc ], 20 );
            if ( r.exitCode != 0 ) continue;
            for ( var line in listToArray( r.output, chr( 10 ) ) ) {
                var f = listToArray( line, ";", true );
                if ( f.len() < 9 || f[ 1 ] != "=" || f[ 3 ] != "IPv4" ) continue;
                var key = f[ 8 ];
                var proto = svc == "_smb._tcp" ? "smb" : "nfs";
                if ( !structKeyExists( found, key ) ) { found[ key ] = { name: f[ 4 ], host: f[ 7 ], address: f[ 8 ], protocols: [] }; out.append( found[ key ] ); }
                if ( !arrayFind( found[ key ].protocols, proto ) ) found[ key ].protocols.append( proto );
            }
        }
        var lines = out.len() ? out.map( function( n ) { return n.name & "   " & n.host & "   " & n.address & "   " & n.protocols.toList( "," ); } ) : [ "No NAS found on the network. Add one by address: bxrig nas add NAME --host=IP" ];
        return say( 0, { nas: out }, arguments.asJson, lines );
    }

    // ---- records ----
    function addCmd( name, opts, yes, dry, asJson ) {
        if ( !validName( arguments.name ) ) return fail( 2, "NAME is lower case letters, digits and dashes, starting with a letter (for example synology)", arguments.asJson );
        var host = arguments.opts.host ?: "";
        var proto = lCase( arguments.opts.protocol ?: "smb" );
        var user = arguments.opts.user ?: "";
        var vers = arguments.opts.vers ?: "";
        if ( !validHost( host ) ) return fail( 2, "--host is required (a name or an IP address, for example synology.local or 192.168.1.20)", arguments.asJson );
        if ( !arrayFind( [ "smb", "nfs" ], proto ) ) return fail( 2, "--protocol is smb or nfs (for SFTP, FTP and the cloud see backup data setup)", arguments.asJson );
        if ( proto == "smb" && !len( user ) ) return fail( 2, "SMB needs --user", arguments.asJson );
        if ( len( user ) && !validUser( user ) ) return fail( 2, "that user name has characters a mount cannot take", arguments.asJson );
        if ( len( vers ) && !reFind( "^[0-9](\.[0-9](\.[0-9])?)?$", vers ) ) return fail( 2, "--vers looks like 3, 3.0 or 3.1.1", arguments.asJson );
        var s = read();
        var rec = structKeyExists( s.nas, arguments.name ) ? s.nas[ arguments.name ] : { shares: {} };
        rec.host = host; rec.protocol = proto; rec.user = user; rec.vers = vers;
        if ( !structKeyExists( rec, "shares" ) ) rec.shares = {};
        var pw = "";
        if ( proto == "smb" ) {
            if ( structKeyExists( arguments.opts, "password-file" ) ) { pw = fileExists( arguments.opts[ "password-file" ] ) ? reReplace( fileRead( arguments.opts[ "password-file" ] ), "[\r\n]+$", "" ) : ""; }
            else if ( structKeyExists( arguments.opts, "ask-password" ) ) pw = secrets().ask( "Password for " & user & "@" & host & ": " );
            if ( !len( pw ) && !len( secrets().fetch( secretKey( arguments.name ) ) ) ) return fail( 2, "SMB needs a password: add --ask-password (typed hidden) or --password-file=FILE", arguments.asJson );
        }
        var d = { name: arguments.name, host: host, protocol: proto, user: user, vers: vers, password_key: proto == "smb" ? secretKey( arguments.name ) : "" };
        if ( arguments.dry ) return say( 0, d, arguments.asJson, [ "Dry run: would save the NAS " & arguments.name & " (" & proto & "://" & host & ")" ], true );
        if ( len( pw ) ) { var err = secrets().store( secretKey( arguments.name ), pw ); if ( len( err ) ) return fail( 6, "could not store the password: " & err, arguments.asJson ); }
        s.nas[ arguments.name ] = rec;
        write( s );
        return say( 0, d, arguments.asJson, [ "Saved " & arguments.name & " (" & proto & "://" & host & ")." & ( proto == "smb" ? " The password is in your keyring." : "" ), "Next: bxrig nas shares " & arguments.name ] );
    }

    function listCmd( asJson ) {
        var s = read();
        var rows = [];
        for ( var n in structKeyArray( s.nas ) ) { var r = s.nas[ n ]; rows.append( { name: n, host: r.host, protocol: r.protocol, user: r.user ?: "", shares: structKeyArray( r.shares ?: {} ) } ); }
        arraySort( rows, function( a, b ) { return compare( a.name, b.name ); } );
        return say( 0, { nas: rows }, arguments.asJson, rows.len() ? rows.map( function( r ) { return r.name & "   " & r.protocol & "://" & r.host & ( len( r.user ) ? "   " & r.user : "" ) & "   shares: " & ( r.shares.len() ? r.shares.toList( ", " ) : "none yet" ); } ) : [ "No NAS yet. Find one: bxrig nas discover" ] );
    }

    function showCmd( name, asJson ) {
        var r = get( arguments.name );
        if ( structIsEmpty( r ) ) return fail( 4, "no NAS called " & arguments.name & " (bxrig nas list)", arguments.asJson );
        var lines = [ arguments.name & ": " & r.protocol & "://" & r.host & ( len( r.user ?: "" ) ? "   user " & r.user : "" ) & ( len( r.vers ?: "" ) ? "   version " & r.vers : "   version negotiated" ) ];
        for ( var sh in structKeyArray( r.shares ?: {} ) ) lines.append( "  " & sh & " -> " & r.shares[ sh ].mountpoint & ( ( r.shares[ sh ].auto ?: false ) ? "   automatic" : "" ) );
        return say( 0, { name: arguments.name, nas: r }, arguments.asJson, lines );
    }

    function removeCmd( name, yes, dry, asJson ) {
        var r = get( arguments.name );
        if ( structIsEmpty( r ) ) return fail( 4, "no NAS called " & arguments.name, arguments.asJson );
        var mounted = structKeyArray( r.shares ?: {} ).filter( function( sh ) { return r.shares[ sh ].auto ?: false; } );
        if ( mounted.len() ) return fail( 4, "turn the automatic mounts off first: " & mounted.map( function( sh ) { return "bxrig nas auto off " & name & " " & sh; } ).toList( "; " ), arguments.asJson );
        if ( !arguments.yes || arguments.dry ) return say( arguments.dry ? 0 : 2, { name: arguments.name }, arguments.asJson, [ ( arguments.dry ? "Dry run: " : "Plan: " ) & "forget the NAS " & arguments.name & " and its stored password (the files on the NAS are not touched)", "Nothing was changed." & ( arguments.dry ? "" : " Add --yes to apply." ) ], arguments.dry );
        var s = read();
        structDelete( s.nas, arguments.name );
        write( s );
        secrets().drop( secretKey( arguments.name ) );
        return say( 0, { name: arguments.name, removed: true }, arguments.asJson, [ "Forgot " & arguments.name & "." ] );
    }

    // ---- shares ----
    function sharesCmd( name, asJson ) {
        var r = get( arguments.name );
        if ( structIsEmpty( r ) ) return fail( 4, "no NAS called " & arguments.name & " (bxrig nas list)", arguments.asJson );
        var shares = [];
        if ( r.protocol == "nfs" ) {
            if ( !has( "showmount" ) ) return fail( 4, "showmount was not found (bxrig nas setup --yes)", arguments.asJson );
            var nr = tryExec( [ "showmount", "-e", "--no-headers", r.host ], 20 );
            if ( nr.exitCode != 0 ) return fail( 4, "could not read the exports of " & r.host & ": " & trim( nr.output ), arguments.asJson );
            for ( var line in listToArray( trim( nr.output ), chr( 10 ) ) ) { var t = trim( line ); if ( len( t ) ) shares.append( { name: listFirst( t, " " & chr( 9 ) ), kind: "export" } ); }
        } else {
            if ( !has( "smbclient" ) ) return fail( 4, "smbclient was not found (bxrig nas setup --yes)", arguments.asJson );
            var pw = secrets().fetch( secretKey( arguments.name ) );
            var auth = privateTemp( "username = " & r.user & chr( 10 ) & "password = " & pw & chr( 10 ) );
            var sr = tryExec( [ "smbclient", "-g", "-L", r.host, "-A", auth ], 30 );
            try { fileDelete( auth ); } catch ( any e ) {}
            if ( sr.exitCode != 0 ) return fail( 4, "could not list the shares of " & r.host & " (wrong password or SMB turned off?): " & trim( listFirst( sr.output, chr( 10 ) ) ), arguments.asJson );
            for ( var ln in listToArray( sr.output, chr( 10 ) ) ) {
                var p = listToArray( ln, "|", true );
                if ( p.len() >= 2 && p[ 1 ] == "Disk" && !reFind( "\$$", p[ 2 ] ) ) shares.append( { name: p[ 2 ], kind: "share", comment: p.len() > 2 ? p[ 3 ] : "" } );
            }
        }
        var lines = shares.len() ? shares.map( function( x ) { return x.name & ( len( x.comment ?: "" ) ? "   " & x.comment : "" ); } ) : [ "No shares found." ];
        return say( 0, { name: arguments.name, shares: shares }, arguments.asJson, lines );
    }

    // ---- mounts ----
    function mountOptions( rec, name ) {
        var uid = trim( tryExec( [ "id", "-u" ], 5 ).output );
        var gid = trim( tryExec( [ "id", "-g" ], 5 ).output );
        if ( rec.protocol == "smb" ) {
            var o = "credentials=" & credFile( arguments.name ) & ",uid=" & uid & ",gid=" & gid & ",iocharset=utf8,file_mode=0600,dir_mode=0700";
            if ( len( rec.vers ?: "" ) ) o &= ",vers=" & rec.vers;
            return o;
        }
        return "_netdev";
    }

    function source( rec, share ) {
        return rec.protocol == "smb" ? "//" & rec.host & "/" & arguments.share : rec.host & ":" & ( left( arguments.share, 1 ) == "/" ? arguments.share : "/" & arguments.share );
    }

    function credCommands( name, rec ) {
        var cmds = [];
        var tmp = privateTemp( "username=" & rec.user & chr( 10 ) & "password=" & secrets().fetch( secretKey( arguments.name ) ) & chr( 10 ) );
        cmds.append( [ "sudo", "install", "-Dm600", "-o", "root", "-g", "root", tmp, credFile( arguments.name ) ] );
        return { cmds: cmds, tmp: tmp };
    }

    // `mount`/`unmount`/`auto` all start the same way: the NAS, the share, and the plan text.
    function mountCmd( verb, name, share, yes, dry, asJson ) {
        var r = get( arguments.name );
        if ( structIsEmpty( r ) ) return fail( 4, "no NAS called " & arguments.name & " (bxrig nas list)", arguments.asJson );
        if ( !validShare( arguments.share ) ) return fail( 2, "that share name has characters a mount cannot take", arguments.asJson );
        var mp = mountPoint( arguments.name, arguments.share );
        var d = { name: arguments.name, share: arguments.share, mountpoint: mp, protocol: r.protocol };
        if ( arguments.verb == "unmount" ) return finish( "unmount " & mp, [], [ [ "sudo", "umount", mp ] ], arguments.yes, arguments.dry, arguments.asJson, d );
        var tool = r.protocol == "smb" ? "mount.cifs" : "mount.nfs";
        if ( !arguments.dry && !has( tool ) ) return fail( 4, tool & " was not found (bxrig nas setup --yes)", arguments.asJson );
        var cmds = [];
        var shown = [];
        var tmp = "";
        if ( r.protocol == "smb" ) {
            if ( !len( secrets().fetch( secretKey( arguments.name ) ) ) ) return fail( 4, "the password of " & arguments.name & " is not in the keyring (bxrig nas add " & arguments.name & " --host=" & r.host & " --user=" & r.user & " --ask-password)", arguments.asJson );
            shown.append( "SMB mounts are read as root, so the password is also kept in " & credFile( arguments.name ) & " (root only, mode 600)" );
            if ( arguments.yes && !arguments.dry ) { var cc = credCommands( arguments.name, r ); tmp = cc.tmp; for ( var c in cc.cmds ) cmds.append( c ); }
            else cmds.append( [ "sudo", "install", "-Dm600", "-o", "root", "-g", "root", "TEMPFILE", credFile( arguments.name ) ] );
        }
        cmds.append( [ "mkdir", "-p", mp ] );
        cmds.append( [ "sudo", "mount", "-t", r.protocol == "smb" ? "cifs" : "nfs", source( r, arguments.share ), mp, "-o", mountOptions( r, arguments.name ) ] );
        var code = finish( "mount " & source( r, arguments.share ) & " at " & mp, shown, cmds, arguments.yes, arguments.dry, arguments.asJson, d );
        try { if ( len( tmp ) && fileExists( tmp ) ) fileDelete( tmp ); } catch ( any e ) {}
        if ( code == 0 && arguments.yes && !arguments.dry ) {
            var s = read();
            if ( !structKeyExists( s.nas[ arguments.name ].shares, arguments.share ) ) s.nas[ arguments.name ].shares[ arguments.share ] = { mountpoint: mp, auto: false };
            write( s );
        }
        return code;
    }

    function unitName( mp, suffix ) {
        var r = tryExec( [ "systemd-escape", "-p", "--suffix=" & arguments.suffix, arguments.mp ], 5 );
        return trim( r.output );
    }

    function autoCmd( args, yes, dry, asJson ) {
        if ( arguments.args.len() != 3 || !arrayFind( [ "on", "off" ], arguments.args[ 1 ] ) ) return fail( 2, "Usage: bxrig nas auto on|off NAME SHARE", arguments.asJson );
        var v = arguments.args[ 1 ];
        var nm = arguments.args[ 2 ];
        var share = arguments.args[ 3 ];
        var r = get( nm );
        if ( structIsEmpty( r ) ) return fail( 4, "no NAS called " & nm & " (bxrig nas list)", arguments.asJson );
        if ( !validShare( share ) ) return fail( 2, "that share name has characters a mount cannot take", arguments.asJson );
        var mp = mountPoint( nm, share );
        var mnt = unitName( mp, "mount" );
        var aut = unitName( mp, "automount" );
        if ( !len( mnt ) ) return fail( 4, "systemd-escape was not found", arguments.asJson );
        var d = { name: nm, share: share, mountpoint: mp, mount_unit: mnt, automount_unit: aut };
        if ( v == "off" ) {
            var offCmds = [ [ "sudo", "systemctl", "disable", "--now", aut ], [ "sudo", "systemctl", "stop", mnt ], [ "sudo", "rm", "-f", unitDir() & "/" & mnt, unitDir() & "/" & aut ], [ "sudo", "systemctl", "daemon-reload" ] ];
            var code = finish( "turn the automatic mount of " & nm & "/" & share & " off", [], offCmds, arguments.yes, arguments.dry, arguments.asJson, d );
            if ( code == 0 && arguments.yes && !arguments.dry ) { var so = read(); if ( structKeyExists( so.nas[ nm ].shares, share ) ) so.nas[ nm ].shares[ share ].auto = false; write( so ); }
            return code;
        }
        if ( r.protocol == "smb" && !len( secrets().fetch( secretKey( nm ) ) ) ) return fail( 4, "the password of " & nm & " is not in the keyring", arguments.asJson );
        var mountUnit = "## Written by `bxrig nas auto on`. Remove with `bxrig nas auto off " & nm & " " & share & "`." & chr( 10 ) & "[Unit]" & chr( 10 ) & "Description=" & nm & " " & share & " (BxRig NAS)" & chr( 10 ) & "After=network-online.target" & chr( 10 ) & "Wants=network-online.target" & chr( 10 ) & chr( 10 )
            & "[Mount]" & chr( 10 ) & "What=" & source( r, share ) & chr( 10 ) & "Where=" & mp & chr( 10 ) & "Type=" & ( r.protocol == "smb" ? "cifs" : "nfs" ) & chr( 10 ) & "Options=" & mountOptions( r, nm ) & ",nofail" & chr( 10 ) & "TimeoutSec=20" & chr( 10 );
        var autoUnit = "## Written by `bxrig nas auto on`." & chr( 10 ) & "[Unit]" & chr( 10 ) & "Description=Automount " & nm & " " & share & chr( 10 ) & chr( 10 ) & "[Automount]" & chr( 10 ) & "Where=" & mp & chr( 10 ) & "TimeoutIdleSec=600" & chr( 10 ) & chr( 10 ) & "[Install]" & chr( 10 ) & "WantedBy=multi-user.target" & chr( 10 );
        var cmds = [];
        var tmpM = "TEMP.mount";
        var tmpA = "TEMP.automount";
        var cc = { cmds: [], tmp: "" };
        if ( arguments.yes && !arguments.dry ) {
            if ( r.protocol == "smb" ) cc = credCommands( nm, r );
            tmpM = privateTemp( mountUnit );
            tmpA = privateTemp( autoUnit );
        }
        for ( var x in cc.cmds ) cmds.append( x );
        if ( r.protocol == "smb" && !( arguments.yes && !arguments.dry ) ) cmds.append( [ "sudo", "install", "-Dm600", "-o", "root", "-g", "root", "TEMPFILE", credFile( nm ) ] );
        cmds.append( [ "mkdir", "-p", mp ] );
        cmds.append( [ "sudo", "install", "-Dm644", tmpM, unitDir() & "/" & mnt ] );
        cmds.append( [ "sudo", "install", "-Dm644", tmpA, unitDir() & "/" & aut ] );
        cmds.append( [ "sudo", "systemctl", "daemon-reload" ] );
        cmds.append( [ "sudo", "systemctl", "enable", "--now", aut ] );
        var shown = [ "mounts " & source( r, share ) & " at " & mp & " the first time something opens it, and lets go after 10 idle minutes", ( r.protocol == "smb" ? "the password is kept in " & credFile( nm ) & " (root only, mode 600), because systemd mounts as root" : "NFS needs no password" ) ];
        var code2 = finish( "turn the automatic mount of " & nm & "/" & share & " on", shown, cmds, arguments.yes, arguments.dry, arguments.asJson, d );
        try { for ( var tf in [ cc.tmp, tmpM, tmpA ] ) if ( len( tf ) && left( tf, 1 ) == "/" && fileExists( tf ) ) fileDelete( tf ); } catch ( any e ) {}
        if ( code2 == 0 && arguments.yes && !arguments.dry ) {
            var sn = read();
            sn.nas[ nm ].shares[ share ] = { mountpoint: mp, auto: true };
            write( sn );
        }
        return code2;
    }

    // ---- test ----
    function testCmd( name, shareName, asJson ) {
        var r = get( arguments.name );
        if ( structIsEmpty( r ) ) return fail( 4, "no NAS called " & arguments.name & " (bxrig nas list)", arguments.asJson );
        var port = r.protocol == "smb" ? "445" : "2049";
        var checks = [];
        var forced = getSystemSetting( "BXRIG_NAS_REACH", "" );
        var reach = len( forced ) ? forced == "yes" : tryExec( [ "bash", "-c", 'exec 3<>"/dev/tcp/$1/$2"', "_", r.host, port ], 8 ).exitCode == 0;
        checks.append( { id: "reachable", ok: reach, note: r.host & ":" & port & ( reach ? " answers" : " does not answer (is the NAS on, is " & uCase( r.protocol ) & " enabled in DSM?)" ) } );
        if ( reach ) {
            var sh = sharesCmdQuiet( arguments.name );
            checks.append( { id: r.protocol == "smb" ? "signed-in" : "exports", ok: sh.ok, note: sh.note } );
        }
        var share = len( arguments.shareName ) ? arguments.shareName : ( structKeyArray( r.shares ?: {} ).len() ? structKeyArray( r.shares )[ 1 ] : "" );
        if ( len( share ) ) {
            var mp = mountPoint( arguments.name, share );
            var mounted = tryExec( [ "findmnt", "-n", "-o", "FSTYPE", mp ], 5 );
            var isMounted = mounted.exitCode == 0 && len( trim( mounted.output ) );
            checks.append( { id: "mounted", ok: isMounted, note: mp & ( isMounted ? " is mounted (" & trim( mounted.output ) & ")" : " is not mounted (bxrig nas mount " & arguments.name & " " & share & " --yes)" ) } );
            if ( isMounted ) {
                var probe = mp & "/.bxrig-test-" & createUUID();
                var w = tryExec( [ "sh", "-c", 'touch "$1" && rm -f "$1"', "_", probe ], 10 );
                checks.append( { id: "writable", ok: w.exitCode == 0, note: w.exitCode == 0 ? "you can write to it" : "it is read only for you (check the share permissions in DSM)" } );
                var df = tryExec( [ "df", "-Pk", mp ], 10 );
                if ( df.exitCode == 0 ) { var cols = listToArray( trim( listLast( trim( df.output ), chr( 10 ) ) ), " ", false, true ); if ( cols.len() >= 4 ) checks.append( { id: "free", ok: true, note: round( val( cols[ 4 ] ) / 1048576 ) & " GB free" } ); }
            }
        }
        var bad = checks.filter( function( c ) { return !c.ok; } );
        var lines = checks.map( function( c ) { return ( c.ok ? "ok    " : "FAIL  " ) & c.id & ": " & c.note; } );
        return say( bad.len() ? 4 : 0, { name: arguments.name, checks: checks }, arguments.asJson, lines );
    }

    function sharesCmdQuiet( name ) {
        var r = get( arguments.name );
        if ( r.protocol == "nfs" ) {
            if ( !has( "showmount" ) ) return { ok: false, note: "showmount is missing (bxrig nas setup --yes)" };
            var nr = tryExec( [ "showmount", "-e", "--no-headers", r.host ], 20 );
            return { ok: nr.exitCode == 0, note: nr.exitCode == 0 ? "the exports can be read" : trim( nr.output ) };
        }
        if ( !has( "smbclient" ) ) return { ok: false, note: "smbclient is missing (bxrig nas setup --yes)" };
        var auth = privateTemp( "username = " & r.user & chr( 10 ) & "password = " & secrets().fetch( secretKey( arguments.name ) ) & chr( 10 ) );
        var sr = tryExec( [ "smbclient", "-g", "-L", r.host, "-A", auth ], 30 );
        try { fileDelete( auth ); } catch ( any e ) {}
        return { ok: sr.exitCode == 0, note: sr.exitCode == 0 ? "the password works" : "sign-in failed: " & trim( listFirst( sr.output, chr( 10 ) ) ) };
    }

    // ---- sync (plain mirror) ----
    function syncCmd( args, opts, yes, dry, asJson ) {
        if ( arguments.args.len() != 2 || !structKeyExists( arguments.opts, "to" ) ) return fail( 2, "Usage: bxrig nas sync NAME SRC --to=SHARE[/PATH] [--delete] [--yes]", arguments.asJson );
        var nm = arguments.args[ 1 ];
        var src = arguments.args[ 2 ];
        var r = get( nm );
        if ( structIsEmpty( r ) ) return fail( 4, "no NAS called " & nm, arguments.asJson );
        var to = arguments.opts.to;
        var share = listFirst( to, "/" );
        var sub = len( to ) > len( share ) ? mid( to, len( share ) + 2, len( to ) ) : "";
        if ( !validShare( share ) || find( "..", sub ) > 0 ) return fail( 2, "--to is SHARE or SHARE/PATH", arguments.asJson );
        if ( !directoryExists( src ) ) return fail( 4, src & " is not a folder", arguments.asJson );
        var mp = mountPoint( nm, share );
        if ( !has( "rsync" ) ) return fail( 4, "rsync was not found (bxrig nas setup --yes)", arguments.asJson );
        if ( tryExec( [ "findmnt", "-n", mp ], 5 ).exitCode != 0 && !arguments.dry ) return fail( 4, mp & " is not mounted (bxrig nas mount " & nm & " " & share & " --yes, or turn auto on)", arguments.asJson );
        var del = structKeyExists( arguments.opts, "delete" );
        var dest = mp & ( len( sub ) ? "/" & sub : "" ) & "/";
        var argv = [ "rsync", "-a", "--info=stats1" ];
        if ( del ) argv.append( "--delete" );
        argv.append( reReplace( src, "/+$", "" ) & "/" );
        argv.append( dest );
        var shown = [ del ? "--delete: files that are on the NAS but not in " & src & " are REMOVED from the NAS" : "nothing on the NAS is deleted (add --delete to make it an exact mirror)" ];
        return finish( "mirror " & src & " to " & nm & ":" & to, shown, [ argv ], arguments.yes, arguments.dry, arguments.asJson, { name: nm, source: src, destination: dest, delete: del } );
    }

    // ---- use as a backup target ----
    function useCmd( args, opts, yes, dry, asJson ) {
        if ( arguments.args.len() != 2 ) return fail( 2, "Usage: bxrig nas use NAME SHARE [--path=bxrig-backup]", arguments.asJson );
        var nm = arguments.args[ 1 ];
        var share = arguments.args[ 2 ];
        var r = get( nm );
        if ( structIsEmpty( r ) ) return fail( 4, "no NAS called " & nm, arguments.asJson );
        if ( !validShare( share ) ) return fail( 2, "that share name has characters a mount cannot take", arguments.asJson );
        var path = arguments.opts.path ?: "bxrig-backup";
        if ( !reFind( "^[A-Za-z0-9._/-]+$", path ) || find( "..", path ) > 0 ) return fail( 2, "--path is a folder name on the share", arguments.asJson );
        var mp = mountPoint( nm, share );
        var key = "nas-" & nm;
        var d = { target: key, type: "nas", nas: nm, share: share, path: path, repository: mp & "/" & path };
        if ( arguments.dry ) return say( 0, d, arguments.asJson, [ "Dry run: would make " & mp & "/" & path & " a backup target called " & key ], true );
        var b = { targets: {} };
        if ( fileExists( backupFile() ) ) { try { b = jsonDeserialize( fileRead( backupFile() ) ); if ( !structKeyExists( b, "targets" ) ) b.targets = {}; } catch ( any e ) {} }
        b.targets[ key ] = { type: "nas", nas: nm, share: share, path: path };
        directoryCreate( getDirectoryFromPath( backupFile() ), true, true );
        fileWrite( backupFile(), jsonSerialize( b ) & chr( 10 ) );
        return say( 0, d, arguments.asJson, [ "Backup target " & key & ": " & mp & "/" & path, "Next: bxrig backup data setup" ] );
    }

    function run( words, opts = {}, dry = false, yes = false, asJson = false ) {
        var verb = arguments.words.len() ? arguments.words[ 1 ] : "";
        var rest = [];
        for ( var i = 2; i <= arguments.words.len(); i++ ) rest.append( arguments.words[ i ] );
        if ( verb == "" || verb == "list" ) return listCmd( arguments.asJson );
        if ( verb == "setup" ) return setupCmd( arguments.yes, arguments.dry, arguments.asJson );
        if ( verb == "discover" ) return discoverCmd( arguments.asJson );
        if ( verb == "add" && rest.len() == 1 ) return addCmd( rest[ 1 ], arguments.opts, arguments.yes, arguments.dry, arguments.asJson );
        if ( verb == "show" && rest.len() == 1 ) return showCmd( rest[ 1 ], arguments.asJson );
        if ( verb == "remove" && rest.len() == 1 ) return removeCmd( rest[ 1 ], arguments.yes, arguments.dry, arguments.asJson );
        if ( verb == "shares" && rest.len() == 1 ) return sharesCmd( rest[ 1 ], arguments.asJson );
        if ( ( verb == "mount" || verb == "unmount" ) && rest.len() == 2 ) return mountCmd( verb, rest[ 1 ], rest[ 2 ], arguments.yes, arguments.dry, arguments.asJson );
        if ( verb == "auto" ) return autoCmd( rest, arguments.yes, arguments.dry, arguments.asJson );
        if ( verb == "test" && rest.len() >= 1 && rest.len() <= 2 ) return testCmd( rest[ 1 ], rest.len() == 2 ? rest[ 2 ] : "", arguments.asJson );
        if ( verb == "sync" ) return syncCmd( rest, arguments.opts, arguments.yes, arguments.dry, arguments.asJson );
        if ( verb == "use" ) return useCmd( rest, arguments.opts, arguments.yes, arguments.dry, arguments.asJson );
        return fail( 2, "Usage: bxrig nas setup | discover | add NAME --host=H [--protocol=smb|nfs] [--user=U] [--ask-password] | list | show NAME | remove NAME | shares NAME | mount|unmount NAME SHARE | auto on|off NAME SHARE | test NAME [SHARE] | sync NAME SRC --to=SHARE[/PATH] | use NAME SHARE", arguments.asJson );
    }
}
