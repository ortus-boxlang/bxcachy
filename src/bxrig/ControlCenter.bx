// Runs the Control Center, one terminal for all BxRig screens: `bxrig tui [PAGE] [--demo]`.
//   bxrig tui                open the Control Center on the Dashboard, sidebar open
//   bxrig tui PAGE           open that page with the sidebar collapsed, like an app of its own (\ or Ctrl+b opens it)
//   bxrig tui list           the page ids (--json for scripts)
//   bxrig tui PAGE --json    print that page's data and exit (no terminal needed), for scripts and tests
//   --sidebar / --no-sidebar force the sidebar open or collapsed at the start
//   --demo                   made-up data, nothing is run
// A page can send you to a full screen such as BxTimeMachine (`launch`); when you leave it you come back to the same page.
// Everything that changes something shows the plan first (the same command with --dry-run), and only a y runs it.
// Exit: 0 after leaving, 2 for an unknown page or usage, 4 when there is no terminal.
class ControlCenter {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.runner = arguments.runner;
        return this;
    }

    function self() { return getSystemSetting( "BXRIG_SELF", "bxrig" ); }

    function pageIds() { return new bxrig.ControlCenterPages().ids(); }

    // `tui list`
    function listPages( asJson ) {
        var rows = new bxrig.ControlCenterPages().list();
        if ( arguments.asJson ) println( variables.cli.envelope( "tui list", 0, { pages: rows } ) );
        else for ( var r in rows ) println( r.id & "  " & r.title );
        return 0;
    }

    function provider( demo ) {
        var dd = new bxrig.DashboardData( variables.cli, variables.runner );
        return arguments.demo ? new bxrig.DashboardDemo( dd ) : dd;
    }

    function buildPages( demo ) {
        var d = arguments.demo;
        return [
            new bxrig.DashboardPage( provider( d ) ),
            new bxrig.ListPage( new bxrig.BoxlangProvider( d ) ),
            new bxrig.ListPage( new bxrig.JavaProvider( d ) ),
            new bxrig.ListPage( new bxrig.SdkProvider( "maven", d ) ),
            new bxrig.ListPage( new bxrig.SdkProvider( "gradle", d ) ),
            new bxrig.ListPage( new bxrig.VersionsProvider( d ) ),
            new bxrig.ListPage( new bxrig.PortsProvider( d ) ),
            new bxrig.ListPage( new bxrig.PackagesProvider( d ) ),
            new bxrig.ListPage( new bxrig.ShortcutsProvider( d ) ),
            new bxrig.ListPage( new bxrig.MachinesProvider( d, provider( d ) ) ),
            new bxrig.ListPage( new bxrig.DatabasesProvider( d, provider( d ) ) ),
            new bxrig.ListPage( new bxrig.MailProvider( d ) ),
            new bxrig.ListPage( new bxrig.StorageProvider( d ) ),
            new bxrig.ListPage( new bxrig.SecretsProvider( d ) ),
            new bxrig.ListPage( new bxrig.ThemesProvider( d ) ),
            new bxrig.ListPage( new bxrig.LogsProvider( d ) )
        ];
    }

    function runCli( args ) {
        try { return systemExecute( self(), arguments.args, 1800, true ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function withFlag( args, flag ) {
        var out = [];
        for ( var a in arguments.args ) out.append( a );
        out.append( arguments.flag );
        return out;
    }

    // Runs a program (argv array) and returns { exitCode, output }.
    function runArgv( argv ) {
        var rest = [];
        for ( var i = 2; i <= arguments.argv.len(); i++ ) rest.append( arguments.argv[ i ] );
        try { return systemExecute( arguments.argv[ 1 ], rest, 1800, true ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function handle( app, intent ) {
        if ( !structCount( arguments.intent ) ) return;
        // exec: any program, with a plan written by the page (no --dry-run exists for it). readonly: run at once and show the output.
        if ( arguments.intent.action == "exec" ) {
            if ( !structKeyExists( arguments.intent, "confirmed" ) ) { arguments.app.showPlan( arguments.intent.title, arguments.intent.plan, arguments.intent ); return; }
            var xr = runArgv( arguments.intent.argv );
            arguments.app.showResult( arguments.intent.title & ( xr.exitCode == 0 ? ": done" : ": failed (exit " & xr.exitCode & ")" ), listToArray( trim( xr.output ), chr( 10 ) ) );
            return;
        }
        if ( arguments.intent.action == "show" ) {
            var sr = structKeyExists( arguments.intent, "argv" ) ? runArgv( arguments.intent.argv ) : runCli( arguments.intent.args );
            arguments.app.showResult( arguments.intent.title, listToArray( trim( sr.output ), chr( 10 ) ) );
            return;
        }
        if ( arguments.intent.action != "cli" ) return;
        var args = arguments.intent.args;
        if ( !structKeyExists( arguments.intent, "confirmed" ) ) {
            var r = runCli( withFlag( args, "--dry-run" ) );
            arguments.app.showPlan( arguments.intent.title, listToArray( trim( r.output ), chr( 10 ) ), arguments.intent );
            return;
        }
        var res = runCli( withFlag( args, "--yes" ) );
        arguments.app.showResult( arguments.intent.title & ( res.exitCode == 0 ? ": done" : ": failed (exit " & res.exitCode & ")" ), listToArray( trim( res.output ), chr( 10 ) ) );
    }

    // Prints the data of a page without a terminal.
    function dump( pageId, demo, asJson ) {
        var pages = buildPages( arguments.demo );
        for ( var p in pages ) if ( p.id() == arguments.pageId ) {
            p.load();
            var st = p.state();
            if ( arguments.asJson ) println( variables.cli.envelope( "tui " & p.id(), 0, st ) );
            else println( p.title() & ": " & ( structKeyExists( st, "attention" ) ? st.attention.len() & " things to look at" : st.rows & " rows" ) );
            return 0;
        }
        println( "Unknown page " & arguments.pageId & ". Pages: " & pageIds().toList( ", " ) );
        return 2;
    }

    // Icons are Nerd Font glyphs. "on" and "off" are explicit; "" follows BXRIG_ICONS, then looks for a Nerd Font on the machine.
    function iconsEnabled( opt = "" ) {
        var o = len( arguments.opt ) ? arguments.opt : getSystemSetting( "BXRIG_ICONS", "" );
        if ( o == "on" ) return true;
        if ( o == "off" ) return false;
        try { return systemExecute( "sh", [ "-c", "fc-list 2>/dev/null | grep -qi 'nerd'" ], 5, true ).exitCode == 0; } catch ( any e ) { return false; }
    }

    // sidebar: "" (open, collapsed when the terminal is narrow), "on" or "off".
    function run( pageId = "dashboard", demo = false, icons = "", sidebar = "" ) {
        var start = arguments.pageId;
        var me = this;
        var iconsOn = iconsEnabled( arguments.icons );
        var sb = arguments.sidebar;
        while ( true ) {
            var app = new bxrig.ControlCenterApp( buildPages( arguments.demo ), start, sb );
            new bxrig.TuiRunner().run(
                app,
                function( tui ) { return new bxrig.ControlCenterView( tui ).setIcons( iconsOn ); },
                function( intent ) { me.handle( app, intent ); }
            );
            start = app.page().id();
            sb = app.sidebarOpen() ? "on" : "off";
            var out = app.outcome();
            if ( left( out, 7 ) != "launch:" ) break;
            var target = mid( out, 8, 40 );
            if ( target == "timemachine" ) new bxrig.TimeMachine( variables.cli, variables.runner ).run( arguments.demo ? { demo: true } : { local: true } );
            else break;
        }
        return 0;
    }
}
