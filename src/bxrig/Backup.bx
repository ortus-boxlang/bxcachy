// `bxrig backup ...`: backups of your BxRig setup (config), the system (snapshots) and your files (data), plus moving them around.
//   backup config ...      see BackupConfig
//   backup snapshots ...   see BackupSnapshots
//   backup data ...        see BackupData
//   backup send|export ... see BackupMove
// More layers are added as they are built. Exit codes are the ones of each layer.
class Backup {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.runner = arguments.runner;
        return this;
    }

    function run( words, opts = {}, yes = false, dry = false, force = false, asJson = false ) {
        var layer = arguments.words.len() ? arguments.words[ 1 ] : "";
        var rest = [];
        for ( var i = 2; i <= arguments.words.len(); i++ ) rest.append( arguments.words[ i ] );
        if ( layer == "config" ) return new bxrig.BackupConfig( variables.cli, variables.runner ).run( rest, arguments.opts, arguments.yes, arguments.dry, arguments.asJson );
        if ( layer == "timeline" ) return new bxrig.BackupTimeline( variables.cli, variables.runner ).run( arguments.opts, arguments.asJson );
        if ( layer == "send" ) return new bxrig.BackupMove( variables.cli, variables.runner ).sendCmd( rest, arguments.opts, arguments.yes, arguments.dry, arguments.asJson );
        if ( layer == "export" ) return new bxrig.BackupMove( variables.cli, variables.runner ).exportCmd( rest, arguments.opts, arguments.yes, arguments.dry, arguments.asJson );
        if ( layer == "data" ) return new bxrig.BackupData( variables.cli, variables.runner ).run( rest, arguments.opts, arguments.yes, arguments.dry, arguments.asJson );
        if ( layer == "snapshots" ) return new bxrig.BackupSnapshots( variables.cli, variables.runner ).run( rest, arguments.opts, arguments.yes, arguments.dry, arguments.asJson );
        var msg = "Usage: bxrig backup config ... | snapshots ... | data ... | send ... | export ... | timeline";
        if ( arguments.asJson ) println( variables.cli.envelope( "backup", 2, { error: msg } ) ); else println( msg );
        return 2;
    }
}
