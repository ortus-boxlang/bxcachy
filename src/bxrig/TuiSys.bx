// What the Control Center pages share for reading the machine: run bxrig and get its JSON data, run a program, format times.
class TuiSys {
    function self() { return getSystemSetting( "BXRIG_SELF", "bxrig" ); }

    // `bxrig ARGS --json` -> the data struct, or {} when it fails or is not JSON.
    function bx( args ) {
        var a = [];
        for ( var x in arguments.args ) a.append( x );
        a.append( "--json" );
        try {
            var r = systemExecute( self(), a, 120, true );
            var j = jsonDeserialize( r.output );
            return structKeyExists( j, "data" ) && isStruct( j.data ) ? j.data : {};
        } catch ( any e ) { return {}; }
    }

    // A program and its arguments -> { exitCode, output }.
    function run( cmd, args = [], timeout = 30 ) {
        try { return systemExecute( arguments.cmd, arguments.args, arguments.timeout, true ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function has( cmd ) {
        var r = run( "sh", [ "-c", "command -v " & arguments.cmd ], 5 );
        return r.exitCode == 0 && len( trim( r.output ) );
    }

    function cli( title, args ) { return { action: "cli", title: arguments.title, args: arguments.args }; }
    function show( title, args ) { return { action: "show", title: arguments.title, args: arguments.args }; }

    // 90 -> "1m", 5400 -> "1h", 200000 -> "2d".
    function span( seconds ) {
        var s = max( 0, arguments.seconds );
        if ( s < 90 ) return s & "s";
        if ( s < 5400 ) return round( s / 60 ) & "m";
        if ( s < 129600 ) return round( s / 3600 ) & "h";
        return int( s / 86400 ) & "d";
    }
}
