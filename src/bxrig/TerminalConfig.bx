// Terminals BxRig offers. Ghostty is the default; the others are optional (all official Arch packages).
// Each terminal that has a config file gets a starter written once with the Nerd Font, so the Starship prompt shows its
// symbols in whichever terminal is used. Files go through the config service (never overwritten once they exist).
class TerminalConfig {
    function init( quiet = false ) {
        variables.config = new bxrig.ConfigService().quiet( arguments.quiet );
        return this;
    }

    function defaultTerminal() { return "ghostty"; }
    function defaultFont() { return "JetBrainsMono Nerd Font"; }

    // The font written into the terminal starters: the one `bxrig appearance font` chose, else JetBrains Mono Nerd.
    function fontFamily() {
        var f = variables.config.cfgHome() & "/bxrig/appearance.json";
        if ( fileExists( f ) ) {
            try { var j = jsonDeserialize( fileRead( f ) ); if ( structKeyExists( j, "font" ) && len( j.font ) ) return j.font; } catch ( any e ) {}
        }
        return defaultFont();
    }

    // id, package, the command that starts it, and its config file relative to ~/.config ("" when it has none).
    function terminals() {
        return [
            { id: "ghostty", pkg: "ghostty", cmd: "ghostty", config: "ghostty/config" },
            { id: "kitty", pkg: "kitty", cmd: "kitty", config: "kitty/kitty.conf" },
            { id: "alacritty", pkg: "alacritty", cmd: "alacritty", config: "alacritty/alacritty.toml" },
            { id: "foot", pkg: "foot", cmd: "foot", config: "foot/foot.ini" },
            { id: "konsole", pkg: "konsole", cmd: "konsole", config: "" }
        ];
    }

    // The desktop entry id of each terminal (from the Arch packages' file lists, 2026-11-11).
    function desktopId( id ) {
        var m = { ghostty: "com.mitchellh.ghostty.desktop", kitty: "kitty.desktop", alacritty: "Alacritty.desktop", foot: "foot.desktop", konsole: "org.kde.konsole.desktop" };
        return structKeyExists( m, arguments.id ) ? m[ arguments.id ] : "";
    }

    // The flags that give a terminal window its own class (Wayland app-id), so a window rule can find it. konsole has none.
    // ghostty: `class` takes any config key as --class=; kitty and alacritty: --class; foot: --app-id (kitty, alacritty and foot from
    // their manuals, not tested here).
    function classArgs( id, cls ) {
        if ( arguments.id == "ghostty" ) return [ "--class=" & arguments.cls ];
        if ( arguments.id == "kitty" || arguments.id == "alacritty" ) return [ "--class", arguments.cls ];
        if ( arguments.id == "foot" ) return [ "--app-id", arguments.cls ];
        return [];
    }

    function ids() { return terminals().map( function( t ) { return t.id; } ); }

    // The terminal struct for an id, or an empty struct.
    function find( id ) {
        for ( var t in terminals() ) if ( t.id == arguments.id ) return t;
        return {};
    }

    // The starter config text for a terminal ("" when it has none). It includes the generated theme file
    // (~/.config/bxrig/theme/..., written by `bxrig theme set`), so a theme change reaches the terminal without editing this file.
    // ghostty: config-file with the ? prefix (no error when missing); kitty: include; alacritty: [general] import; foot: include in [main].
    function starter( id, cfgHome = "" ) {
        var f = fontFamily();
        var th = arguments.cfgHome & "/bxrig/theme";
        var nl = chr( 10 );
        var head = "# BxRig starter. Written once; from here on it is yours." & nl;
        switch ( arguments.id ) {
            case "ghostty":   return head & "font-family = " & f & nl & "config-file = ?" & th & "/ghostty" & nl;
            case "kitty":     return head & "font_family " & f & nl & "include " & th & "/kitty.conf" & nl;
            case "alacritty": return head & "[general]" & nl & 'import = ["' & th & '/alacritty.toml"]' & nl & nl & "[font.normal]" & nl & 'family = "' & f & '"' & nl;
            case "foot":      return head & "include=" & th & "/foot.ini" & nl & nl & "[main]" & nl & "font=" & f & ":size=11" & nl;
        }
        return "";
    }

    // Config entries (name, target, mode, content) for a list of terminal ids.
    function entries( ids, cfgHome ) {
        var out = [];
        for ( var id in arguments.ids ) {
            var t = find( id );
            if ( structKeyExists( t, "id" ) && len( t.config ) ) out.append( { name: "terminal-" & id, target: arguments.cfgHome & "/" & t.config, mode: "644", content: starter( id, arguments.cfgHome ) } );
        }
        return out;
    }

    // Rewrites the starters of the terminals that exist with the current font, but only the ones still as BxRig wrote them (clean or outdated);
    // one you changed is kept and reported. Returns { written, kept } (entry names).
    function refreshFonts() {
        var out = { written: [], kept: [] };
        for ( var e in entries( ids(), variables.config.cfgHome() ) ) {
            var st = variables.config.configState( e );
            if ( st == "missing" || st == "clean" ) continue;
            if ( st == "outdated" && variables.config.configWrite( e, e.content, "font", true, false ) == 0 ) out.written.append( e.name );
            else out.kept.append( e.name );
        }
        return out;
    }

    // Writes the missing starter files. Returns { written, kept, failed }.
    function apply( ids ) {
        var out = { written: [], kept: [], failed: [] };
        for ( var e in entries( arguments.ids, variables.config.cfgHome() ) ) {
            if ( variables.config.configState( e ) != "missing" ) { out.kept.append( e.name ); continue; }
            if ( variables.config.configWrite( e, e.content, "apply", true, false ) == 0 ) out.written.append( e.name ); else out.failed.append( e.name );
        }
        if ( out.written.len() ) new bxrig.Theme( {} ).ensure();
        return out;
    }
}
