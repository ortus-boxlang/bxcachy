// Draws BxTimeMachine, the backup screen, on MatchBox's terminal canvas (docs/tui.md in the MatchBox repo): your backups as rows across a time axis
// (newest on the right), the chosen backup as a card with older ones stacked behind it, the file browser, the plan and result screens.
// Catppuccin Frappe neutrals with the Ortus brand gradient (cyan #00DBFF to green #00FF78); every tier has its own colour.
//
// paint( app, tick, width, height ) records the frame without painting the terminal, so a test can read it back with
// tui.render_to_string( width, height ); the run loop calls tui.end_frame() afterwards. paint() also records what a click on each
// region does, read with hitAt( x, y ).
class TimeMachineView {
    function init( tui ) {
        variables.tui = arguments.tui;
        variables.BASE = "##303446"; variables.MANTLE = "##292c3c"; variables.CRUST = "##232634";
        variables.SURFACE0 = "##414559"; variables.SURFACE1 = "##51576d"; variables.OVERLAY = "##737994";
        variables.TEXT = "##c6d0f5"; variables.SUB = "##a5adce";
        variables.GREEN = "##00ff78"; variables.CYAN = "##00dbff"; variables.YELLOW = "##e5c890"; variables.RED = "##e78284"; variables.MAUVE = "##ca9ee6"; variables.SKY = "##99d1db";
        variables.kit = new bxrig.TuiKit( arguments.tui );
        variables.months = [ "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" ];
        variables.days = [ "Thu", "Fri", "Sat", "Sun", "Mon", "Tue", "Wed" ];
        variables.stars = [];
        variables.starsFor = "";
        return this;
    }

    // ---- colours and drawing helpers (the shared kit does the work) ----
    function mix( a, b, t ) { return variables.kit.mix( arguments.a, arguments.b, arguments.t ); }
    function brand( t ) { return variables.kit.brand( arguments.t ); }
    function shimmer( x, w, phase ) { return variables.kit.shimmer( arguments.x, arguments.w, arguments.phase ); }
    function tierColor( tier ) {
        var t = arguments.tier;
        if ( t == "hourly" ) return variables.SKY;
        if ( t == "daily" ) return variables.CYAN;
        if ( t == "weekly" ) return variables.GREEN;
        if ( t == "monthly" ) return variables.YELLOW;
        return variables.MAUVE;
    }

    function put( x, y, s, col, bg = "", bold = false, dim = false ) { return variables.kit.put( arguments.x, arguments.y, arguments.s, arguments.col, arguments.bg, arguments.bold, arguments.dim ); }
    function fillRect( x, y, w, h, bg ) { variables.kit.fillRect( arguments.x, arguments.y, arguments.w, arguments.h, arguments.bg ); }
    function gtext( x, y, s, bold, phase, bg = "" ) { variables.kit.gtext( arguments.x, arguments.y, arguments.s, arguments.bold, arguments.phase, arguments.bg ); }
    function trunc( s, w ) { return variables.kit.trunc( arguments.s, arguments.w ); }
    function hit( kind, x, y, w, h, n = 0, m = 0 ) { variables.kit.hit( arguments.kind, arguments.x, arguments.y, arguments.w, arguments.h, arguments.n, arguments.m ); }
    function hitAt( x, y ) { return variables.kit.hitAt( arguments.x, arguments.y ); }

    // ---- dates, pure ----
    function civil( days ) {
        var z = arguments.days + 719468;
        var era = int( ( z >= 0 ? z : z - 146096 ) / 146097 );
        var doe = z - era * 146097;
        var yoe = int( ( doe - int( doe / 1460 ) + int( doe / 36524 ) - int( doe / 146096 ) ) / 365 );
        var y = yoe + era * 400;
        var doy = doe - ( 365 * yoe + int( yoe / 4 ) - int( yoe / 100 ) );
        var mp = int( ( 5 * doy + 2 ) / 153 );
        var d = doy - int( ( 153 * mp + 2 ) / 5 ) + 1;
        var m = mp < 10 ? mp + 3 : mp - 9;
        return { y: m <= 2 ? y + 1 : y, m: m, d: d, wd: ( ( arguments.days mod 7 ) + 7 ) mod 7 };
    }

    // kind: "time" (HH:MM), "day" (Mon 10), "month" (Nov 10), "year" (Nov 2026), "full" (Tue 10 Nov 2026 10:00)
    function fmt( epoch, kind ) {
        var e = arguments.epoch;
        var d = civil( int( e / 86400 ) );
        var sec = e - int( e / 86400 ) * 86400;
        var hh = right( "0" & int( sec / 3600 ), 2 );
        var mi = right( "0" & int( ( sec mod 3600 ) / 60 ), 2 );
        if ( arguments.kind == "time" ) return hh & ":" & mi;
        if ( arguments.kind == "day" ) return variables.days[ d.wd + 1 ] & " " & d.d;
        if ( arguments.kind == "month" ) return variables.months[ d.m ] & " " & d.d;
        if ( arguments.kind == "year" ) return variables.months[ d.m ] & " " & d.y;
        return variables.days[ d.wd + 1 ] & " " & d.d & " " & variables.months[ d.m ] & " " & d.y & "  " & hh & ":" & mi;
    }

    function axisKind( app ) {
        var s = arguments.app.span();
        if ( s <= 2 * 86400 ) return "time";
        if ( s <= 14 * 86400 ) return "day";
        if ( s <= 190 * 86400 ) return "month";
        return "year";
    }

    // ---- the frame ----
    function paint( app, tick, width, height ) {
        variables.tui.begin_frame();
        variables.tui.fill( 0, 0, arguments.width, arguments.height, { bg: variables.BASE } );
        if ( arguments.width < 90 || arguments.height < 30 ) {
            var msg = "Make the window a little bigger (90 x 30)";
            put( int( ( arguments.width - len( msg ) ) / 2 ), int( arguments.height / 2 ), msg, variables.YELLOW, variables.BASE );
            return this;
        }
        var phase = ( arguments.tick mod 90 ) / 90 * 1.4 - 0.2;
        header( arguments.app, arguments.width, phase );
        var mode = arguments.app.mode();
        if ( mode == "browse" ) browse( arguments.app, arguments.width, arguments.height, phase );
        else timelineScreen( arguments.app, arguments.tick, arguments.width, arguments.height, phase );
        footer( arguments.app, arguments.width, arguments.height, phase );
        if ( mode == "confirm" || mode == "result" ) modalBox( arguments.app, arguments.width, arguments.height, phase );
        if ( mode == "pick" ) pickBox( arguments.app, arguments.width, arguments.height, phase );
        if ( mode == "help" ) helpBox( arguments.width, arguments.height, phase );
        return this;
    }

    // A few faint stars behind everything, fixed per size.
    function stars( width, height, tick, minY ) {
        var key = arguments.width & "x" & arguments.height;
        if ( key != variables.starsFor ) {
            variables.starsFor = key;
            variables.stars = [];
            var seed = 2654435769;
            for ( var i = 0; i < 40; i++ ) {
                seed = ( seed * 1664525 + 1013904223 ) mod 4294967296; var x = int( seed / 256 ) mod arguments.width;
                seed = ( seed * 1664525 + 1013904223 ) mod 4294967296; var y = int( seed / 256 ) mod arguments.height;
                variables.stars.append( { x: x, y: y, i: i } );
            }
        }
        for ( var s in variables.stars ) if ( s.y >= arguments.minY && s.y < arguments.height - 3 ) put( s.x, s.y, ( ( arguments.tick / 6 + s.i ) mod 9 ) < 1 ? "*" : "·", variables.SURFACE0, variables.BASE );
    }

    function header( app, width, phase ) {
        fillRect( 0, 0, arguments.width, 2, variables.MANTLE );
        gtext( 3, 0, "◉  B x T i m e M a c h i n e", true, arguments.phase, variables.MANTLE );
        var tl = arguments.app.timeline();
        var n = tl.total ?: 0;
        var places = tl.rows.len();
        var sub = n & " backups in " & places & " places";
        put( arguments.width - len( sub ) - 3, 0, sub, variables.SUB, variables.MANTLE );
        put( 3, 1, "your system, your setup and your files, through time", variables.OVERLAY, variables.MANTLE );
        variables.kit.logo( arguments.width - 10, 1, "word", arguments.phase, variables.MANTLE );
    }

    function footer( app, width, height, phase ) {
        var y = arguments.height - 2;
        fillRect( 0, y, arguments.width, 2, variables.MANTLE );
        var m = arguments.app.mode();
        var keys = "";
        if ( m == "timeline" ) keys = "←→ time  ↑↓ place  +/- zoom  ⏎ open  d diff  r restore  e export  s send  n back up  ? help";
        else if ( m == "browse" ) keys = "↑↓ move   / filter   r restore this   e export this   esc back";
        else if ( m == "confirm" ) keys = "y  do it     n  not now";
        else if ( m == "pick" ) keys = "↑↓ choose   enter send   esc cancel";
        else keys = "any key to go on";
        put( 2, y, trunc( keys, arguments.width - 26 ), variables.SUB, variables.MANTLE );
        if ( len( arguments.app.message() ) ) put( 2, y + 1, trunc( arguments.app.message(), arguments.width - 30 ), variables.YELLOW, variables.MANTLE );
        put( arguments.width - 22, y, "Powered by ", variables.OVERLAY, variables.MANTLE );
        gtext( arguments.width - 11, y, "BoxLang", true, arguments.phase, variables.MANTLE );
        put( arguments.width - 17, y + 1, "www.boxlang.io", variables.SURFACE1, variables.MANTLE );
    }

    // ---- the timeline ----
    function timelineScreen( app, tick, width, height, phase ) {
        var allRows = arguments.app.rows();
        var railW = 24;
        var plotL = railW + 2;
        var plotW = arguments.width - plotL - 4;
        var top = 3;
        var avail = arguments.height - 24;
        var rowH = allRows.len() * 2 <= avail ? 2 : 1;
        var maxRows = min( allRows.len(), max( 2, int( avail / rowH ) ) );
        var selRow = arguments.app.rowIndex();
        var first = max( 1, min( selRow - int( maxRows / 2 ), allRows.len() - maxRows + 1 ) );
        if ( maxRows < 1 ) first = 1;
        // zoom chips
        var zx = plotL;
        put( zx - 8, top, "zoom", variables.OVERLAY, variables.BASE );
        var zi = 0;
        for ( var z in arguments.app.zooms() ) {
            zi++;
            var on = z.name == arguments.app.zoom().name;
            var lab = " " & z.name & " ";
            put( zx, top, lab, on ? variables.CRUST : variables.SUB, on ? variables.GREEN : variables.SURFACE0, on );
            hit( "zoom", zx, top, len( lab ), 1, zi );
            zx += len( lab ) + 1;
        }
        if ( first > 1 ) put( 3, top + 1, "▲ " & ( first - 1 ) & " more places", variables.OVERLAY, variables.BASE );
        var y0 = top + 2;
        var selX = -1;
        if ( arguments.app.hasPoint() ) selX = arguments.app.xFor( arguments.app.point().epoch, plotL, plotW );
        // the vertical guide at the selected moment
        if ( selX >= 0 ) for ( var gy = y0; gy < y0 + maxRows * rowH; gy++ ) put( selX, gy, "│", mix( variables.SURFACE1, variables.CYAN, 0.5 ), variables.BASE );
        for ( var vi = 0; vi < maxRows; vi++ ) {
            var ri = first + vi;
            var r = allRows[ ri ];
            var y = y0 + vi * rowH;
            var isSel = ri == selRow;
            if ( isSel ) { fillRect( 0, y, arguments.width, 1, variables.MANTLE ); put( 1, y, "▎", variables.GREEN, variables.MANTLE, true ); }
            var bg = isSel ? variables.MANTLE : variables.BASE;
            var dot = r.kind == "system" ? "◈" : r.kind == "config" ? "◆" : r.kind == "files" ? "■" : "↔";
            put( 3, y, dot & " " & trunc( r.label, railW - 6 ), isSel ? variables.TEXT : variables.SUB, bg, isSel );
            var last = r.points.len() ? arguments.app.ago( r.points[ 1 ] ) : "";
            if ( len( r.error ) ) put( 3, y + ( rowH > 1 ? 1 : 0 ), trunc( r.error, railW - 4 ), variables.RED, variables.BASE, false, true );
            else if ( rowH > 1 ) put( 3, y + 1, r.points.len() ? r.points.len() & " · " & last : "none yet", variables.OVERLAY, variables.BASE );
            hit( "row", 0, y, railW + 1, rowH, ri );
            // the line and its points
            put( plotL, y, repeatString( "─", plotW ), variables.SURFACE0, bg );
            if ( !r.points.len() && !len( r.error ) ) put( plotL + 2, y, "no backups yet, press n", variables.OVERLAY, bg, false, true );
            for ( var pi = r.points.len(); pi >= 1; pi-- ) {
                var p = r.points[ pi ];
                if ( !arguments.app.inWindow( p ) ) continue;
                var px = arguments.app.xFor( p.epoch, plotL, plotW );
                var chosen = isSel && pi == arguments.app.selIndex();
                if ( chosen ) put( px, y, ( arguments.tick mod 14 ) < 8 ? "◉" : "●", variables.GREEN, bg, true );
                else put( px, y, "●", tierColor( p.tier ), bg );
                hit( "point", px, y, 1, 1, ri, pi );
            }
        }
        if ( first + maxRows - 1 < allRows.len() ) put( 3, y0 + maxRows * rowH, "▼ " & ( allRows.len() - first - maxRows + 1 ) & " more places", variables.OVERLAY, variables.BASE );
        var ay = y0 + maxRows * rowH + ( first + maxRows - 1 < allRows.len() ? 1 : 0 );
        stars( arguments.width, arguments.height, arguments.tick, ay + 3 );
        axis( arguments.app, plotL, plotW, ay );
        cards( arguments.app, arguments.tick, arguments.width, arguments.height, ay + 4, arguments.phase );
    }

    function axis( app, plotL, plotW, y ) {
        put( arguments.plotL, arguments.y, repeatString( "┴", 1 ) & repeatString( "─", arguments.plotW - 2 ) & "┘", variables.SURFACE1, variables.BASE );
        var kind = axisKind( arguments.app );
        var ticks = max( 2, int( arguments.plotW / 14 ) );
        for ( var i = 0; i <= ticks; i++ ) {
            var f = i / ticks;
            var e = arguments.app.windowStart() + int( f * arguments.app.span() );
            var x = arguments.plotL + int( f * ( arguments.plotW - 1 ) );
            var lab = i == ticks ? "now" : fmt( e, kind );
            put( min( x, arguments.plotL + arguments.plotW - len( lab ) ), arguments.y + 1, lab, i == ticks ? variables.GREEN : variables.OVERLAY, variables.BASE );
            put( x, arguments.y, "┬", variables.SURFACE1, variables.BASE );
        }
        // the tiers
        var lx = arguments.plotL;
        for ( var t in [ "hourly", "daily", "weekly", "monthly", "yearly" ] ) {
            put( lx, arguments.y + 2, "●", tierColor( t ), variables.BASE );
            lx = put( lx + 2, arguments.y + 2, t & "  ", variables.OVERLAY, variables.BASE );
        }
    }

    // The chosen backup as a card, with the older ones stacked behind it like windows in the past.
    function cards( app, tick, width, height, top, phase ) {
        var cw = min( 66, arguments.width - 34 );
        var ch = 9;
        var cx = 6;
        var cy = arguments.top + 3;
        if ( cy + ch + 3 > arguments.height ) { cy = arguments.height - ch - 3; }
        if ( !arguments.app.hasPoint() ) {
            var r = arguments.app.row();
            put( cx, cy + 2, len( r.error ) ? r.label & ": " & r.error : "Nothing in " & r.label & " yet.", variables.SUB, variables.BASE );
            put( cx, cy + 3, "Press n to make a backup here.", variables.OVERLAY, variables.BASE );
            return;
        }
        var rowPts = arguments.app.row().points;
        var idx = arguments.app.selIndex();
        // older backups behind the card (to the up-right, dimmer each step)
        for ( var k = 3; k >= 1; k-- ) {
            if ( idx + k > rowPts.len() ) continue;
            var f = 1 - k * 0.25;
            variables.tui.border( cx + k * 2, cy - k, cw, ch, { border: "rounded", fg: mix( variables.BASE, tierColor( rowPts[ idx + k ].tier ), 0.25 * f ), bg: variables.BASE } );
            put( cx + k * 2 + 2, cy - k, " " & fmt( rowPts[ idx + k ].epoch, "month" ) & " ", mix( variables.BASE, variables.SUB, 0.5 * f ), variables.BASE );
        }
        var p = arguments.app.point();
        var r2 = arguments.app.row();
        variables.tui.border( cx, cy, cw, ch, { border: "rounded", fg: variables.SURFACE1, bg: variables.MANTLE } );
        gtext( cx + 1, cy, repeatString( "─", cw - 2 ), false, arguments.phase, variables.MANTLE );
        gtext( cx + 3, cy, r2.label, true, arguments.phase, variables.MANTLE );
        put( cx + 2, cy + 1, fmt( p.epoch, "full" ), variables.TEXT, variables.MANTLE, true );
        put( cx + 2, cy + 2, arguments.app.ago( p ) & "   ", variables.SUB, variables.MANTLE );
        var tcol = tierColor( p.tier );
        put( cx + 2 + len( arguments.app.ago( p ) ) + 3, cy + 2, " " & p.tier & " ", variables.CRUST, tcol, true );
        put( cx + 2, cy + 4, "id      " & p.id, variables.SUB, variables.MANTLE );
        put( cx + 2, cy + 5, "about   " & trunc( p.label ?: "", cw - 14 ), variables.SUB, variables.MANTLE );
        var facts = [];
        if ( structKeyExists( p, "files" ) && p.files > 0 ) facts.append( p.files & " files" );
        if ( structKeyExists( p, "packages" ) && p.packages > 0 ) facts.append( p.packages & " packages" );
        if ( structKeyExists( p, "size" ) && p.size > 0 ) facts.append( size( p.size ) );
        if ( structKeyExists( p, "host" ) && len( p.host ) ) facts.append( "from " & p.host );
        if ( structKeyExists( p, "secrets" ) && p.secrets ) facts.append( "with encrypted secrets" );
        if ( facts.len() ) put( cx + 2, cy + 6, "holds   " & trunc( facts.toList( " · " ), cw - 14 ), variables.SUB, variables.MANTLE );
        var acts = r2.kind == "files" ? "enter browse   r restore   e export   s send" : r2.kind == "config" ? "enter browse   d diff   r restore   e export" : r2.kind == "system" ? "enter changes   r restore a folder" : "";
        put( cx + 2, cy + 7, trunc( acts, cw - 4 ), variables.GREEN, variables.MANTLE );
        // the count by tier of this place, to the right of the card
        var sx = cx + cw + 8;
        put( sx, cy, "this place", variables.OVERLAY, variables.BASE );
        var counts = {};
        for ( var q in rowPts ) counts[ q.tier ] = ( counts[ q.tier ] ?: 0 ) + 1;
        var ty = cy + 2;
        for ( var t in [ "hourly", "daily", "weekly", "monthly", "yearly" ] ) {
            if ( !structKeyExists( counts, t ) ) continue;
            put( sx, ty, "●", tierColor( t ), variables.BASE );
            put( sx + 2, ty, right( "   " & counts[ t ], 3 ) & "  " & t, variables.SUB, variables.BASE );
            ty++;
        }
    }

    function size( bytes ) { return variables.kit.size( arguments.bytes ); }

    // ---- browse ----
    function browse( app, width, height, phase ) {
        var b = arguments.app.browseState();
        var px = 3; var py = 3; var pw = arguments.width - 6; var ph = arguments.height - 7;
        var p = arguments.app.point();
        var title = trunc( arguments.app.row().label & "  " & ( structKeyExists( p, "epoch" ) ? fmt( p.epoch, "full" ) : "" ), pw - 6 );
        variables.tui.border( px, py, pw, ph, { border: "rounded", fg: variables.SURFACE1, bg: variables.MANTLE } );
        gtext( px + 2, py, " " & title & " ", true, arguments.phase, variables.MANTLE );
        var fy = py + 1;
        var filterText = b.typing ? b.filter & "▏" : ( len( b.filter ) ? b.filter : "press / to filter" );
        put( px + 2, fy, "filter  ", variables.OVERLAY, variables.MANTLE );
        put( px + 10, fy, filterText, b.typing ? variables.GREEN : ( len( b.filter ) ? variables.TEXT : variables.OVERLAY ), variables.MANTLE, b.typing );
        var files = arguments.app.filteredFiles();
        put( px + pw - 22, fy, files.len() & " of " & b.files.len() & " files", variables.OVERLAY, variables.MANTLE );
        var listH = ph - 4;
        if ( len( b.error ) ) { put( px + 2, py + 3, trunc( b.error, pw - 6 ), variables.RED, variables.MANTLE ); return; }
        if ( !files.len() ) { put( px + 2, py + 3, len( b.filter ) ? "No file matches." : "No files to show.", variables.SUB, variables.MANTLE ); return; }
        var top = max( 1, min( b.cursor - int( listH / 2 ), files.len() - listH + 1 ) );
        for ( var i = 0; i < listH; i++ ) {
            var n = top + i;
            if ( n > files.len() ) break;
            var f = files[ n ];
            var on = n == b.cursor;
            var y = py + 3 + i;
            if ( on ) fillRect( px + 1, y, pw - 2, 1, variables.SURFACE0 );
            put( px + 2, y, on ? "▸" : " ", variables.GREEN, on ? variables.SURFACE0 : variables.MANTLE, true );
            put( px + 4, y, trunc( f.path, pw - 20 ), on ? variables.TEXT : variables.SUB, on ? variables.SURFACE0 : variables.MANTLE, on );
            if ( structKeyExists( f, "size" ) && f.size > 0 ) put( px + pw - 12, y, right( "         " & size( f.size ), 10 ), variables.OVERLAY, on ? variables.SURFACE0 : variables.MANTLE );
            hit( "file", px + 1, y, pw - 2, 1, n );
        }
    }

    // ---- modal boxes ----
    function modalBox( app, width, height, phase ) {
        var m = arguments.app.modal();
        var bw = min( arguments.width - 10, 100 );
        var bh = min( arguments.height - 8, max( 8, m.lines.len() + 6 ) );
        var bx = int( ( arguments.width - bw ) / 2 );
        var by = int( ( arguments.height - bh ) / 2 );
        variables.tui.border( bx, by, bw, bh, { border: "rounded", fg: variables.GREEN, bg: variables.CRUST } );
        gtext( bx + 2, by, " " & trunc( m.title, bw - 8 ) & " ", true, arguments.phase, variables.CRUST );
        var shown = min( m.lines.len(), bh - 5 );
        for ( var i = 1; i <= shown; i++ ) put( bx + 2, by + 1 + i, trunc( m.lines[ i ], bw - 5 ), variables.TEXT, variables.CRUST );
        if ( m.lines.len() > shown ) put( bx + 2, by + bh - 3, "… " & ( m.lines.len() - shown ) & " more lines", variables.OVERLAY, variables.CRUST );
        if ( arguments.app.mode() == "confirm" ) {
            put( bx + 2, by + bh - 2, " y  do it ", variables.CRUST, variables.GREEN, true );
            put( bx + 14, by + bh - 2, " n  not now ", variables.TEXT, variables.SURFACE0 );
        } else put( bx + 2, by + bh - 2, "press any key", variables.OVERLAY, variables.CRUST );
    }

    function pickBox( app, width, height, phase ) {
        var ps = arguments.app.pickState();
        var bw = 52;
        var bh = min( 14, ps.list.len() + 6 );
        var bx = int( ( arguments.width - bw ) / 2 );
        var by = int( ( arguments.height - bh ) / 2 );
        variables.tui.border( bx, by, bw, bh, { border: "rounded", fg: variables.GREEN, bg: variables.CRUST } );
        gtext( bx + 2, by, " Send to which place? ", true, arguments.phase, variables.CRUST );
        var i = 0;
        for ( var c in ps.list ) {
            i++;
            var on = i == ps.cursor;
            put( bx + 2, by + 1 + i, ( on ? "▸ " : "  " ) & trunc( c.label, bw - 8 ), on ? variables.GREEN : variables.SUB, variables.CRUST, on );
        }
    }

    function helpBox( width, height, phase ) {
        var lines = [
            "←  →         older / newer backup of this place        h l",
            "↑  ↓         another place                              k j",
            "+  -         zoom the time axis in and out",
            "enter        open the backup: browse its files          o",
            "d            what changed (config and system)",
            "r            restore (a plan comes first)",
            "e            export as a file (tar, zip or tar.gz)",
            "s            send to another place (a NAS to the cloud)",
            "n            back up this place now",
            "/            filter the files (in the browser)",
            "q  esc       leave"
        ];
        var bw = 74;
        var bh = lines.len() + 5;
        var bx = int( ( arguments.width - bw ) / 2 );
        var by = int( ( arguments.height - bh ) / 2 );
        variables.tui.border( bx, by, bw, bh, { border: "rounded", fg: variables.GREEN, bg: variables.CRUST } );
        gtext( bx + 2, by, " Keys ", true, arguments.phase, variables.CRUST );
        var i = 0;
        for ( var l in lines ) { i++; put( bx + 3, by + 1 + i, l, variables.TEXT, variables.CRUST ); }
    }
}
