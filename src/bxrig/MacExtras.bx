// Mac-style helpers: `emoji`, `forcequit`, `window minimize|restore`, `overview [setup]`, `nightshift ...`, `gpu doctor`, `input doctor|gestures`,
// `airplay on|off|status`. Each is a thin wrapper over a tool whose command is documented:
//   emoji        `rofimoji` (picks an emoji and types or copies it; Omarchy uses Walker's symbols mode on Super+Ctrl+E)
//   forcequit    Hyprland `hyprctl kill` (click the window to kill); Plasma `org.kde.KWin /KWin killWindow` over D-Bus
//   window       Hyprland `hyprctl dispatch movetoworkspacesilent special:minimized` / `togglespecialworkspace minimized`
//   overview     Hyprland `hyprctl dispatch hyprexpo:expo toggle` (the hyprexpo plugin, installed by `overview setup` with hyprpm);
//                Plasma KWin Overview through `org.kde.kglobalaccel invokeShortcut Overview`
//   nightshift   Hyprland: a user service running `wlsunset -l LAT -L LON` (sunrise and sunset computed from your time zone's
//                coordinates in /usr/share/zoneinfo/zone1970.tab, offline); Plasma: kwinrc [NightColor] Active=true, Mode=Automatic
//   gpu doctor   detects the GPU vendor with lspci and reports the missing driver packages
//   input        Apple Magic Mouse/Trackpad checks (kernel hid_magicmouse, bluetooth) and libinput-gestures workspace swipes
//   airplay      UxPlay as a user service (an AirPlay receiver; needs avahi-daemon)
// Not verified on a real machine: hyprexpo with the Lua config era, KWin killWindow, kwinrc NightColor Mode, UxPlay flags. Exit: 0 done,
// 4 a tool or precondition is missing, 6 a command failed.
class MacExtras {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxrig.Installer( arguments.runner );
        variables.config = new bxrig.ConfigService().quiet( true );
        return this;
    }

    function say( command, code, data, asJson, lines = [] ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function tryExec( argv, timeout = 60 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message, timeout: false }; }
    }

    function has( name ) { return tryExec( [ "sh", "-c", 'command -v "$1"', "_", arguments.name ], 10 ).exitCode == 0; }

    function plasma() {
        var d = lCase( getSystemSetting( "BXRIG_DESKTOP", getSystemSetting( "XDG_CURRENT_DESKTOP", "" ) ) );
        return find( "kde", d ) > 0 || find( "plasma", d ) > 0;
    }

    function qdbus() { for ( var q in [ "qdbus6", "qdbus" ] ) if ( has( q ) ) return q; return ""; }

    function need( command, tool, hint, asJson ) {
        return say( arguments.command, 4, { error: arguments.tool & " was not found" }, arguments.asJson, [ "error: " & arguments.tool & " was not found. " & arguments.hint ] );
    }

    function run( command, argv, ok, asJson, timeout = 600 ) {
        var r = tryExec( arguments.argv, arguments.timeout );
        if ( r.exitCode != 0 ) return say( arguments.command, 6, { error: trim( r.output ) }, arguments.asJson, [ "error: " & arguments.argv[ 1 ] & " failed (exit " & r.exitCode & ")" ] );
        return say( arguments.command, 0, { argv: arguments.argv }, arguments.asJson, arguments.ok == "" ? [] : [ arguments.ok ] );
    }

    function emoji( asJson ) {
        if ( !has( "rofimoji" ) ) return need( "emoji", "rofimoji", "Install it: bxrig install rofimoji", arguments.asJson );
        return run( "emoji", [ "rofimoji" ], "", arguments.asJson );
    }

    function forcequit( asJson ) {
        if ( plasma() ) {
            if ( qdbus() == "" ) return need( "forcequit", "qdbus6", "It comes with Qt 6 tools.", arguments.asJson );
            return run( "forcequit", [ qdbus(), "org.kde.KWin", "/KWin", "org.kde.KWin.killWindow" ], "", arguments.asJson );
        }
        if ( !has( "hyprctl" ) ) return need( "forcequit", "hyprctl", "This needs Hyprland.", arguments.asJson );
        return run( "forcequit", [ "hyprctl", "kill" ], "", arguments.asJson );
    }

    function window( action, asJson ) {
        if ( !has( "hyprctl" ) ) return need( "window", "hyprctl", "This needs Hyprland.", arguments.asJson );
        if ( arguments.action == "minimize" ) return run( "window", [ "hyprctl", "dispatch", "movetoworkspacesilent", "special:minimized" ], "", arguments.asJson );
        if ( arguments.action == "restore" ) return run( "window", [ "hyprctl", "dispatch", "togglespecialworkspace", "minimized" ], "", arguments.asJson );
        return say( "window", 2, {}, arguments.asJson, [ "Usage: bxrig window minimize|restore" ] );
    }

    function overview( setup, asJson ) {
        if ( plasma() ) {
            if ( qdbus() == "" ) return need( "overview", "qdbus6", "It comes with Qt 6 tools.", arguments.asJson );
            return run( "overview", [ qdbus(), "org.kde.kglobalaccel", "/component/kwin", "org.kde.kglobalaccel.Component.invokeShortcut", "Overview" ], "", arguments.asJson );
        }
        if ( !has( "hyprctl" ) ) return need( "overview", "hyprctl", "This needs Hyprland.", arguments.asJson );
        if ( arguments.setup ) {
            if ( !has( "hyprpm" ) ) return need( "overview", "hyprpm", "It ships with Hyprland.", arguments.asJson );
            for ( var step in [ [ "hyprpm", "update" ], [ "hyprpm", "add", "https://github.com/hyprwm/hyprland-plugins" ], [ "hyprpm", "enable", "hyprexpo" ] ] ) {
                var r = tryExec( step, 1800 );
                if ( r.exitCode != 0 && step[ 2 ] != "add" ) return say( "overview", 6, { error: trim( r.output ) }, arguments.asJson, [ "error: " & step.toList( " " ) & " failed" ] );
            }
            return say( "overview", 0, { plugin: "hyprexpo" }, arguments.asJson, [ "hyprexpo is enabled. Open the overview: bxrig overview" ] );
        }
        return run( "overview", [ "hyprctl", "dispatch", "hyprexpo:expo", "toggle" ], "", arguments.asJson );
    }

    // ---- night shift ----
    function tz() {
        var r = tryExec( [ "timedatectl", "show", "-p", "Timezone", "--value" ], 15 );
        var z = r.exitCode == 0 ? trim( r.output ) : "";
        if ( !len( z ) ) { var l = tryExec( [ "readlink", "-f", "/etc/localtime" ], 10 ); z = reReplace( trim( l.output ), "^.*/zoneinfo/", "" ); }
        return z;
    }

    function seg( iso, m, i ) { return arguments.m.len[ arguments.i ] ? mid( arguments.iso, arguments.m.pos[ arguments.i ], arguments.m.len[ arguments.i ] ) : ""; }

    // ISO 6709 "+DDMM+DDDMM" or "+DDMMSS+DDDMMSS" to [ lat, lon ] in degrees.
    function coords( iso ) {
        var m = reFind( "^([+-])([0-9]{2})([0-9]{2})([0-9]{2})?([+-])([0-9]{3})([0-9]{2})([0-9]{2})?$", arguments.iso, 1, true );
        if ( !m.pos[ 1 ] ) return [];
        var latSign = seg( arguments.iso, m, 2 ) == "-" ? -1 : 1;
        var lonSign = seg( arguments.iso, m, 6 ) == "-" ? -1 : 1;
        var lat = val( seg( arguments.iso, m, 3 ) ) + val( seg( arguments.iso, m, 4 ) ) / 60 + ( len( seg( arguments.iso, m, 5 ) ) ? val( seg( arguments.iso, m, 5 ) ) / 3600 : 0 );
        var lon = val( seg( arguments.iso, m, 7 ) ) + val( seg( arguments.iso, m, 8 ) ) / 60 + ( len( seg( arguments.iso, m, 9 ) ) ? val( seg( arguments.iso, m, 9 ) ) / 3600 : 0 );
        return [ round( latSign * lat * 100 ) / 100, round( lonSign * lon * 100 ) / 100 ];
    }

    // The coordinates of a time zone from zone1970.tab (or zone.tab), or [].
    function zoneCoords( zone ) {
        var dir = getSystemSetting( "BXRIG_ZONEINFO", "/usr/share/zoneinfo" );
        for ( var f in [ "zone.tab", "zone1970.tab" ] ) {
            if ( !fileExists( dir & "/" & f ) ) continue;
            for ( var line in listToArray( fileRead( dir & "/" & f ), chr( 10 ) ) ) {
                if ( left( line, 1 ) == "##" ) continue;
                var cols = listToArray( line, chr( 9 ), true );
                if ( cols.len() >= 3 && cols[ 3 ] == arguments.zone ) return coords( cols[ 2 ] );
            }
        }
        return [];
    }

    function unitFile() { return variables.config.cfgHome() & "/systemd/user/bxrig-wlsunset.service"; }

    function nightshift( action, location, asJson ) {
        var cmd = "nightshift";
        if ( plasma() ) {
            if ( !has( "kwriteconfig6" ) ) return need( cmd, "kwriteconfig6", "This needs KDE Plasma 6.", arguments.asJson );
            var on = arguments.action != "off";
            tryExec( [ "kwriteconfig6", "--file", "kwinrc", "--group", "NightColor", "--key", "Active", on ? "true" : "false" ], 20 );
            if ( on ) tryExec( [ "kwriteconfig6", "--file", "kwinrc", "--group", "NightColor", "--key", "Mode", "Automatic" ], 20 );
            if ( qdbus() != "" ) tryExec( [ qdbus(), "org.kde.KWin", "/KWin", "reconfigure" ], 20 );
            return say( cmd, 0, { plasma_night_light: on }, arguments.asJson, [ "Plasma Night Light " & ( on ? "on (automatic sunrise and sunset)" : "off" ) & "." ] );
        }
        if ( arguments.action == "status" ) {
            var s = tryExec( [ "systemctl", "--user", "is-active", "bxrig-wlsunset.service" ], 15 );
            return say( cmd, 0, { active: trim( s.output ) == "active" }, arguments.asJson, [ "Night shift: " & trim( s.output ) ] );
        }
        if ( arguments.action == "off" ) {
            tryExec( [ "systemctl", "--user", "disable", "--now", "bxrig-wlsunset.service" ], 30 );
            return say( cmd, 0, { active: false }, arguments.asJson, [ "Night shift is off." ] );
        }
        if ( arguments.action == "toggle" ) {
            var cur = tryExec( [ "systemctl", "--user", "is-active", "bxrig-wlsunset.service" ], 15 );
            return nightshift( trim( cur.output ) == "active" ? "off" : "on", arguments.location, arguments.asJson );
        }
        if ( !has( "wlsunset" ) ) return need( cmd, "wlsunset", "Install it: bxrig install wlsunset", arguments.asJson );
        var ll = [];
        if ( len( arguments.location ) ) {
            var parts = listToArray( arguments.location, "," );
            if ( parts.len() != 2 || !isNumeric( parts[ 1 ] ) || !isNumeric( parts[ 2 ] ) ) return say( cmd, 4, { error: "location must be LAT,LON" }, arguments.asJson, [ "error: --location must be LAT,LON, for example 40.7,-74.0" ] );
            ll = [ parts[ 1 ], parts[ 2 ] ];
        } else ll = zoneCoords( tz() );
        if ( ll.len() != 2 ) return say( cmd, 4, { error: "no coordinates for your time zone" }, arguments.asJson, [ "error: no coordinates found for your time zone; pass --location=LAT,LON" ] );
        var entry = { name: "wlsunset-unit", target: unitFile(), mode: "644", content: "[Unit]" & chr( 10 ) & "Description=BxRig night shift (wlsunset)" & chr( 10 ) & "After=graphical-session.target" & chr( 10 ) & chr( 10 ) & "[Service]" & chr( 10 ) & "ExecStart=wlsunset -l " & ll[ 1 ] & " -L " & ll[ 2 ] & " -t 3500 -T 6500" & chr( 10 ) & "Restart=on-failure" & chr( 10 ) & chr( 10 ) & "[Install]" & chr( 10 ) & "WantedBy=graphical-session.target" & chr( 10 ) };
        var st = variables.config.configState( entry );
        if ( st != "drifted" && st != "blocked" ) variables.config.configWrite( entry, entry.content, "apply", true, false );
        tryExec( [ "systemctl", "--user", "daemon-reload" ], 30 );
        var r = tryExec( [ "systemctl", "--user", "enable", "--now", "bxrig-wlsunset.service" ], 60 );
        if ( r.exitCode != 0 ) return say( cmd, 6, { error: trim( r.output ) }, arguments.asJson, [ "error: could not start the night shift service" ] );
        return say( cmd, 0, { active: true, latitude: ll[ 1 ], longitude: ll[ 2 ] }, arguments.asJson, [ "Night shift on: warm at sunset, cool at sunrise (" & ll[ 1 ] & ", " & ll[ 2 ] & ")." ] );
    }

    // ---- GPU ----
    function gpu( asJson ) {
        var cmd = "gpu doctor";
        var out = has( "lspci" ) ? tryExec( [ "lspci", "-nn" ], 20 ).output : "";
        var cards = [];
        for ( var l in listToArray( out, chr( 10 ) ) ) if ( reFindNoCase( "VGA compatible|3D controller|Display controller", l ) ) cards.append( trim( reReplace( l, "^[^ ]+ ", "" ) ) );
        var vendors = [];
        for ( var c in cards ) {
            if ( reFindNoCase( "nvidia", c ) && !arrayFind( vendors, "nvidia" ) ) vendors.append( "nvidia" );
            else if ( reFindNoCase( "(^|[^A-Za-z])(AMD|ATI)([^A-Za-z]|$)|Radeon", c ) && !arrayFind( vendors, "amd" ) ) vendors.append( "amd" );
            else if ( reFindNoCase( "Intel", c ) && !arrayFind( vendors, "intel" ) ) vendors.append( "intel" );
        }
        var have = {};
        var pq = tryExec( [ "pacman", "-Qq" ], 60 );
        for ( var p in listToArray( pq.output, chr( 10 ) ) ) have[ trim( p ) ] = true;
        var want = { nvidia: [ "nvidia-utils", "libva-nvidia-driver" ], amd: [ "mesa", "vulkan-radeon", "libva-mesa-driver" ], intel: [ "mesa", "vulkan-intel", "intel-media-driver" ] };
        var rows = []; var missing = [];
        for ( var v in vendors ) for ( var pkg in want[ v ] ) {
            var ok = structKeyExists( have, pkg );
            rows.append( { vendor: v, package: pkg, installed: ok } );
            if ( !ok && !arrayFind( missing, pkg ) ) missing.append( pkg );
        }
        var lines = cards.len() ? cards.map( function( c ) { return "GPU: " & c; } ) : [ "No GPU found by lspci." ];
        for ( var r in rows ) lines.append( ( r.installed ? "ok    " : "FIX   " ) & r.vendor & ": " & r.package );
        if ( arrayFind( vendors, "nvidia" ) ) lines.append( "note: for local AI install ollama-cuda; CachyOS normally installs the NVIDIA driver itself (chwd)." );
        if ( arrayFind( vendors, "amd" ) ) lines.append( "note: for local AI install ollama-rocm." );
        if ( missing.len() ) lines.append( "Install: sudo pacman -S --needed " & missing.toList( " " ) );
        return say( cmd, missing.len() ? 4 : 0, { gpus: cards, vendors: vendors, packages: rows, missing: missing }, arguments.asJson, lines );
    }

    // ---- input devices and gestures ----
    function inputDoctor( asJson ) {
        var mods = tryExec( [ "sh", "-c", "lsmod 2>/dev/null | grep -c hid_magicmouse" ], 10 ).output;
        var bt = tryExec( [ "systemctl", "is-active", "bluetooth" ], 15 ).output;
        var groups = tryExec( [ "id", "-nG" ], 10 ).output;
        var d = { magicmouse_driver: val( trim( mods ) ) > 0, bluetooth: trim( bt ) == "active", libinput_gestures: has( "libinput-gestures" ), in_input_group: find( "input", groups ) > 0 };
        var lines = [
            ( d.magicmouse_driver ? "ok    " : "info  " ) & "kernel driver hid_magicmouse (loads when a Magic Mouse or Trackpad connects)" & ( d.magicmouse_driver ? "" : ": not loaded now" ),
            ( d.bluetooth ? "ok    " : "FIX   " ) & "bluetooth service" & ( d.bluetooth ? "" : ": sudo systemctl enable --now bluetooth (bluez and bluez-utils)" ),
            ( d.libinput_gestures ? "ok    " : "FIX   " ) & "libinput-gestures" & ( d.libinput_gestures ? "" : ": bxrig install libinput-gestures" ),
            ( d.in_input_group ? "ok    " : "FIX   " ) & "you are in the input group" & ( d.in_input_group ? "" : ": sudo gpasswd -a $USER input, then log out and in" )
        ];
        return say( "input doctor", 0, d, arguments.asJson, lines );
    }

    function gesturesFile() { return variables.config.cfgHome() & "/libinput-gestures.conf"; }

    function gesturesText() {
        return "# Written by bxrig. Three-finger swipes switch workspaces and open the overview; edit it freely (it is kept)." & chr( 10 )
            & "gesture swipe left 3 hyprctl dispatch workspace e+1" & chr( 10 )
            & "gesture swipe right 3 hyprctl dispatch workspace e-1" & chr( 10 )
            & "gesture swipe up 3 bxrig overview" & chr( 10 )
            & "gesture swipe down 3 hyprctl dispatch workspace previous" & chr( 10 );
    }

    function gestures( yes, dryRun, asJson ) {
        var cmd = "input gestures";
        if ( !has( "libinput-gestures-setup" ) ) return need( cmd, "libinput-gestures-setup", "Install it: bxrig install libinput-gestures", arguments.asJson );
        var entry = { name: "libinput-gestures", target: gesturesFile(), mode: "644", content: gesturesText() };
        var data = { file: gesturesFile() };
        if ( !arguments.yes || arguments.dryRun ) return say( cmd, arguments.dryRun ? 0 : 2, data, arguments.asJson, [ ( arguments.dryRun ? "Dry run" : "Plan" ) & ": write " & gesturesFile() & " (3-finger swipe left/right: workspaces, up: overview) and start libinput-gestures at login", arguments.dryRun ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." ] );
        var st = variables.config.configState( entry );
        if ( st != "drifted" && st != "blocked" ) variables.config.configWrite( entry, entry.content, "apply", true, false );
        tryExec( [ "libinput-gestures-setup", "autostart" ], 30 );
        tryExec( [ "libinput-gestures-setup", "start" ], 30 );
        return say( cmd, 0, data, arguments.asJson, [ "Gestures set up. You must be in the input group (bxrig input doctor)." ] );
    }

    // ---- AirPlay ----
    function airplayUnit() { return variables.config.cfgHome() & "/systemd/user/bxrig-airplay.service"; }

    function airplay( action, asJson ) {
        var cmd = "airplay";
        if ( arguments.action == "status" ) {
            var s = tryExec( [ "systemctl", "--user", "is-active", "bxrig-airplay.service" ], 15 );
            return say( cmd, 0, { active: trim( s.output ) == "active" }, arguments.asJson, [ "AirPlay receiver: " & trim( s.output ) ] );
        }
        if ( arguments.action == "off" ) {
            tryExec( [ "systemctl", "--user", "disable", "--now", "bxrig-airplay.service" ], 30 );
            return say( cmd, 0, { active: false }, arguments.asJson, [ "AirPlay receiver is off." ] );
        }
        if ( arguments.action != "on" ) return say( cmd, 2, {}, arguments.asJson, [ "Usage: bxrig airplay on|off|status" ] );
        if ( !has( "uxplay" ) ) return need( cmd, "uxplay", "Install it: bxrig install uxplay", arguments.asJson );
        var entry = { name: "airplay-unit", target: airplayUnit(), mode: "644", content: "[Unit]" & chr( 10 ) & "Description=BxRig AirPlay receiver (UxPlay)" & chr( 10 ) & "After=graphical-session.target" & chr( 10 ) & chr( 10 ) & "[Service]" & chr( 10 ) & "ExecStart=uxplay -n BxRig" & chr( 10 ) & "Restart=on-failure" & chr( 10 ) & chr( 10 ) & "[Install]" & chr( 10 ) & "WantedBy=graphical-session.target" & chr( 10 ) };
        var st = variables.config.configState( entry );
        if ( st != "drifted" && st != "blocked" ) variables.config.configWrite( entry, entry.content, "apply", true, false );
        tryExec( [ "systemctl", "--user", "daemon-reload" ], 30 );
        var r = tryExec( [ "systemctl", "--user", "enable", "--now", "bxrig-airplay.service" ], 60 );
        if ( r.exitCode != 0 ) return say( cmd, 6, { error: trim( r.output ) }, arguments.asJson, [ "error: could not start the AirPlay receiver" ] );
        return say( cmd, 0, { active: true }, arguments.asJson, [ "AirPlay receiver on as BxRig. It needs avahi: sudo systemctl enable --now avahi-daemon" ] );
    }
}
