// `bxrig display ...`: monitors, scale, rotation, position, mirroring, the laptop panel and brightness (Omarchy's monitor panel).
//   display list | status [--json]
//   display scale NAME auto|0.5..4 | rotate NAME 0|90|180|270 | mode NAME preferred|WxH[@R] | position NAME auto|XxY
//   display mirror on|off          the laptop panel is shown on every external monitor
//   display laptop on|off          turn the laptop panel (eDP, LVDS, DSI) off or back on
//   display brightness up|down|set N   N is a percent; Noctalia for up and down, else brightnessctl
//   display apply | reset          re-push what is saved | forget it all
// Where each one lands:
//   Hyprland  one generated file, ~/.config/bxrig/theme/monitors.lua (a list of hl.monitor tables), read by the managed hypr/bxrig.lua after
//             your own hyprland.lua, then `hyprctl reload`. It is written through the config service, so an edited file is never overwritten.
//   Plasma    `kscreen-doctor output.NAME.scale.X` etc. (no file: KDE remembers its own layout)
// What you set is remembered in ~/.config/bxrig/display.json. Settings act at once (no --yes); --dry-run shows what would happen.
// Exit: 0 done, 2 bad usage, 4 precondition (no such monitor, no tool), 6 a command failed.
class Display {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxrig.Installer( arguments.runner );
        variables.cfgSvc = new bxrig.ConfigService().quiet( true );
        return this;
    }

    function cfg() { return variables.cfgSvc.cfgHome(); }
    function stateFile() { return cfg() & "/bxrig/display.json"; }
    function monitorsFile() { return cfg() & "/bxrig/theme/monitors.lua"; }

    function tryExec( argv, timeout = 30 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function has( name ) { return tryExec( [ "sh", "-c", 'command -v "$1"', "_", arguments.name ], 10 ).exitCode == 0; }
    function inHyprland() { return len( getSystemSetting( "HYPRLAND_INSTANCE_SIGNATURE", "" ) ) > 0 && has( "hyprctl" ); }
    function inPlasma() { return findNoCase( "KDE", getSystemSetting( "XDG_CURRENT_DESKTOP", "" ) ) > 0 && has( "kscreen-doctor" ); }
    function internal( name ) { return reFind( "^(eDP|LVDS|DSI)-", arguments.name ) > 0; }
    function safeName( name ) { return reFind( "^[A-Za-z0-9._-]+$", arguments.name ) > 0; }

    function say( code, data, asJson, lines = [], dry = false ) {
        if ( arguments.asJson ) println( variables.cli.envelope( "display", arguments.code, arguments.data, arguments.dry ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function fail( code, msg, asJson ) { return say( arguments.code, { error: arguments.msg }, arguments.asJson, [ "error: " & arguments.msg ] ); }

    // ---- state ----
    function readState() {
        var s = { monitors: {}, mirror: {}, laptop: "on" };
        if ( fileExists( stateFile() ) ) {
            try { var j = jsonDeserialize( fileRead( stateFile() ) ); for ( var k in j ) s[ k ] = j[ k ]; } catch ( any e ) {}
        }
        return s;
    }

    function writeState( s ) {
        directoryCreate( getDirectoryFromPath( stateFile() ), true, true );
        fileWrite( stateFile(), jsonSerialize( arguments.s ) & chr( 10 ) );
    }

    // ---- what is connected ----
    // [ { name, width, height, refresh, scale, x, y, rotation, focused, disabled, description, internal } ]
    function monitors() {
        var out = [];
        if ( inHyprland() ) {
            var r = tryExec( [ "hyprctl", "monitors", "all", "-j" ], 20 );
            if ( r.exitCode == 0 ) {
                try {
                    for ( var m in jsonDeserialize( r.output ) ) {
                        var t = int( val( m.transform ?: 0 ) );
                        out.append( {
                            name: m.name, width: m.width ?: 0, height: m.height ?: 0, refresh: round( val( m.refreshRate ?: 0 ) * 100 ) / 100,
                            scale: m.scale ?: 1, x: m.x ?: 0, y: m.y ?: 0, rotation: t < 4 ? t * 90 : 0, focused: m.focused ?: false,
                            disabled: m.disabled ?: false, description: m.description ?: "", internal: internal( m.name )
                        } );
                    }
                } catch ( any e ) {}
            }
        }
        return out;
    }

    function known( name ) {
        var ms = monitors();
        if ( !ms.len() ) return safeName( arguments.name );
        for ( var m in ms ) if ( m.name == arguments.name ) return true;
        return false;
    }

    // ---- the generated Hyprland file ----
    function lua( s ) {
        var rows = [];
        var names = structKeyArray( s.monitors );
        arraySort( names, "text" );
        for ( var n in names ) {
            var m = s.monitors[ n ];
            var f = [ 'output = "' & n & '"' ];
            f.append( 'mode = "' & ( m.mode ?: "preferred" ) & '"' );
            f.append( 'position = "' & ( m.position ?: "auto" ) & '"' );
            f.append( "scale = " & ( ( m.scale ?: "auto" ) == "auto" ? '"auto"' : m.scale ) );
            if ( int( val( m.rotation ?: 0 ) ) > 0 ) f.append( "transform = " & ( int( val( m.rotation ) ) / 90 ) );
            if ( ( m.disabled ?: false ) == true ) f = [ 'output = "' & n & '"', "disabled = true" ];
            rows.append( "  { " & f.toList( ", " ) & " }" );
        }
        var mir = s.mirror;
        if ( ( mir.on ?: false ) == true && len( mir.source ?: "" ) ) {
            for ( var t in mir.targets ) rows.append( '  { output = "' & t & '", mode = "preferred", position = "auto", scale = 1, mirror = "' & mir.source & '" }' );
        }
        return "-- Generated by `bxrig display`. Rewritten on every change; do not edit. Your own monitors go in hyprland.lua." & chr( 10 )
            & "return {" & ( rows.len() ? chr( 10 ) & rows.toList( "," & chr( 10 ) ) & chr( 10 ) : "" ) & "}" & chr( 10 );
    }

    // Writes monitors.lua and reloads Hyprland. Returns "reloaded", "written" (no Hyprland running) or "failed".
    function applyHyprland( s ) {
        var e = { name: "display-monitors", target: monitorsFile(), mode: "644", content: lua( arguments.s ) };
        if ( variables.cfgSvc.configState( e ) != "clean" && variables.cfgSvc.configWrite( e, e.content, "display", true, false ) != 0 ) return "failed";
        if ( inHyprland() ) return tryExec( [ "hyprctl", "reload" ], 20 ).exitCode == 0 ? "reloaded" : "failed";
        return "written";
    }

    // Plasma (kscreen-doctor): one argument per setting.
    function plasmaArgs( name, m ) {
        var a = [];
        if ( ( m.disabled ?: false ) == true ) return [ "output." & arguments.name & ".disable" ];
        a.append( "output." & arguments.name & ".enable" );
        if ( ( m.scale ?: "auto" ) != "auto" ) a.append( "output." & arguments.name & ".scale." & m.scale );
        if ( structKeyExists( m, "rotation" ) ) a.append( "output." & arguments.name & ".rotation." & { "0": "normal", "90": "left", "180": "inverted", "270": "right" }[ toString( int( val( m.rotation ) ) ) ] );
        if ( ( m.mode ?: "preferred" ) != "preferred" ) a.append( "output." & arguments.name & ".mode." & m.mode );
        if ( ( m.position ?: "auto" ) != "auto" ) a.append( "output." & arguments.name & ".position." & replace( m.position, "x", "," ) );
        return a;
    }

    function applyPlasma( s, only = "" ) {
        var args = [ "kscreen-doctor" ];
        for ( var n in s.monitors ) {
            if ( len( arguments.only ) && n != arguments.only ) continue;
            for ( var a in plasmaArgs( n, s.monitors[ n ] ) ) args.append( a );
        }
        if ( args.len() == 1 ) return "nothing to apply";
        var r = tryExec( args, 30 );
        return r.exitCode == 0 ? "applied" : "failed: " & trim( r.output );
    }

    // Applies the saved state to the desktop in use. Returns a text for the "applied" map.
    function applyAll( s, dry = false ) {
        if ( arguments.dry ) return inPlasma() && !inHyprland() ? "kscreen-doctor " & structKeyArray( arguments.s.monitors ).toList( " " ) : "would write " & monitorsFile() & ( inHyprland() ? " and run hyprctl reload" : "" );
        if ( inPlasma() && !inHyprland() ) return applyPlasma( arguments.s );
        return applyHyprland( arguments.s );
    }

    function result( setting, value, applied, notes, asJson, dry ) {
        var data = { setting: arguments.setting, value: arguments.value, applied: arguments.applied, notes: arguments.notes };
        var lines = [ arguments.setting & ": " & arguments.value ];
        for ( var k in arguments.applied ) lines.append( "  " & k & ": " & arguments.applied[ k ] );
        for ( var n in arguments.notes ) lines.append( "note: " & n );
        return say( 0, data, arguments.asJson, lines, arguments.dry );
    }

    // ---- commands ----
    function listCmd( asJson ) {
        var ms = monitors();
        var s = readState();
        var lines = [];
        for ( var m in ms ) lines.append( m.name & ( m.internal ? " (laptop panel)" : "" ) & ( m.disabled ? "  off" : "  " & m.width & "x" & m.height & "@" & m.refresh & "  scale " & m.scale & "  rotation " & m.rotation & "  at " & m.x & "," & m.y ) & ( len( m.description ) ? "   " & m.description : "" ) );
        if ( !ms.len() ) lines.append( "No monitors read (they are listed from inside Hyprland)." );
        return say( 0, { monitors: ms, saved: s }, arguments.asJson, lines );
    }

    function entry( s, name ) {
        if ( !structKeyExists( arguments.s.monitors, arguments.name ) ) arguments.s.monitors[ arguments.name ] = {};
        return arguments.s.monitors[ arguments.name ];
    }

    function monitorCmd( verb, args, dry, asJson ) {
        if ( arguments.args.len() != 2 ) return fail( 2, "Usage: bxrig display " & arguments.verb & " NAME VALUE (names: bxrig display list)", arguments.asJson );
        var name = arguments.args[ 1 ];
        var value = arguments.args[ 2 ];
        if ( !known( name ) ) return fail( 4, "no monitor " & name & " (bxrig display list)", arguments.asJson );
        var s = readState();
        var m = entry( s, name );
        if ( arguments.verb == "scale" ) {
            if ( value != "auto" && !( isNumeric( value ) && val( value ) >= 0.5 && val( value ) <= 4 ) ) return fail( 2, "scale is auto or a number from 0.5 to 4", arguments.asJson );
            m.scale = value;
        } else if ( arguments.verb == "rotate" ) {
            if ( !arrayFind( [ "0", "90", "180", "270" ], value ) ) return fail( 2, "rotate is 0, 90, 180 or 270", arguments.asJson );
            m.rotation = int( val( value ) );
        } else if ( arguments.verb == "mode" ) {
            if ( value != "preferred" && !reFind( "^[0-9]+x[0-9]+(@[0-9.]+)?$", value ) ) return fail( 2, "mode is preferred or WIDTHxHEIGHT[@RATE]", arguments.asJson );
            m.mode = value;
        } else {
            if ( value != "auto" && !reFind( "^-?[0-9]+x-?[0-9]+$", value ) ) return fail( 2, "position is auto or XxY (for example 1920x0)", arguments.asJson );
            m.position = value;
        }
        if ( !arguments.dry ) writeState( s );
        return result( arguments.verb, name & " " & value, { desktop: applyAll( s, arguments.dry ) }, [], arguments.asJson, arguments.dry );
    }

    function mirrorCmd( args, dry, asJson ) {
        var v = arguments.args.len() == 1 ? arguments.args[ 1 ] : "";
        if ( v != "on" && v != "off" ) return fail( 2, "Usage: bxrig display mirror on|off", arguments.asJson );
        var s = readState();
        if ( v == "on" ) {
            var src = "";
            var targets = [];
            for ( var m in monitors() ) { if ( m.internal ) src = m.name; else targets.append( m.name ); }
            if ( !len( src ) ) return fail( 4, "there is no laptop panel to mirror", arguments.asJson );
            if ( !targets.len() ) return fail( 4, "there is no external monitor to mirror it to", arguments.asJson );
            s.mirror = { on: true, source: src, targets: targets };
        } else {
            s.mirror = { on: false };
        }
        if ( !arguments.dry ) writeState( s );
        return result( "mirror", v, { desktop: applyAll( s, arguments.dry ) }, [], arguments.asJson, arguments.dry );
    }

    function laptopCmd( args, dry, asJson ) {
        var v = arguments.args.len() == 1 ? arguments.args[ 1 ] : "";
        if ( v != "on" && v != "off" ) return fail( 2, "Usage: bxrig display laptop on|off", arguments.asJson );
        var s = readState();
        var panels = monitors().filter( function( m ) { return m.internal; } ).map( function( m ) { return m.name; } );
        if ( !panels.len() ) for ( var n in s.monitors ) if ( internal( n ) ) panels.append( n );
        if ( !panels.len() ) return fail( 4, "no laptop panel was found (eDP, LVDS or DSI)", arguments.asJson );
        if ( v == "off" && monitors().filter( function( m ) { return !m.internal && !m.disabled; } ).len() == 0 && monitors().len() ) return fail( 4, "turning the panel off would leave no monitor on; connect an external one first", arguments.asJson );
        for ( var p in panels ) {
            var e = entry( s, p );
            e.disabled = v == "off";
        }
        s.laptop = v;
        if ( !arguments.dry ) writeState( s );
        return result( "laptop", v, { desktop: applyAll( s, arguments.dry ) }, [], arguments.asJson, arguments.dry );
    }

    function brightnessCmd( args, dry, asJson ) {
        var v = arguments.args.len() ? arguments.args[ 1 ] : "";
        var argv = [];
        var how = "";
        if ( ( v == "up" || v == "down" ) && arguments.args.len() == 1 && has( "noctalia" ) ) { argv = [ "noctalia", "msg", "brightness-" & v ]; how = "noctalia"; }
        else if ( v == "up" || v == "down" ) { argv = [ "brightnessctl", "set", v == "up" ? "5%+" : "5%-" ]; how = "brightnessctl"; }
        else if ( v == "set" && arguments.args.len() == 2 && isNumeric( arguments.args[ 2 ] ) && val( arguments.args[ 2 ] ) >= 1 && val( arguments.args[ 2 ] ) <= 100 ) { argv = [ "brightnessctl", "set", int( val( arguments.args[ 2 ] ) ) & "%" ]; how = "brightnessctl"; }
        else return fail( 2, "Usage: bxrig display brightness up|down | set 1..100", arguments.asJson );
        if ( how == "brightnessctl" && !has( "brightnessctl" ) ) return fail( 4, "brightnessctl is not installed (bxrig install brightnessctl)", arguments.asJson );
        if ( arguments.dry ) return result( "brightness", v, { command: argv.toList( " " ) }, [], arguments.asJson, true );
        var r = tryExec( argv, 20 );
        if ( r.exitCode != 0 ) return say( 6, { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
        return result( "brightness", v, { via: how }, [], arguments.asJson, false );
    }

    function status( asJson ) { return listCmd( arguments.asJson ); }

    function run( words, dry = false, yes = false, asJson = false ) {
        var verb = arguments.words.len() ? arguments.words[ 1 ] : "";
        var rest = [];
        for ( var i = 2; i <= arguments.words.len(); i++ ) rest.append( arguments.words[ i ] );
        if ( verb == "" || verb == "list" || verb == "status" ) return listCmd( arguments.asJson );
        if ( arrayFind( [ "scale", "rotate", "mode", "position" ], verb ) ) return monitorCmd( verb, rest, arguments.dry, arguments.asJson );
        if ( verb == "mirror" ) return mirrorCmd( rest, arguments.dry, arguments.asJson );
        if ( verb == "laptop" ) return laptopCmd( rest, arguments.dry, arguments.asJson );
        if ( verb == "brightness" ) return brightnessCmd( rest, arguments.dry, arguments.asJson );
        if ( verb == "apply" ) return result( "apply", "saved display settings", { desktop: applyAll( readState(), arguments.dry ) }, [], arguments.asJson, arguments.dry );
        if ( verb == "reset" ) {
            var empty = { monitors: {}, mirror: {}, laptop: "on" };
            if ( !arguments.dry ) writeState( empty );
            return result( "reset", "forgot the saved display settings", { desktop: applyAll( empty, arguments.dry ) }, [], arguments.asJson, arguments.dry );
        }
        return fail( 2, "Usage: bxrig display list | scale NAME V | rotate NAME DEG | mode NAME M | position NAME XxY | mirror on|off | laptop on|off | brightness up|down|set N | apply | reset", arguments.asJson );
    }
}
