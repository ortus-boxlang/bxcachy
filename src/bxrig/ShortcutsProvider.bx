// Shortcuts: every shortcut BxRig manages, with search; rebind one (it asks for the keys and shows the plan), reset it, check conflicts. Reads `keys show`.
class ShortcutsProvider {
    function init( demo = false ) { variables.demo = arguments.demo; variables.sys = new bxrig.TuiSys(); return this; }
    function id() { return "shortcuts"; }
    function icon() { return "keyboard"; }
    function title() { return "Shortcuts"; }
    function hint() { return "your keys, in one list"; }
    function live() { return false; }
    function refreshSeconds() { return 0; }
    function detailLines() { return 2; }
    function emptyText() { return "No shortcuts found."; }
    function columns() { return [ { key: "action", label: "action", w: 26 }, { key: "keys", label: "keys", w: 22 }, { key: "origin", label: "origin", w: 10 }, { key: "how", label: "through", w: 0 } ]; }
    function style( r ) { return r.custom ? "ok" : ""; }
    function detail( r ) { return [ r.action & ": " & ( r.keys == "unbound" ? "no keys yet" : r.keys ), r.custom ? "Yours. Press r to go back to the default." : ( r.keys == "unbound" ? "Not bound. Press e to give it keys." : "The default. Press e to change it." ) ]; }

    function actions() {
        return [
            { key: "e", label: "rebind", run: function( r ) { return { action: "ask", title: "Rebind " & r.action, prompt: "New keys, like Super+Shift+T", make: function( v ) { return { action: "cli", title: "Rebind " & r.action, args: [ "keys", "set", r.id, v ] }; } }; } },
            { key: "r", label: "reset", run: function( r ) { return { action: "cli", title: "Reset " & r.action, args: [ "keys", "reset", r.id ] }; } },
            { key: "c", label: "conflicts", run: function( r ) { return { action: "show", title: "Conflicts", args: [ "keys", "conflicts" ] }; } }
        ];
    }

    function load( q = "" ) {
        var src = variables.demo ? [ { id: "launcher", action: "Launcher", keys: "Super+Space", custom: false, how: "hyprland" }, { id: "terminal", action: "Terminal", keys: "Super+Return", custom: false, how: "hyprland" }, { id: "ai-shell", action: "Pull-down AI", keys: "Super+grave", custom: true, how: "hyprland" }, { id: "clipboard", action: "Clipboard history", keys: "Super+V", custom: false, how: "hyprland" } ] : ( variables.sys.bx( [ "keys", "show" ] ).shortcuts ?: [] );
        var rows = [];
        for ( var s in src ) rows.append( { id: s.id, action: s.action, keys: len( s.keys ) ? s.keys : "unbound", custom: s.custom, origin: s.custom ? "yours" : "default", how: s.how ?: "" } );
        return rows;
    }
}
