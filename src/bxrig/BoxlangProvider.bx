// BoxLang Central: the BoxLang versions bvm has installed, with install and switch. Reads `bvm list` and `bvm current`.
// The output format of bvm is read leniently (every version number on a line); verify on a machine with bvm working.
class BoxlangProvider {
    function init( demo = false ) { variables.demo = arguments.demo; variables.sys = new bxrig.TuiSys(); return this; }
    function id() { return "boxlang"; }
    function icon() { return "archive"; }
    function title() { return "BoxLang"; }
    function hint() { return "versions installed with bvm"; }
    function live() { return false; }
    function refreshSeconds() { return 0; }
    function detailLines() { return 2; }
    function emptyText() { return "No BoxLang versions found. Press i to install the latest."; }
    function columns() { return [ { key: "mark", label: "", w: 4 }, { key: "version", label: "version", w: 24 }, { key: "state", label: "", w: 0 } ]; }
    function style( r ) { return r.active ? "ok" : ""; }
    function detail( r ) { return [ "BoxLang " & r.version, r.active ? "Active. New shells and `boxlang` use it." : "Press u to use it." ]; }

    function actions() {
        return [
            { key: "u", label: "use", run: function( r ) { return { action: "exec", title: "Use BoxLang " & r.version, argv: [ "bvm", "use", r.version ], plan: [ "Plan: bvm use " & r.version ] }; } },
            { key: "i", label: "install", run: function( r ) { return { action: "ask", title: "Install BoxLang", prompt: "Version (latest, snapshot or 1.8.0)", make: function( v ) { return { action: "exec", title: "Install BoxLang " & v, argv: [ "bvm", "install", v ], plan: [ "Plan: bvm install " & v ] }; } }; } },
            { key: "x", label: "remove", run: function( r ) { return { action: "exec", title: "Remove BoxLang " & r.version, argv: [ "bvm", "remove", r.version ], plan: [ "Plan: bvm remove " & r.version ] }; } }
        ];
    }

    // Every version number on the lines of `bvm list`, newest first.
    function parseList( text, current ) {
        var out = [];
        var seen = {};
        for ( var line in listToArray( arguments.text, chr( 10 ) ) ) {
            var m = reFind( "[0-9]+\.[0-9]+\.[0-9]+(-snapshot)?", line, 1, true );
            if ( isArray( m.match ) && m.match.len() && len( m.match[ 1 ] ) && !structKeyExists( seen, m.match[ 1 ] ) ) {
                var v = m.match[ 1 ]; seen[ v ] = true;
                var act = v == arguments.current || find( "*", line ) > 0 || find( "(current)", line ) > 0;
                out.append( { version: v, active: act, mark: act ? "*" : " ", state: act ? "active" : "" } );
            }
        }
        return out;
    }

    function load( q = "" ) {
        if ( variables.demo ) return [ { version: "1.8.0", active: true, mark: "*", state: "active" }, { version: "1.7.2", active: false, mark: " ", state: "" }, { version: "1.6.0", active: false, mark: " ", state: "" }, { version: "1.9.0-snapshot", active: false, mark: " ", state: "snapshot" } ];
        var cur = trim( variables.sys.run( "bvm", [ "current" ], 10 ).output );
        var m = reFind( "[0-9]+\.[0-9]+\.[0-9]+(-snapshot)?", cur, 1, true );
        return parseList( variables.sys.run( "bvm", [ "list" ], 10 ).output, isArray( m.match ) && m.match.len() ? m.match[ 1 ] : "" );
    }
}
