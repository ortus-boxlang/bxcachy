// `bxrig notify dnd on|off|toggle|status | snooze [DURATION|off] | clear [--history]`: Noctalia's notifications from the command line.
//   dnd      Do Not Disturb: `noctalia msg notification-dnd-set on|off`, `notification-dnd-toggle`, `notification-dnd-status` (Noctalia docs, v5.4)
//   snooze   Do Not Disturb now, off again after DURATION (30m, 2h, 90s, or minutes; default 30m): a transient user timer runs
//            `noctalia msg notification-dnd-set off`; `snooze off` cancels it and turns Do Not Disturb off
//   clear    dismisses the visible notifications (`notification-clear-active`); --history also empties the history
// Noctalia has no command that opens its history panel, so there is none here: open the control center. Exit: 0 done, 4 precondition
// (no noctalia, no systemd-run for snooze, bad duration), 6 the command failed.
class Notify {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.inst = new bxrig.Installer( arguments.runner );
        return this;
    }

    function say( code, data, asJson, lines = [] ) {
        if ( arguments.asJson ) println( variables.cli.envelope( "notify", arguments.code, arguments.data ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function tryExec( argv, timeout = 30 ) {
        try { return variables.inst.exec( arguments.argv, arguments.timeout ); } catch ( any e ) { return { exitCode: 127, output: e.message }; }
    }

    function has( name ) { return tryExec( [ "sh", "-c", 'command -v "$1"', "_", arguments.name ], 10 ).exitCode == 0; }

    function msg( words ) {
        var argv = [ "noctalia", "msg" ];
        for ( var w in arguments.words ) argv.append( w );
        return tryExec( argv, 30 );
    }

    // "30m", "2h", "90s" or "45" (minutes) to seconds; 0 when it is not a duration.
    function seconds( text ) {
        var t = lCase( trim( arguments.text ) );
        if ( !len( t ) ) return 1800;
        var m = reFind( "^([0-9]+)([smh]?)$", t, 1, true );
        if ( !m.pos[ 1 ] ) return 0;
        var n = val( mid( t, m.pos[ 2 ], m.len[ 2 ] ) );
        var unit = m.len[ 3 ] ? mid( t, m.pos[ 3 ], m.len[ 3 ] ) : "m";
        return n * ( unit == "h" ? 3600 : ( unit == "s" ? 1 : 60 ) );
    }

    function dnd( action, asJson ) {
        if ( !has( "noctalia" ) ) return say( 4, { error: "noctalia was not found" }, arguments.asJson, [ "error: noctalia was not found (this needs the Hyprland + Noctalia desktop)" ] );
        var words = arguments.action == "status" ? [ "notification-dnd-status" ] : ( arguments.action == "toggle" ? [ "notification-dnd-toggle" ] : [ "notification-dnd-set", arguments.action ] );
        var r = msg( words );
        if ( r.exitCode != 0 ) return say( 6, { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
        var out = trim( r.output );
        return say( 0, { action: arguments.action, output: out }, arguments.asJson, [ arguments.action == "status" ? "Do Not Disturb: " & out : "Do Not Disturb: " & arguments.action ] );
    }

    function snooze( duration, asJson ) {
        if ( !has( "noctalia" ) ) return say( 4, { error: "noctalia was not found" }, arguments.asJson, [ "error: noctalia was not found" ] );
        if ( lCase( arguments.duration ) == "off" ) {
            tryExec( [ "systemctl", "--user", "stop", "bxrig-snooze.timer" ], 20 );
            return dnd( "off", arguments.asJson );
        }
        var secs = seconds( arguments.duration );
        if ( secs < 1 ) return say( 4, { error: "bad duration " & arguments.duration }, arguments.asJson, [ "error: bad duration " & arguments.duration & " (use 30m, 2h, 90s or minutes)" ] );
        if ( !has( "systemd-run" ) ) return say( 4, { error: "systemd-run was not found" }, arguments.asJson, [ "error: systemd-run was not found (snooze needs a systemd user session)" ] );
        tryExec( [ "systemctl", "--user", "stop", "bxrig-snooze.timer" ], 20 );
        var on = msg( [ "notification-dnd-set", "on" ] );
        if ( on.exitCode != 0 ) return say( 6, { error: trim( on.output ) }, arguments.asJson, [ "error: " & trim( on.output ) ] );
        var t = tryExec( [ "systemd-run", "--user", "--quiet", "--unit=bxrig-snooze", "--on-active=" & secs & "s", "noctalia", "msg", "notification-dnd-set", "off" ], 30 );
        if ( t.exitCode != 0 ) return say( 6, { error: "could not start the timer: " & trim( t.output ) }, arguments.asJson, [ "error: could not start the timer: " & trim( t.output ) ] );
        return say( 0, { snooze_seconds: secs }, arguments.asJson, [ "Do Not Disturb for " & secs & " seconds. Cancel: bxrig notify snooze off" ] );
    }

    function clear( history, asJson ) {
        if ( !has( "noctalia" ) ) return say( 4, { error: "noctalia was not found" }, arguments.asJson, [ "error: noctalia was not found" ] );
        var r = msg( [ "notification-clear-active" ] );
        if ( r.exitCode == 0 && arguments.history ) r = msg( [ "notification-clear-history" ] );
        if ( r.exitCode != 0 ) return say( 6, { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
        return say( 0, { cleared: arguments.history ? "active and history" : "active" }, arguments.asJson, [ "Cleared " & ( arguments.history ? "the visible notifications and the history." : "the visible notifications." ) ] );
    }
}
