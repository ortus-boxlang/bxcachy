// `bxrig keys set|reset|conflicts`: change the keys of BxRig's bindings, safely.
//   keys set ID KEYS [--yes] [--force]   e.g. keys set ai-shell Super+Alt+A. Only bindings can change (the Cmd-style remaps are xremap's).
//                                         Refused (exit 4) when the combo is invalid or another binding already uses it; --force allows
//                                         a clash with a line in YOUR hyprland files (never with another BxRig binding).
//   keys reset ID [--yes]                 back to the default keys
//   keys conflicts [--json]               double use of a combo: inside the table, and between the table and your own hl.bind lines
// Overrides live in ~/.config/bxrig/shortcuts.json (written through the config service). They take effect when `keys apply --yes`
// rewrites the Hyprland module and the Plasma settings. Exit: 0 done, 2 plan without --yes, 4 invalid or a conflict, 6 write failed.
// The scan of your own files is a best-effort read of `hl.bind( ... )` lines (mainMod and quoted names), not a Lua parser.
class KeysEditor {
    function init( cli ) {
        variables.cli = arguments.cli;
        variables.config = new bxrig.ConfigService().quiet( true );
        variables.sc = new bxrig.Shortcuts();
        return this;
    }

    function say( command, code, data, asJson, lines = [] ) {
        if ( arguments.asJson ) println( variables.cli.envelope( arguments.command, arguments.code, arguments.data, false ) );
        else for ( var l in arguments.lines ) println( l );
        return arguments.code;
    }

    function file() { return variables.sc.overridesFile(); }

    // The combos of the hl.bind lines in your Hyprland files (bxrig.lua is ours and skipped): [ { combo, file, line } ].
    function userBinds() {
        var out = [];
        var dir = variables.config.cfgHome() & "/hypr";
        if ( !directoryExists( dir ) ) return out;
        for ( var f in directoryList( dir, false, "name" ) ) {
            if ( right( f, 4 ) != ".lua" || f == "bxrig.lua" ) continue;
            var n = 0;
            for ( var line in listToArray( fileRead( dir & "/" & f ), chr( 10 ), true ) ) {
                n++;
                var t = trim( line );
                if ( left( t, 8 ) != "hl.bind(" ) continue;
                var cut = find( ", hl.", t );
                var fn = find( ", function", t );
                if ( fn > 0 && ( cut == 0 || fn < cut ) ) cut = fn;
                var pre = cut > 0 ? left( t, cut - 1 ) : t;
                var toks = [];
                if ( find( "mainMod", pre ) ) toks.append( "Super" );
                var pos = 1;
                while ( true ) {
                    var m = reFind( '"([^"]*)"', pre, pos, true );
                    if ( m.pos[ 1 ] == 0 ) break;
                    for ( var piece in listToArray( mid( pre, m.pos[ 2 ], m.len[ 2 ] ), "+" ) ) if ( len( trim( piece ) ) ) toks.append( trim( piece ) );
                    pos = m.pos[ 1 ] + m.len[ 1 ];
                }
                var norm = toks.len() > 1 ? variables.sc.normalize( toks.toList( "+" ) ) : "";
                if ( len( norm ) ) out.append( { combo: norm, file: f, line: n } );
            }
        }
        return out;
    }

    // Conflicts of the current table: { within: [ { combo, ids } ], user: [ { id, combo, file, line } ] }.
    function scan() {
        var rows = variables.sc.editable();
        var byCombo = {};
        for ( var r in rows ) {
            var c = variables.sc.normalize( r.keys );
            if ( !structKeyExists( byCombo, c ) ) byCombo[ c ] = [];
            byCombo[ c ].append( r.id );
        }
        var within = [];
        for ( var c2 in structKeyArray( byCombo ) ) if ( byCombo[ c2 ].len() > 1 ) within.append( { combo: c2, ids: byCombo[ c2 ] } );
        var user = [];
        for ( var ub in userBinds() ) if ( structKeyExists( byCombo, ub.combo ) ) for ( var id in byCombo[ ub.combo ] ) user.append( { id: id, combo: ub.combo, file: ub.file, line: ub.line } );
        return { within: within, user: user };
    }

    function conflicts( asJson ) {
        var sc = scan();
        var lines = [];
        for ( var w in sc.within ) lines.append( "Two BxRig bindings share " & w.combo & ": " & w.ids.toList( ", " ) );
        for ( var u in sc.user ) lines.append( u.id & " (" & u.combo & ") is also bound in your " & u.file & " line " & u.line );
        if ( !lines.len() ) lines.append( "No conflicts." );
        return say( "keys conflicts", 0, { ok: !( sc.within.len() || sc.user.len() ), within: sc.within, user: sc.user }, arguments.asJson, lines );
    }

    function writeOverrides( data ) {
        var body = serializeJSON( arguments.data ) & chr( 10 );
        return variables.config.configWrite( { name: "shortcuts-overrides", target: file(), mode: "644", content: body }, body, "apply", true, false ) == 0;
    }

    // `keys set ID KEYS`
    function setKeys( id, keys, yes, force, asJson ) {
        var cmd = "keys set";
        var row = {};
        for ( var r in variables.sc.table() ) if ( r.id == arguments.id ) row = r;
        if ( structIsEmpty( row ) ) return say( cmd, 4, { error: "Unknown binding" }, arguments.asJson, [ "error: unknown binding " & arguments.id & ". See: bxrig keys show" ] );
        if ( row.kind == "remap" ) return say( cmd, 4, { error: "Not editable" }, arguments.asJson, [ "error: " & arguments.id & " is a Cmd-style remap handled by xremap; only the bindings can be changed" ] );
        var parsed = variables.sc.parseKeys( arguments.keys );
        if ( !parsed.ok ) return say( cmd, 4, { error: parsed.error }, arguments.asJson, [ "error: " & parsed.error ] );
        var combo = variables.sc.normalize( arguments.keys );
        for ( var other in variables.sc.table() ) if ( other.id != arguments.id && variables.sc.normalize( other.keys ) == combo ) return say( cmd, 4, { error: "Used by " & other.id }, arguments.asJson, [ "error: " & arguments.keys & " is already used by " & other.id & " (" & other.action & ")" ] );
        var clash = userBinds().filter( function( ub ) { return ub.combo == combo; } );
        if ( clash.len() && !arguments.force ) return say( cmd, 4, { error: "Used in your files", file: clash[ 1 ].file, line: clash[ 1 ].line }, arguments.asJson, [ "error: " & arguments.keys & " is already bound in your " & clash[ 1 ].file & " line " & clash[ 1 ].line & " (add --force to use it anyway)" ] );
        var data = { id: arguments.id, keys: arguments.keys, was: row.keys };
        if ( !arguments.yes ) return say( cmd, 2, data, arguments.asJson, [ "Plan: " & row.action & " changes from " & row.keys & " to " & arguments.keys, "Nothing was changed. Add --yes to apply, then: bxrig keys apply --yes" ] );
        var cur = variables.sc.loadOverrides();
        cur[ arguments.id ] = arguments.keys;
        if ( !writeOverrides( cur ) ) return say( cmd, 6, { error: "Could not write " & file() }, arguments.asJson, [ "error: could not write " & file() ] );
        return say( cmd, 0, data, arguments.asJson, [ row.action & " is now " & arguments.keys & ". Write it into the Hyprland and Plasma settings: bxrig keys apply --yes" ] );
    }

    // `keys reset ID`
    function reset( id, yes, asJson ) {
        var cmd = "keys reset";
        var cur = variables.sc.loadOverrides();
        if ( !structKeyExists( cur, arguments.id ) ) return say( cmd, 4, { error: "No override" }, arguments.asJson, [ "error: " & arguments.id & " has no custom keys" ] );
        if ( !arguments.yes ) return say( cmd, 2, { id: arguments.id }, arguments.asJson, [ "Plan: " & arguments.id & " goes back to its default keys.", "Nothing was changed. Add --yes to apply." ] );
        structDelete( cur, arguments.id );
        if ( !writeOverrides( cur ) ) return say( cmd, 6, { error: "Could not write " & file() }, arguments.asJson, [ "error: could not write " & file() ] );
        return say( cmd, 0, { id: arguments.id }, arguments.asJson, [ arguments.id & " is back to its default keys. Write it: bxrig keys apply --yes" ] );
    }
}
