// Runner: providers, defaults, argv resolution (pure parts). Run from src/: (cd src && matchbox ../tests/runner_test.bxs)
failures = 0;
function check( label, ok ) { if ( ok ) println( "ok   " & label ); else { println( "FAIL " & label ); failures++; } }
r = new bxcachy.Runner();
check( "legacy launcher providers are all there", r.launcherProviders().toList( "," ) == "system,noctalia,rofi,walker,krunner,vicinae,hyprrunner,custom" );
check( "menu providers", r.menuProviders().toList( "," ) == "rofi,walker,vicinae,hyprrunner" );
check( "default launcher on Hyprland is Noctalia", r.defaults( "Hyprland" ).provider == "noctalia" );
check( "default launcher on KDE is the system runner", r.defaults( "KDE" ).provider == "system" && r.defaults( "KDE" ).menu_provider == "rofi" );
cfg = r.defaults( "Hyprland" );
check( "noctalia resolves to its panel command", r.resolve( "noctalia", cfg ).toList( " " ) == "noctalia msg panel-toggle launcher" );
check( "vicinae resolves to toggle", r.resolve( "vicinae", cfg ).toList( " " ) == "vicinae toggle" );
check( "system has no command, the desktop owns it", r.resolve( "system", cfg ).len() == 0 );
cfg.launcher_commands.rofi = [ "rofi", "-show", "run" ];
check( "a configured launcher command wins", r.resolve( "rofi", cfg ).toList( " " ) == "rofi -show run" );
cfg.custom_command = [ "my-launcher", "--fast" ];
check( "custom uses custom_command", r.resolve( "custom", cfg ).toList( " " ) == "my-launcher --fast" );
threw = false; try { r.resolve( "custom", r.defaults( "KDE" ) ); } catch ( any e ) { threw = true; }
check( "custom without a command is an error", threw );
check( "menu command fills {prompt}", r.menuCommand( "rofi", r.defaults( "KDE" ), "Apps" ).toList( " " ) == "rofi -dmenu -i -show-icons -format i -p Apps" );
cfg = r.defaults( "KDE" ); cfg.menu_commands.vicinae = [ "test-menu", "--title", "{prompt}" ];
check( "a menu override takes {prompt} too", r.menuCommand( "vicinae", cfg, "My Apps" ).toList( "|" ) == "test-menu|--title|My Apps" );
check( "argv validation: arrays of non-empty strings only", r.validArgv( [ "a", "b" ] ) && !r.validArgv( [] ) && !r.validArgv( "rofi -show drun" ) && !r.validArgv( [ "a", "" ] ) );
check( "every provider with a package maps to a catalog app", r.catalogId( "rofi" ) == "rofi" && r.catalogId( "walker" ) == "walker" && r.catalogId( "vicinae" ) == "vicinae" && r.catalogId( "noctalia" ) == "" && r.catalogId( "system" ) == "" );
if ( failures > 0 ) { println( failures & " failed" ); exit( 1 ); }
println( "all passed" );
