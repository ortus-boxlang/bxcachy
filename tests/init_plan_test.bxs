// InitPlan: wizard answers to ordered commands (pure). Run from src/: (cd src && matchbox ../tests/init_plan_test.bxs)
failures = 0;
function check( label, ok ) { if ( ok ) println( "ok   " & label ); else { println( "FAIL " & label ); failures++; } }
ip = new bxcachy.InitPlan();
function ids( p ) { return p.steps.map( function( s ) { return s.id; } ).toList( "," ); }
function cmd( p, id ) { for ( var s in p.steps ) if ( s.id == id ) return s.argv.toList( " " ); return ""; }

p = ip.plan( {} );
check( "no answers, no steps (an unanswered page does nothing)", p.steps.len() == 0 && p.pending.len() == 0 && p.errors.len() == 0 );

p = ip.plan( { desktops: "hyprland", layout: "master", terminal: "ghostty", shell: "zsh" } );
check( "Hyprland only: hyprland, terminal, shell, then the session", ids( p ) == "hyprland,terminal,shell,default-terminal,session" );
check( "hyprland step carries the terminal and the layout", cmd( p, "hyprland" ) == "bxcachy setup hyprland --terminal=ghostty --layout=master" );
check( "KDE is not configured when only Hyprland is chosen", find( "plasma", ids( p ) ) == 0 || !find( "setup plasma", p.steps.map( function( s ) { return s.argv.toList( " " ); } ).toList( "|" ) ) );
check( "the session follows the desktop", cmd( p, "session" ) == "bxcachy session set hyprland" );

p = ip.plan( { desktops: "plasma" } );
check( "KDE only: plasma and the plasma session", ids( p ) == "plasma,session" && cmd( p, "session" ) == "bxcachy session set plasma" );

p = ip.plan( { desktops: "both", login_session: "plasma", mac_keys: true } );
check( "Both configures both, login_session picks the session", ids( p ) == "hyprland,plasma,xremap,session" && cmd( p, "session" ) == "bxcachy session set plasma" );
check( "Both without login_session starts on Hyprland", cmd( ip.plan( { desktops: "both" } ), "session" ) == "bxcachy session set hyprland" );
check( "xremap builds for KDE when Plasma is the only desktop", cmd( ip.plan( { desktops: "plasma", mac_keys: true } ), "xremap" ) == "bxcachy setup xremap --build=kde" );
check( "mac_keys false adds nothing", find( "xremap", ids( ip.plan( { desktops: "hyprland", mac_keys: false } ) ) ) == 0 );

p = ip.plan( { terminal: "ghostty", terminals_extra: [ "kitty", "foot" ] } );
check( "terminals: default plus extras in one step", cmd( p, "terminal" ) == "bxcachy setup terminal --default=ghostty --also=kitty,foot" );

p = ip.plan( { ai_orchestrators: [ "pane", "herdr" ], ai_agents: [ "claude-code" ] } );
check( "apps: orchestrators and agents in one install", cmd( p, "apps" ) == "bxcachy install pane herdr claude-code tmux" );
check( "no apps chosen, no install step", find( "apps", ids( ip.plan( { ai_orchestrators: [], ai_agents: [] } ) ) ) == 0 );

p = ip.plan( { git_name: "Ada Lovelace", git_email: "ada@example.com" } );
check( "git identity is two argument arrays (no shell string)", ids( p ) == "git-name,git-email" && p.steps[ 1 ].argv[ 5 ] == "Ada Lovelace" && p.steps[ 1 ].argv.len() == 5 );

p = ip.plan( { launcher: "rofi", menu: "walker" } );
check( "launcher and menu: install what is needed, then record the choice", ids( p ) == "apps,launcher,menu" && cmd( p, "apps" ) == "bxcachy install rofi walker" && cmd( p, "launcher" ) == "bxcachy runner set rofi" && cmd( p, "menu" ) == "bxcachy runner menu-set walker" );
p = ip.plan( { launcher: "noctalia", menu: "rofi" } );
p = ip.plan( { launcher: "fuzzel", menu: "wofi" } );
check( "Fuzzel and Wofi are installed from the catalog", cmd( p, "apps" ) == "bxcachy install fuzzel wofi" );
p = ip.plan( { launcher: "noctalia", menu: "rofi" } );
check( "Noctalia needs no package of its own", cmd( p, "apps" ) == "bxcachy install rofi" && cmd( p, "launcher" ) == "bxcachy runner set noctalia" );

p = ip.plan( { ssh_key: true, natural_scroll: false, layouts: [] } );
check( "ssh_key is now a step (optional: ssh-keygen asks for a passphrase), no longer pending", p.pending.len() == 0 && cmd( p, "ssh-key" ) == "bxcachy ssh key" && ( p.steps[ 1 ].optional ?: false ) );
check( "the SSH key takes the git email as its comment", cmd( ip.plan( { ssh_key: true, git_email: "ada@example.com" } ), "ssh-key" ) == "bxcachy ssh key --email=ada@example.com" && find( "ssh-key", ids( ip.plan( { ssh_key: false } ) ) ) == 0 );
p = ip.plan( { desktops: "plasma", layouts: [ "us-intl", "es" ] } );
check( "Plasma gets its keyboard layouts through setup keyboard (not pending)", cmd( p, "plasma-keyboard" ) == "bxcachy setup keyboard --layouts=us-intl,es" && p.pending.len() == 0 );
check( "Hyprland-only has no Plasma keyboard step", find( "plasma-keyboard", ids( ip.plan( { desktops: "hyprland", layouts: [ "us" ] } ) ) ) == 0 );
p = ip.plan( { container_engine: "docker", databases: [ "postgres", "meilisearch" ] } );
check( "databases: docker is remembered, then each service starts", ids( p ) == "apps,db-engine,db-postgres,db-meilisearch" && cmd( p, "db-engine" ) == "bxcachy db engine docker" && cmd( p, "db-postgres" ) == "bxcachy db start postgres" && cmd( p, "db-meilisearch" ) == "bxcachy db start meilisearch" );
p = ip.plan( { databases: [ "postgres", "redis" ], database_passwords: "ask" } );
check( "asking for passwords adds the prompt flag, except for engines with no password", cmd( p, "db-postgres" ) == "bxcachy db start postgres --ask-password" && cmd( p, "db-redis" ) == "bxcachy db start redis" );
check( "generated passwords add nothing", cmd( ip.plan( { databases: [ "postgres" ], database_passwords: "generate" } ), "db-postgres" ) == "bxcachy db start postgres" );
p = ip.plan( { desktops: "hyprland", dotfiles_repo: "https://github.com/me/dotfiles" } );
check( "your dotfiles are the last step", ids( p ) == "hyprland,session,dotfiles" || ids( p ).endsWith( ",dotfiles" ) );
check( "dotfiles: the command takes the repo, the method is detected", cmd( p, "dotfiles" ) == "bxcachy dotfiles apply https://github.com/me/dotfiles" );
check( "an empty repo answer adds nothing", find( "dotfiles", ids( ip.plan( { dotfiles_repo: "" } ) ) ) == 0 );
check( "no databases picked: nothing starts (Podman needs no setting)", ids( ip.plan( { container_engine: "podman", databases: [] } ) ) == "containers" );
check( "Docker without databases is still remembered", cmd( ip.plan( { container_engine: "docker", databases: [] } ), "db-engine" ) == "bxcachy db engine docker" );
p = ip.plan( { desktops: "hyprland", workspaces: 4, natural_scroll: true, layouts: [ "us-intl", "es" ], theme: "light", wallpaper: "aurora" } );
check( "the Hyprland starter takes workspaces, natural scroll, layouts, theme and wallpaper", cmd( p, "hyprland" ) == "bxcachy setup hyprland --workspaces=4 --natural-scroll --layouts=us-intl,es --theme=light --wallpaper=aurora" && p.pending.len() == 0 );
p = ip.plan( { desktops: "plasma", workspaces: 4, theme: "light" } );
check( "those answers are pending when Hyprland is not set up", p.pending.toList( "," ) == "workspaces,theme" );

p = ip.plan( { toolchains: [ "java", "php", "go" ] } );
check( "toolchains: a catalog profile each, Laravel after PHP", ids( p ) == "toolchain-java,toolchain-php,laravel,toolchain-go" && cmd( p, "toolchain-java" ) == "bxcachy profile-install jvm" && cmd( p, "laravel" ) == "composer global require laravel/installer" );
p = ip.plan( { toolchains: [ "javascript" ], js_runtimes: [ "node", "bun", "deno" ] } );
check( "JavaScript: Node through nvm, Bun and Deno as catalog apps", ids( p ) == "toolchain-node,apps" && cmd( p, "toolchain-node" ) == "bxcachy toolchain node" && cmd( p, "apps" ) == "bxcachy install bun deno" );
check( "JavaScript without a runtime answer means Node", cmd( ip.plan( { toolchains: [ "javascript" ] } ), "toolchain-node" ) == "bxcachy toolchain node" );
check( "Bun only is just the catalog app", ids( ip.plan( { toolchains: [ "javascript" ], js_runtimes: [ "bun" ] } ) ) == "apps" );
check( "python is the python profile", cmd( ip.plan( { toolchains: [ "python" ] } ), "toolchain-python" ) == "bxcachy profile-install python" );
check( "no toolchains, no steps", ip.plan( { toolchains: [] } ).steps.len() == 0 );

check( "Podman is the containers profile", cmd( ip.plan( { container_engine: "podman" } ), "containers" ) == "bxcachy profile-install containers" );
check( "Docker is one extra package", cmd( ip.plan( { container_engine: "docker" } ), "apps" ) == "bxcachy install docker" && find( "containers", ids( ip.plan( { container_engine: "docker" } ) ) ) == 0 );

p = ip.plan( { vpn: "proton", password_manager: "keepassxc", gaming: "steam", backups: [ "snapper", "restic" ] } );
check( "VPN, password manager, Steam and backups share one install", cmd( p, "apps" ) == "bxcachy install proton-vpn keepassxc steam snapper snap-pac restic" );
check( "VPN none and gaming none add nothing", ip.plan( { vpn: "none", gaming: "none", password_manager: "none" } ).steps.len() == 0 );
check( "the gaming bundle is the gaming profile", cmd( ip.plan( { gaming: "bundle" } ), "gaming" ) == "bxcachy profile-install gaming" );

p = ip.plan( { desktops: "gnome" } );
check( "an unknown desktop is an error", p.errors.len() == 1 && p.steps.len() == 0 );

// ---- apps: Basic or Customize, the default browser and terminal ----
check( "Basic installs the recommended set for the chosen desktop", cmd( ip.plan( { desktops: "hyprland", app_mode: "defaults" } ), "apps-basic" ) == "bxcachy install --shell=hyprland" && cmd( ip.plan( { desktops: "plasma", app_mode: "defaults" } ), "apps-basic" ) == "bxcachy install --shell=plasma" && cmd( ip.plan( { desktops: "both", app_mode: "defaults" } ), "apps-basic" ) == "bxcachy install --shell=all" );
check( "Basic without a desktop answer uses the running desktop", cmd( ip.plan( { app_mode: "defaults" } ), "apps-basic" ) == "bxcachy install" );
check( "no app_mode answer, no app step", find( "apps-basic", ids( ip.plan( { desktops: "hyprland" } ) ) ) == 0 );
sm = { "hypr-tool": [ "hyprland" ], "kde-tool": [ "plasma" ] };
c = { app_mode: "custom", apps_everyday_browsers: [ "firefox" ], apps_media_video: [ "mpv", "hypr-tool", "kde-tool" ] };
c.desktops = "plasma"; p = ip.plan( c, sm );
check( "Customize installs what was ticked, dropping apps for the other desktop", cmd( p, "apps" ) == "bxcachy install firefox mpv kde-tool" && find( "apps-basic", ids( p ) ) == 0 );
c.desktops = "hyprland"; check( "and the reverse on Hyprland", cmd( ip.plan( c, sm ), "apps" ) == "bxcachy install firefox mpv hypr-tool" );
c.desktops = "both"; check( "Both keeps everything", cmd( ip.plan( c, sm ), "apps" ) == "bxcachy install firefox mpv hypr-tool kde-tool" );
p = ip.plan( { app_mode: "custom", default_browser: "brave", apps_everyday_browsers: [ "firefox" ] } );
check( "the default browser is installed too (even when not ticked) and set as default, after the install", cmd( p, "apps" ) == "bxcachy install firefox brave" && cmd( p, "default-browser" ) == "bxcachy default browser brave" && ids( p ) == "apps,default-browser" );
p = ip.plan( { app_mode: "defaults", file_manager: "strata", toolchains: [ "rust" ] } );
check( "file manager: installed, then set as default; rust: rustup stable, optional", cmd( p, "apps" ) == "bxcachy install strata" && cmd( p, "default-filemanager" ) == "bxcachy default filemanager strata" && cmd( p, "toolchain-rust" ) == "rustup default stable" && cmd( p, "strata-integrations" ) == "bxcachy strata integrations" );
p = ip.plan( { app_mode: "defaults", dictation: "voxtype" } );
check( "dictation voxtype installs voxtype and wtype", cmd( p, "apps" ) == "bxcachy install voxtype wtype" );
p = ip.plan( { app_mode: "defaults", dictation: "none" } );
check( "dictation none adds nothing", ids( p ) == "apps-basic" );
p = ip.plan( { app_mode: "defaults", default_browser: "firefox" } );
check( "in Basic mode a different default browser is added to the install", ids( p ) == "apps-basic,apps,default-browser" && cmd( p, "apps" ) == "bxcachy install firefox" );
check( "the default terminal follows the terminal answer", cmd( ip.plan( { terminal: "kitty" } ), "default-terminal" ) == "bxcachy default terminal kitty" );

// ---- AI: agents, keys, default ----
p = ip.plan( { ai_agents: [ "claude-code", "codex-cli" ], ai_default: "codex-cli", ai_keys: "later" } );
check( "agents are installed, a keyring is checked, and the default is set", cmd( p, "apps" ) == "bxcachy install claude-code codex-cli tmux" && cmd( p, "secrets-setup" ) == "bxcachy secrets setup" && cmd( p, "ai-default" ) == "bxcachy ai default codex-cli" );
check( "keys 'later' asks for nothing", find( "key-", ids( p ) ) == 0 );
check( "the keyring check comes after the install and before the default", ids( p ) == "apps,secrets-setup,ai-default" );
p = ip.plan( { ai_agents: [ "claude-code", "gemini-cli" ], ai_keys: "now", ai_global_keys: [ "GEMINI_API_KEY", "OPENAI_API_KEY" ] } );
check( "keys 'now' types one key per chosen agent, as optional steps", cmd( p, "key-ANTHROPIC_API_KEY" ) == "bxcachy secrets set ANTHROPIC_API_KEY" && cmd( p, "key-GEMINI_API_KEY" ) == "bxcachy secrets set GEMINI_API_KEY" && find( "key-OPENAI_API_KEY", ids( p ) ) == 0 );
optional = true; for ( s in p.steps ) if ( left( s.id, 4 ) == "key-" && !( s.optional ?: false ) ) optional = false;
check( "key steps are optional (skipping never stops the plan)", optional );
check( "a global export is planned only for a key of a chosen agent", cmd( p, "global-GEMINI_API_KEY" ) == "bxcachy secrets global on GEMINI_API_KEY" && find( "global-OPENAI_API_KEY", ids( p ) ) == 0 );
p = ip.plan( { ai_agents: [ "opencode-cli" ], ai_keys: "now", ai_providers: [ "novita", "openrouter", "anthropic" ], ai_global_keys: [ "NOVITA_API_KEY", "GROQ_API_KEY" ] } );
check( "a many-provider agent implies no key; the ticked providers are asked", cmd( p, "key-NOVITA_API_KEY" ) == "bxcachy secrets set NOVITA_API_KEY" && cmd( p, "key-OPENROUTER_API_KEY" ) == "bxcachy secrets set OPENROUTER_API_KEY" && cmd( p, "key-ANTHROPIC_API_KEY" ) == "bxcachy secrets set ANTHROPIC_API_KEY" && find( "key-OPENAI_API_KEY", ids( p ) ) == 0 );
check( "global export only for keys that are being typed", cmd( p, "global-NOVITA_API_KEY" ) == "bxcachy secrets global on NOVITA_API_KEY" && find( "global-GROQ_API_KEY", ids( p ) ) == 0 );
p = ip.plan( { ai_agents: [ "claude-code" ], ai_keys: "now", ai_providers: [ "anthropic", "novita" ] } );
check( "a key is asked once even when the agent and the providers both name it", ids( p ) == "apps,secrets-setup,key-ANTHROPIC_API_KEY,key-NOVITA_API_KEY" );
check( "an unknown provider is an error", ip.plan( { ai_keys: "now", ai_providers: [ "nope" ] } ).errors.len() == 1 );
p = ip.plan( { ai_local: [ "ollama", "jan" ], ai_local_gpu: "nvidia" } );
check( "local models are installed, with the GPU build of Ollama for your card", cmd( p, "apps" ) == "bxcachy install ollama jan ollama-cuda" );
check( "AMD gets ROCm", cmd( ip.plan( { ai_local: [ "ollama" ], ai_local_gpu: "amd" } ), "apps" ) == "bxcachy install ollama ollama-rocm" );
check( "no GPU build without Ollama or without an answer", cmd( ip.plan( { ai_local: [ "jan" ], ai_local_gpu: "nvidia" } ), "apps" ) == "bxcachy install jan" && cmd( ip.plan( { ai_local: [ "ollama" ] } ), "apps" ) == "bxcachy install ollama" );
check( "Plasma with an agent also installs Yakuake for the pull-down AI shell", cmd( ip.plan( { desktops: "plasma", ai_agents: [ "claude-code" ] } ), "apps" ) == "bxcachy install claude-code tmux yakuake" && cmd( ip.plan( { desktops: "both", ai_agents: [ "claude-code" ] } ), "apps" ) == "bxcachy install claude-code tmux yakuake" );
check( "Hyprland only, or Plasma without agents, adds no Yakuake", cmd( ip.plan( { desktops: "hyprland", ai_agents: [ "claude-code" ] } ), "apps" ) == "bxcachy install claude-code tmux" && find( "apps", ids( ip.plan( { desktops: "plasma" } ) ) ) == 0 );
p = ip.plan( { ai_local: [ "ollama" ], ai_ollama_service: true, ai_models: "qwen3:8b, llama3.2 ,," } );
check( "Ollama: the service step, then one optional pull per model", ids( p ) == "apps,ollama-service,model-qwen3:8b,model-llama3.2" && cmd( p, "model-qwen3:8b" ) == "bxcachy ai models pull qwen3:8b" );
optionalPull = true; for ( s in p.steps ) if ( left( s.id, 6 ) == "model-" && !( s.optional ?: false ) ) optionalPull = false;
check( "model downloads are optional steps", optionalPull );
check( "no service step unless asked, no model steps without Ollama", find( "ollama-service", ids( ip.plan( { ai_local: [ "ollama" ], ai_ollama_service: false } ) ) ) == 0 && find( "model-", ids( ip.plan( { ai_local: [ "jan" ], ai_models: "x" } ) ) ) == 0 );
check( "a bad model name is an error", ip.plan( { ai_local: [ "ollama" ], ai_models: "a;b" } ).errors.len() == 1 );
check( "tmux comes with the agents", cmd( ip.plan( { ai_agents: [ "claude-code" ] } ), "apps" ) == "bxcachy install claude-code tmux" );
p = ip.plan( { container_engine: "podman", docker_compat: true } );
check( "Podman with docker compatibility adds the shim step after the containers profile", ids( p ) == "containers,docker-compat" && cmd( p, "docker-compat" ) == "bxcachy containers docker-compat" );
check( "no docker shim without the answer, or on Docker", find( "docker-compat", ids( ip.plan( { container_engine: "podman" } ) ) ) == 0 && find( "docker-compat", ids( ip.plan( { container_engine: "docker", docker_compat: true } ) ) ) == 0 );
check( "the LazyVim starter is a step", cmd( ip.plan( { editor_starter: "lazyvim" } ), "editor-lazyvim" ) == "bxcachy editor lazyvim" && find( "editor-lazyvim", ids( ip.plan( { editor_starter: "none" } ) ) ) == 0 );
p = ip.plan( { desktop_utilities: [ "cliphist", "wf-recorder", "playerctl" ] } );
check( "desktop utilities are installed in the one apps step", cmd( p, "apps" ) == "bxcachy install cliphist wf-recorder playerctl" );
p = ip.plan( { vpn: "nordvpn", remote_desktop: [ "remmina", "rustdesk" ] } );
check( "NordVPN is installed, then set up (optional step); remote desktop apps join the install", cmd( p, "apps" ) == "bxcachy install remmina rustdesk nordvpn" && cmd( p, "vpn-nordvpn" ) == "bxcachy vpn nordvpn setup" && ( p.steps[ 2 ].optional ?: false ) );
check( "cloud storage installs rclone and fuse3, and nothing without the answer", cmd( ip.plan( { cloud_storage: true } ), "apps" ) == "bxcachy install rclone fuse3" && ip.plan( { cloud_storage: false } ).steps.len() == 0 );
p = ip.plan( { desktops: "plasma", plasma_layout: "master" } );
plStep = p.steps.filter( function( x ) { return x.id == "plasma-layout"; } )[ 1 ];
check( "the Plasma layout is an optional tiling layout step", cmd( p, "plasma-layout" ) == "bxcachy tiling layout master" && ( plStep.optional ?: false ) );
check( "no Plasma layout step on Hyprland only, and an unknown layout is an error", find( "plasma-layout", ids( ip.plan( { desktops: "hyprland", plasma_layout: "master" } ) ) ) == 0 && ip.plan( { desktops: "plasma", plasma_layout: "spiral" } ).errors.len() == 1 );
check( "no keys step without an answer", find( "key-", ids( ip.plan( { ai_agents: [ "claude-code" ] } ) ) ) == 0 );
p = ip.plan( { ai_agents: [ "claude-code" ], ai_default: "gemini-cli" } );
check( "a default agent that was not ticked is installed too", cmd( p, "apps" ) == "bxcachy install claude-code gemini-cli tmux" );
check( "an unknown default agent is an error", ip.plan( { ai_default: "bogus" } ).errors.len() == 1 );
check( "no agents, no keyring step", ip.plan( { ai_agents: [], ai_keys: "later" } ).steps.len() == 0 );

if ( failures > 0 ) { println( failures & " failed" ); exit( 1 ); }
println( "all passed" );
