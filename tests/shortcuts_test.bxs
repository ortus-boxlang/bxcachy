// Shortcuts: the shared table and its renderings. Run from src/: (cd src && matchbox ../tests/shortcuts_test.bxs)
failures = 0;
function check( label, ok ) { if ( ok ) println( "ok   " & label ); else { println( "FAIL " & label ); failures++; } }
sc = new bxcachy.Shortcuts();
ids = sc.table().map( function( r ) { return r.id; } ).toList( "," );
check( "the Hyprland-only bindings follow", ids == "copy,paste,switch-windows,logout,ai-shell,clipboard-history,screen-record,screen-record-region,control-center,all-apps" );
x = sc.render( "xremap" );
check( "xremap: terminals send Ctrl+Shift+C/V", find( "Super-c: Ctrl-Shift-c", x ) > 0 && find( "Super-v: Ctrl-Shift-v", x ) > 0 );
check( "xremap: elsewhere Ctrl+C/V and Alt-Tab", find( "Super-c: Ctrl-c", x ) > 0 && find( "Super-tab: Alt-Tab", x ) > 0 );
check( "xremap: terminal rule uses only, general rule uses not", find( "only: [", x ) > 0 && find( "not: [", x ) > 0 && find( "'kitty'", x ) > 0 );
h = sc.render( "hyprland" );
check( "hyprland: Lua module, logout bind via uwsm", find( 'hl.dsp.exec_cmd("uwsm stop")', h ) > 0 && find( 'mainMod .. " + SHIFT + Q"', h ) > 0 );
check( "hyprland: Noctalia autostart and launcher", find( 'hl.exec_cmd("noctalia")', h ) > 0 && find( "panel-toggle launcher", h ) > 0 );
check( "hyprland: Alt+Tab opens the Noctalia window switcher", find( 'hl.bind("ALT + Tab"', h ) > 0 && find( "window-switcher hold", h ) > 0 );
check( "hyprland: Super+Space follows the chosen launcher and falls back to Noctalia", find( "bxcachy runner launch || noctalia msg panel-toggle launcher", h ) > 0 && find( '+Space", hl.dsp.exec_cmd(ipc', h ) == 0 );
check( "hyprland: no hyprlang bind lines", find( "bind = ", h ) == 0 );
check( "hyprland load line", sc.hyprlandLoadLine() == 'require("bxcachy")' );
check( "plasma: ksmserver Log Out is Meta+Shift+Q", find( "[ksmserver]", sc.render( "plasma" ) ) > 0 && find( "Log Out=Meta+Shift+Q", sc.render( "plasma" ) ) > 0 );
check( "show lists every row", sc.show().len() == 10 );
threw = false;
try { sc.render( "bogus" ); } catch ( any e ) { threw = true; }
check( "unknown target throws", threw );
// ---- key combos (the shortcut editor) ----
check( "parseKeys: Super+Shift+V", sc.parseKeys( "Super+Shift+V" ).ok && sc.normalize( "Super+Shift+V" ) == "SHIFT+SUPER+V" );
check( "parseKeys: order, case and spellings do not matter", sc.normalize( "shift+SUPER+v" ) == sc.normalize( "Super+Shift+V" ) && sc.normalize( "Meta+Alt+Enter" ) == sc.normalize( "Super+Alt+Return" ) );
check( "parseKeys: a backtick is grave", sc.parseKeys( "Super+`" ).key == "grave" );
check( "parseKeys rejects a bare key, an unknown modifier and an unknown key", !sc.parseKeys( "V" ).ok && !sc.parseKeys( "Hyper+V" ).ok && !sc.parseKeys( "Super+Banana" ).ok );
check( "hyprExpr with and without Super", sc.hyprExpr( "Super+Shift+V" ) == 'mainMod .. " + SHIFT + V"' && sc.hyprExpr( "Ctrl+Alt+Q" ) == '"CTRL + ALT + Q"' );
check( "qtKeys is Qt's spelling", sc.qtKeys( "Super+Shift+Q" ) == "Meta+Shift+Q" && sc.qtKeys( "Super+Alt+Space" ) == "Meta+Alt+Space" );
over = new bxcachy.Shortcuts( { "ai-shell": "Super+Alt+A", copy: "Super+Alt+C", bogus: "x" } );
check( "an override changes a binding's keys, not a remap's, and an unknown id is ignored", over.table().filter( function( r ) { return r.id == "ai-shell"; } )[ 1 ].keys == "Super+Alt+A" && over.table()[ 1 ].keys == "Super+C" && over.table().len() == 10 );
check( "an override reaches the rendered Hyprland text", find( 'hl.bind(mainMod .. " + ALT + A"', over.render( "hyprland" ) ) > 0 && find( '" + grave"', over.render( "hyprland" ) ) == 0 );
check( "an override with bad keys is ignored", new bxcachy.Shortcuts( { "ai-shell": "nonsense" } ).table().filter( function( r ) { return r.id == "ai-shell"; } )[ 1 ].keys == "Super+`" );

if ( failures > 0 ) { println( failures & " failed" ); exit( 1 ); }
println( "all passed" );
