// Shortcuts: the shared table and its renderings. Run from src/: (cd src && matchbox ../tests/shortcuts_test.bxs)
failures = 0;
function check( label, ok ) { if ( ok ) println( "ok   " & label ); else { println( "FAIL " & label ); failures++; } }
sc = new bxcachy.Shortcuts();
ids = sc.table().map( function( r ) { return r.id; } ).toList( "," );
check( "minimum set: copy, paste, window switch, logout", ids == "copy,paste,switch-windows,logout" );
x = sc.render( "xremap" );
check( "xremap: terminals send Ctrl+Shift+C/V", find( "Super-c: Ctrl-Shift-c", x ) > 0 && find( "Super-v: Ctrl-Shift-v", x ) > 0 );
check( "xremap: elsewhere Ctrl+C/V and Alt-Tab", find( "Super-c: Ctrl-c", x ) > 0 && find( "Super-tab: Alt-Tab", x ) > 0 );
check( "xremap: terminal rule uses only, general rule uses not", find( "only: [", x ) > 0 && find( "not: [", x ) > 0 && find( "'kitty'", x ) > 0 );
check( "hyprland: logout bind via uwsm", find( "bind = SUPER SHIFT, Q, exec, uwsm stop", sc.render( "hyprland" ) ) > 0 );
check( "plasma: ksmserver Log Out is Meta+Shift+Q", find( "[ksmserver]", sc.render( "plasma" ) ) > 0 && find( "Log Out=Meta+Shift+Q", sc.render( "plasma" ) ) > 0 );
check( "show lists every row", sc.show().len() == 4 );
threw = false;
try { sc.render( "bogus" ); } catch ( any e ) { threw = true; }
check( "unknown target throws", threw );
if ( failures > 0 ) { println( failures & " failed" ); exit( 1 ); }
println( "all passed" );
