// SetupPlan: facts and request to steps. Run from src/: (cd src && matchbox ../tests/setup_plan_test.bxs)
failures = 0;
function check( label, ok ) { if ( ok ) println( "ok   " & label ); else { println( "FAIL " & label ); failures++; } }
plan = new bxcachy.SetupPlan();
function facts( over = {} ) {
 f = { isRoot: false, hasSudo: true, kwinVersion: "6.6.2", desktop: "KDE", sessionType: "wayland", installed: { git: true, "python-dbus": true, "python-gobject": true, "qt6-tools": true }, hyprkwinInstalled: false, workDir: "/tmp/hk", os: "cachyos", arch: "x86_64", hasPacman: true, hyprlandAdded: [] };
 for ( k in over ) f[k] = over[k];
 return f;
}
ids = function( p ) { return p.steps.map( function( s ) { return s.id; } ).toList( "," ); };

check( "pins: a full commit", reFind( "^[0-9a-f]{40}$", plan.pins().hyprkwin.commit ) > 0 );
check( "support: 6.6 and 6.8 tested, 6.7 untested, 6.5 and 5.27 not", plan.plasmaSupport( "6.6.2" ) == "tested" && plan.plasmaSupport( "6.8.0" ) == "tested" && plan.plasmaSupport( "6.7.1" ) == "untested" && plan.plasmaSupport( "6.5.4" ) == "unsupported" && plan.plasmaSupport( "5.27.9" ) == "unsupported" );

p = plan.plasma( facts(), {} );
check( "fresh install: fetch then install, no keys step", p.errors.len() == 0 && ids( p ) == "fetch,install" );
check( "fetch clones the repo and checks out the pinned commit", p.steps[1].commands[1][2] == "clone" && p.steps[1].commands[2][6] == plan.pins().hyprkwin.commit && p.steps[1].commands[2][3] == "/tmp/hk" );
check( "install runs tools/install.sh inside the checkout, as the user (no sudo)", p.steps[2].commands[1].toList( " " ) == "env -C /tmp/hk tools/install.sh" );
check( "keys stay off by default and the notes say how to enable them", find( "--keys", p.notes.toList( " " ) ) > 0 && find( "Log out", p.notes.toList( " " ) ) > 0 );

p = plan.plasma( facts( { installed: { git: true } } ), {} );
check( "missing packages: one sudo pacman step first", ids( p ) == "packages,fetch,install" && p.steps[1].commands[1].toList( " " ) == "sudo pacman -S --needed --noconfirm python-dbus python-gobject qt6-tools" );
p = plan.plasma( facts( { installed: {}, hasSudo: false } ), {} );
check( "missing packages without sudo is an error", p.errors.len() == 1 && p.steps.len() == 0 );

p = plan.plasma( facts(), { keys: true } );
check( "--keys adds the apply step after the install", ids( p ) == "fetch,install,keys-apply" && p.steps[3].commands[1].toList( " " ) == "env -C /tmp/hk python3 tools/hyprkwin-shortcuts.py apply" && p.notes.len() == 1 );
p = plan.plasma( facts( { hyprkwinInstalled: true } ), { undoKeys: true } );
check( "--undo-keys: fetch then restore, no install", ids( p ) == "fetch,keys-restore" && p.steps[2].commands[1][6] == "restore" );
p = plan.plasma( facts(), { undoKeys: true } );
check( "--undo-keys without HyprKwin is an error", p.errors.len() == 1 && find( "not installed", p.errors[1] ) > 0 );
p = plan.plasma( facts(), { keys: true, undoKeys: true } );
check( "--keys with --undo-keys is an error", find( "not both", p.errors.toList( " " ) ) > 0 );
p = plan.plasma( facts( { hyprkwinInstalled: true } ), {} );
check( "already installed: an update step, no logout note", ids( p ) == "fetch,install" && find( "update HyprKwin", p.steps[2].title ) > 0 && find( "Log out", p.notes.toList( " " ) ) == 0 );

p = plan.plasma( facts( { isRoot: true } ), {} );
check( "root is refused", p.errors.len() == 1 && p.steps.len() == 0 );
p = plan.plasma( facts( { kwinVersion: "" } ), {} );
check( "no Plasma is refused", find( "not installed", p.errors[1] ) > 0 );
p = plan.plasma( facts( { kwinVersion: "6.4.0" } ), {} );
check( "an unsupported Plasma is refused", find( "6.6 and 6.8", p.errors[1] ) > 0 );
p = plan.plasma( facts( { kwinVersion: "6.7.1" } ), {} );
check( "Plasma 6.7 runs with a warning", p.errors.len() == 0 && p.warnings.len() == 1 );
p = plan.plasma( facts( { sessionType: "x11" } ), {} );
check( "an X11 Plasma session is refused", find( "Wayland", p.errors[1] ) > 0 );
p = plan.plasma( facts( { desktop: "Hyprland", sessionType: "wayland" } ), {} );
check( "running it from another desktop is fine", p.errors.len() == 0 );

p = plan.undoPlasma( facts( { hyprkwinInstalled: true } ) );
check( "undo: fetch then uninstall", ids( p ) == "fetch,uninstall" && p.steps[2].commands[1].toList( " " ) == "env -C /tmp/hk tools/uninstall.sh" );
p = plan.undoPlasma( facts() );
check( "undo without HyprKwin is an error", p.errors.len() == 1 );

// ---- hyprland
pk = plan.hyprlandPackages();
check( "hyprland packages: native noctalia, no meta-package, no quickshell variant", arrayFind( pk, "noctalia" ) > 0 && !arrayFind( pk, "cachyos-hypr-noctalia" ) && !arrayFind( pk, "noctalia-shell" ) && !arrayFind( pk, "noctalia-qs" ) && arrayFind( pk, "hyprland" ) > 0 && arrayFind( pk, "uwsm" ) > 0 );
p = plan.hyprland( facts( { installed: {} } ), {} );
check( "hyprland: one sudo pacman call with every package", p.errors.len() == 0 && ids( p ) == "packages,images,starter,keys" && p.steps[1].commands[1].len() == 5 + pk.len() && p.steps[1].commands[1][1] == "sudo" && p.steps[1].commands[1][2] == "pacman" && p.added.len() == pk.len() );
have = {}; for ( x in pk ) have[x] = true;
p = plan.hyprland( facts( { installed: have } ), {} );
check( "hyprland: everything installed means no package step, a note, and still the config steps", ids( p ) == "images,starter,keys" && p.errors.len() == 0 && find( "already installed", p.notes[1] ) > 0 && p.added.len() == 0 );
check( "hyprland: the config steps run no commands (they are executed in process)", p.steps[1].kind == "assets" && p.steps[2].kind == "starter" && p.steps[3].kind == "keys" && p.steps[2].commands.len() == 0 );
part = {}; part["hyprland"] = true; part["kitty"] = true;
p = plan.hyprland( facts( { installed: part } ), {} );
check( "hyprland: only the missing packages are installed", p.added.len() == pk.len() - 2 && !arrayFind( p.added, "hyprland" ) && !arrayFind( p.added, "kitty" ) && arrayFind( p.added, "noctalia" ) > 0 );
check( "hyprland: root, no pacman, other OS, other CPU and no sudo are refused", plan.hyprland( facts( { isRoot: true } ), {} ).errors.len() == 1 && plan.hyprland( facts( { hasPacman: false } ), {} ).errors.len() == 1 && find( "Unsupported OS", plan.hyprland( facts( { os: "ubuntu" } ), {} ).errors[1] ) > 0 && find( "x86_64", plan.hyprland( facts( { arch: "aarch64" } ), {} ).errors[1] ) > 0 && plan.hyprland( facts( { hasSudo: false, installed: {} } ), {} ).errors.len() == 1 );
check( "hyprland: Arch is accepted like CachyOS", plan.hyprland( facts( { os: "arch", installed: {} } ), {} ).errors.len() == 0 );
w = {}; w["noctalia-qs"] = true;
check( "hyprland: the Quickshell variant installed gives a warning, not an error", plan.hyprland( facts( { installed: w } ), {} ).warnings.len() == 1 && plan.hyprland( facts( { installed: w } ), {} ).errors.len() == 0 );
added = [ "noctalia", "kitty" ]; haveAdded = { noctalia: true, kitty: true, hyprland: true };
p = plan.undoHyprland( facts( { hyprlandAdded: added, installed: haveAdded } ) );
check( "undo hyprland: removes only what setup installed", p.steps.len() == 1 && p.steps[1].commands[1].toList( " " ) == "sudo pacman -Rs --noconfirm noctalia kitty" );
check( "undo hyprland: nothing recorded is an error", plan.undoHyprland( facts( { hyprlandAdded: [] } ) ).errors.len() == 1 );
check( "undo hyprland: already removed is an error", plan.undoHyprland( facts( { hyprlandAdded: added, installed: {} } ) ).errors.len() == 1 );

// setup xremap
function xfacts( over = {} ) {
 f = facts( { desktop: "Hyprland", installed: {}, hasYay: true, user: "dev", groups: [ "dev", "wheel" ], udevRule: false } );
 for ( k in over ) f[k] = over[k];
 return f;
}
x = plan.xremap( xfacts(), {} );
check( "xremap on Hyprland: package, udev, group, config, service", ids( x ) == "package,udev,group,config,service" && x.steps[1].commands[1][5] == "xremap-hypr-bin" );
check( "xremap udev step writes one rule line and reloads udev", x.steps[2].commands.len() == 3 && find( 'KERNEL=="uinput"', x.steps[2].commands[1][4] ) > 0 && x.steps[2].commands[1][4] contains "99-bxcachy-input.rules" );
check( "xremap remembers what it added", x.added.package == "xremap-hypr-bin" && x.added.group && x.added.udev );
x = plan.xremap( xfacts( { desktop: "KDE" } ), {} );
check( "xremap on KDE uses the kde build", x.steps[1].commands[1][5] == "xremap-kde-bin" );
x = plan.xremap( xfacts( { desktop: "KDE" } ), { build: "hypr" } );
check( "--build overrides the detected desktop", x.steps[1].commands[1][5] == "xremap-hypr-bin" );
x = plan.xremap( xfacts( { installed: { "xremap-hypr-bin": true }, udevRule: true, groups: [ "dev", "input" ] } ), {} );
check( "xremap already set up: only config and service", ids( x ) == "config,service" && x.added.package == "" && !x.added.group && !x.added.udev );
check( "xremap: unknown desktop is an error", plan.xremap( xfacts( { desktop: "" } ), {} ).errors.len() == 1 );
check( "xremap: no yay is an error when the package is missing", plan.xremap( xfacts( { hasYay: false } ), {} ).errors.len() == 1 );
check( "xremap: root is an error", plan.xremap( xfacts( { isRoot: true } ), {} ).errors.len() == 1 );
u = plan.undoXremap( xfacts( { installed: { "xremap-hypr-bin": true } } ), { package: "xremap-hypr-bin", group: true, udev: true } );
check( "undo xremap: service, package, udev, group", ids( u ) == "service,package,udev,group" );
u = plan.undoXremap( xfacts( { installed: { "xremap-hypr-bin": true } } ), { package: "xremap-hypr-bin", group: false, udev: false } );
check( "undo xremap leaves a group and rule it did not add", ids( u ) == "service,package" );
check( "undo xremap: nothing recorded is an error", plan.undoXremap( xfacts(), {} ).errors.len() == 1 );

if ( failures > 0 ) { println( failures & " failed" ); CLIExit( 1 ); }
println( "setup plan tests passed" );
