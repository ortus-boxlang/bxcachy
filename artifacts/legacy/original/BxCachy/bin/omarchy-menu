#!/usr/bin/env python3
"""Extensible Omarchy-inspired menu for CachyOS. No dependencies beyond Python 3."""
import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DEFAULT = ROOT / 'menu' / 'default.json'
CUSTOM = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'cachyos-omarchy-pack' / 'menu.json'


def load(path):
    with path.open(encoding='utf-8') as f:
        data = json.load(f)
    if not isinstance(data, dict) or not isinstance(data.get('sections'), list):
        raise ValueError(f'{path}: expected object with sections array')
    return data


def menu():
    base = load(DEFAULT)
    if CUSTOM.exists():
        extra = load(CUSTOM)
        # Replace matching section IDs; append additional entries otherwise.
        by_id = {s['id']: s for s in base['sections']}
        for section in extra['sections']:
            sid = section['id']
            if sid in by_id:
                existing = by_id[sid]
                positions = {e['id']: i for i, e in enumerate(existing['items'])}
                for item in section.get('items', []):
                    if item['id'] in positions:
                        existing['items'][positions[item['id']]] = item
                    else:
                        existing['items'].append(item)
            else:
                base['sections'].append(section)
    return base


def validate(data):
    ids = set()
    for section in data['sections']:
        if not isinstance(section.get('id'), str) or not isinstance(section.get('label'), str):
            raise ValueError('Each section requires string id and label')
        for item in section.get('items', []):
            if not all(isinstance(item.get(k), str) for k in ('id', 'label')):
                raise ValueError('Each item requires string id and label')
            if item['id'] in ids:
                raise ValueError('Duplicate item ID: ' + item['id'])
            ids.add(item['id'])
            cmd = item.get('command')
            if not isinstance(cmd, list) or not cmd or not all(isinstance(x, str) for x in cmd):
                raise ValueError('Item command must be nonempty string array: ' + item['id'])
            if 'confirm' in item and not isinstance(item['confirm'], bool):
                raise ValueError('confirm must be boolean')
    return True


def choose(options, prompt):
    if shutil.which('gum') and sys.stdin.isatty():
        result = subprocess.run(['gum', 'choose', '--header', prompt, *options], check=False, text=True, capture_output=True)
        return result.stdout.strip() if result.returncode == 0 else None
    print('\n' + prompt)
    for i, label in enumerate(options, 1):
        print(f' {i:2}. {label}')
    try:
        value = input('Select (blank to go back): ').strip()
        return options[int(value)-1] if value and 1 <= int(value) <= len(options) else None
    except (ValueError, EOFError, KeyboardInterrupt):
        return None


def execute(item):
    if item.get('confirm'):
        try:
            answer = input(f"Run {item['label']}? [y/N] ").strip().lower()
        except EOFError:
            return 1
        if answer != 'y':
            return 0
    cmd = [arg.replace('{ROOT}', str(ROOT)) for arg in item['command']]
    if not shutil.which(cmd[0]) and not Path(cmd[0]).exists():
        print(f"Not installed: {cmd[0]}. Install it first or customize the menu.", file=sys.stderr)
        return 127
    try:
        return subprocess.run(cmd, check=False).returncode
    except OSError as exc:
        print(exc, file=sys.stderr)
        return 1


def main():
    parser = argparse.ArgumentParser(description='Omarchy-inspired extensible CachyOS menu')
    parser.add_argument('--list', action='store_true')
    parser.add_argument('--validate', action='store_true')
    parser.add_argument('--run', metavar='ITEM_ID')
    parser.add_argument('--print-config-path', action='store_true')
    args = parser.parse_args()
    if args.print_config_path:
        print(CUSTOM)
        return 0
    try:
        data = menu()
        validate(data)
    except (ValueError, OSError, json.JSONDecodeError) as exc:
        print(f'Menu configuration error: {exc}', file=sys.stderr)
        return 2
    if args.validate:
        print('Menu configuration valid')
        return 0
    if args.list:
        for section in data['sections']:
            print(section['label'])
            for item in section.get('items', []):
                print(f"  {item['id']}: {item['label']}")
        return 0
    if args.run:
        for section in data['sections']:
            for item in section.get('items', []):
                if item['id'] == args.run:
                    return execute(item)
        print('Unknown item ID: ' + args.run, file=sys.stderr)
        return 2
    while True:
        sections = data['sections']
        options = [s['label'] for s in sections] + ['Exit']
        selected = choose(options, 'CachyOS · Omarchy-style Menu')
        if not selected or selected == 'Exit':
            return 0
        section = sections[options.index(selected)]
        items = section.get('items', [])
        labels = [x['label'] for x in items] + ['Back']
        chosen = choose(labels, section['label'])
        if chosen and chosen != 'Back':
            item = items[labels.index(chosen)]
            code = execute(item)
            if code and sys.stdin.isatty():
                input(f'Command exited {code}. Press Enter...')


if __name__ == '__main__':
    sys.exit(main())
