#!/usr/bin/env python3
"""Safe LazyVim and Podman Docker compatibility setup for BxCachy base."""
import argparse
import os
import pathlib
import shutil
import subprocess
import sys

HOME = pathlib.Path.home()
NVIM = HOME / '.config/nvim'
BIN = HOME / '.local/bin'
LAZYVIM_URL = 'https://github.com/LazyVim/starter.git'
WRAPPERS = {
    'docker': '#!/bin/sh\nexec podman "$@"\n',
    'docker-compose': '#!/bin/sh\nexec podman-compose "$@"\n',
}

def lazyvim(action):
    if NVIM.exists() or NVIM.is_symlink():
        print(f'LazyVim: existing {NVIM} preserved; no overwrite')
        return
    print(f'LazyVim: clone starter to {NVIM} (without .git)')
    if action != 'install':
        return
    if not shutil.which('git'):
        raise RuntimeError('git required for LazyVim')
    NVIM.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(['git', 'clone', '--depth', '1', LAZYVIM_URL, str(NVIM)], check=True)
    shutil.rmtree(NVIM / '.git')
    print('LazyVim starter installed; plugins download when nvim first starts.')

def aliases(action):
    print('Docker compatibility: docker -> podman; docker-compose -> podman-compose')
    for name, script in WRAPPERS.items():
        target = BIN / name
        existing = shutil.which(name)
        if target.exists() or target.is_symlink():
            if target.is_file() and target.read_text(errors='replace') == script:
                print(f'{name}: BxCachy wrapper already installed')
            else:
                print(f'{name}: existing {target} preserved')
            continue
        if existing and pathlib.Path(existing).resolve() != target.resolve():
            print(f'{name}: existing executable at {existing} preserved; wrapper not created')
            continue
        print(f'{name}: create {target}')
        if action == 'install':
            BIN.mkdir(parents=True, exist_ok=True)
            target.write_text(script)
            target.chmod(0o755)
    if action == 'install':
        print('Ensure ~/.local/bin precedes system binaries in PATH for Docker compatibility.')
        print('For Docker API clients, optionally run: bxcachy podman socket-enable')

def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('action', choices=['plan', 'install', 'doctor'])
    p.add_argument('feature', nargs='?', choices=['all', 'lazyvim', 'docker-aliases'], default='all')
    p.add_argument('--yes', action='store_true')
    args = p.parse_args(argv)
    if args.action == 'install' and not args.yes:
        p.error('install requires --yes')
    if args.feature in ('all', 'lazyvim'):
        lazyvim(args.action)
    if args.feature in ('all', 'docker-aliases'):
        aliases(args.action)
    return 0

if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, subprocess.CalledProcessError, RuntimeError) as exc:
        print('ERROR:', exc, file=sys.stderr)
        sys.exit(1)
