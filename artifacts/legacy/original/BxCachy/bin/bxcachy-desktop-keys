#!/usr/bin/env python3
"""Generate opt-in desktop keybinds; do not alter Hyprland or Noctalia configs."""
import argparse,pathlib,sys
ROOT=pathlib.Path(__file__).resolve().parent
KEYS=[('SUPER SHIFT','C','clipboard history','bxcachy-desktop clipboard history'),('SUPER SHIFT','S','region screenshot','bxcachy-desktop screenshot'),('SUPER SHIFT','R','region recording','bxcachy-desktop record')]
def main():
 p=argparse.ArgumentParser();p.add_argument('action',choices=['plan','stage']);p.add_argument('--output',type=pathlib.Path,default=pathlib.Path.home()/'.config/bxcachy/desktop-keys.conf');a=p.parse_args()
 content='# BxCachy opt-in desktop bindings; check for conflicts before sourcing\n'+''.join(f'bind = {mods}, {key}, exec, {ROOT / "bxcachy-desktop"} {command.split(" ",1)[1]} # {desc}\n' for mods,key,desc,command in KEYS)
 print(content)
 if a.action=='stage':
  a.output.parent.mkdir(parents=True,exist_ok=True)
  if a.output.exists() and a.output.read_text()!=content: p.error('Existing shortcut file differs; refusing overwrite')
  a.output.write_text(content);print('Staged only; not sourced by Hyprland:',a.output)
if __name__=='__main__':main()
