#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "${EUID}" -eq 0 ]]; then echo 'Run as your normal user, not sudo' >&2; exit 1; fi
if ! command -v pacman >/dev/null; then echo 'Requires CachyOS/Arch pacman' >&2; exit 1; fi
if [[ "${1:-}" == '--install-deps' ]]; then
  sudo pacman -S --needed rofi-wayland ghostty
fi
mkdir -p "$HOME/.local/share/applications"
cat > "$HOME/.local/share/applications/bxcachy-menu.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=BxCachy Menu
Comment=Extensible BxCachy management menu
Exec=$ROOT/bin/bxcachy-menu
Icon=preferences-system
Terminal=false
Categories=Settings;System;
EOF
printf 'Desktop entry created. Open the menu from KDE or Hyprland app launcher.\n'
printf 'For Hyprland, generate bindings: %s/bin/shortcuts generate\n' "$ROOT"
