#!/usr/bin/env python3
"""Safe cloud mount planning and opt-in rclone setup; never stores credentials itself."""
import argparse,os,pathlib,re,shutil,subprocess,sys
BASE=pathlib.Path.home()/"Cloud"
def valid(name):
 if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}",name):raise ValueError("Invalid remote or mount name")
 return name
def main():
 p=argparse.ArgumentParser(description=__doc__);sub=p.add_subparsers(dest='action',required=True)
 sub.add_parser('doctor');sub.add_parser('configure');sub.add_parser('remotes')
 m=sub.add_parser('mount');m.add_argument('remote');m.add_argument('--folder');m.add_argument('--yes',action='store_true')
 u=sub.add_parser('unmount');u.add_argument('folder');u.add_argument('--yes',action='store_true')
 a=p.parse_args()
 if a.action=='doctor':
  for x in ('rclone','fusermount3','dolphin','insync','dropbox'):print(x,shutil.which(x) or 'not installed')
  return
 if not shutil.which('rclone'):raise RuntimeError('rclone missing; install rclone first')
 if a.action=='configure':subprocess.run(['rclone','config'],check=True);return
 if a.action=='remotes':subprocess.run(['rclone','listremotes'],check=True);return
 if a.action=='mount':
  remote=valid(a.remote);folder=valid(a.folder or remote);target=BASE/folder
  available=subprocess.run(['rclone','listremotes'],text=True,capture_output=True,check=True).stdout.splitlines()
  if remote+':' not in available:raise ValueError('Remote not configured; run bxcachy cloud configure')
  cmd=['rclone','mount',remote+':',str(target),'--vfs-cache-mode','writes','--daemon']
  print('Mount:',remote+':','->',target,'\nCommand:',' '.join(cmd))
  if not a.yes:print('Dry run only. Add --yes to mount.');return
  if target.is_symlink():raise ValueError('Refusing symlink mount point')
  target.mkdir(parents=True,exist_ok=True)
  if any(target.iterdir()):raise ValueError('Mount point not empty')
  subprocess.run(cmd,check=True);return
 if a.action=='unmount':
  folder=valid(a.folder);target=BASE/folder
  if not target.is_dir() or target.is_symlink():raise ValueError('Invalid mount directory')
  if not a.yes:print('Would unmount',target,'; add --yes');return
  subprocess.run(['fusermount3','-u',str(target)],check=True)
if __name__=='__main__':
 try:main()
 except (RuntimeError,ValueError,OSError,subprocess.CalledProcessError) as e:print('ERROR:',e,file=sys.stderr);sys.exit(1)
