#!/usr/bin/env python3
"""Conservative CachyOS provisioning: plan, install packages, stage configs, rollback."""
import argparse, datetime, hashlib, json, os, pathlib, shutil, subprocess, sys
ROOT = pathlib.Path(__file__).resolve().parent.parent
HOME = pathlib.Path.home()
STATE = HOME / '.local/state/cachyos-omarchy-pack'
CONFIG = HOME / '.config'
PACKAGES = ['hyprland', 'noctalia', 'uwsm', 'xdg-desktop-portal-hyprland', 'polkit-kde-agent', 'ghostty', 'dolphin', 'git', 'gum']
FILES = {'hypr/omarchy-keys.conf': ROOT / 'config/omarchy-keys.conf',
         'hypr/omarchy-keys.lua': ROOT / 'config/omarchy-keys.lua'}

def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def check_platform():
    if os.geteuid() == 0: raise RuntimeError('Run as normal user, never sudo this script')
    if not shutil.which('pacman'): raise RuntimeError('pacman not found: this installer requires Arch/CachyOS')
    osrel = pathlib.Path('/etc/os-release').read_text() if pathlib.Path('/etc/os-release').exists() else ''
    if 'cachyos' not in osrel.lower(): print('WARNING: CachyOS not detected; review before proceeding', file=sys.stderr)

def plan():
    print('Provision plan (no changes):')
    print('  Packages:', ' '.join(PACKAGES))
    print('  Config: stage two shortcut examples under ~/.config/hypr (never overwrite)')
    print('  Hyprland activation: manual only; Lua and traditional configs are not interchangeable')
    print('  Preserve KDE, SDDM, kernel, bootloader, network, existing active Hyprland config')
    print('  Backups: ~/.local/state/cachyos-omarchy-pack/backups/<timestamp>')

def snapshot(paths):
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    dest = STATE / 'backups' / stamp
    dest.mkdir(parents=True, exist_ok=False)
    records=[]
    for p in paths:
        rel = p.relative_to(HOME)
        record={'path':str(rel), 'existed':p.is_file()}
        if p.is_file():
            target=dest/rel; target.parent.mkdir(parents=True,exist_ok=True)
            shutil.copy2(p,target); record['sha256']=digest(p)
        records.append(record)
    (dest/'manifest.json').write_text(json.dumps({'files':records},indent=2)+'\n')
    return dest

def stage():
    # Never overwrite any existing files, including symlinks.
    for rel in FILES:
        p=CONFIG/rel
        if p.exists() or p.is_symlink():
            print('SKIP existing:',p)
    targets=[CONFIG/rel for rel in FILES if not (CONFIG/rel).exists() and not (CONFIG/rel).is_symlink()]
    if not targets:
        print('Nothing to stage; existing files unchanged')
        return
    backup=snapshot(targets)
    for p in targets:
        p.parent.mkdir(parents=True,exist_ok=True)
        source=FILES[str(p.relative_to(CONFIG))]
        shutil.copy2(source,p)
        print('STAGED:',p)
    print('Backup:',backup)
    print('Shortcuts are NOT activated. Review duplicates and source manually in traditional hyprland.conf; merge Lua manually.')

def install():
    if not shutil.which('sudo'): raise RuntimeError('sudo not found')
    missing=[]
    for pkg in PACKAGES:
        result=subprocess.run(['pacman','-Si',pkg],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        if result.returncode: missing.append(pkg)
    if missing:
        raise RuntimeError('Packages missing in enabled repos: '+', '.join(missing)+'; no packages installed')
    print('Pacman will prompt before installing; inspect its transaction and CANCEL if it proposes removing KDE/SDDM.')
    subprocess.run(['sudo','pacman','-S','--needed',*PACKAGES],check=True)

def restore(backup):
    manifest=json.loads((backup/'manifest.json').read_text())
    for record in manifest['files']:
        path=HOME/record['path']
        if not path.is_relative_to(CONFIG): raise RuntimeError('Unsafe restore path')
        if record['existed']:
            original=backup/record['path']
            if not original.is_file(): raise RuntimeError('Missing backup: '+str(original))
            if path.exists() or path.is_symlink():
                raise RuntimeError('Refusing to overwrite current file: '+str(path))
            path.parent.mkdir(parents=True,exist_ok=True)
            shutil.copy2(original,path)
            print('RESTORED:',path)
        elif path.is_file():
            rel=str(path.relative_to(CONFIG))
            if rel not in FILES or digest(path)!=digest(FILES[rel]):
                raise RuntimeError('Refusing to delete modified/unmanaged file: '+str(path))
            path.unlink(); print('REMOVED staged file:',path)
    print('Rollback only affects staged config files, not pacman packages or system settings.')

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    sub=parser.add_subparsers(dest='action',required=True)
    for action in ('plan','doctor','stage','install'): sub.add_parser(action)
    rollback=sub.add_parser('rollback'); rollback.add_argument('backup',type=pathlib.Path)
    args=parser.parse_args()
    if args.action=='plan': plan(); return
    if args.action=='doctor':
        for cmd in ('pacman','hyprland','noctalia','uwsm','ghostty','gum'):
            print(f'{cmd}: {shutil.which(cmd) or "MISSING"}')
        print('KDE config untouched by this tool'); return
    if args.action=='rollback': restore(args.backup.resolve()); return
    check_platform()
    if args.action=='stage': stage()
    if args.action=='install': install()

if __name__=='__main__':
    try: main()
    except (RuntimeError,subprocess.CalledProcessError,OSError,ValueError) as exc:
        print('ERROR:',exc,file=sys.stderr); sys.exit(1)
