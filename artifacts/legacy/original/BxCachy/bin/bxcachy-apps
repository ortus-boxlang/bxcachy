#!/usr/bin/env python3
"""Manage BxCachy default and optional desktop applications without changing desktop settings."""
import argparse
import shutil
import subprocess
import sys

BASE = {'sharing': ['localsend'], 'media': ['mpv'], 'packages': ['pacseek']}
DESKTOP = {'localsend':'localsend','mpv':'mpv','obs':'obs-studio','kdenlive':'kdenlive','pinta':'pinta','chromium':'chromium','obsidian':'obsidian','libreoffice':'libreoffice-fresh'}
TUI = {'lazygit':'lazygit','btop':'btop','neovim':'neovim','pacseek':'pacseek','yazi':'yazi'}
WEB = {'github':'https://github.com','boxlang-docs':'https://boxlang.ortusbooks.com','youtube':'https://youtube.com'}
OPTIONAL = {'obs': 'obs-studio', 'kdenlive': 'kdenlive', 'pinta': 'pinta', 'chromium': 'chromium', 'obsidian': 'obsidian', 'libreoffice': 'libreoffice-fresh'}

def available(pkg):
    return subprocess.run(['pacman', '-Si', pkg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

def installed(pkg):
    return subprocess.run(['pacman', '-Qq', pkg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('action', choices=['plan', 'doctor', 'install', 'optional-list', 'optional-install', 'desktop-list', 'tui-list', 'web-list'])
    p.add_argument('names', nargs='*')
    p.add_argument('--yes', action='store_true')
    a = p.parse_args(argv)
    if a.action in ('desktop-list','tui-list','web-list'):
        catalog={'desktop-list':DESKTOP,'tui-list':TUI,'web-list':WEB}[a.action]
        for name,value in catalog.items():print(f'{name}: {value}')
        return 0
    if a.action == 'optional-list':
        for name, pkg in OPTIONAL.items(): print(f'{name}: {pkg} (optional)')
        return 0
    if not shutil.which('pacman'): p.error('Requires CachyOS/Arch pacman')
    if a.action == 'optional-install':
        if not a.names or any(n not in OPTIONAL for n in a.names): p.error('Choose optional names from: '+', '.join(OPTIONAL))
        packages = [OPTIONAL[n] for n in a.names]
    else:
        if a.names: p.error('Base app actions do not accept package names')
        packages = [pkg for group in BASE.values() for pkg in group]
    missing = [pkg for pkg in packages if not installed(pkg)]
    for pkg in packages: print(f'{pkg}: {"installed" if pkg not in missing else "missing"}')
    if a.action in ('plan', 'doctor'): return 0
    if not a.yes: p.error('Installation requires --yes')
    unavailable = [pkg for pkg in missing if not available(pkg)]
    if unavailable:
        print('Unavailable in configured pacman repositories: '+', '.join(unavailable), file=sys.stderr)
        print('No automatic AUR execution. Install these manually or enable an appropriate repository.', file=sys.stderr)
        if a.action == 'optional-install': return 3
        missing = [pkg for pkg in missing if pkg not in unavailable]
    if missing: subprocess.run(['sudo', 'pacman', '-S', '--needed', *missing], check=True)
    return 0

if __name__ == '__main__':
    try: sys.exit(main())
    except (OSError, subprocess.CalledProcessError) as e:
        print(f'ERROR: {e}', file=sys.stderr); sys.exit(1)
