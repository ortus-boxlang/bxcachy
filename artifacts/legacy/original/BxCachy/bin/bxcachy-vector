#!/usr/bin/env python3
"""Opt-in vector database containers; localhost-only, isolated persistent storage."""
import argparse, pathlib, re, shutil, subprocess, sys
BASE=pathlib.Path.home()/'.local/share/bxcachy/vectors'
# Explicit images/ports. Review image versions before production use.
ENGINES={
 'qdrant':('docker.io/qdrant/qdrant:v1.12.5',6333,6333,'/qdrant/storage',None),
 'chroma':('docker.io/chromadb/chroma:0.6.3',8000,8000,'/chroma/chroma',None),
 'weaviate':('docker.io/semitechnologies/weaviate:1.28.4',8080,8080,'/var/lib/weaviate',['QUERY_DEFAULTS_LIMIT=25','AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=true','PERSISTENCE_DATA_PATH=/var/lib/weaviate','DEFAULT_VECTORIZER_MODULE=none','CLUSTER_HOSTNAME=node1']),
 'milvus':('docker.io/milvusdb/milvus:v2.4.15',19530,19530,'/var/lib/milvus',None),
 'pgvector':('docker.io/pgvector/pgvector:pg17',5432,5432,'/var/lib/postgresql/data',None),
}
def execute(cmd):
 print(' '.join(map(str,cmd)),flush=True);subprocess.run(list(map(str,cmd)),check=True)
def main():
 p=argparse.ArgumentParser(description=__doc__);p.add_argument('action',choices=['list','plan','start','stop','logs','status','remove','doctor']);p.add_argument('engine',nargs='?',choices=sorted(ENGINES));p.add_argument('--name',default='default');p.add_argument('--port',type=int);p.add_argument('--yes',action='store_true');a=p.parse_args()
 if a.action=='doctor':
  for tool in ('podman','curl'):print(tool,shutil.which(tool) or 'missing')
  print('Milvus is listed but requires a multi-service deployment; it is not provisioned by this command.')
  return
 if not shutil.which('podman'):raise RuntimeError('Podman is required')
 if a.action=='list':execute(['podman','ps','-a','--filter','label=io.bxcachy.vector=true']);return
 if not a.engine:p.error('engine required')
 if not re.fullmatch(r'[a-zA-Z0-9-]{1,48}',a.name):raise ValueError('Invalid instance name')
 engine=a.engine;name=f'bxcachy-vector-{engine}-{a.name}'
 if a.action in ('stop','logs','status'):
  execute(['podman',{'stop':'stop','logs':'logs','status':'inspect'}[a.action],name]);return
 if a.action=='remove':
  if not a.yes:print('Dry run: would remove container',name,'and preserve all data');return
  execute(['podman','rm','-f',name]);return
 image,internal,default_port,volume,env=ENGINES[engine];port=a.port or default_port
 if not 1024<=port<=65535:raise ValueError('Port must be between 1024 and 65535')
 directory=BASE/name;data=directory/'data'
 if engine=='milvus':
  print('Milvus requires etcd and object storage. Use an official standalone compose deployment; this recipe intentionally does not start a broken single container.')
  return 2
 command=['podman','run','-d','--name',name,'--label','io.bxcachy.vector=true','--restart','unless-stopped','-p',f'127.0.0.1:{port}:{internal}','-v',f'{data}:{volume}:Z']
 for item in env or []:command+=['-e',item]
 if engine=='pgvector':
  command+=['--env-file',str(directory/'database.env')]
 if engine=='weaviate':command+=['--security-opt','no-new-privileges']
 command.append(image)
 print('Engine:',engine,'\nImage:',image,'\nLocal endpoint: 127.0.0.1:'+str(port),'\nPersistent data:',data)
 if engine=='weaviate':print('WARNING: anonymous API; localhost binding only. Do not publish this port externally.')
 if a.action=='plan' or not a.yes:print('Dry run only. Use start --yes to create.');return
 if subprocess.run(['podman','container','exists',name],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0:raise ValueError('Container exists: '+name)
 data.mkdir(parents=True,exist_ok=True)
 if engine=='pgvector':
  import secrets
  pw=secrets.token_urlsafe(30);secret=directory/'database.env';secret.write_text('POSTGRES_PASSWORD='+pw+'\n');secret.chmod(0o600)
 execute(command)
if __name__=='__main__':
 try:sys.exit(main() or 0)
 except (RuntimeError,ValueError,OSError,subprocess.CalledProcessError) as exc:print('ERROR:',exc,file=sys.stderr);sys.exit(1)
