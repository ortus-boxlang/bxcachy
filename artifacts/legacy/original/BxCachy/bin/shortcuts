#!/usr/bin/env python3
"""Safe Hyprland shortcut editor. Writes a separate generated config; never edits KDE."""
import argparse, json, os, pathlib, re, shutil, subprocess, sys
ROOT=pathlib.Path(__file__).resolve().parent.parent
USER=pathlib.Path.home()/'.config/bxcachy'
DEFAULT=ROOT/'config/shortcuts.json'
TARGET=pathlib.Path.home()/'.config/hypr/bxcachy-keys.conf'
ALLOWED={'exec','killactive','togglefloating','fullscreen','workspace','movetoworkspace','movefocus'}
MODS={'SUPER','SHIFT','ALT','CTRL'}
def read():
 p=USER/'shortcuts.json'
 return json.loads((p if p.exists() else DEFAULT).read_text())
def validate(data):
 seen=set(); ids=set()
 if not isinstance(data,dict) or not isinstance(data.get('bindings'),list): raise ValueError('bindings must be an array')
 for b in data['bindings']:
  if not isinstance(b,dict): raise ValueError('invalid binding')
  if not isinstance(b.get('id'),str) or not re.fullmatch(r'[a-z0-9-]+',b['id']) or b['id'] in ids: raise ValueError('invalid/duplicate id')
  ids.add(b['id'])
  mods=b.get('mods','').split(); key=b.get('key','').upper()
  if len(mods)!=len(set(mods)) or any(m not in MODS for m in mods): raise ValueError('invalid modifiers: '+b['id'])
  if not re.fullmatch(r'[A-Z0-9_-]+',key): raise ValueError('invalid key: '+b['id'])
  if b.get('dispatcher') not in ALLOWED: raise ValueError('unsupported dispatcher: '+b['id'])
  if not isinstance(b.get('argument'),str) or '\n' in b['argument'] or '\r' in b['argument']: raise ValueError('invalid argument')
  if any(c in b['argument'] for c in ['\n','\r']): raise ValueError('newlines not allowed')
  combo=(tuple(sorted(mods)),key)
  if combo in seen: raise ValueError('duplicate key combination: '+'+'.join((*mods,key)))
  seen.add(combo)
 return data
def save(data):
 validate(data); USER.mkdir(parents=True,exist_ok=True)
 p=USER/'shortcuts.json'; tmp=p.with_suffix('.tmp'); tmp.write_text(json.dumps(data,indent=2)+'\n'); tmp.replace(p)
def render(data):
 validate(data)
 lines=['# Generated by BxCachy. Edit using bin/shortcuts, not this file.']
 for b in data['bindings']:
  arg=b['argument'].replace('{ROOT}',str(ROOT))
  lines.append(f"bind = {' '.join(b['mods'].split())}, {b['key'].upper()}, {b['dispatcher']}, {arg}".rstrip().rstrip(','))
 return '\n'.join(lines)+'\n'
def conflicts(data):
 """Best-effort scan of traditional Hyprland config and source files; dynamic Lua is unsupported."""
 validate(data)
 home=pathlib.Path.home(); main=home/'.config/hypr/hyprland.conf'
 wanted={(tuple(sorted(b['mods'].split())),b['key'].upper()):b['id'] for b in data['bindings']}
 found=[]; visited=set()
 def scan(path,depth=0):
  if depth>12 or path in visited or not path.is_file():return
  visited.add(path)
  for number,line in enumerate(path.read_text(errors='replace').splitlines(),1):
   stripped=line.split('#',1)[0].strip()
   if stripped.startswith('source') and '=' in stripped:
    raw=stripped.split('=',1)[1].strip()
    if '$' not in raw and '*' not in raw:
     candidate=pathlib.Path(raw.replace('~',str(home),1))
     if not candidate.is_absolute():candidate=path.parent/candidate
     if candidate.name!='bxcachy-keys.conf':scan(candidate.resolve(),depth+1)
   if stripped.startswith(('bind =','bindm =','binde =','bindl =','bindr =')):
    fields=stripped.split('=',1)[1].split(',')
    if len(fields)<2:continue
    mods=tuple(sorted(fields[0].strip().upper().split()));key=fields[1].strip().upper()
    if (mods,key) in wanted:found.append((wanted[(mods,key)],str(path),number))
 scan(main)
 return found
def update():
 data=read(); out=render(data)
 TARGET.parent.mkdir(parents=True,exist_ok=True)
 if TARGET.exists() and not TARGET.read_text().startswith('# Generated by BxCachy.'):
  raise ValueError('Refusing to overwrite unmanaged shortcut file: '+str(TARGET))
 tmp=TARGET.with_suffix('.tmp'); tmp.write_text(out); tmp.replace(TARGET)
 print('Generated:',TARGET)
 print('To enable: add `source = ~/.config/hypr/bxcachy-keys.conf` to traditional Hyprland config.')
 print('Check existing bindings for conflicts first. CachyOS Lua-based configs need manual integration.')
def main():
 p=argparse.ArgumentParser(); sub=p.add_subparsers(dest='action',required=True)
 for x in ('list','validate','generate','reset','edit','gui','conflicts'): sub.add_parser(x)
 s=sub.add_parser('set'); s.add_argument('id'); s.add_argument('mods'); s.add_argument('key')
 a=p.parse_args(); data=read()
 if a.action=='list':
  validate(data)
  for b in data['bindings']: print(f"{b['id']:20} {b['mods']}+{b['key']} : {b['label']}")
 elif a.action=='validate': validate(data); print('Shortcut configuration valid')
 elif a.action=='conflicts':
  issues=conflicts(data)
  for ident,path,line in issues:print(f'CONFLICT {ident}: {path}:{line}')
  if issues:sys.exit(1)
  print('No conflicts found in statically resolvable Hyprland files; Lua/dynamic bindings not scanned')
 elif a.action=='generate': update()
 elif a.action=='reset': save(json.loads(DEFAULT.read_text())); update()
 elif a.action=='set':
  b=next((b for b in data['bindings'] if b['id']==a.id),None)
  if b is None: raise ValueError('Unknown binding: '+a.id)
  b['mods']=a.mods.upper().replace('+',' '); b['key']=a.key.upper()
  save(data); update()
 elif a.action=='edit':
  save(data); subprocess.run([os.environ.get('EDITOR','nano'),str(USER/'shortcuts.json')],check=True); update()
 elif a.action=='gui':
  if not shutil.which('rofi'): raise ValueError('Install rofi-wayland for graphical shortcut editing')
  validate(data)
  entries=[f"{b['label']}  [{b['mods']}+{b['key']}]" for b in data['bindings']]
  pick=subprocess.run(['rofi','-dmenu','-i','-p','Keyboard shortcuts'],input='\n'.join(entries),text=True,capture_output=True)
  if pick.returncode or pick.stdout.strip() not in entries:return
  b=data['bindings'][entries.index(pick.stdout.strip())]
  new=subprocess.run(['rofi','-dmenu','-p',f"{b['label']}: SUPER+ALT+KEY"],input=b['mods'].replace(' ','+')+'+'+b['key']+'\n',text=True,capture_output=True)
  if new.returncode or not new.stdout.strip():return
  parts=new.stdout.strip().upper().split('+')
  if len(parts)<2: raise ValueError('Enter MOD+KEY, e.g. SUPER+ALT+M')
  b['mods']=' '.join(parts[:-1]); b['key']=parts[-1]
  save(data); update()
if __name__=='__main__':
 try: main()
 except (ValueError,OSError,subprocess.CalledProcessError) as e: print('ERROR:',e,file=sys.stderr);sys.exit(1)
