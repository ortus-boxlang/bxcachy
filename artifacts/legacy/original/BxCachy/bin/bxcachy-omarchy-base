#!/usr/bin/env python3
"""Opt-in Omarchy-inspired developer and desktop essentials for existing CachyOS."""
import argparse
import shutil
import subprocess
import sys

# Pacman packages only: no AUR execution or remote install scripts.
GROUPS = {
    'cli': ['git', 'github-cli', 'lazygit', 'fzf', 'zoxide', 'ripgrep', 'fd', 'eza', 'bat', 'btop', 'starship', 'tmux', 'jq', 'curl', 'gum'],
    'editor': ['neovim'],
    'desktop': ['wl-clipboard', 'cliphist', 'grim', 'slurp', 'swappy', 'wf-recorder'],
    'menu': ['rofi-wayland', 'ghostty'],
}

def packages():
    return list(dict.fromkeys(pkg for group in GROUPS.values() for pkg in group))

def installed(pkg):
    return subprocess.run(['pacman', '-Qq', pkg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['plan', 'doctor', 'install'])
    parser.add_argument('--yes', action='store_true', help='Approve pacman transaction (sudo may still prompt)')
    args = parser.parse_args(argv)
    if not shutil.which('pacman'):
        parser.error('pacman is required; BxCachy targets CachyOS/Arch')
    missing = [p for p in packages() if not installed(p)]
    for group, items in GROUPS.items():
        print(f'{group}:')
        for pkg in items:
            print(f'  {pkg}: {"installed" if pkg not in missing else "missing"}')
    if args.action == 'doctor':
        return 0
    if not missing:
        print('All Omarchy-inspired base packages are installed.')
        return 0
    command = ['sudo', 'pacman', '-S', '--needed', *missing]
    print('Install:', ' '.join(command))
    if args.action == 'plan':
        print('Plan only. No changes made.')
        return 0
    if not args.yes:
        parser.error('Use --yes to install after reviewing the plan')
    # Validate package availability before initiating a pacman transaction.
    unavailable = [p for p in missing if subprocess.run(['pacman', '-Si', p], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0]
    if unavailable:
        parser.error('Packages unavailable in configured repositories: ' + ', '.join(unavailable))
    subprocess.run(command, check=True)
    print('Omarchy-inspired base packages installed. Existing KDE, Noctalia, Hyprland, and runner untouched.')
    return 0

if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, subprocess.CalledProcessError) as exc:
        print('ERROR:', exc, file=sys.stderr)
        sys.exit(1)
