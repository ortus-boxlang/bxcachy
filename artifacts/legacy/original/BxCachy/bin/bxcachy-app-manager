#!/usr/bin/env python3
"""Curated, non-destructive BxCachy app catalog and optional launcher installer."""
import argparse,json,os,pathlib,re,shutil,subprocess,sys,urllib.parse
ROOT=pathlib.Path(__file__).resolve().parent.parent
CATALOG=ROOT/'catalog/apps.json'
APPDIR=pathlib.Path.home()/'.local/share/applications'
PROFILE=ROOT/'catalog/app-profile.json'

def catalog():
 data=json.loads(CATALOG.read_text())
 apps=data['apps']
 if len({a['id'] for a in apps})!=len(apps):raise ValueError('Duplicate app IDs')
 return apps

def profile():
 return json.loads(PROFILE.read_text())

def tier(app):
 return 'base' if app.get('default') else 'curated'

def system_search(query,aur=False):
 if not query.strip():raise ValueError('Search query required')
 if aur:
  if not shutil.which('yay'):raise RuntimeError('yay is required for AUR search')
  cmd=['yay','-Ss',query]
 else:
  if not shutil.which('pacman'):raise RuntimeError('pacman is required')
  cmd=['pacman','-Ss',query]
 return subprocess.run(cmd,check=False).returncode

def install_defaults(apps,yes=False):
 selected=[a for a in apps if a.get('default')]
 errors=[]
 for app in selected:
  print(f'[{app["kind"]}] {app["name"]}',flush=True)
  try:install_pkg(app,yes)
  except (OSError,ValueError,RuntimeError,subprocess.CalledProcessError) as e:
   errors.append((app['id'],str(e)))
 if errors:
  for name,reason in errors:print(f'FAILED {name}: {reason}',file=sys.stderr)
  return 1
 return 0

def filter_apps(apps,kind=None,category=None,search=None):
 return [a for a in apps if (not kind or a['kind']==kind) and (not category or category.lower() in a['category'].lower()) and (not search or search.lower() in (' '.join((a['id'],a['name'],a['category'],a['description']))).lower())]

def find(apps,ids):
 byid={a['id']:a for a in apps}
 missing=[x for x in ids if x not in byid]
 if missing:raise ValueError('Unknown app(s): '+', '.join(missing))
 return [byid[x] for x in ids]

def safe_url(url):
 parsed=urllib.parse.urlsplit(url)
 if parsed.scheme!='https' or not parsed.hostname or parsed.username or parsed.password or any(c in url for c in '\n\r\x00'):
  raise ValueError('Only valid HTTPS web apps are supported')
 return url

def browser():
 for name in ('chromium','google-chrome-stable','google-chrome','brave','firefox'):
  if shutil.which(name):return name
 return None

def launch_web(app):
 url=safe_url(app['target'])
 b=browser()
 if not b:raise RuntimeError('Install a browser before launching web apps')
 args=[b,'--app='+url] if b!='firefox' else [b,'--new-window',url]
 return subprocess.Popen(args,start_new_session=True).pid

def desktop_file(app,b='chromium'):
 url=safe_url(app['target'])
 if not re.fullmatch(r'[a-z0-9][a-z0-9-]*',app['id']):raise ValueError('Invalid app id')
 if any(c in app['name'] for c in '\n\r\x00'):raise ValueError('Invalid app name')
 if b not in ('chromium','google-chrome','google-chrome-stable','brave','firefox'):raise ValueError('Unsupported browser')
 exec_line=(f'{b} --new-window {url}' if b=='firefox' else f'{b} --app={url}')
 return f'[Desktop Entry]\nType=Application\nName=BxCachy - {app["name"]}\nExec={exec_line}\nTerminal=false\nCategories=Network;\nStartupNotify=true\n'

def install_web(app,yes=False):
 if app['kind']!='web':raise ValueError('Web launchers require web app')
 b=browser()
 if not b:raise RuntimeError('Install a supported browser first')
 dest=APPDIR/('bxcachy-web-'+app['id']+'.desktop')
 if dest.exists():
  print('Already exists; preserving:',dest);return
 if not yes:
  print('Would create:',dest);return
 APPDIR.mkdir(parents=True,exist_ok=True)
 dest.write_text(desktop_file(app,b));dest.chmod(0o644)
 print('Created:',dest)

def install_pkg(app,yes=False):
 if app['kind']=='web':return install_web(app,yes)
 pkg=app['target']
 if not re.fullmatch(r'[a-zA-Z0-9@._+:-]+',pkg):raise ValueError('Invalid package name')
 if shutil.which('pacman') and subprocess.run(['pacman','-Qq',pkg],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0:
  print('Installed:',pkg);return
 source=app['source']
 if source not in ('pacman','aur'):
  raise RuntimeError('Manual installation required; package mapping unverified: '+app['name'])
 if source=='aur':
  helper=shutil.which('yay')
  if not helper:
   print('AUR package requires yay:',pkg);return
  cmd=[helper,'-S','--needed',pkg]
 else:
  if not shutil.which('pacman'):raise RuntimeError('pacman required')
  if subprocess.run(['pacman','-Si',pkg],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode:
   print('Package not found in enabled repositories:',pkg,'(catalog is advisory)');return
  cmd=['sudo','pacman','-S','--needed',pkg]
 print('Command:', ' '.join(cmd))
 if yes:subprocess.run(cmd,check=True)

def choose(entries,prompt):
 if not shutil.which('rofi'):raise RuntimeError('rofi is required for GUI; use list/search CLI otherwise')
 proc=subprocess.run(['rofi','-dmenu','-i','-p',prompt,'-format','i'],input='\n'.join(entries)+'\n',text=True,capture_output=True)
 if proc.returncode:return None
 try:idx=int(proc.stdout.strip());return idx if 0<=idx<len(entries) else None
 except ValueError:return None

def gui(apps):
 kinds=['desktop','tui','web']
 kindidx=choose(['Desktop applications','Terminal / TUI applications','Web applications'],'BxCachy Apps')
 if kindidx is None:return
 kind=kinds[kindidx]
 choices=sorted(filter_apps(apps,kind=kind),key=lambda x:(x['category'],x['name']))
 index=choose([f'{a["name"]}  [{a["category"]}]'+('  • Base' if a['default'] else '') for a in choices],kind.upper()+' (type to search)')
 if index is None:return
 app=choices[index]
 action=choose(['Preview install','Install (confirm)','Launch' if kind=='web' else 'Show details'],'BxCachy: '+app['name'])
 if action is None:return
 if action==0:install_pkg(app,False)
 elif action==1:
  if choose(['Cancel','Confirm install'],'Confirm '+app['name'])==1:install_pkg(app,True)
 elif kind=='web':launch_web(app)
 else:print(json.dumps(app,indent=2))

def main(argv=None):
 p=argparse.ArgumentParser(description=__doc__)
 p.add_argument('action',choices=['list','search','show','install','launch','web-shortcut','gui','defaults','install-defaults','system-search'])
 p.add_argument('ids',nargs='*')
 p.add_argument('--kind',choices=['desktop','tui','web'])
 p.add_argument('--category')
 p.add_argument('--query')
 p.add_argument('--yes',action='store_true')
 p.add_argument('--json',action='store_true')
 p.add_argument('--aur',action='store_true')
 p.add_argument('--tier',choices=['base','curated'])
 a=p.parse_args(argv);apps=catalog()
 if a.action=='gui':gui(apps);return 0
 if a.action=='system-search':return system_search(a.query or ' '.join(a.ids),a.aur)
 if a.action=='install-defaults':return install_defaults(apps,a.yes)
 if a.action in ('list','search','defaults'):
  if a.action=='search' and not (a.query or a.ids):p.error('search needs --query or search terms')
  result=filter_apps(apps,a.kind,a.category,a.query or (' '.join(a.ids) if a.action=='search' else None))
  if a.action=='defaults':result=[x for x in result if x['default']]
  if a.tier:result=[x for x in result if tier(x)==a.tier]
  if a.json:print(json.dumps(result,indent=2))
  else:
   for x in result:print(f'{x["kind"]:7} {x["id"]:20} {x["category"]:18} {x["source"]:7} {"BASE" if x["default"] else "optional":8} {x["name"]}')
   print(f'{len(result)} entries')
  return 0
 if not a.ids:p.error('Specify one or more app IDs')
 selected=find(apps,a.ids)
 if a.action=='show':
  for x in selected:print(json.dumps(x,indent=2))
 elif a.action=='install':
  for x in selected:install_pkg(x,a.yes)
 elif a.action=='web-shortcut':
  for x in selected:install_web(x,a.yes)
 elif a.action=='launch':
  for x in selected:
   if x['kind']!='web':raise ValueError('Launch currently supports web apps only')
   launch_web(x)
 return 0
if __name__=='__main__':
 try:sys.exit(main())
 except (ValueError,RuntimeError,OSError,subprocess.CalledProcessError) as e:print('ERROR:',e,file=sys.stderr);sys.exit(1)
