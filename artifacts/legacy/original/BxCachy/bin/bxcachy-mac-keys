#!/usr/bin/env python3
"""Toggle left Alt/left Super positions for current Hyprland session only."""
import json,subprocess,sys,pathlib,os
STATE=pathlib.Path(os.environ.get('XDG_RUNTIME_DIR','/tmp'))/('bxcachy-mac-keys-'+str(os.getuid())+'.json')
def run(*args):return subprocess.run(['hyprctl',*args],capture_output=True,text=True,check=True).stdout
def current():
 d=json.loads(run('getoption','input:kb_options','-j'))
 return d.get('str','')
def main():
 action=sys.argv[1] if len(sys.argv)>1 else 'status'
 if action not in ('status','on','off','toggle'):return 2
 try:old=current()
 except (OSError,subprocess.CalledProcessError,ValueError) as e:print('Hyprland unavailable:',e,file=sys.stderr);return 1
 active='altwin:swap_lalt_lwin' in old.split(',')
 if action=='status':print('Mac key positions:', 'ON' if active else 'OFF','XKB:',old or '(none)');return 0
 if action=='toggle':action='off' if active else 'on'
 if action=='on':
  if active:print('Already enabled');return 0
  STATE.write_text(json.dumps({'previous':old}))
  target=','.join(filter(None,[old,'altwin:swap_lalt_lwin']))
 else:
  if not active:print('Already disabled');return 0
  target=','.join(x for x in old.split(',') if x!='altwin:swap_lalt_lwin')
  if STATE.exists():
   try:target=json.loads(STATE.read_text())['previous']
   except (ValueError,KeyError):pass
 try:run('keyword','input:kb_options',target)
 except (OSError,subprocess.CalledProcessError) as e:print('Cannot update keyboard:',e,file=sys.stderr);return 1
 if action=='off':STATE.unlink(missing_ok=True)
 print('Mac-style left Command key:', 'enabled' if action=='on' else 'disabled')
 print('Note: this swaps physical left Alt and Super; it does not translate Ctrl shortcuts into Command shortcuts.')
 return 0
if __name__=='__main__':sys.exit(main())
