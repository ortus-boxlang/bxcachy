#!/usr/bin/env python3
"""Rofi-wayland graphical menu, extensible via existing menu JSON."""
import json, os, pathlib, shutil, subprocess, sys
ROOT=pathlib.Path(__file__).resolve().parent.parent
CONFIG=pathlib.Path.home()/'.config/cachyos-omarchy-pack/menu.json'
DEFAULT=ROOT/'menu/default.json'
def main():
 if not shutil.which('rofi'): raise RuntimeError('rofi not found: install rofi-wayland')
 data=json.loads((CONFIG if CONFIG.exists() else DEFAULT).read_text())
 sections=data.get('sections',[])
 if not isinstance(sections,list): raise ValueError('Invalid menu configuration')
 sections=[s for s in sections if isinstance(s,dict) and isinstance(s.get('label'),str) and isinstance(s.get('items'),list)]
 sections.append({'label':'Settings','items':[{'label':'Keyboard Shortcuts','command':[str(ROOT/'bin/shortcuts'),'gui']},{'label':'Shortcut Configuration (terminal)','command':['ghostty','-e',str(ROOT/'bin/shortcuts'),'edit']},{'label':'Provisioning Plan','command':['ghostty','-e',str(ROOT/'bin/provision'),'plan']} ]})
 def choose(labels,prompt):
  result=subprocess.run(['rofi','-dmenu','-i','-p',prompt],input='\n'.join(labels)+'\n',text=True,capture_output=True)
  return result.stdout.strip() if result.returncode==0 else ''
 while True:
  labels=[s['label'] for s in sections]
  choice=choose(labels,'Omarchy')
  if choice not in labels:return
  section=sections[labels.index(choice)]
  items=[i for i in section['items'] if isinstance(i,dict) and isinstance(i.get('label'),str) and isinstance(i.get('command'),list) and all(isinstance(x,str) for x in i['command'])]
  names=[i['label'] for i in items]+['← Back']
  selection=choose(names,choice)
  if selection not in names or selection=='← Back':continue
  item=items[names.index(selection)]
  cmd=[x.replace('{ROOT}',str(ROOT)) for x in item['command']]
  if not cmd or not shutil.which(cmd[0]) and not pathlib.Path(cmd[0]).is_file():
   print('Command unavailable:',cmd[0] if cmd else '(empty)',file=sys.stderr);continue
  if item.get('confirm'):
   confirmation=choose(['Cancel','Run'],'Confirm action')
   if confirmation!='Run':continue
  subprocess.Popen(cmd,start_new_session=True)
if __name__=='__main__':
 try:main()
 except (RuntimeError,ValueError,OSError) as e:print('ERROR:',e,file=sys.stderr);sys.exit(1)
